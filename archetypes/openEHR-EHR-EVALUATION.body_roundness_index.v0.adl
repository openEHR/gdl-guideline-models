	openEHR-EHR-EVALUATION.body_roundness_index.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-08-04">
		["name"] = <"Kevin Arjona">
		["organisation"] = <"Cambio CDS">
		["email"] = <"kevin.arjona@cambio.se">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the calculated BRI and HR of All-Cause Mortality based on the BRI.">
			keywords = <"body","roundness","index","bri","hr","mortality","obesity","risk","assessment">
			copyright = <"© Cambio CDS">
			use = <"Use to record the calculated BRI  and HR of All-Cause Mortality. ">
			misuse = <"Not to be used to record results other than the BRI.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["references"] = <"Thomas DM, Bredlau C, Bosy-Westphal A, Mueller M, Shen W, Gallagher D, Maeda Y, McDougall A, Peterson CM, Ravussin E, Heymsfield SB. Relationships between body roundness with body fat and visceral adipose tissue emerging from a new geometrical model. Obesity (Silver Spring). 2013 Nov;21(11):2264-71. doi: 10.1002/oby.20408. Epub 2013 Jun 11. PMID: 23519954; PMCID: PMC3692604.

Rico-Martín S, Calderón-García JF, Sánchez-Rey P, Franco-Antonio C, Martínez Alvarez M, Sánchez Muñoz-Torrero JF. Effectiveness of body roundness index in predicting metabolic syndrome: A systematic review and meta-analysis. Obes Rev. 2020 Jul;21(7):e13023. doi: 10.1111/obr.13023. Epub 2020 Apr 8. PMID: 32267621.

Zhang X, Ma N, Lin Q, Chen K, Zheng F, Wu J, Dong X, Niu W. Body Roundness Index and All-Cause Mortality Among US Adults. JAMA Netw Open. 2024 Jun 3;7(6):e2415051. doi: 10.1001/jamanetworkopen.2024.15051. Erratum in: JAMA Netw Open. 2024 Jul 1;7(7):e2426540. doi: 10.1001/jamanetworkopen.2024.26540. PMID: 38837158; PMCID: PMC11154161.">
		["build_uid"] = <"664e60c8-7c58-364e-ad15-2a9416cdd4d2">
	>

definition
	EVALUATION[at0000] matches {    -- Body Roundness Index
		data matches {
			ITEM_TREE[at0003] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- Total score
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::380]>
								list = <
									["1"] = <
										units = <"1">
										precision = <|3|>
									>
								>
							>
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- HR of All-Cause Mortality
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0006,    -- 0.57 (0.49-0.67)
									at0007,    -- 0.81 (0.69-0.95)
									at0008,    -- 1 (reference)
									at0009,    -- 1.48 (1.30-1.69)
									at0010]    -- 1.62 (1.42-1.85)
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0002] occurrences matches {0..1} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Body Roundness Index">
					description = <"The Body Roundness Index (BRI) is an assessment index used to identify individuals at increased risk of obesity-related conditions and all-cause mortality.">
					comment = <"Original version, c 2013.">
				>
				["at0001"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
				["at0003"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Total score">
					description = <"The total sum of each component parameter for the body roundness index.">
				>
