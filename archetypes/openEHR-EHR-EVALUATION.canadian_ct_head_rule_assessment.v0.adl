		["organisation"] = <"Cambio CDS">
		["email"] = <"kevin.arjona@cambio.se">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the recommendation for a CT head scan based on the Canadian CT Head Rule.">
			keywords = <"minor, head, injury, ct, trauma, concussion, skull, fracture, glasgow, coma, scale, GCS, radiology, assessment.", ...>
			copyright = <"© Cambio CDS">
			use = <"Use to record the recommendations and the associated risk level based on the criteria recorded in the openEHR-EHR-OBSERVATION.canadian_ct_head_rule.v0 archetype.">
			misuse = <"Do not use to evaluate other criteria; instead, use the appropriate archetypes.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
