	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the assessment of CHA2DS2-VA score.">
			keywords = <"CHA2DS2-VA","risk","assessment">
			copyright = <"Cambio Healthcare Systems">
