definition
	EVALUATION[at0000] matches {    -- CHA2DS2VA score assessment
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Annual risk of ischemic stroke
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003,    -- 0.5%
									at0004,    -- 1.5%
									at0005,    -- 2.9%
									at0006,    -- 5.1%
									at0007,    -- 7.3%
									at0008,    -- 11.2%
									at0009,    -- 15.5%
									at0010,    -- 14.7%
									at0011]    -- 19.5%
								}
							}
						}
					}
					ELEMENT[at0013] occurrences matches {0..1} matches {    -- Recommendation
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

