archetype (adl_version=1.4)
	openEHR-EHR-EVALUATION.eye_diagnosis_assessment.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["name"] = <"Cambio CDS">
		["date"] = <"2026-09-07">
	>
	lifecycle_state = <"in_development">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record a symptom-matrix based diagnostic impression and its supporting evidence for common eye presentations.">
			use = <"Use as clinical decision support. The suggested diagnosis is not a confirmed diagnosis and must be assessed by a qualified clinician.">
			misuse = <"Not for traumatic eye injuries or as a replacement for clinical examination.">
			copyright = <"© Cambio CDS">
		>
	>

definition
	EVALUATION[at0000] matches {
		data matches {
			ITEM_TREE[at0001] matches {
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] matches { -- Suggested diagnosis
						value matches { DV_CODED_TEXT matches { defining_code matches {[local::at0011, at0012, at0013, at0014, at0015, at0016, at0017, at0018]} } }
					}
					ELEMENT[at0003] matches { value matches { DV_COUNT matches {*} } } -- Conjunctivitis match count
					ELEMENT[at0004] matches { value matches { DV_COUNT matches {*} } } -- Iritis match count
					ELEMENT[at0005] matches { value matches { DV_COUNT matches {*} } } -- Keratitis match count
					ELEMENT[at0006] matches { value matches { DV_COUNT matches {*} } } -- Acute glaucoma match count
					ELEMENT[at0007] matches { value matches { DV_COUNT matches {*} } } -- Posterior vitreous detachment match count
					ELEMENT[at0008] matches { value matches { DV_COUNT matches {*} } } -- Retinal detachment match count
					ELEMENT[at0009] matches { value matches { DV_COUNT matches {*} } } -- Macular degeneration match count
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <text = <"Eye diagnosis assessment"> description = <"Symptom-matrix diagnostic impression.">>
				["at0001"] = <text = <"Assessment"> description = <"Diagnostic assessment data.">>
				["at0002"] = <text = <"Suggested diagnosis"> description = <"Unique highest-scoring diagnostic impression, if present.">>
				["at0003"] = <text = <"Conjunctivitis match count"> description = <"Number of matching symptoms.">>
				["at0004"] = <text = <"Iritis match count"> description = <"Number of matching symptoms.">>
				["at0005"] = <text = <"Keratitis match count"> description = <"Number of matching symptoms.">>
				["at0006"] = <text = <"Acute glaucoma match count"> description = <"Number of matching symptoms.">>
				["at0007"] = <text = <"Posterior vitreous detachment match count"> description = <"Number of matching symptoms.">>
				["at0008"] = <text = <"Retinal detachment match count"> description = <"Number of matching symptoms.">>
				["at0009"] = <text = <"Macular degeneration match count"> description = <"Number of matching symptoms.">>
				["at0011"] = <text = <"Conjunctivitis"> description = <"Suggested diagnosis.">>
				["at0012"] = <text = <"Iritis"> description = <"Suggested diagnosis.">>
				["at0013"] = <text = <"Keratitis"> description = <"Suggested diagnosis.">>
				["at0014"] = <text = <"Acute glaucoma"> description = <"Suggested diagnosis.">>
				["at0015"] = <text = <"Posterior vitreous detachment"> description = <"Suggested diagnosis.">>
				["at0016"] = <text = <"Retinal detachment"> description = <"Suggested diagnosis.">>
				["at0017"] = <text = <"Macular degeneration"> description = <"Suggested diagnosis.">>
				["at0018"] = <text = <"No single leading diagnosis"> description = <"No symptoms matched or the leading score was tied.">>
			>
		>
	>