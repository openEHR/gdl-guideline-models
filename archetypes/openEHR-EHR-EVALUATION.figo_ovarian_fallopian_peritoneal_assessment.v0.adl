	openEHR-EHR-EVALUATION.figo_ovarian_fallopian_peritoneal_assessment.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-02-02">
		["name"] = <"Katja Mariko Wilde">
		["organisation"] = <"Cambio CDS">
		["email"] = <"katja-wilde@t-online.de">
	>
	lifecycle_state = <"in_development">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the derived FIGO stage (including substages) for ovarian, fallopian tube, and primary peritoneal carcinoma based on recorded staging findings.">
			keywords = <"figo","ovarian","fallopian","tube","peritoneal","carcinoma","staging","oncology">
			copyright = <"© Cambio CDS">
			use = <"Use to record the derived FIGO stage (including substages) for ovarian, fallopian tube, and primary peritoneal carcinoma based on recorded staging findings.">
			misuse = <"Not to be used for recording TNM categories, TNM stage groups, or pathological staging outputs. Not to be used for staging other tumour types outside ovarian, fallopian tube, and primary peritoneal carcinoma.">
		>
	>
	other_details = <
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Regionala cancercentrum i samverkan. Nationellt vårdprogram Äggstockscancer med epitelial histologi: Kapitel 1 Sammanfattning. Kunskapsbanken, 2025. Available at: https://kunskapsbanken.cancercentrum.se/diagnoser/aggstockscancer-epitelial/vardprogram/sammanfattning/
Prat J. Ovarian, fallopian tube and peritoneal cancer staging: Rationale and explanation of new FIGO staging 2013. Best Pract Res Clin Obstet Gynaecol. 2015 Aug;29(6):858-69. doi: 10.1016/j.bpobgyn.2015.03.006. Epub 2015 Mar 31. PMID: 25890882.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
