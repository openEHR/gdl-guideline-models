	>

definition
	EVALUATION[at0000] matches {    -- FIGO stage for ovarian, fallopian tube and primary peritoneal carcinoma (2013)
		protocol matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0002] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
		data matches {
			ITEM_TREE[at0003] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- FIGO stage
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0005,    -- Stage I
									at0006,    -- Stage IA
									at0007,    -- Stage IB
									at0008,    -- Stage IC
									at0009,    -- Stage IC1
									at0010,    -- Stage IC2
									at0011,    -- Stage IC3
									at0012,    -- Stage II
									at0013,    -- Stage IIA
									at0014,    -- Stage IIB
									at0015,    -- Stage III
									at0016,    -- Stage IIIA1i
									at0017,    -- Stage IIIA1ii
									at0018,    -- Stage IIIA2
									at0019,    -- Stage IIIB
									at0020,    -- Stage IIIC
									at0021,    -- Stage IV
									at0022,    -- Stage IVA
									at0023,    -- Stage IVB
									at0024,    -- Stage cannot be assigned
									at0025,    -- Stage IX (substage not specified)
									at0026,    -- Stage ICX (substage not specified)
									at0027,    -- Stage IIX (substage not specified)
									at0028,    -- Stage IIIX (substage not specified)
									at0029,    -- Stage IIIA1X (substage not specified)
									at0030]    -- Stage IVX (substage not specified)
								}
							}
						}
					}
				}
			}
		}
	}

