	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To assess the results of the clinical and pathological findings stored in the openEHR-EHR-OBSERVATION.figo_staging_for_endometrial_cancer_.v0 archetype.">
			keywords = <"figo","endometrial","cancer","uterine","staging","oncology","gynecology","tumor","assessment">
			copyright = <"© Cambio CDS">
			use = <"Use to record the assigned prognostic stage group for endometrial cancer based on the extent of the tumor.">
			misuse = <"Not to be used to record staging for cervical, ovarian, or other gynecological cancers.">
		>
	>
