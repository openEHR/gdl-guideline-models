definition
	EVALUATION[at0000] matches {    -- FIGO staging for endometrial cancer assessment
		data matches {
			ITEM_TREE[at0003] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- Stage group
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0005,    -- I
									at0006,    -- IA
									at0007,    -- IB
									at0008,    -- II
									at0009,    -- III
									at0010,    -- IIIA
									at0011,    -- IIIB
									at0012,    -- IIIC
									at0013,    -- IIIC1
									at0014,    -- IIIC2
									at0015,    -- IV
									at0016,    -- IVA
									at0017]    -- IVB
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0002] occurrences matches {0..1} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

