archetype (adl_version=1.4; uid=31c5d4bc-8a48-4d6e-9f68-934bfe0dbf89)
	openEHR-EHR-EVALUATION.nivo_assessment.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-08-31">
		["name"] = <"Kevin Arjona">
		["organisation"] = <"Cambio CDS">
		["email"] = <"kevin.arjona@cambio.se">
	>
	lifecycle_state = <"in_development">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the interpreted risk classification and predicted mortality estimates derived from the Noninvasive Ventilation Outcomes (NIVO) score.">
			keywords = <"nivo", "noninvasive ventilation", "mortality", "risk", "assessment">
			copyright = <"© Cambio CDS">
			use = <"Use to record the risk classification, in-hospital mortality estimate, and 90-day mortality estimate derived from the NIVO score.">
			misuse = <"Not to be used to predict outcomes for patients who have not initiated noninvasive ventilation or for conditions other than acute respiratory failure.">
		>
	>
	other_details = <
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Hartley T, Lane ND, Steer J, Elliott MW, Sovani MP, Curtis HJ, Fuller ER, Murphy PB, Shrikrishna D, Lewis KE, Ward NR, Turnbull CD, Hart N, Bourke SC. The Noninvasive Ventilation Outcomes (NIVO) score: prediction of in-hospital mortality in exacerbations of COPD requiring assisted ventilation. Eur Respir J. 2021 Aug 12;58(2):2004042. doi: 10.1183/13993003.04042-2020.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
	>

definition
	EVALUATION[at0000] matches {    -- NIVO assessment
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Risk assessment
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- In-hospital mortality
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- 90-day mortality
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0005] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0006] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"NIVO assessment">
					description = <"A clinical assessment representing the interpreted NIVO score, including risk classification and predicted mortality estimates.">
				>
				["at0001"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Risk assessment">
					description = <"Risk category based on the calculated NIVO score.">
				>
				["at0003"] = <
					text = <"In-hospital mortality">
					description = <"Predicted in-hospital mortality based on the calculated NIVO score.">
				>
				["at0004"] = <
					text = <"90-day mortality">
					description = <"Predicted mortality within 90 days based on the calculated NIVO score.">
				>
				["at0005"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0006"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
				>
			>
		>
	>