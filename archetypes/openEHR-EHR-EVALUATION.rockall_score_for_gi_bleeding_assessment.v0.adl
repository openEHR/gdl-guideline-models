			purpose = <"To assess the data recorded on the openEHR-EHR-OBSERVATION.rockall_score_for_gi_bleeding.v0 archetype">
			keywords = <"GI, bleeding, upper, endoscopy, gastrointestinal, score, prognosis, assessment", ...>
			copyright = <"© Cambio CDS">
			use = <"Use to assess the data recorded for the Rockall Score for Upper GI Bleeding in patients with clinical upper GI bleeding.">
			misuse = <"Do not use in patients who have not completed an endoscopy. 
Do not use to record endoscopy diagnoses, use the proper archetype instead">
