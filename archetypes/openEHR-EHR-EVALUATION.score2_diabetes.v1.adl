					description = <"Current">
				>
				["at0004"] = <
					text = <"Other">
					description = <"Other">
				>
				["at0005"] = <
					text = <"Total cholesterol ">
					description = <"*">
				>
				["at0006"] = <
					text = <"HDL cholesterol ">
					description = <"*">
				>
				["at0007"] = <
					text = <"Diabetes">
					description = <"*">
				>
				["at0008"] = <
					text = <"Yes">
					description = <"Yes">
				>
				["at0009"] = <
					text = <"No">
					description = <"No">
				>
				["at0010"] = <
					text = <"10-year risk ">
					description = <"*">
				>
				["at0011"] = <
					text = <"Diabetes age at diagnosis (yrs)">
					description = <"*">
				>
				["at0012"] = <
					text = <"HbA1c">
					description = <"*">
				>
				["at0013"] = <
