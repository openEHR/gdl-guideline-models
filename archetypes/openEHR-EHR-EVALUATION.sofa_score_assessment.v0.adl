definition
	EVALUATION[at0000] matches {    -- SOFA score assessment
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- PaO2
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::125]>
								list = <
									["1"] = <
										units = <"kPa">
									>
									["2"] = <
										units = <"mm[Hg]">
									>
								>
							>
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {    -- PaO2 date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- FiO2
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::380]>
								list = <
									["1"] = <
										units = <"%">
									>
								>
							>
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {    -- FiO2 date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- PaO2/FiO2
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::125]>
								list = <
									["1"] = <
										units = <"kPa">
									>
									["2"] = <
										units = <"mm[Hg]">
									>
								>
							>
						}
					}
					ELEMENT[at0032] occurrences matches {0..1} matches {    -- PaO2/FiO2 date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0038] occurrences matches {0..1} matches {    -- PaO2/FiO2 comment
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0045] occurrences matches {0..1} matches {    -- O2 saturation
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::380]>
								list = <
									["1"] = <
										units = <"%">
									>
								>
							>
						}
					}
					ELEMENT[at0046] occurrences matches {0..1} matches {    -- O2 saturation date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- Systolic Blood Pressure
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::125]>
								list = <
									["1"] = <
										units = <"mm[Hg]">
									>
								>
							>
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {    -- Systolic Blood Pressure date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- Diastolic Blood Pressure
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::125]>
								list = <
									["1"] = <
										units = <"mm[Hg]">
									>
								>
							>
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {    -- Diastolic Blood Pressure date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- MAP
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::125]>
								list = <
									["1"] = <
										units = <"mm[Hg]">
									>
								>
							>
						}
					}
					ELEMENT[at0013] occurrences matches {0..1} matches {    -- MAP date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0039] occurrences matches {0..1} matches {    -- MAP comment
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0014] occurrences matches {0..1} matches {    -- Platelet count
						value matches {
							C_DV_QUANTITY <
								
								list = <
									["1"] = <
										units = <"10*3/uL">
									>
									["2"] = <
										units = <"10*9/L">
									>
								>
							>
						}
					}
					ELEMENT[at0015] occurrences matches {0..1} matches {    -- Platelet date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0042] occurrences matches {0..1} matches {    -- Platelet comment
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0016] occurrences matches {0..1} matches {    -- Total Bilirubin
						value matches {
							C_DV_QUANTITY <
								
								list = <
									["1"] = <
										units = <"umol/L">
									>
									["2"] = <
										units = <"mg/dL">
									>
								>
							>
						}
					}
					ELEMENT[at0017] occurrences matches {0..1} matches {    -- Total Bilirubin date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0040] occurrences matches {0..1} matches {    -- Total Bilirubin comment
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0018] occurrences matches {0..1} matches {    -- Creatinine
						value matches {
							C_DV_QUANTITY <
								
								list = <
									["1"] = <
										units = <"umol/L">
									>
								>
							>
						}
					}
					ELEMENT[at0019] occurrences matches {0..1} matches {    -- Creatinine date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0041] occurrences matches {0..1} matches {    -- Creatinine comment
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0020] occurrences matches {0..1} matches {    -- Urine output/24 hrs
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::126]>
								list = <
									["1"] = <
										units = <"ml/d">
									>
								>
							>
						}
					}
					ELEMENT[at0021] occurrences matches {0..1} matches {    -- Urine output date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0033] occurrences matches {0..1} matches {    -- Urine output
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::129]>
								list = <
									["1"] = <
										units = <"mL">
									>
								>
							>
						}
					}
					ELEMENT[at0036] occurrences matches {0..1} matches {    -- Hours
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::128]>
								list = <
									["1"] = <
										units = <"h">
									>
								>
							>
						}
					}
					ELEMENT[at0050] occurrences matches {0..1} matches {    -- Level of consciousness scale
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0051,    -- ACVPU
									at0052,    -- GCS
									at0053]    -- RLS
								}
							}
						}
					}
					ELEMENT[at0023] occurrences matches {0..1} matches {    -- Glasgow Coma Scale
						value matches {
							DV_COUNT matches {*}
						}
					}
					ELEMENT[at0024] occurrences matches {0..1} matches {    -- GCS date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0047] occurrences matches {0..1} matches {    -- RLS
						value matches {
							DV_COUNT matches {*}
						}
					}
					ELEMENT[at0048] occurrences matches {0..1} matches {    -- RLS date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0049] occurrences matches {0..1} matches {    -- ACVPU
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0054,    -- Alert (A)
									at0055,    -- Confusion (C)
									at0056,    -- Voice (V)
									at0057,    -- Pain (P)
									at0058]    -- Unresponsive (U)
								}
							}
						}
					}
					ELEMENT[at0059] occurrences matches {0..1} matches {    -- ACVPU date/time
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0043] occurrences matches {0..1} matches {    -- Enable SOFA score assessment
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0044] occurrences matches {0..1} matches {    -- Comments
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0025] matches {*}    -- Item tree
		}
	}

