archetype (adl_version=1.4; uid=b3f8adef-9be9-4467-ac92-1739ee3bee64)
	openEHR-EHR-EVALUATION.sokal_assesment.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2021-02-24">
		["name"] = <"Emma Malm">
		["organisation"] = <"Cambio CDS">
		["email"] = <"emma.snygg@hotmail.com">
	>
	lifecycle_state = <"AuthorDraft">
	other_contributors = <"Kevin Arjona, Cambio CDS, Kevin.arjona@cambio.se", ...>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the assessed risk group for the Sokal index.">
			keywords = <"CML","sokal","index","chronic","myelogenous","leukemia","myeloid","survival","risk","score","oncology","hematology">
			copyright = <"© Cambio CDS">
			use = <"Use to record the interpretation of the calculated Sokal index to predict risk group, 2-year Survival and Median Survival. ">
			misuse = <"Not to be used for patients with other types of leukemia.

Not to be used for pediatric patients.

Not to be used to record the risk group for other CML scoring systems like ELTS or Hasford.">
		>
	>
	other_details = <
		["references"] = <"Sokal JE, Cox EB, Baccarani M, Tura S, Gomez GA, Robertson JE, Tso CY, Braun TJ, Clarkson BD, Cervantes F, et al. Prognostic discrimination in \"good-risk\" chronic granulocytic leukemia. Blood. 1984 Apr;63(4):789-99. PMID: 6584184.">
		["current_contact"] = <"Emma Malm, Cambio CDS, emma.snygg@hotmail.com">
		["MD5-CAM-1.0.1"] = <"221BB36BBB60CE5E8493F631276A28A9">
		["build_uid"] = <"4db575b8-9d37-3b1d-bd45-3c7ed4df92cc">
	>

definition
	EVALUATION[at0000] matches {    -- Sokal index for Chronic Myelogenous Leukemia
		data matches {
			ITEM_TREE[at0002] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- Risk Group
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0004,    -- Low
									at0005,    -- Intermediate
									at0006]    -- High
								}
							}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- 2-year Survival
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0008,    -- 90%
									at0009,    -- 65-90%
									at0010]    -- 65%
								}
							}
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {    -- Median Survival
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0012,    -- 5 years
									at0013,    -- 2.5-5 years
									at0014]    -- 2.5 years
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0015] occurrences matches {0..1} matches {    -- Extenstion
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

