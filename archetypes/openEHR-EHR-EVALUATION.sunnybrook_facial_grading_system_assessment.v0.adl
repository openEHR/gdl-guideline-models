	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Sunnybrook facial grading system assessment">
					description = <"Scale used to grade facial paralysis and assess the severity of peripheral facial palsy.">
					comment = <"Original version, c 1996.">
				>
				["at0001"] = <
