description
	original_author = <
		["date"] = <"2017-03-04">
		["name"] = <"Syeeda S Farruque">
		["organisation"] = <"Cambio CDS">
		["email"] = <"models@cambiocds.com">
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Katja Mariko Wilde", ...>
	details = <
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"*To record the interpreted 30-day mortality risk associated with the TIMI risk score for STEMI. (en)">
			keywords = <"*TIMI (en)","*STEMI (en)","*myocardial infarction (en)","*st-elevation (en)","*mortality (en)","*30-day mortality (en)","*risk (en)","*assessment (en)">
			copyright = <"*© Cambio CDS (en)">
			use = <"*Use to record the interpreted 30-day mortality risk associated with the TIMI risk score for STEMI. (en)">
			misuse = <"*Not to be used for calculating the TIMI risk score for STEMI. Use instead openEHR-EHR-OBSERVATION.timi_stemi.v0. (en)">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the interpreted 30-day mortality risk associated with the TIMI risk score for STEMI.">
			keywords = <"TIMI","STEMI","myocardial infarction","st-elevation","mortality","30-day mortality","risk","assessment">
			copyright = <"© Cambio CDS">
			use = <"Use to record the interpreted 30-day mortality risk associated with the TIMI risk score for STEMI.">
			misuse = <"Not to be used for calculating the TIMI risk score for STEMI. Use instead openEHR-EHR-OBSERVATION.timi_stemi.v0.">
		>
	>
	other_details = <
		["references"] = <"Morrow DA, Antman EM, Charlesworth A, Cairns R, Murphy SA, de Lemos JA, Giugliano RP, McCabe CH, Braunwald E. TIMI risk score for ST-elevation myocardial infarction: A convenient, bedside, clinical score for risk assessment at presentation: An intravenous nPA for treatment of infarcting myocardium early II trial substudy. Circulation. 2000 Oct 24;102(17):2031-7. doi: 10.1161/01.cir.102.17.2031. PMID: 11044416.">
		["MD5-CAM-1.0.1"] = <"4a2318d854032493bf89b2d011c84512">
		["build_uid"] = <"14a74a11-dd18-33fa-ac5e-55d9966909ce">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_organisation"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
	>

definition
	EVALUATION[at0000] matches {    -- TIMI risk score for STEMI assessment
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0015] occurrences matches {0..1} matches {    -- 30-day mortality risk
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0016,    -- 0,8%
									at0017,    -- 1,6%
									at0018,    -- 2,2%
									at0019,    -- 4,4%
									at0020,    -- 7,3%
									at0021,    -- 12,4%
									at0022,    -- 16,1%
									at0023,    -- 23,4%
									at0024,    -- 26,8%
									at0025]    -- 35,9%
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0013] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0014] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

