archetype (adl_version=1.4; uid=b9c3d2e4-5f6a-7890-bcde-f01234567890)
	openEHR-EHR-EVALUATION.tnm_assessment_breast.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-02-06">
		["name"] = <"Rashmi Damodaran">
		["organisation"] = <"Cambio CDS">
		["email"] = <"rashmi.damodaran@cambio.se">
	>
	lifecycle_state = <"Author draft">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the TNM stage assessment for breast cancer, including both clinical (cTNM) and pathological (pTNM) staging according to the UICC TNM 8th edition.">
			keywords = <"breast", "cancer", "TNM", "staging", "assessment", "clinical", "pathological", "stage group">
			copyright = <"© Cambio CDS">
			use = <"Use to record the combined TNM assessment and stage group for breast cancer. This archetype captures the overall staging result derived from T, N, and M categories.">
			misuse = <"Not to be used for recording individual T, N, M categories - use the TNM classification observation archetype for that purpose. Not to be used for TNM assessment of other cancer types.">
		>
	>
	other_details = <
		["licence"] = <"">
		["custodian_organisation"] = <"Cambio CDS">
		["references"] = <"Brierley JD, Gospodarowicz MK, Wittekind C, editors. TNM Classification of Malignant Tumours. 8th ed. Oxford: Wiley-Blackwell; 2017.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"">
		["build_uid"] = <"">
	>

definition
	EVALUATION[at0000] matches {    -- TNM assessment - Breast
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0002] occurrences matches {0..1} matches {    -- Clinical assessment (cTNM)
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0003] occurrences matches {0..1} matches {    -- Clinical TNM assessment
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0004] occurrences matches {0..1} matches {    -- Clinical TNM assessment with subcategory
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0005] occurrences matches {0..1} matches {    -- Clinical stage group
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0006,    -- Stage 0
											at0007,    -- Stage IA
											at0008,    -- Stage IB
											at0009,    -- Stage IIA
											at0010,    -- Stage IIB
											at0011,    -- Stage IIIA
											at0012,    -- Stage IIIB
											at0013,    -- Stage IIIC
											at0014]    -- Stage IV
										}
									}
								}
							}
						}
					}
					CLUSTER[at0015] occurrences matches {0..1} matches {    -- Pathological assessment (pTNM)
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0016] occurrences matches {0..1} matches {    -- Pathological TNM assessment
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0017] occurrences matches {0..1} matches {    -- Pathological TNM assessment with subcategory
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0018] occurrences matches {0..1} matches {    -- Pathological stage group
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0019,    -- Stage 0
											at0020,    -- Stage IA
											at0021,    -- Stage IB
											at0022,    -- Stage IIA
											at0023,    -- Stage IIB
											at0024,    -- Stage IIIA
											at0025,    -- Stage IIIB
											at0026,    -- Stage IIIC
											at0027]    -- Stage IV
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0028] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0029] occurrences matches {0..1} matches {*}    -- Extension
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"TNM assessment - Breast">
					description = <"TNM stage assessment for breast cancer according to the UICC TNM 8th edition, including both clinical (cTNM) and pathological (pTNM) staging.">
				>
				["at0001"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Clinical assessment (cTNM)">
					description = <"Clinical TNM stage assessment based on pre-treatment evaluation.">
				>
				["at0003"] = <
					text = <"Clinical TNM assessment">
					description = <"Combined clinical TNM classification (e.g., cT2N1M0).">
				>
				["at0004"] = <
					text = <"Clinical TNM assessment with subcategory">
					description = <"Combined clinical TNM classification including subcategories (e.g., cT1cN2aM0).">
				>
				["at0005"] = <
					text = <"Clinical stage group">
					description = <"Overall clinical stage grouping based on cTNM classification.">
				>
				["at0006"] = <
					text = <"Stage 0">
					description = <"Tis, N0, M0">
				>
				["at0007"] = <
					text = <"Stage IA">
					description = <"T1, N0, M0">
				>
				["at0008"] = <
					text = <"Stage IB">
					description = <"T0-T1, N1mi, M0">
				>
				["at0009"] = <
					text = <"Stage IIA">
					description = <"T0-T1, N1, M0 or T2, N0, M0">
				>
				["at0010"] = <
					text = <"Stage IIB">
					description = <"T2, N1, M0 or T3, N0, M0">
				>
				["at0011"] = <
					text = <"Stage IIIA">
					description = <"T0-T2, N2, M0 or T3, N1-N2, M0">
				>
				["at0012"] = <
					text = <"Stage IIIB">
					description = <"T4, N0-N2, M0">
				>
				["at0013"] = <
					text = <"Stage IIIC">
					description = <"Any T, N3, M0">
				>
				["at0014"] = <
					text = <"Stage IV">
					description = <"Any T, Any N, M1">
				>
				["at0015"] = <
					text = <"Pathological assessment (pTNM)">
					description = <"Pathological TNM stage assessment based on post-surgical histopathological examination.">
				>
				["at0016"] = <
					text = <"Pathological TNM assessment">
					description = <"Combined pathological TNM classification (e.g., pT2pN1pM0).">
				>
				["at0017"] = <
					text = <"Pathological TNM assessment with subcategory">
					description = <"Combined pathological TNM classification including subcategories (e.g., pT1cpN2apM0).">
				>
				["at0018"] = <
					text = <"Pathological stage group">
					description = <"Overall pathological stage grouping based on pTNM classification.">
				>
				["at0019"] = <
					text = <"Stage 0">
					description = <"pTis, pN0, pM0">
				>
				["at0020"] = <
					text = <"Stage IA">
					description = <"pT1, pN0, pM0">
				>
				["at0021"] = <
					text = <"Stage IB">
					description = <"pT0-pT1, pN1mi, pM0">
				>
				["at0022"] = <
					text = <"Stage IIA">
					description = <"pT0-pT1, pN1, pM0 or pT2, pN0, pM0">
				>
				["at0023"] = <
					text = <"Stage IIB">
					description = <"pT2, pN1, pM0 or pT3, pN0, pM0">
				>
				["at0024"] = <
					text = <"Stage IIIA">
					description = <"pT0-pT2, pN2, pM0 or pT3, pN1-pN2, pM0">
				>
				["at0025"] = <
					text = <"Stage IIIB">
					description = <"pT4, pN0-pN2, pM0">
				>
				["at0026"] = <
					text = <"Stage IIIC">
					description = <"Any pT, pN3, pM0">
				>
				["at0027"] = <
					text = <"Stage IV">
					description = <"Any pT, Any pN, pM1">
				>
				["at0028"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0029"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
			>
		>
	>
