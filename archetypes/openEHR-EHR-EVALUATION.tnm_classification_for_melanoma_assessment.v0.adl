definition
	EVALUATION[at0000] matches {    -- TNM classification for melanoma assessment
		data matches {
			ITEM_TREE[at0003] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- Staging
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0005,    -- Clinical staging
									at0006]    -- Pathological staging
								}
							}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- Stage group
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0008,    -- 0
									at0009,    -- IA
									at0010,    -- IB
									at0011,    -- IIA
									at0012,    -- IIB
									at0013,    -- IIC
									at0014,    -- III
									at0015,    -- IIIA
									at0016,    -- IIIB
									at0017,    -- IIIC
									at0018,    -- IIID
									at0019]    -- IV
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0002] occurrences matches {0..1} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

