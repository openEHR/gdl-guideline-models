	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the prognostic stage group for melanoma.">
			keywords = <"tnm","melanoma","skin","cancer","oncology","uicc","ajcc","staging","metastasis","tumor","stage","assessment">
			copyright = <"© Cambio CDS">
			use = <"Use to record the prognostic stage group (from stage 0 to stage IV) for melanoma based on the T, N, and M categories.">
			misuse = <"Not to be used for staging other types of cancer.

Not to be used for non-melanoma skin cancers.">
		>
	>
