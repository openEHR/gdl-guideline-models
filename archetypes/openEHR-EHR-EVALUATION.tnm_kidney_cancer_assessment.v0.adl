	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the prognostic stage group for kidney cancer.">
			keywords = <"tnm","kidney","cancer","renal","cell","carcinoma","rcc","oncology","uicc","staging","metastasis","tumor","stage","assessment">
			copyright = <"© Cambio CDS">
			use = <"Use to record the prognostic stage group (from stage I to stage IV) for kidney cancer based on the T, N, and M categories.">
			misuse = <"Not to be used for staging other types of cancer. 

Not to be used for non-renal cell carcinomas of the kidney.">
		>
	>
