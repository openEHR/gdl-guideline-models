	openEHR-EHR-EVALUATION.tnm_ovarian_fallopian_peritoneal_clinical_assessment.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-01-26">
		["name"] = <"Katja Mariko Wilde">
		["organisation"] = <"Cambio CDS">
		["email"] = <"katja-wilde@t-online.de">
	>
	lifecycle_state = <"in_development">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the derived TNM stage group for ovarian, fallopian tube, and primary peritoneal carcinoma based on the clinical T, N, and M categories.">
			keywords = <"tnm","uicc","ovarian","fallopian","tube","peritoneal","carcinoma","staging","oncology">
			copyright = <"© Cambio CDS">
			use = <"Use to record the derived TNM stage group for ovarian, fallopian tube, and primary peritoneal carcinoma based on the clinical T, N, and M categories.">
			misuse = <"Not to be used for recording raw tumour findings, lymph node measurements, imaging results, surgical findings, or pathological TNM (pTNM).">
		>
	>
	other_details = <
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Regionala cancercentrum i samverkan. Nationellt vårdprogram Äggstockscancer med epitelial histologi: Kapitel 1 Sammanfattning. Kunskapsbanken, 2025. Available at: https://kunskapsbanken.cancercentrum.se/diagnoser/aggstockscancer-epitelial/vardprogram/sammanfattning/
Brierley JD, Gospodarowicz MK, Wittekind C, editors. TNM classification of malignant tumours. 8th ed. Hoboken (NJ): Wiley Blackwell; 2017">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
