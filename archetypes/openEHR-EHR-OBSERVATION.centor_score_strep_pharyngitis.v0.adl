		["references"] = <"https://pubmed.ncbi.nlm.nih.gov/6763125/
https://www.mdcalc.com/calc/104/centor-score-modified-mcisaac-strep-pharyngitis
https://verktyg.internetmedicin.se/kalkylatorer/centorkriterierna
McIsaac WJ, White D, Tannenbaum D, Low DE. CMAJ. 1998;158(1):75-83.">
