	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To assess the likelihood of streptococcal pharyngitis and support diagnostic and treatment decisions based on a validated clinical prediction rule.">
			keywords = <"strep throat, sore throat, McIsaac score, Centor score, pharyngitis, clinical decision support, antibiotics", ...>
			copyright = <"Use © Cambio CDS">
			use = <"Used in primary care or emergency settings for patients presenting with sore throat symptoms.">
			misuse = <"Not to be used in patients with known immunosuppression or chronic tonsillar conditions. Should not replace clinical judgment.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
