					text = <"Tonsillar swelling or exudates">
					description = <"">
				>
				["at0007"] = <
					text = <"Fever >= 38 °C">
					description = <"">
				>
				["at0008"] = <
					text = <"Results">
					description = <"">
				>
				["at0009"] = <
					text = <"1-2.5%">
					description = <"No further testing or antibiotics.">
				>
				["at0010"] = <
					text = <"5-10%">
					description = <"No further testing or antibiotics.">
				>
				["at0011"] = <
					text = <"11-17%">
					description = <"Optional rapid strep testing and/or culture.">
				>
				["at0012"] = <
					text = <"28-35%">
					description = <"Consider rapid strep testing and/or culture.">
				>
				["at0013"] = <
					text = <"51-53%">
					description = <"Consider rapid strep testing and/or culture. Empiric antibiotics may be appropriate depending on the specific scenario">
				>
