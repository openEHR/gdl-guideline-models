definition
	OBSERVATION[at0000] matches {    -- centor_score_strep_pharyngitis
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0007] occurrences matches {0..1} matches {    -- Fever > 38 °C
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- Cough
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0005] occurrences matches {0..1} matches {    -- Tender cervical lymph nodes
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0006] occurrences matches {0..1} matches {    -- Tonsillar swelling or exudates
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0008] occurrences matches {0..1} matches {    -- Results
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0009,    -- 1-2.5%
													at0010,    -- 5-10%
													at0011,    -- 11-17%
													at0012,    -- 28-35%
													at0013]    -- 51-53%
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"centor_score_strep_pharyngitis">
					description = <"A clinical decision guideline for estimating the probability of streptococcal pharyngitis in patients with sore throat symptoms using the Modified Centor Score (also known as McIsaac score). The score considers five criteria: fever, cough absence, cervical lymph nodes, tonsillar findings, and patient age. The total score ranges from -1 to 5 and helps guide decisions on testing and antibiotic treatment.">
					comment = <"Original version, c 1981">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Cough">
					description = <"">
				>
				["at0005"] = <
					text = <"Tender cervical lymph nodes">
					description = <"">
				>
				["at0006"] = <
					text = <"Tonsillar swelling or exudates">
					description = <"">
				>
				["at0007"] = <
					text = <"Fever > 38 °C">
					description = <"">
				>
				["at0008"] = <
					text = <"Results">
					description = <"">
				>
				["at0009"] = <
					text = <"1-2.5%">
					description = <"No further testing or antibiotics.">
				>
				["at0010"] = <
					text = <"5-10%">
					description = <"No further testing or antibiotics.">
				>
				["at0011"] = <
					text = <"11-17%">
					description = <"Optional rapid strep testing and/or culture.">
				>
				["at0012"] = <
					text = <"28-35%">
					description = <"Consider rapid strep testing and/or culture.">
				>
				["at0013"] = <
					text = <"51-53%">
					description = <"Consider rapid strep testing and/or culture. Empiric antibiotics may be appropriate depending on the specific scenario">
				>
			>
		>
	>
