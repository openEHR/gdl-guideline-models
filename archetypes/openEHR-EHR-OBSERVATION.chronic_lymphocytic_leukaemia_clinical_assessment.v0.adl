	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Chronic lymphocytic leukaemia clinical assessment">
					description = <"Rai and Binet staging are clinical classification systems used to stratify tumor burden in chronic lymphocytic leukemia (CLL), based on physical examination findings and blood counts.">
					comment = <"Rai staging, original version, 1975.
Binet staging, original version, 1981.">
				>
