	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the results for each component parameter and their value for the Figo grading for endometrioid adenocarcinoma.">
			keywords = <"figo","endometrioid","adenocarcinoma","endometrial","cancer","oncology","pathology","grading","gynecology","obstetrics">
			copyright = <"© Cambio CDS">
			use = <"Use to record the component parameters and the histologic grade for the Figo grading for endometrioid adenocarcinoma.">
			misuse = <"Not to be used for grading other histological subtypes of endometrial cancer, such as serous or clear cell carcinomas.">
		>
	>
