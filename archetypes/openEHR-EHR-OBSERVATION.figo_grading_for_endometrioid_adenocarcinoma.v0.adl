definition
	OBSERVATION[at0000] matches {    -- FIGO grading for endometrioid adenocarcinoma
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0013] occurrences matches {0..1} matches {    -- Glandular differentiation
										value matches {
											1|[local::at0014],
											2|[local::at0015],
											3|[local::at0016]
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {    -- Notable severe nuclear atypia in more than 50% of the cells
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0011,    -- Absent
													at0012]    -- Present
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0005] occurrences matches {0..1} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"FIGO grading for endometrioid adenocarcinoma">
					description = <"The Figo grading for endometrioid adenocarcinoma is used to determine the histologic grade of endometrioid adenocarcinoma based on the proportion of solid growth and the presence of severe nuclear atypia.">
					comment = <"Original version, c 2009.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0005"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
				["at0010"] = <
					text = <"Notable severe nuclear atypia in more than 50% of the cells">
					description = <"">
				>
				["at0011"] = <
					text = <"Absent">
					description = <"">
				>
				["at0012"] = <
					text = <"Present">
					description = <"">
				>
				["at0013"] = <
					text = <"Glandular differentiation">
					description = <"">
				>
				["at0014"] = <
					text = <"FIGO grade 1 - tumors ≤5%">
					description = <"">
				>
				["at0015"] = <
					text = <"FIGO grade 2 - tumors from 6% to 50%">
					description = <"">
				>
				["at0016"] = <
					text = <"FIGO grade 3 - tumors >50%">
					description = <"">
				>
			>
