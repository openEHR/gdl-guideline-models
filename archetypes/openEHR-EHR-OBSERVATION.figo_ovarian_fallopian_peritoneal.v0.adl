archetype (adl_version=1.4; uid=492db2ee-e5ce-47da-8451-8266b8c04edf)
	openEHR-EHR-OBSERVATION.figo_ovarian_fallopian_peritoneal.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-01-26">
		["name"] = <"Katja Mariko Wilde">
		["organisation"] = <"Cambio CDS">
		["email"] = <"katja-wilde@t-online.de">
	>
	lifecycle_state = <"in_development">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the results for each component parameter required to determine the FIGO stage for ovarian, fallopian tube, and primary peritoneal carcinoma.">
			keywords = <"figo","ovarian","fallopian","tube","peritoneal","carcinoma","staging","oncology">
			copyright = <"© Cambio CDS">
			use = <"Use to record the results for each component parameter required to determine the FIGO stage for ovarian, fallopian tube, and primary peritoneal carcinoma.">
			misuse = <"Not to be used for recording clinical TNM staging or pathological TNM (pTNM) classification. Not to be used for staging of other gynaecological malignancies outside ovarian, fallopian tube, and primary peritoneal carcinoma.">
		>
	>
	other_details = <
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Regionala cancercentrum i samverkan. Nationellt vårdprogram Äggstockscancer med epitelial histologi: Kapitel 1 Sammanfattning. Kunskapsbanken, 2025. Available at: https://kunskapsbanken.cancercentrum.se/diagnoser/aggstockscancer-epitelial/vardprogram/sammanfattning/
Prat J. Ovarian, fallopian tube and peritoneal cancer staging: Rationale and explanation of new FIGO staging 2013. Best Pract Res Clin Obstet Gynaecol. 2015 Aug;29(6):858-69. doi: 10.1016/j.bpobgyn.2015.03.006. Epub 2015 Mar 31. PMID: 25890882.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"b7da18190428deeee312d90cabb75a6f">
		["build_uid"] = <"42d314b6-c4b6-400d-bc52-bf7b69c91da2">
	>

definition
	OBSERVATION[at0000] matches {    -- FIGO staging inputs for ovarian, fallopian tube and primary peritoneal carcinoma (2013)
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0017] occurrences matches {0..1} matches {    -- Ovary and fallopian tube involvement pattern
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0018,    -- Not applicable
													at0019,    -- Limited to one ovary (capsule intact) or one fallopian tube
													at0020,    -- Limited to both ovaries (capsule intact) or both fallopian tubes
													at0021]    -- Limited to one or both ovaries/fallopian tubes with either of the following
												}
											}
										}
									}
									ELEMENT[at0022] occurrences matches {0..1} matches {    -- Tumour spill / surface / cytology finding
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0023,    -- Not applicable
													at0024,    -- Surgical spill (intraoperative rupture/spillage)
													at0025,    -- Capsule ruptured before surgery or tumour on ovarian/fallopian tube surface
													at0026]    -- Malignant cells in ascites or peritoneal washings
												}
											}
										}
									}
									ELEMENT[at0027] occurrences matches {0..1} matches {    -- Pelvic extension pattern
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0028,    -- Not applicable
													at0029,    -- Extension to and/or implants on uterus, tubes, or ovaries
													at0030]    -- Extension to other pelvic intraperitoneal tissues
												}
											}
										}
									}
									ELEMENT[at0036] occurrences matches {0..1} matches {    -- Largest retroperitoneal nodal metastasis size
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0037,    -- Not applicable
													at0038,    -- ≤ 10 mm
													at0039]    -- > 10 mm
												}
											}
										}
									}
									ELEMENT[at0040] occurrences matches {0..1} matches {    -- Extrapelvic peritoneal disease extent
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0041,    -- Not applicable
													at0042,    -- Microscopic extrapelvic peritoneal disease
													at0043,    -- Macroscopic extrapelvic peritoneal metastasis ≤ 2 cm
													at0044]    -- Macroscopic extrapelvic peritoneal metastasis > 2 cm (includes liver/spleen capsule involvement without parenchymal disease)
												}
											}
										}
									}
									ELEMENT[at0045] occurrences matches {0..1} matches {    -- Type of distant metastasis
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0046,    -- Not applicable
													at0047,    -- Pleural effusion with positive cytology
													at0048]    -- Parenchymal metastasis and/or extra-abdominal organ metastasis (incl. inguinal nodes and nodes outside abdominal cavity)
												}
											}
										}
									}
									ELEMENT[at0049] occurrences matches {0..1} matches {    -- Primary peritoneal carcinoma
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0050] occurrences matches {0..1} matches {    -- Tumour confined to ovaries/ovary or fallopian tube(s)
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0051] occurrences matches {0..1} matches {    -- Pelvic extension below pelvic brim
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0052] occurrences matches {0..1} matches {    -- Extrapelvic peritoneal spread
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0053] occurrences matches {0..1} matches {    -- Retroperitoneal lymph node metastasis
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0054] occurrences matches {0..1} matches {    -- Distant metastasis excluding peritoneal metastasis
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0005] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

