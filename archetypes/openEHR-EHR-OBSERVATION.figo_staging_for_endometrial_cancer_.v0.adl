definition
	OBSERVATION[at0000] matches {    -- FIGO staging for endometrial cancer
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0006] occurrences matches {0..1} matches {    -- Clinical and pathological findings
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0007,    -- Tumor confined to the corpus uteri
													at0008,    -- No invasion or invasion < half the thickness of the myometrium
													at0009,    -- Invasion ≥ half the thickness of the myometrium
													at0010,    -- Invasion into the cervical stroma but not outside the uterus
													at0011,    -- Local and/or regional spread
													at0012,    -- Invasion of uterine serosa and/or adnexa
													at0013,    -- Vaginal growth and/or parametrial growth
													at0014,    -- Metastases to pelvic nodes and/or paraaortic lymph nodes
													at0015,    -- Positive pelvic nodes
													at0016,    -- Positive paraaortic glands regardless of positive or negative pelvic glands
													at0017,    -- Spread to bladder and/or rectum and/or distant metastases
													at0018,    -- Spread to the bladder and/or rectum
													at0019]    -- Distant metastases, including intra-abdominal metastases and/or inguinal metastases
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0005] occurrences matches {0..1} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

