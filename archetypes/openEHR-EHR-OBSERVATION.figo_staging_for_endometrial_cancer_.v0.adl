archetype (adl_version=1.4; uid=33129fa8-bf57-4193-8e95-800fda57f3aa)
	openEHR-EHR-OBSERVATION.figo_staging_for_endometrial_cancer_.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-07-10">
		["name"] = <"Kevin Arjona">
		["organisation"] = <"Cambio CDS">
		["email"] = <"kevin.arjona@cambio.se">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the individual anatomical, nodal, and distant-spread findings used to determine FIGO 2009 stage for endometrial cancer.">
			keywords = <"figo","endometrial","cancer","uterine","staging","oncology","gynecology","tumor">
			copyright = <"© Cambio CDS">
			use = <"Use to record each endometrial cancer staging finding separately: depth of myometrial invasion; cervical stromal involvement; uterine serosal/adnexal involvement; vaginal/parametrial involvement; pelvic and para-aortic nodal status; bladder/rectal mucosal invasion; and distant metastasis. For each applicable finding, distinguish absent, present, and not assessed. Record isolated tumour cells separately from nodal metastasis. These inputs are structured for the FIGO 2009 staging logic; FIGO 2023 molecular and histological risk modifiers are not represented by this archetype version.">
			misuse = <"Not to be used to record staging for cervical, ovarian, or other gynecological cancers.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Pecorelli S. Revised FIGO staging for carcinoma of the vulva, cervix, and endometrium. Int J Gynaecol Obstet. 2009 May;105(2):103-4. doi: 10.1016/j.ijgo.2009.02.012. Erratum in: Int J Gynaecol Obstet. 2010 Feb;108(2):176. PMID: 19367689.

Berek JS, Matias-Guiu X, Creutzberg C, Fotopoulou C, Gaffney D, Kehoe S, Lindemann K, Mutch D, Concin N; Endometrial Cancer Staging Subcommittee, FIGO Women's Cancer Committee. FIGO staging of endometrial cancer: 2023. Int J Gynaecol Obstet. 2023 Aug;162(2):383-394. doi: 10.1002/ijgo.14923. Epub 2023 Jun 20. Erratum in: Int J Gynaecol Obstet. 2024 Sep;166(3):1374. doi: 10.1002/ijgo.15193. PMID: 37337978.

Matsuo K, Klar M, Song BB, Roman LD, Wright JD. Validation of the 2023 FIGO staging schema for advanced endometrial cancer. Eur J Cancer. 2023 Nov;193:113316. doi: 10.1016/j.ejca.2023.113316. Epub 2023 Sep 21. PMID: 37741790.

Nationellt vårdprogram livmoderkroppscancer [Internet]. Regionala cancercentrum i samverkan; [cited 2026 Jul 10]. Available from: https://kunskapsbanken.cancercentrum.se/diagnoser/livmoderkroppscancer/vardprogram/kategorisering-av-tumoren/
Pecorelli S. Revised FIGO staging for carcinoma of the vulva, cervix, and endometrium. Int J Gynaecol Obstet. 2009;105(2):103-4.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"0ea3af2fdf607ba07b41d4a21843a04a">
		["build_uid"] = <"591bb3e6-32c2-3bf0-8566-765294549ca3">
	>

definition
	OBSERVATION[at0000] matches {    -- FIGO staging for endometrial cancer
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0020] occurrences matches {0..1} matches {    -- Myometrial invasion
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0021,    -- No myometrial invasion
													at0022,    -- Less than half of myometrial thickness
													at0023,    -- At least half of myometrial thickness
													at0024]    -- Not assessed
												}
											}
										}
									}
									ELEMENT[at0025] occurrences matches {0..1} matches {    -- Cervical stromal invasion
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0026,    -- Absent
													at0027,    -- Present
													at0028]    -- Not assessed
												}
											}
										}
									}
									ELEMENT[at0029] occurrences matches {0..1} matches {    -- Uterine serosa and adnexal involvement
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0030,    -- Absent
													at0031,    -- Present
													at0032]    -- Not assessed
												}
											}
										}
									}
									ELEMENT[at0033] occurrences matches {0..1} matches {    -- Vaginal and parametrial involvement
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0034,    -- Absent
													at0035,    -- Present
													at0036]    -- Not assessed
												}
											}
										}
									}
									ELEMENT[at0037] occurrences matches {0..1} matches {    -- Pelvic lymph node status
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0038,    -- Not assessed
													at0039,    -- No metastasis identified
													at0040,    -- Isolated tumour cells only
													at0041]    -- Metastasis identified
												}
											}
										}
									}
									ELEMENT[at0042] occurrences matches {0..1} matches {    -- Para-aortic lymph node status
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0043,    -- Not assessed
													at0044,    -- No metastasis identified
													at0045,    -- Isolated tumour cells only
													at0046]    -- Metastasis identified
												}
											}
										}
									}
									ELEMENT[at0047] occurrences matches {0..1} matches {    -- Bladder and rectal mucosal invasion
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0048,    -- Absent
													at0049,    -- Present
													at0050]    -- Not assessed
												}
											}
										}
									}
									ELEMENT[at0051] occurrences matches {0..1} matches {    -- Distant metastasis
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
														at0052,    -- Not assessed
														at0053,    -- No distant metastasis identified
														at0054,    -- Intra-abdominal and/or inguinal metastasis
														at0055]    -- Other distant metastasis
												}
											}
										}
									}
								}
							}
						}
							}
						}
					}
					}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0005] occurrences matches {0..1} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"FIGO staging for endometrial cancer">
					description = <"The stage of endometrial cancer according to the FIGO 2009 staging system for endometrial cancer.">
					comment = <"Original version, c 2009.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0005"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
				["at0020"] = <
					text = <"Myometrial invasion">
					description = <"Depth of invasion into the myometrium.">
				>
				["at0021"] = <
					text = <"No myometrial invasion">
					description = <"No invasion into the myometrium.">
				>
				["at0022"] = <
					text = <"Less than half of myometrial thickness">
					description = <"Myometrial invasion is less than 50% of its thickness.">
				>
				["at0023"] = <
					text = <"At least half of myometrial thickness">
					description = <"Myometrial invasion is 50% or more of its thickness.">
				>
				["at0024"] = <
					text = <"Not assessed">
					description = <"Myometrial invasion could not be assessed or was not recorded.">
				>
				["at0025"] = <
					text = <"Cervical stromal invasion">
					description = <"Invasion of cervical stroma, excluding cervical mucosal involvement alone.">
				>
				["at0026"] = <
					text = <"Absent">
					description = <"No cervical stromal invasion identified.">
				>
				["at0027"] = <
					text = <"Present">
					description = <"Cervical stromal invasion identified.">
				>
				["at0028"] = <
					text = <"Not assessed">
					description = <"Cervical stromal invasion could not be assessed or was not recorded.">
				>
				["at0029"] = <
					text = <"Uterine serosal or adnexal involvement">
					description = <"Involvement of the uterine serosa or adnexa.">
				>
				["at0030"] = <
					text = <"Absent">
					description = <"No uterine serosal or adnexal involvement identified.">
				>
				["at0031"] = <
					text = <"Present">
					description = <"Uterine serosal and/or adnexal involvement identified.">
				>
				["at0032"] = <
					text = <"Not assessed">
					description = <"Uterine serosal or adnexal involvement could not be assessed or was not recorded.">
				>
				["at0033"] = <
					text = <"Vaginal or parametrial involvement">
					description = <"Vaginal or parametrial tumour involvement.">
				>
				["at0034"] = <
					text = <"Absent">
					description = <"No vaginal or parametrial involvement identified.">
				>
				["at0035"] = <
					text = <"Present">
					description = <"Vaginal and/or parametrial involvement identified.">
				>
				["at0036"] = <
					text = <"Not assessed">
					description = <"Vaginal or parametrial involvement could not be assessed or was not recorded.">
				>
				["at0037"] = <
					text = <"Pelvic lymph node status">
					description = <"Status of pelvic lymph nodes. Isolated tumour cells are recorded separately from nodal metastasis.">
				>
				["at0038"] = <
					text = <"Not assessed">
					description = <"Pelvic lymph nodes were not assessed or the result was not recorded.">
				>
				["at0039"] = <
					text = <"No metastasis identified">
					description = <"No pelvic lymph node metastasis identified.">
				>
				["at0040"] = <
					text = <"Isolated tumour cells only (N0(i+))">
					description = <"Only isolated tumour cells are identified in pelvic lymph node(s); this is not classified as nodal metastasis for FIGO 2009 staging.">
				>
				["at0041"] = <
					text = <"Metastasis identified">
					description = <"Pelvic lymph node metastasis identified.">
				>
				["at0042"] = <
					text = <"Para-aortic lymph node status">
					description = <"Status of para-aortic lymph nodes. Isolated tumour cells are recorded separately from nodal metastasis.">
				>
				["at0043"] = <
					text = <"Not assessed">
					description = <"Para-aortic lymph nodes were not assessed or the result was not recorded.">
				>
				["at0044"] = <
					text = <"No metastasis identified">
					description = <"No para-aortic lymph node metastasis identified.">
				>
				["at0045"] = <
					text = <"Isolated tumour cells only (N0(i+))">
					description = <"Only isolated tumour cells are identified in para-aortic lymph node(s); this is not classified as nodal metastasis for FIGO 2009 staging.">
				>
				["at0046"] = <
					text = <"Metastasis identified">
					description = <"Para-aortic lymph node metastasis identified.">
				>
				["at0047"] = <
					text = <"Bladder or rectal mucosal invasion">
					description = <"Invasion of the bladder or rectal mucosa, rather than serosal contact alone.">
				>
				["at0048"] = <
					text = <"Absent">
					description = <"No bladder or rectal mucosal invasion identified.">
				>
				["at0049"] = <
					text = <"Present">
					description = <"Bladder and/or rectal mucosal invasion identified.">
				>
				["at0050"] = <
					text = <"Not assessed">
					description = <"Bladder or rectal mucosal invasion could not be assessed or was not recorded.">
				>
				["at0051"] = <
					text = <"Distant metastasis status">
					description = <"Distant metastatic disease, including intra-abdominal or inguinal metastases.">
				>
				["at0052"] = <
					text = <"Not assessed">
					description = <"Distant metastases were not assessed or the result was not recorded.">
				>
				["at0053"] = <
					text = <"No distant metastasis identified">
					description = <"No distant metastasis identified.">
				>
				["at0054"] = <
					text = <"Intra-abdominal and/or inguinal metastasis">
					description = <"Distant metastatic involvement in the abdomen and/or inguinal region.">
				>
				["at0055"] = <
					text = <"Other distant metastasis">
					description = <"Distant metastatic disease at another site.">
				>
			>
		>
	>
