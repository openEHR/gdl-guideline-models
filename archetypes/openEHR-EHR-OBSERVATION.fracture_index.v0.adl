	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Fracture index">
					description = <"An assessment score used to predict the 5-year risk of hip fractures in postmenopausal women.">
					comment = <"Original version, c 2001">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
