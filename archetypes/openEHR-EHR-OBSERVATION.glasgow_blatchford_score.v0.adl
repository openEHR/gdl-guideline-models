	>

definition
	OBSERVATION[at0000] matches {    -- glasgow_blatchford_score
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0010] occurrences matches {0..1} matches {    -- Haemoglobin, men (g/dL)
										value matches {
											0|[local::at0011],
											1|[local::at0012],
											3|[local::at0013],
											6|[local::at0014]
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {    -- Haemoglobin, women (g/dL)
										value matches {
											0|[local::at0016],
											1|[local::at0017],
											6|[local::at0018]
										}
									}
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- Blood urea (mmol/L)
										value matches {
											0|[local::at0005],
											2|[local::at0006],
											3|[local::at0007],
											4|[local::at0008],
											6|[local::at0009]
										}
									}
									ELEMENT[at0019] occurrences matches {0..1} matches {    -- Systolic blood pressure (mmHg)
										value matches {
											0|[local::at0020],
											1|[local::at0021],
											2|[local::at0022],
											3|[local::at0023]
										}
									}
									ELEMENT[at0024] occurrences matches {0..1} matches {    -- Pulse ≥ 100 / min
										value matches {
											0|[local::at0025],
											1|[local::at0026]
										}
									}
									ELEMENT[at0027] occurrences matches {0..1} matches {    -- Melena
										value matches {
											0|[local::at0028],
											1|[local::at0029]
										}
									}
									ELEMENT[at0030] occurrences matches {0..1} matches {    -- Syncope
										value matches {
											0|[local::at0031],
											2|[local::at0032]
										}
									}
									ELEMENT[at0033] occurrences matches {0..1} matches {    -- Hepatic disease
										value matches {
											0|[local::at0034],
											2|[local::at0035]
										}
									}
									ELEMENT[at0036] occurrences matches {0..1} matches {    -- Cardiac failure
										value matches {
											0|[local::at0037],
											2|[local::at0038]
										}
									}
									ELEMENT[at0040] occurrences matches {0..1} matches {    -- Total score
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::380]>
												list = <
													["1"] = <
														units = <"1">
													>
												>
											>
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0041] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0042] occurrences matches {0..1} matches {*}    -- Extension
				}
			}
		}
	}

