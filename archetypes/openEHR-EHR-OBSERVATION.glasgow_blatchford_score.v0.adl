archetype (adl_version=1.4; uid=ceefeb51-a4de-4080-97ca-7598075a4442)
	openEHR-EHR-OBSERVATION.glasgow_blatchford_score.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-03-15">
		["name"] = <"Mahmoud Elachi">
		["organisation"] = <"Cambio CDS">
		["email"] = <"mel.achi@gmail.com">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the results for each component parameter and their total sum for the Glasgow-Blatchford score.">
			keywords = <"GBS, UGIB, blood urea, upper, GI, bleeding, gastrointestinal, Glasgow, Blatchford", ...>
			copyright = <"Use © Cambio CDS ">
			use = <"Use to record the results for each component parameter and their total sum for the Glasgow-Blatchford score.">
			misuse = <"Not to be used for recording information related to lower gastrointestinal bleeding.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Blatchford O, Murray WR, Blatchford M. A risk score to predict need for treatment for upper-gastrointestinal haemorrhage. Lancet. 2000 Oct 14;356(9238):1318-21. doi: 10.1016/S0140-6736(00)02816-6. PMID: 11073021.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"5367255af8fe1933f882fb76509a5058">
