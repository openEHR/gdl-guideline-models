archetype (adl_version=1.4; uid=990c0d22-919e-4191-a045-b13c8d53fabe)
	openEHR-EHR-OBSERVATION.guci_index.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-02-20">
		["name"] = <"Mahmoud Elachi">
		["organisation"] = <"Cambio CDS">
		["email"] = <"mel.achi@gmail.com">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the results for each component parameter and their total sum for the Göteborg University Cirrhosis Index (GUCI).">
			keywords = <"GUCI, chronic hepatitis C, liver cirrhosis, fibrosis, non-invasive, antiviral therapy, cirrhosis index", ...>
			copyright = <"Use © Cambio CDS ">
			use = <"Use to record the results for each component parameter and their total sum for the GUCI.">
			misuse = <"Not to be used for patients with liver diseases other than chronic hepatitis C, acute hepatic conditions, or pediatric populations, and must not replace clinical judgment, imaging, elastography, or biopsy when indicated.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Islam S, Antonsson L, Westin J, Lagging M. Cirrhosis in hepatitis C virus-infected patients can be excluded using an index of standard biochemical serum markers. Scand J Gastroenterol. 2005 Jul;40(7):867-72. doi: 10.1080/00365520510015674. PMID: 16109665.

Westin J, Ydreborg M, Islam S, Alsiö A, Dhillon AP, Pawlotsky JM, Zeuzem S, Schalm SW, Ferrari C, Neumann AU, Hellstrand K, Lagging M; DITTO-HCV Study Group. A non-invasive fibrosis score predicts treatment outcome in chronic hepatitis C virus infection. Scand J Gastroenterol. 2008 Jan;43(1):73-80. doi: 10.1080/00365520701514461. PMID: 18938750.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"5e313c5c82de7727b30207ab7c3857bc">
		["build_uid"] = <"8f6add28-a2c6-3f0b-bbef-0e417dac1f68">
	>

definition
	OBSERVATION[at0000] matches {    -- Göteborg University Cirrhosis index
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0009] occurrences matches {0..1} matches {    -- PK-INR
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::129]>
												list = <
													["1"] = <
														units = <"Units">
													>
												>
											>
										}
									}
									ELEMENT[at0008] occurrences matches {0..1} matches {    -- GUCI-score
										value matches {
											DV_QUANTITY matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Göteborg University Cirrhosis index">
					description = <"An assessment score used to estimate the probability of liver cirrhosis in patients with chronic hepatitis C.">
					comment = <"Original version, c 2005">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0008"] = <
					text = <"GUCI-score">
					description = <"">
				>
				["at0009"] = <
					text = <"PK-INR">
					description = <"">
				>
			>
		>
	>
