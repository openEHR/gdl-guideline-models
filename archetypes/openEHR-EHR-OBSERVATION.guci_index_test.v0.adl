archetype (adl_version=1.4; uid=04fd30c8-a0eb-4fb9-8f1f-e0ff30ccd1f2)
	openEHR-EHR-OBSERVATION.guci_index_test.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-02-20">
		["name"] = <"Mahmoud Elachi">
		["organisation"] = <"Cambio CDS">
		["email"] = <"mel.achi@gmail.com">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To support the early risk stratification of patients presenting with suspected acute upper gastrointestinal bleeding by structuring relevant clinical and laboratory data and enabling automated evaluation of the need for clinical intervention.">
			keywords = <"Upper gastrointestinal bleeding, Risk stratification, Emergency medicine, Clinical decision support, Gastroenterology, Triage, Hemoglobin, Urea, Blood pressure, Melena, Syncope", ...>
			copyright = <"Use © Cambio CDS ">
			use = <"This archetype is used in emergency and acute care settings to record clinical findings and laboratory results associated with upper gastrointestinal bleeding and to assist clinical decision-making regarding patient triage, need for hospital admission, and further management.
It enables integration into clinical decision support systems where risk assessment is performed based on routinely collected patient data.">
			misuse = <"The GUCI is not validated for other causes of liver disease, acute liver conditions, or pediatric populations, and it should not replace liver biopsy, elastography, or comprehensive clinical assessment when indicated.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Islam S, Antonsson L, Westin J, Lagging M. Cirrhosis in hepatitis C virus-infected patients can be excluded using an index of standard biochemical serum markers. Scand J Gastroenterol. 2005 Jul;40(7):867-72. doi: 10.1080/00365520510015674. PMID: 16109665.

https://pubmed-ncbi-nlm-nih-gov.proxybibl.vgregion.se/18938750/

Blatchford O, Murray WR, Blatchford M. A risk score to predict need for treatment for upper-gastrointestinal haemorrhage. Lancet. 2000 Oct 14;356(9238):1318-21. doi: 10.1016/S0140-6736(00)02816-6. PMID: 11073021.
">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"056a79c2e6cd1b398bca50867f5a8b65">
		["build_uid"] = <"8f6add28-a2c6-3f0b-bbef-0e417dac1f68">
	>

definition
	OBSERVATION[at0000] matches {    -- guci_index_test
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- ASAT
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::384]>
												list = <
													["1"] = <
														units = <"U/L">
													>
												>
											>
										}
									}
									ELEMENT[at0005] occurrences matches {0..1} matches {    -- Övre referens
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::445]>
												list = <
													["1"] = <
														units = <"U/L">
													>
												>
											>
										}
									}
									ELEMENT[at0009] occurrences matches {0..1} matches {    -- PK-INR
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::124]>
												list = <
													["1"] = <
														units = <"Units">
													>
												>
											>
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {    -- TPK
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::122]>
												list = <
													["1"] = <
														units = <"10⁹/L">
													>
												>
											>
										}
									}
									ELEMENT[at0008] occurrences matches {0..1} matches {    -- GUCI-score
										value matches {
											DV_QUANTITY matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"guci_index_test">
					description = <"Göteborg University Cirrhosis Index (GUCI)
A clinical decision guideline for estimating the probability of liver cirrhosis in adult patients with chronic hepatitis C using a laboratory-based index derived from AST, AST upper reference limit, INR, and platelet count.">
					comment = <"Original version, c 2005">
				>
