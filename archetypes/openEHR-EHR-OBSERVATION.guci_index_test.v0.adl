definition
	OBSERVATION[at0000] matches {    -- guci_index_test
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0010] occurrences matches {0..1} matches {    -- ASAT
										value matches {
											DV_QUANTITY matches {*}
										}
									}
									ELEMENT[at0011] occurrences matches {0..1} matches {    -- Over referense
										value matches {
											DV_QUANTITY matches {*}
										}
									}
									ELEMENT[at0012] occurrences matches {0..1} matches {    -- PK-INR
										value matches {
											DV_QUANTITY matches {*}
										}
									}
									ELEMENT[at0013] occurrences matches {0..1} matches {    -- TPK
										value matches {
											DV_QUANTITY matches {*}
										}
									}
									ELEMENT[at0014] occurrences matches {0..1} matches {    -- GUCI-Score
										value matches {
											DV_QUANTITY matches {*}
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {    -- Score
										value matches {
											DV_COUNT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"guci_index_test">
					description = <"Göteborg University Cirrhosis Index (GUCI)
A clinical decision guideline for estimating the probability of liver cirrhosis in adult patients with chronic hepatitis C using a laboratory-based index derived from AST, AST upper reference limit, INR, and platelet count.">
					comment = <"Original version, c 2005">
				>
