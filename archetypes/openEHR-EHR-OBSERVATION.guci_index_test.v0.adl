archetype (adl_version=1.4; uid=cdfc8831-8f7f-4fef-8698-7d9a61b8a4d8)
	openEHR-EHR-OBSERVATION.guci_index_test.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-02-20">
		["name"] = <"Mahmoud Elachi">
		["organisation"] = <"Cambio CDS">
		["email"] = <"mel.achi@gmail.com">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To support non-invasive assessment of cirrhosis risk and to estimate likelihood of sustained virological response to antiviral therapy.">
			keywords = <"Chronic hepatitis C, liver cirrhosis, fibrosis assessment, GUCI, non-invasive index, antiviral response prediction", ...>
			copyright = <"Use © Cambio CDS ">
			use = <"The GUCI is used in adult patients with chronic hepatitis C to estimate the probability of liver cirrhosis using routine laboratory parameters and to support risk stratification and prediction of sustained virological response prior to antiviral therapy.">
			misuse = <"The GUCI is not validated for other causes of liver disease, acute liver conditions, or pediatric populations, and it should not replace liver biopsy, elastography, or comprehensive clinical assessment when indicated.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"https://pubmed.ncbi.nlm.nih.gov/16109665/
https://pubmed-ncbi-nlm-nih-gov.proxybibl.vgregion.se/18938750/">
		["original_namespace"] = <"org.openehr">
