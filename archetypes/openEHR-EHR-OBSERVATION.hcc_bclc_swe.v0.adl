archetype (adl_version=1.4; uid=eb08ad1d-958d-43d7-98e9-76a8cd41d477)
	openEHR-EHR-OBSERVATION.hcc_bclc_swe.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2025-12-26">
		["name"] = <"Katja Mariko Wilde">
		["organisation"] = <"Cambio CDS">
		["email"] = <"katja-wilde@t-online.de">
	>
	lifecycle_state = <"in_development">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the results for each component parameter required for Swedish BCLC-based staging and treatment assessment in patients with hepatocellular carcinoma.">
			keywords = <"hepatocellular carcinoma","hcc","bclc","swedish","staging","treatment">
			copyright = <"© Cambio CDS">
			use = <"Use to record the results for each component parameter required for Swedish BCLC-based staging and treatment assessment in patients with hepatocellular carcinoma.">
			misuse = <"Not to be used to record the staging and treatment assessment in patients with hepatocellular carcinoma.">
		>
	>
	other_details = <
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Regionala cancercentrum i samverkan. Nationellt vårdprogram levercellscancer: Kapitel 8 Diagnostik och staging. Kunskapsbanken, 2024. Available at: https://kunskapsbanken.cancercentrum.se/diagnoser/levercellscancer/vardprogram/diagnostik/">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"054a790fe512b693da1a354e081510e1">
		["build_uid"] = <"c21a8b73-4151-477b-8c59-9383c1984aa4">
	>

definition
	OBSERVATION[at0000] matches {    -- Hepatocellular carcinoma Swedish BCLC
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0006] occurrences matches {0..1} matches {    -- Largest tumour diameter
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::122]>
												list = <
													["1"] = <
														units = <"cm">
													>
												>
											>
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {    -- Tumour number
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0008,    -- Single
													at0009,    -- Few (2-3)
													at0010]    -- Multiple
												}
											}
										}
									}
									ELEMENT[at0011] occurrences matches {0..1} matches {    -- Confined to liver
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0024,    -- Yes
													at0025]    -- No
												}
											}
										}
									}
									ELEMENT[at0012] occurrences matches {0..1} matches {    -- Extrahepatic spread
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0026,    -- Absent
													at0027]    -- Present
												}
											}
										}
									}
									ELEMENT[at0023] occurrences matches {0..1} matches {    -- Macroscopic tumour thrombus
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0028,    -- Absent
													at0029]    -- Present
												}
											}
										}
									}
									ELEMENT[at0013] occurrences matches {0..1} matches {    -- Tumour growth pattern
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0030,    -- Multifocal
													at0031]    -- Diffuse growth
												}
											}
										}
									}
									ELEMENT[at0014] occurrences matches {0..1} matches {    -- Portal vein status
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0015,    -- None
													at0016,    -- Peripheral thrombosis
													at0017]    -- Main trunk thrombosis
												}
											}
										}
									}
									ELEMENT[at0020] occurrences matches {0..1} matches {    -- Tumour burden
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0032,    -- Within transplant criteria
													at0033]    -- Initially outside transplant criteria
												}
											}
										}
									}
									ELEMENT[at0019] occurrences matches {0..1} matches {    -- Transplant candidate
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0034,    -- Yes
													at0035]    -- No
												}
											}
										}
									}
									ELEMENT[at0021] occurrences matches {0..1} matches {    -- Downstaging successful
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0036,    -- Yes
													at0037]    -- No
												}
											}
										}
									}
									ELEMENT[at0022] occurrences matches {0..1} matches {    -- Cirrhosis
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0038,    -- Absent
													at0039]    -- Present
												}
											}
										}
									}
									ELEMENT[at0018] occurrences matches {0..1} matches {    -- Severe comorbidity
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0040,    -- Absent
													at0041]    -- Present
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0005] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Hepatocellular carcinoma Swedish BCLC">
					description = <"A structured set of input parameters used to record tumour-related, liver-related, and patient-related parameters required for staging and treatment decision-making in hepatocellular carcinoma according to the Swedish adaptation of the Barcelona Clinic Liver Cancer framework.">
					comment = <"Derived from the Barcelona Clinic Liver Cancer (BCLC) classification originally published in 1999 and adapted according to Swedish national treatment recommendations for hepatocellular carcinoma.
">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0005"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
				["at0006"] = <
					text = <"Largest tumour diameter">
					description = <"Largest tumour diameter in centimetres.">
				>
				["at0007"] = <
					text = <"Tumour number">
					description = <"Number of hepatocellular carcinoma tumour lesions present.">
				>
				["at0008"] = <
					text = <"Single">
					description = <"One tumour lesion.">
				>
				["at0009"] = <
					text = <"Few (2-3)">
					description = <"Two or three tumour lesions.">
				>
				["at0010"] = <
					text = <"Multiple">
					description = <"More than three tumour lesions.">
				>
				["at0011"] = <
					text = <"Confined to liver">
					description = <"Whether the tumour is confined to the liver with no extrahepatic spread.">
				>
				["at0012"] = <
					text = <"Extrahepatic spread">
					description = <"Presence or absence of extrahepatic metastasis.">
				>
				["at0013"] = <
					text = <"Tumour growth pattern">
					description = <"Growth pattern of the hepatocellular carcinoma.">
				>
				["at0014"] = <
					text = <"Portal vein status">
					description = <"Status of the portal vein with respect to tumour thrombosis.">
				>
				["at0015"] = <
					text = <"None">
					description = <"No portal vein thrombosis.">
				>
				["at0016"] = <
					text = <"Peripheral thrombosis">
					description = <"Tumour thrombosis in peripheral (segmental or lobar) portal vein branches.">
				>
				["at0017"] = <
					text = <"Main trunk thrombosis">
					description = <"Tumour thrombosis involving the main portal vein trunk.">
				>
				["at0018"] = <
					text = <"Severe comorbidity">
					description = <"Presence or absence of severe comorbidity limiting therapy options.">
				>
				["at0019"] = <
					text = <"Transplant candidate">
					description = <"Whether the patient is considered a candidate for liver transplantation.">
				>
				["at0020"] = <
					text = <"Tumour burden">
					description = <"Tumour burden relative to transplant selection criteria (Metroticket 2.0).">
				>
				["at0021"] = <
					text = <"Downstaging successful">
					description = <"Whether downstaging treatment successfully reduced tumour burden to within transplant criteria.">
				>
				["at0022"] = <
					text = <"Cirrhosis">
					description = <"Presence or absence of liver cirrhosis.">
				>
				["at0023"] = <
					text = <"Macroscopic tumour thrombus">
					description = <"Presence or absence of macroscopic tumour thrombus in a major vessel.">
				>
				["at0024"] = <
					text = <"Yes">
					description = <"Tumour is confined to the liver.">
				>
				["at0025"] = <
					text = <"No">
					description = <"Tumour is not confined to the liver.">
				>
				["at0026"] = <
					text = <"Absent">
					description = <"No extrahepatic spread detected.">
				>
				["at0027"] = <
					text = <"Present">
					description = <"Extrahepatic spread is present.">
				>
				["at0028"] = <
					text = <"Absent">
					description = <"No macroscopic tumour thrombus detected.">
				>
				["at0029"] = <
					text = <"Present">
					description = <"Macroscopic tumour thrombus is present.">
				>
				["at0030"] = <
					text = <"Multifocal">
					description = <"Multiple discrete nodular tumour lesions.">
				>
				["at0031"] = <
					text = <"Diffuse growth">
					description = <"Diffuse infiltrative tumour growth pattern.">
				>
				["at0032"] = <
					text = <"Within transplant criteria">
					description = <"Tumour burden is within Metroticket 2.0 transplant selection criteria.">
				>
				["at0033"] = <
					text = <"Initially outside transplant criteria">
					description = <"Tumour burden initially exceeds Metroticket 2.0 transplant selection criteria.">
				>
				["at0034"] = <
					text = <"Yes">
					description = <"Patient is a transplant candidate.">
				>
				["at0035"] = <
					text = <"No">
					description = <"Patient is not a transplant candidate.">
				>
				["at0036"] = <
					text = <"Yes">
					description = <"Downstaging treatment was successful.">
				>
				["at0037"] = <
					text = <"No">
					description = <"Downstaging treatment was not successful.">
				>
				["at0038"] = <
					text = <"Absent">
					description = <"No cirrhosis detected.">
				>
				["at0039"] = <
					text = <"Present">
					description = <"Cirrhosis is present.">
				>
				["at0040"] = <
					text = <"Absent">
					description = <"No severe comorbidity limiting therapy.">
				>
				["at0041"] = <
					text = <"Present">
					description = <"Severe comorbidity is present, limiting therapy options.">
				>
			>
		>
	>
