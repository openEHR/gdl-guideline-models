archetype (adl_version=1.4; uid=7540c23b-f656-4bcb-8aeb-90dd43b8ef92)
	openEHR-EHR-OBSERVATION.insulin_bolus_dose.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-04-09">
		["name"] = <"Mahmoud Elachi">
		["organisation"] = <"Cambio CDS">
		["email"] = <"mel.achi@gmail.com">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the input parameters and calculated result for an insulin correction dose calculation.">
			keywords = <"insulin, bolus, correction dose, blood glucose, diabetes, hyperglycaemia, total daily dose", ...>
			copyright = <"Use © Cambio CDS">
			use = <"Use to record blood glucose, total daily insulin dose, and the calculated correction bolus dose for decision support purposes.">
			misuse = <"Not to be used for recording an insulin prescription, insulin administration event, or a full diabetes management plan.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["references"] = <"ISPAD Clinical Practice Consensus Guidelines 2022. Chapter 8.
https://www.ispad.org/resources/ispad-clinical-practice-consensus-guidelines/2022-ispad-clinical-practice-consensus-guidelines/ispad-cpcg-2022-english.html
">
		["build_uid"] = <"9587c152-4571-37e6-87f9-ac3c85d15b2d">
	>

definition
	OBSERVATION[at0000] matches {    -- Insulin bolus dose
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- P-glukos
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::384]>
												list = <
													["1"] = <
														units = <"mmol">
													>
												>
											>
										}
									}
									ELEMENT[at0005] occurrences matches {0..1} matches {    -- Dygnsdos insulin
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::445]>
												list = <
													["1"] = <
														units = <"u">
													>
												>
											>
										}
									}
									ELEMENT[at0006] occurrences matches {0..1} matches {    -- Bolus dose
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::445]>
												list = <
													["1"] = <
														units = <"u">
													>
												>
											>
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Insulin bolus dose">
					description = <"A clinical calculation used to estimate a reasonable bolus insulin dose for an insulin-treated patient with temporarily elevated blood glucose.">
					comment = <"Original version, c 2022, Chapter 8.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"P-glukos">
					description = <"">
				>
				["at0005"] = <
					text = <"Dygnsdos insulin">
					description = <"">
				>
				["at0006"] = <
					text = <"Bolus dose">
					description = <"">
				>
			>
		>
	>
