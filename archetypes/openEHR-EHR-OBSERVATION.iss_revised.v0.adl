definition
	OBSERVATION[at0000] matches {    -- Revised International Staging System for Multiple Myeloma (R-ISS)
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0006] occurrences matches {0..1} matches {    -- Serum β2 microglobulin
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0007,    -- <3.5 mg/L
													at0008,    -- 3.5-5.4 mg/L
													at0009]    -- >5.4 mg/L
												}
											}
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {    -- Serum albumin
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0011,    -- <3.5 g/dL
													at0012]    -- ≥3.5 g/dL
												}
											}
										}
									}
									ELEMENT[at0013] occurrences matches {0..1} matches {    -- ISS stage
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0014,    -- ISS I
													at0015,    -- ISS II
													at0016]    -- ISS III
												}
											}
										}
									}
									ELEMENT[at0017] occurrences matches {0..1} matches {    -- CA by iFISH
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0018,    -- Standard risk
													at0019]    -- High risk
												}
											}
										}
									}
									ELEMENT[at0020] occurrences matches {0..1} matches {    -- Serum LDH
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0021,    -- Normal
													at0022]    -- High
												}
											}
										}
									}
									ELEMENT[at0023] occurrences matches {0..1} matches {    -- Revised ISS stage
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0024,    -- R-ISS I
													at0025,    -- R-ISS II
													at0026]    -- R-ISS III
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0005] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Revised International Staging System for Multiple Myeloma (R-ISS)">
					description = <"A staging system for classifying and stratifying patients with multiple myeloma.">
					comment = <"Original version, c 2015">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0005"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
				["at0006"] = <
					text = <"Serum β2 microglobulin">
					description = <"">
				>
				["at0007"] = <
					text = <"<3.5 mg/L">
					description = <"">
				>
				["at0008"] = <
					text = <"3.5-5.4 mg/L">
					description = <"">
				>
				["at0009"] = <
					text = <">5.4 mg/L">
					description = <"">
				>
				["at0010"] = <
					text = <"Serum albumin">
					description = <"">
				>
				["at0011"] = <
					text = <"<3.5 g/dL">
					description = <"">
				>
				["at0012"] = <
					text = <"≥3.5 g/dL">
					description = <"">
				>
				["at0013"] = <
					text = <"ISS stage">
					description = <"">
				>
				["at0014"] = <
					text = <"ISS I">
					description = <"Serum β2-microglobulin <3.5 mg/L and serum albumin ≥3.5 g/dL.">
				>
				["at0015"] = <
					text = <"ISS II">
					description = <"Not stage I or III.">
				>
				["at0016"] = <
					text = <"ISS III">
					description = <"Serum β2-microglobulin ≥5.5 mg/L.">
				>
				["at0017"] = <
					text = <"CA by iFISH">
					description = <"Chromosomal abnormalities (CA) detected by
interphase fluorescent in situ hybridization (iFISH).">
				>
				["at0018"] = <
					text = <"Standard risk">
					description = <"No high risk CA.">
				>
				["at0019"] = <
					text = <"High risk">
					description = <"Presence of del(17p) and/or translocation t(4;14) and/or translocation t(14;16).">
				>
				["at0020"] = <
					text = <"Serum LDH">
					description = <"">
				>
				["at0021"] = <
					text = <"Normal">
					description = <"Serum LDH < the upper limit of normal.">
				>
				["at0022"] = <
					text = <"High">
					description = <"Serum LDH > the upper limit of normal.">
				>
				["at0023"] = <
					text = <"Revised ISS stage">
					description = <"">
				>
				["at0024"] = <
					text = <"R-ISS I">
					description = <"ISS stage I and standard-risk CA by iFISH and normal LDH.">
				>
				["at0025"] = <
					text = <"R-ISS II">
					description = <"Not R-ISS stage I or III.">
				>
				["at0026"] = <
					text = <"R-ISS III">
					description = <"ISS stage III and either high-risk CA by iFISH or high LDH.">
				>
			>
		>
	>
