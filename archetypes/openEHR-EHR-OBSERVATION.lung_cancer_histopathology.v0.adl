archetype (adl_version=1.4; uid=bfaa39e7-6004-4434-81ed-21942bb99a63)
	openEHR-EHR-OBSERVATION.lung_cancer_histopathology.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2025-12-29">
		["name"] = <"Mahmoud Elachi">
		["organisation"] = <"Cambio CDS">
		["email"] = <"mel.achi@gmail.com">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record morphology and immunohistochemical findings relevant for subtyping lung cancer according to current national guidelines.">
			keywords = <"lung cancer, histopathology, biomarker, immunohistochemistry, diagnosis", ...>
			copyright = <"Use © Cambio CDS">
			use = <"Used during pathological assessment of lung tumor tissue. Supports diagnostic classification into adenocarcinoma, squamous cell carcinoma, small-cell lung cancer, or other subtypes.">
			misuse = <"Not intended for molecular genetic testing or treatment planning. Do not use for non-lung tumors.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Regionala cancercentrum i samverkan. Nationellt vårdprogram lungcancer. Kunskapsbanken, 2025.
Available at: kunskapsbanken.cancercentrum.se/diagnoser/lungcancer/vardprogram/">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"d0049ff206ec13a0834fa74ce35940e9">
		["build_uid"] = <"58937016-33bd-3da8-935d-42afa5938fed">
	>

definition
	OBSERVATION[at0000] matches {    -- lung_cancer_histopathology
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0031] occurrences matches {0..1} matches {    -- Tumor characteristics
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0058] occurrences matches {0..1} matches {    -- Tumor morphology
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0059,    -- Glandular
															at0060,    -- Keratinizing
															at0061,    -- Small-cell
															at0062,    -- Solid
															at0063,    -- Acinar
															at0064,    -- Papillary
															at0065]    -- Poorly differentiated
														}
													}
												}
											}
										}
									}
									CLUSTER[at0067] occurrences matches {0..1} matches {    -- Biomarker Results
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0069] occurrences matches {0..1} matches {    -- TTF-1 result
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0070,    -- Positive
															at0071,    -- Negative
															at0072]    -- Not done
														}
													}
												}
											}
											ELEMENT[at0073] occurrences matches {0..1} matches {    -- p40 result
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0074,    -- Positive
															at0075,    -- Negative
															at0076]    -- Not done
														}
													}
												}
											}
											ELEMENT[at0077] occurrences matches {0..1} matches {    -- CK5/6 result
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0078,    -- Positive
															at0079,    -- Negative
															at0080]    -- Not done
														}
													}
												}
											}
											ELEMENT[at0081] occurrences matches {0..1} matches {    -- Synaptophysin result
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0082,    -- Positive
															at0083,    -- Negative
															at0084]    -- Not done
														}
													}
												}
											}
											ELEMENT[at0085] occurrences matches {0..1} matches {    -- Chromogranin result
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0086,    -- Positive
															at0087,    -- Negative
															at0088]    -- Not done
														}
													}
												}
											}
											ELEMENT[at0089] occurrences matches {0..1} matches {    -- Ki-67 index
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0090,    -- 30%
															at0091,    -- High
															at0092]    -- Low
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0005] occurrences matches {0..1} matches {*}    -- Extension
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"lung_cancer_histopathology">
					description = <"A clinical decision guideline for classifying the histopathological subtype of lung cancer in patients with suspected or confirmed malignancy, based on tumor morphology and immunohistochemical markers such as TTF-1, p40, CK5/6, synaptophysin, chromogranin A, and Ki-67.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
