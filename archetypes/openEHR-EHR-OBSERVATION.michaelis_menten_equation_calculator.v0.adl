archetype (adl_version=1.4; uid=67bf9948-3070-4efe-91b6-20368f0f1e0b)
    openEHR-EHR-OBSERVATION.michaelis_menten_equation_calculator.v0

concept
    [at0000]

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["date"] = <"2026-09-28">
        ["name"] = <"Mahmoud Elachi">
        ["organisation"] = <"Cambio CDS">
        ["email"] = <"mel.achi@gmail.com">
    >
    lifecycle_state = <"Author draft">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"To record Michaelis-Menten parameters and calculated value for one missing parameter.">
            use = <"Use when one of V0, Vmax, Km, or substrate concentration [S] is unknown.">
            misuse = <"Not for multi-substrate or inhibition kinetics.">
            copyright = <"Cambio CDS">
        >
    >

definition
    OBSERVATION[at0000] matches {    -- Michaelis-Menten equation calculator
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    EVENT[at0002] occurrences matches {0..*} matches {
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {
                                    ELEMENT[at0004] occurrences matches {0..1} matches {    -- Substrate concentration [S]
                                        value matches {
                                            C_DV_QUANTITY <
                                                list = <
                                                    ["1"] = <units = <"mol/L">>
                                                    ["2"] = <units = <"mmol/L">>
                                                    ["3"] = <units = <"umol/L">>
                                                    ["4"] = <units = <"nmol/L">>
                                                >
                                            >
                                        }
                                    }
                                    ELEMENT[at0005] occurrences matches {0..1} matches {    -- Maximum rate (Vmax)
                                        value matches {
                                            C_DV_QUANTITY <
                                                list = <
                                                    ["1"] = <units = <"1/s">>
                                                    ["2"] = <units = <"1/min">>
                                                >
                                            >
                                        }
                                    }
                                    ELEMENT[at0006] occurrences matches {0..1} matches {    -- Michaelis constant (Km)
                                        value matches {
                                            C_DV_QUANTITY <
                                                list = <
                                                    ["1"] = <units = <"mol/L">>
                                                    ["2"] = <units = <"mmol/L">>
                                                    ["3"] = <units = <"umol/L">>
                                                    ["4"] = <units = <"nmol/L">>
                                                >
                                            >
                                        }
                                    }
                                    ELEMENT[at0008] occurrences matches {0..1} matches {    -- Reaction rate (V0)
                                        value matches {
                                            C_DV_QUANTITY <
                                                list = <
                                                    ["1"] = <units = <"1/s">>
                                                    ["2"] = <units = <"1/min">>
                                                >
                                            >
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

ontology
    term_definitions = <
        ["en"] = <
            items = <
                ["at0000"] = <
                    text = <"Michaelis-Menten equation calculator">
                    description = <"Calculates one unknown Michaelis-Menten parameter from the remaining three.">
                >
                ["at0001"] = <
                    text = <"History">
                    description = <"@ internal @">
                >
                ["at0002"] = <
                    text = <"Any event">
                    description = <"@ internal @">
                >
                ["at0003"] = <
                    text = <"Tree">
                    description = <"@ internal @">
                >
                ["at0004"] = <
                    text = <"Substrate concentration [S]">
                    description = <"Substrate concentration used in the Michaelis-Menten equation.">
                >
                ["at0005"] = <
                    text = <"Maximum rate (Vmax)">
                    description = <"Maximum reaction rate at saturating substrate concentration.">
                >
                ["at0006"] = <
                    text = <"Michaelis constant (Km)">
                    description = <"Substrate concentration at which reaction rate is half of Vmax.">
                >
                ["at0008"] = <
                    text = <"Reaction rate (V0)">
                    description = <"Initial reaction rate.">
                >
            >
        >
    >
