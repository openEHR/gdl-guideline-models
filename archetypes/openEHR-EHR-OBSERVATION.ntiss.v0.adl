	openEHR-EHR-OBSERVATION.ntiss.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-08-26">
		["name"] = <"Kevin Arjona">
		["organisation"] = <"Cambio CDS">
		["email"] = <"kevin.arjona@cambio.se">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record responses to the NTISS items and the total score based on the NTISS.">
			keywords = <"ntiss","neonatal","therapeutic","intervention","scoring","system","intensive","care","severity">
			copyright = <"© Cambio CDS">
			use = <"Use to record the therapeutic interventions received by a newborn during a 24-hour scoring period.">
			misuse = <"Not to be used outside the neonatal intensive care population.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Gray JE, Richardson DK, McCormick MC, Workman-Daniels K, Goldmann DA. Neonatal therapeutic intervention scoring system: a therapy-based severity-of-illness index. Pediatrics. 1992 Oct;90(4):561-7. PMID: 1408510.

Wu PL, Lee WT, Lee PL, Chen HL. Predictive power of serial neonatal therapeutic intervention scoring system scores for short-term mortality in very-low-birth-weight infants. Pediatr Neonatol. 2015 Apr;56(2):108-13. doi: 10.1016/j.pedneo.2014.06.005. Epub 2014 Sep 20. PMID: 25246194.

Richardson DK, Gray JE, McCormick MC, Workman K, Goldmann DA. Score for Neonatal Acute Physiology: a physiologic severity index for neonatal intensive care. Pediatrics. 1993 Mar;91(3):617-23. PMID: 8441569.

Garg B, Sharma D, Farahbakhsh N. Assessment of sickness severity of illness in neonates: review of various neonatal illness scoring systems. J Matern Fetal Neonatal Med. 2018 May;31(10):1373-1380. doi: 10.1080/14767058.2017.1315665. Epub 2017 Apr 20. PMID: 28372507.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["build_uid"] = <"69f4b7e6-3007-3ddc-ad99-05ad3505bf75">
	>

definition
	OBSERVATION[at0000] matches {    -- NTISS Score
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0006] occurrences matches {0..1} matches {    -- Ventilation
										value matches {
											0|[local::at0007],
											1|[local::at0008],
											2|[local::at0009],
											3|[local::at0010],
											4|[local::at0011],
											4|[local::at0012]
										}
									}
									ELEMENT[at0013] occurrences matches {0..1} matches {    -- Surfactant administration
										value matches {
											0|[local::at0014],
											1|[local::at0015]
										}
									}
									ELEMENT[at0016] occurrences matches {0..1} matches {    -- Endotracheal intubation
										value matches {
											0|[local::at0017],
											2|[local::at0018]
										}
									}
									ELEMENT[at0019] occurrences matches {0..1} matches {    -- Tracheostomy
										value matches {
											0|[local::at0020],
											1|[local::at0021],
											1|[local::at0022]
										}
									}
									ELEMENT[at0023] occurrences matches {0..1} matches {    -- Extracorporeal membrane oxygenation
										value matches {
											0|[local::at0024],
											4|[local::at0025]
										}
									}
									ELEMENT[at0026] occurrences matches {0..1} matches {    -- Frequent vital signs
										value matches {
											0|[local::at0027],
											1|[local::at0028]
										}
									}
									ELEMENT[at0029] occurrences matches {0..1} matches {    -- Phlebotomy
										value matches {
											0|[local::at0030],
											1|[local::at0031],
											2|[local::at0032]
										}
									}
									ELEMENT[at0033] occurrences matches {0..1} matches {    -- Cardiorespiratory monitoring
										value matches {
											0|[local::at0034],
											1|[local::at0035]
										}
									}
									ELEMENT[at0036] occurrences matches {0..1} matches {    -- Thermoregulated environment
										value matches {
											0|[local::at0037],
											1|[local::at0038]
										}
									}
									ELEMENT[at0039] occurrences matches {0..1} matches {    -- Non-invasive oxygen monitoring
										value matches {
											0|[local::at0040],
											1|[local::at0041]
										}
									}
									ELEMENT[at0042] occurrences matches {0..1} matches {    -- Arterial pressure monitoring
										value matches {
											0|[local::at0043],
											1|[local::at0044]
										}
									}
									ELEMENT[at0045] occurrences matches {0..1} matches {    -- Central venous pressure monitoring
										value matches {
											0|[local::at0046],
											1|[local::at0047]
										}
									}
									ELEMENT[at0048] occurrences matches {0..1} matches {    -- Urinary catheter
										value matches {
											0|[local::at0049],
											1|[local::at0050]
										}
									}
									ELEMENT[at0051] occurrences matches {0..1} matches {    -- Quantitative intake and output
										value matches {
											0|[local::at0052],
											1|[local::at0053]
										}
									}
									ELEMENT[at0054] occurrences matches {0..1} matches {    -- Indomethacin administration
										value matches {
											0|[local::at0055],
											1|[local::at0056]
										}
									}
									ELEMENT[at0057] occurrences matches {0..1} matches {    -- Volume expansion
										value matches {
											0|[local::at0058],
											1|[local::at0059],
											3|[local::at0060]
										}
									}
									ELEMENT[at0061] occurrences matches {0..1} matches {    -- Vasopressor administration
										value matches {
											0|[local::at0062],
											2|[local::at0063],
											3|[local::at0064]
										}
									}
									ELEMENT[at0065] occurrences matches {0..1} matches {    -- Cardiopulmonary resuscitation
										value matches {
											0|[local::at0066],
											4|[local::at0067]
										}
									}
									ELEMENT[at0068] occurrences matches {0..1} matches {    -- Pacemaker
										value matches {
											0|[local::at0069],
											3|[local::at0070],
											4|[local::at0071]
										}
									}
									ELEMENT[at0072] occurrences matches {0..1} matches {    -- Peripheral intravenous line
										value matches {
											0|[local::at0073],
											1|[local::at0074]
										}
									}
									ELEMENT[at0075] occurrences matches {0..1} matches {    -- Arterial line
										value matches {
											0|[local::at0076],
											2|[local::at0077]
										}
									}
									ELEMENT[at0078] occurrences matches {0..1} matches {    -- Central venous line
										value matches {
											0|[local::at0079],
											2|[local::at0080]
										}
									}
									ELEMENT[at0081] occurrences matches {0..1} matches {    -- Gavage feeding
										value matches {
											0|[local::at0082],
											1|[local::at0083]
										}
									}
									ELEMENT[at0084] occurrences matches {0..1} matches {    -- Phototherapy
										value matches {
											0|[local::at0085],
											1|[local::at0086]
										}
									}
									ELEMENT[at0087] occurrences matches {0..1} matches {    -- Intravenous fat emulsion
										value matches {
											0|[local::at0088],
											1|[local::at0089]
										}
									}
									ELEMENT[at0090] occurrences matches {0..1} matches {    -- Intravenous amino acid solution
										value matches {
											0|[local::at0091],
											1|[local::at0092]
										}
									}
									ELEMENT[at0093] occurrences matches {0..1} matches {    -- Insulin administration
										value matches {
											0|[local::at0094],
											2|[local::at0095]
										}
									}
									ELEMENT[at0096] occurrences matches {0..1} matches {    -- Potassium infusion
										value matches {
											0|[local::at0097],
											3|[local::at0098]
										}
									}
									ELEMENT[at0099] occurrences matches {0..1} matches {    -- Intravenous gamma globulin
										value matches {
											0|[local::at0100],
											1|[local::at0101]
										}
									}
									ELEMENT[at0102] occurrences matches {0..1} matches {    -- Double volume exchange transfusion
										value matches {
											0|[local::at0103],
											3|[local::at0104]
										}
									}
									ELEMENT[at0105] occurrences matches {0..1} matches {    -- Partial volume exchange transfusion
										value matches {
											0|[local::at0106],
											2|[local::at0107]
										}
									}
									ELEMENT[at0108] occurrences matches {0..1} matches {    -- Red blood cell transfusion
										value matches {
											0|[local::at0109],
											2|[local::at0110],
											3|[local::at0111]
										}
									}
									ELEMENT[at0112] occurrences matches {0..1} matches {    -- Platelet transfusion
										value matches {
											0|[local::at0113],
											3|[local::at0114]
										}
									}
									ELEMENT[at0115] occurrences matches {0..1} matches {    -- White blood cell transfusion
										value matches {
											0|[local::at0116],
											3|[local::at0117]
										}
									}
									ELEMENT[at0118] occurrences matches {0..1} matches {    -- Transport of patient
										value matches {
											0|[local::at0119],
											2|[local::at0120]
										}
									}
									ELEMENT[at0121] occurrences matches {0..1} matches {    -- Dialysis
										value matches {
											0|[local::at0122],
											4|[local::at0123]
										}
									}
									ELEMENT[at0133] occurrences matches {0..1} matches {    -- Chest tube
										value matches {
											0|[local::at0134],
											2|[local::at0135],
											3|[local::at0136]
										}
									}
									ELEMENT[at0124] occurrences matches {0..1} matches {    -- Thoracentesis
										value matches {
											0|[local::at0125],
											3|[local::at0126]
										}
									}
									ELEMENT[at0137] occurrences matches {0..1} matches {    -- Pericardial procedure
										value matches {
											0|[local::at0138],
											4|[local::at0139],
											4|[local::at0140]
										}
									}
									ELEMENT[at0141] occurrences matches {0..1} matches {    -- Operation
										value matches {
											0|[local::at0142],
											2|[local::at0143],
											4|[local::at0144]
										}
									}
									ELEMENT[at0127] occurrences matches {0..1} matches {    -- Transport of patient
										value matches {
											0|[local::at0128],
											2|[local::at0129]
										}
									}
									ELEMENT[at0145] occurrences matches {0..1} matches {    -- Antibiotic administration
										value matches {
											0|[local::at0146],
											1|[local::at0147],
											2|[local::at0148]
										}
									}
									ELEMENT[at0149] occurrences matches {0..1} matches {    -- Diuretic administration
										value matches {
											0|[local::at0150],
											1|[local::at0151],
											2|[local::at0152]
										}
									}
									ELEMENT[at0130] occurrences matches {0..1} matches {    -- Anticonvulsant therapy
										value matches {
											0|[local::at0131],
											1|[local::at0132]
										}
									}
									ELEMENT[at0153] occurrences matches {0..1} matches {    -- Aminophylinne administration
										value matches {
											0|[local::at0154],
											1|[local::at0155]
										}
									}
									ELEMENT[at0156] occurrences matches {0..1} matches {    -- Other unscheduled medication
										value matches {
											0|[local::at0157],
											1|[local::at0158]
										}
									}
									ELEMENT[at0159] occurrences matches {0..1} matches {    -- Postnatal steroid administration
										value matches {
											0|[local::at0160],
											1|[local::at0161]
										}
									}
									ELEMENT[at0162] occurrences matches {0..1} matches {    -- Potassium binding resin administration
										value matches {
											0|[local::at0163],
											3|[local::at0164]
										}
									}
									ELEMENT[at0165] occurrences matches {0..1} matches {    -- Treatment of metabolic acidosis
										value matches {
											0|[local::at0166],
											3|[local::at0167]
										}
									}
									ELEMENT[at0168] occurrences matches {0..1} matches {    -- Total score
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::380]>
												list = <
													["1"] = <
														units = <"1">
														precision = <|3|>
													>
												>
											>
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0005] occurrences matches {0..1} matches {    -- Extenstion
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"NTISS Score">
					description = <"NTISS Score (Neonatal Therapeutic Intervention Scoring System) is a severity-of-illness index for neonatal intensive care, derived by modifying the Therapeutic Intervention Scoring System (TISS), that quantifies the intensity and complexity of therapeutic interventions a newborn receives during a defined scoring period.">
					comment = <"Original version, c 1992">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
