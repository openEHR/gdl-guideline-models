archetype (adl_version=1.4; uid=2354af3c-3bc1-4d80-8eee-18fa75504ffb)
	openEHR-EHR-OBSERVATION.score2.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2025-07-09">
		["name"] = <"Konstantinos Kalliamvakos">
		["organisation"] = <"Cambio Healthcare Systems">
		["email"] = <"konstantinos.kalliamvakos@cambio.se">
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Rong Chen, Cambio CDS, Sweden","Shweta Ghaisas">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the results for each variable and the SCORE2 uncalibrated and calibrated 10-year CVD risk.">
			keywords = <"SCORE","systematic","coronary","risk","evaluation","2","CVD","cardiovascular","disease","diabetes">
			copyright = <"© Cambio CDS">
			use = <"Use to record the results for each variable and the SCORE2 uncalibrated and calibrated 10-year CVD risk.">
			misuse = <"Not to be used for recording the 10-year CVD risk for patients living outside of Europe.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["references"] = <"SCORE2 working group and ESC Cardiovascular risk collaboration. SCORE2 risk prediction algorithms: new models to estimate 10-year risk of cardiovascular disease in Europe. Eur Heart J. 2021 Jul 1;42(25):2439-2454. doi: 10.1093/eurheartj/ehab309. PMID: 34120177; PMCID: PMC8248998.">
		["build_uid"] = <"8f852e9a-4f10-3917-bb60-203b70bfeebe">
	>

definition
	OBSERVATION[at0000] matches {    -- Systematic Coronary Risk Evaluation 2 (SCORE2)
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- Centered age
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::128]>
												list = <
													["1"] = <
														units = <"a">
													>
												>
											>
										}
									}
									ELEMENT[at0005] occurrences matches {0..1} matches {    -- Smoking
										value matches {
											1|[local::at0006],
											0|[local::at0007]
										}
									}
									ELEMENT[at0008] occurrences matches {0..1} matches {    -- Centered SBP
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::125]>
												list = <
													["1"] = <
														units = <"mm[Hg]">
													>
												>
											>
										}
									}
									ELEMENT[at0009] occurrences matches {0..1} matches {    -- Centered TC
										value matches {
											C_DV_QUANTITY <
												
												list = <
													["1"] = <
														units = <"mmol/L">
													>
												>
											>
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {    -- Centered HDL-C
										value matches {
											C_DV_QUANTITY <
												
												list = <
													["1"] = <
														units = <"mmol/L">
													>
												>
											>
										}
									}
									ELEMENT[at0011] occurrences matches {0..1} matches {    -- Risk region
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0012,    -- Low
													at0013,    -- Moderate
													at0014,    -- High
													at0015]    -- Very high
												}
											}
										}
									}
									ELEMENT[at0016] occurrences matches {0..1} matches {    -- Un-calibrated 10-year risk
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::380]>
												list = <
													["1"] = <
														units = <"1">
													>
												>
											>
										}
									}
									ELEMENT[at0017] occurrences matches {0..1} matches {    -- Calibrated 10-year risk
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::507]>
												list = <
													["1"] = <
														units = <"%">
													>
												>
											>
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Systematic Coronary Risk Evaluation 2 (SCORE2)">
					description = <"An assessment score used to predict the 10-year risk of cardiovascular disease, in patients without previous CVD or diabetes.">
					comment = <"Original version, c 2021">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Centered age">
					description = <"Centered and scaled age (years): (Age - 60)/5">
				>
				["at0005"] = <
					text = <"Smoking">
					description = <"">
				>
				["at0006"] = <
					text = <"Current">
					description = <"">
				>
				["at0007"] = <
					text = <"Other">
					description = <"">
				>
				["at0008"] = <
					text = <"Centered SBP">
					description = <"Centered systolic blood pressure (mmHg): (SBP-120)/20">
				>
				["at0009"] = <
					text = <"Centered TC">
					description = <"Centered total cholesterol (mmol/L): Total cholesterol - 6">
				>
				["at0010"] = <
					text = <"Centered HDL-C">
					description = <"Centered high-density lipoprotein cholesterol (mmol/L): (HDL-C - 1.3)/0.5">
				>
				["at0011"] = <
					text = <"Risk region">
					description = <"">
				>
				["at0012"] = <
					text = <"Low">
					description = <"">
				>
				["at0013"] = <
					text = <"Moderate">
					description = <"">
				>
				["at0014"] = <
					text = <"High">
					description = <"">
				>
				["at0015"] = <
					text = <"Very high">
					description = <"">
				>
				["at0016"] = <
					text = <"Un-calibrated 10-year risk">
					description = <"">
				>
				["at0017"] = <
					text = <"Calibrated 10-year risk">
					description = <"">
				>
			>
		>
	>
