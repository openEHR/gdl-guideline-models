definition
	OBSERVATION[at0000] matches {    -- SOFA score for sepsis
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- Use of additional oxygen
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0055] occurrences matches {0..1} matches {    -- Sat O2 (%)
										value matches {
											0|[local::at0060],
											0|[local::at0056],
											1|[local::at0057],
											2|[local::at0058]
										}
									}
									ELEMENT[at0009] occurrences matches {0..1} matches {    -- PaO2/FiO2 (kPa)
										value matches {
											0|[local::at0061],
											0|[local::at0010],
											1|[local::at0011],
											2|[local::at0012],
											3|[local::at0013],
											4|[local::at0014]
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {    -- Platelet count (x 10^9/L)
										value matches {
											0|[local::at0062],
											0|[local::at0016],
											1|[local::at0017],
											2|[local::at0018],
											3|[local::at0019],
											4|[local::at0020]
										}
									}
									ELEMENT[at0021] occurrences matches {0..1} matches {    -- Total Bilirubin (μmol/L)
										value matches {
											0|[local::at0063],
											0|[local::at0022],
											1|[local::at0023],
											2|[local::at0024],
											3|[local::at0025],
											4|[local::at0026]
										}
									}
									ELEMENT[at0027] occurrences matches {0..1} matches {    -- Degree of hyptension (MAP, mmHg)/Catecholamines (μg/kg/min)
										value matches {
											0|[local::at0064],
											0|[local::at0028],
											1|[local::at0029],
											2|[local::at0030],
											3|[local::at0031],
											4|[local::at0032]
										}
									}
									ELEMENT[at0033] occurrences matches {0..1} matches {    -- Glasgow Coma Scale (GCS)
										value matches {
											0|[local::at0065],
											0|[local::at0034],
											1|[local::at0035],
											2|[local::at0036],
											3|[local::at0037],
											4|[local::at0038]
										}
									}
									ELEMENT[at0039] occurrences matches {0..1} matches {    -- Reaction Level Scale (RLS)
										value matches {
											0|[local::at0066],
											0|[local::at0040],
											1|[local::at0041],
											2|[local::at0042],
											3|[local::at0043],
											4|[local::at0044]
										}
									}
									ELEMENT[at0045] occurrences matches {0..1} matches {    -- ACVPU scale
										value matches {
											0|[local::at0067],
											0|[local::at0046],
											1|[local::at0047]
										}
									}
									ELEMENT[at0049] occurrences matches {0..1} matches {    -- Creatinine (μmol/L) and/or Urine output (mL/d)
										value matches {
											0|[local::at0068],
											0|[local::at0050],
											1|[local::at0051],
											2|[local::at0052],
											3|[local::at0053],
											4|[local::at0054]
										}
									}
									ELEMENT[at0059] occurrences matches {0..1} matches {    -- Total score
										value matches {
											DV_COUNT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

