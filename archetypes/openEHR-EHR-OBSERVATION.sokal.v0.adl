	openEHR-EHR-OBSERVATION.sokal.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2021-02-24">
		["name"] = <"Emma Malm">
		["organisation"] = <"Cambio CDS">
