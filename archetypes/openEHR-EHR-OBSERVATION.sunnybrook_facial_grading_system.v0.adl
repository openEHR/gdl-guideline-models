	openEHR-EHR-OBSERVATION.sunnybrook_facial_grading_system.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-02-26">
		["name"] = <"Kevin Arjona">
		["organisation"] = <"Cambio CDS">
		["email"] = <"kevin.arjona@cambio.se">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the result for each component parameter: Resting symmetry, Voluntary movement, Synkinesis.">
			keywords = <"facial, palsy, facial nerve, paralysis, sunnybrook, Bell", ...>
			copyright = <"© Cambio CDS">
			use = <"Use to assess facial nerve function.">
			misuse = <"Not intended for central facial palsy assessment.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["references"] = <"Ross BG, Fradet G, Nedzelski JM. Development of a sensitive clinical facial grading system. Otolaryngol Head Neck Surg. 1996 Mar;114(3):380-6. doi: 10.1016/S0194-59989670206-1. PMID: 8649870.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"3104d605c16eb09ea22332dff45f81f4">
		["build_uid"] = <"44e8894c-296a-38b2-9861-2ef94fac9be8">
	>

definition
	OBSERVATION[at0000] matches {    -- Sunnybrook Facial Grading System
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0006] occurrences matches {0..1} matches {    -- Resting symmetry eye
										value matches {
											0|[local::at0007],
											1|[local::at0008],
											1|[local::at0009],
											1|[local::at0010]
										}
									}
									ELEMENT[at0011] occurrences matches {0..1} matches {    -- Resting symmetry cheek
										value matches {
											0|[local::at0012],
											2|[local::at0013],
											1|[local::at0014],
											1|[local::at0015]
										}
									}
									ELEMENT[at0016] occurrences matches {0..1} matches {    -- Resting symmetry mouth
										value matches {
											0|[local::at0017],
											1|[local::at0018],
											1|[local::at0019]
										}
									}
									ELEMENT[at0026] occurrences matches {0..1} matches {    -- Symmetry of voluntary movement forehead wrinkle
										value matches {
											1|[local::at0027],
											2|[local::at0028],
											3|[local::at0029],
											4|[local::at0030],
											5|[local::at0031]
										}
									}
									ELEMENT[at0032] occurrences matches {0..1} matches {    -- Symmetry of voluntary movement gentle eye closure
										value matches {
											1|[local::at0033],
											2|[local::at0034],
											3|[local::at0035],
											4|[local::at0036],
											5|[local::at0037]
										}
									}
									ELEMENT[at0038] occurrences matches {0..1} matches {    -- Symmetry of voluntary movement open mouth smile
										value matches {
											1|[local::at0039],
											2|[local::at0040],
											3|[local::at0041],
											4|[local::at0042],
											5|[local::at0043]
										}
									}
									ELEMENT[at0044] occurrences matches {0..1} matches {    -- Symmetry of voluntary movement snarl
										value matches {
											1|[local::at0045],
											2|[local::at0046],
											3|[local::at0047],
											4|[local::at0048],
											5|[local::at0049]
										}
									}
									ELEMENT[at0050] occurrences matches {0..1} matches {    -- Symmetry of voluntary movement lip pucker
										value matches {
											1|[local::at0051],
											2|[local::at0052],
											3|[local::at0053],
											4|[local::at0054],
											5|[local::at0055]
										}
									}
									ELEMENT[at0056] occurrences matches {0..1} matches {    -- Synkinesis forehead wrinkle
										value matches {
											0|[local::at0057],
											1|[local::at0058],
											2|[local::at0059],
											3|[local::at0060]
										}
									}
									ELEMENT[at0062] occurrences matches {0..1} matches {    -- Synkinesis gentle eye closure
										value matches {
											0|[local::at0063],
											1|[local::at0064],
											2|[local::at0065],
											3|[local::at0066]
										}
									}
									ELEMENT[at0067] occurrences matches {0..1} matches {    -- Synkinesis open mouth smile
										value matches {
											0|[local::at0068],
											1|[local::at0069],
											2|[local::at0070],
											3|[local::at0071]
										}
									}
									ELEMENT[at0072] occurrences matches {0..1} matches {    -- Synkinesis snarl
										value matches {
											0|[local::at0073],
											1|[local::at0074],
											2|[local::at0075],
											3|[local::at0076]
										}
									}
									ELEMENT[at0077] occurrences matches {0..1} matches {    -- Synkinesis lip pucker
										value matches {
											0|[local::at0078],
											1|[local::at0079],
											2|[local::at0080],
											3|[local::at0081]
										}
									}
									ELEMENT[at0082] occurrences matches {0..1} matches {    -- Resting symmetry score
										value matches {
											DV_COUNT matches {*}
										}
									}
									ELEMENT[at0083] occurrences matches {0..1} matches {    -- Voluntary movement score
										value matches {
											DV_COUNT matches {*}
										}
									}
									ELEMENT[at0084] occurrences matches {0..1} matches {    -- Synkinesis score
										value matches {
											DV_COUNT matches {*}
										}
									}
									ELEMENT[at0085] occurrences matches {0..1} matches {    -- Composite score
										value matches {
											DV_COUNT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0005] occurrences matches {0..1} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

