definition
	OBSERVATION[at0000] matches {    -- TIMI risk score for STEMI
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0018] occurrences matches {0..1} matches {    -- Age category
										value matches {
											0|[local::at0019],
											2|[local::at0020],
											3|[local::at0021]
										}
									}
									ELEMENT[at0025] occurrences matches {0..1} matches {    -- Sys BP < 100mmhg
										value matches {
											0|[local::at0027],
											3|[local::at0028]
										}
									}
									ELEMENT[at0026] occurrences matches {0..1} matches {    -- HR > 100 bpm
										value matches {
											0|[local::at0029],
											2|[local::at0030]
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {    -- Weight < 67kg
										value matches {
											0|[local::at0016],
											1|[local::at0017]
										}
									}
									ELEMENT[at0031] occurrences matches {0..1} matches {    -- Diabetes mellitus
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0032,    -- No
													at0033]    -- Yes
												}
											}
										}
									}
									ELEMENT[at0034] occurrences matches {0..1} matches {    -- Hypertension
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0035,    -- No
													at0036]    -- Yes
												}
											}
										}
									}
									ELEMENT[at0037] occurrences matches {0..1} matches {    -- Angina pectoris
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0038,    -- No
													at0039]    -- Yes
												}
											}
										}
									}
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- DM/HyperT/Angina history
										value matches {
											0|[local::at0005],
											1|[local::at0006]
										}
									}
									ELEMENT[at0022] occurrences matches {0..1} matches {    -- Killip Class II-IV
										value matches {
											0|[local::at0023],
											2|[local::at0024]
										}
									}
									ELEMENT[at0040] occurrences matches {0..1} matches {    -- Anterior ST elevation
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0041,    -- No
													at0042]    -- Yes
												}
											}
										}
									}
									ELEMENT[at0043] occurrences matches {0..1} matches {    -- Left bundle branch block
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0044,    -- No
													at0045]    -- Yes
												}
											}
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {    -- Anterior ST elevation or LBBB
										value matches {
											0|[local::at0008],
											1|[local::at0009]
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {    -- Time to treatment > 4hrs
										value matches {
											0|[local::at0011],
											1|[local::at0012]
										}
									}
									ELEMENT[at0014] occurrences matches {0..1} matches {    -- Total score
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..14|}
											}
										}
									}
									ELEMENT[at0013] occurrences matches {0..1} matches {    -- Comment
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0046] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0047] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"TIMI risk score for STEMI">
					description = <"An assessment score used to estimate 30-day mortality risk in patients with ST-elevation myocardial infarction.">
					comment = <"Original version, c 2000">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"DM/HyperT/Angina history">
					description = <"Presence of prior angina, diabetes or history of hypertension">
				>
				["at0005"] = <
					text = <"No">
					description = <"No angina/DM/hyperT">
				>
				["at0006"] = <
					text = <"Yes">
					description = <"Angina/hyperT/DM was present">
				>
				["at0007"] = <
					text = <"Anterior ST elevation or LBBB">
					description = <"No anterior STE or LBBB score = 0; if ant STE/LBBB is present, the score = 1">
				>
				["at0008"] = <
					text = <"No">
					description = <"No ant STE/LBBB">
				>
				["at0009"] = <
					text = <"Yes">
					description = <"Ant STE/LBBB present">
				>
				["at0010"] = <
					text = <"Time to treatment > 4hrs">
					description = <"If time to treatment is below 4hrs, score = 0 and if over 4hrs the score = 1">
				>
				["at0011"] = <
					text = <"No">
					description = <"Time to treatment < 4hrs.">
				>
				["at0012"] = <
					text = <"Yes">
					description = <"Time to treatment >4hrs.">
				>
				["at0013"] = <
					text = <"Comment">
					description = <"Comments related to the score">
				>
				["at0014"] = <
					text = <"Total score">
					description = <"Total sum of scores (TIMI-score STEMI)">
				>
				["at0015"] = <
					text = <"Weight < 67kg">
					description = <"If patient's weight is < 67kg score 1 point otherwise 0">
				>
				["at0016"] = <
					text = <"No">
					description = <"> 67kg">
				>
				["at0017"] = <
					text = <"Yes">
					description = <"< 67kg (147.7lbs)">
				>
				["at0018"] = <
					text = <"Age category">
					description = <"Zero score for age < 65yrs; +2 score for age 65-74 yrs and 3+ score for age >= 75yrs">
				>
				["at0019"] = <
					text = <"Age < 65">
					description = <"*">
				>
				["at0020"] = <
					text = <"Age between 65-74">
					description = <"*">
				>
				["at0021"] = <
					text = <"Age >= 75">
					description = <"*">
				>
				["at0022"] = <
					text = <"Killip Class II-IV">
					description = <"If the Killip class is II to IV, the score = +2 and if I, the score = 0">
				>
				["at0023"] = <
					text = <"No">
					description = <"Killip is only class I">
				>
				["at0024"] = <
					text = <"Yes">
					description = <"Killip is between classes II and IV">
				>
				["at0025"] = <
					text = <"Sys BP < 100mmhg">
					description = <"If the sys tolic BP is under 100mmHg, the score of 3 is given">
				>
				["at0026"] = <
					text = <"HR > 100 bpm">
					description = <"Heart rates over 100 bpm is scored 2">
				>
				["at0027"] = <
					text = <"No">
					description = <"> 100mmHg">
				>
				["at0028"] = <
					text = <"Yes">
					description = <"< 100mmHg">
				>
				["at0029"] = <
					text = <"No">
					description = <"HR < 100">
				>
				["at0030"] = <
					text = <"Yes">
					description = <"HR > 100">
				>
				["at0031"] = <
					text = <"Diabetes mellitus">
					description = <"">
				>
				["at0032"] = <
					text = <"No">
					description = <"">
				>
				["at0033"] = <
					text = <"Yes">
					description = <"">
				>
				["at0034"] = <
					text = <"Hypertension">
					description = <"">
				>
				["at0035"] = <
					text = <"No">
					description = <"">
				>
				["at0036"] = <
					text = <"Yes">
					description = <"">
				>
				["at0037"] = <
					text = <"Angina pectoris">
					description = <"">
				>
				["at0038"] = <
					text = <"No">
					description = <"">
				>
				["at0039"] = <
					text = <"Yes">
					description = <"">
				>
				["at0040"] = <
					text = <"Anterior ST elevation">
					description = <"">
				>
				["at0041"] = <
					text = <"No">
					description = <"">
				>
				["at0042"] = <
					text = <"Yes">
					description = <"">
				>
				["at0043"] = <
					text = <"Left bundle branch block">
					description = <"Left bundle branch block (LBBB)">
				>
				["at0044"] = <
					text = <"No">
					description = <"">
				>
				["at0045"] = <
					text = <"Yes">
					description = <"">
				>
				["at0046"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0047"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
			>
		>
