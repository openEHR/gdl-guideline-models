archetype (adl_version=1.4; uid=a8b2c1d3-4e5f-6789-abcd-ef0123456790)
	openEHR-EHR-OBSERVATION.tnm_classification_breast_cancer.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2026-02-05">
		["name"] = <"Rashmi Damodaran">
		["organisation"] = <"Cambio CDS">
		["email"] = <"rashmi.damodaran@cambio.se">
	>
	lifecycle_state = <"Author draft">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the TNM classification for breast cancer, including both clinical (cTNM) and pathological (pTNM) staging according to the UICC TNM 8th edition.">
			keywords = <"breast","cancer","TNM","staging","classification","tumor","node","metastasis","clinical","pathological">
			copyright = <"© Cambio CDS">
			use = <"Use to record the clinical and pathological TNM classification for breast cancer staging. This archetype supports both pre-treatment clinical staging (cTNM) and post-surgical pathological staging (pTNM).">
			misuse = <"Not to be used for TNM classification of other cancer types. Not to be used for treatment planning without clinical verification.">
		>
	>
	other_details = <
		["licence"] = <"">
		["custodian_organisation"] = <"Cambio CDS">
		["references"] = <"Brierley JD, Gospodarowicz MK, Wittekind C, editors. TNM Classification of Malignant Tumours. 8th ed. Oxford: Wiley-Blackwell; 2017.">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"d4a1d7496f44670377cf3658f37fe315">
		["build_uid"] = <"">
	>

definition
	OBSERVATION[at0000] matches {    -- TNM classification - Breast
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0004] occurrences matches {0..1} matches {    -- Clinical classification (cTNM)
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0086] occurrences matches {0..1} matches {    -- Tumor size
												value matches {
													C_DV_QUANTITY <
														property = <[openehr::122]>
														list = <
															["1"] = <
																units = <"mm">
																magnitude = <|>=0.0|>
																precision = <|1|>
															>
														>
													>
												}
											}
											ELEMENT[at0005] occurrences matches {0..1} matches {    -- cT - Primary tumor
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0006,    -- TX - Primary tumor cannot be assessed
															at0007,    -- T0 - No evidence of primary tumor
															at0099,    -- Tis - Carcinoma in situ
															at0087,    -- T1 - Tumor ≤20 mm in greatest dimension
															at0014,    -- T2 - Tumor >20-50 mm
															at0015,    -- T3 - Tumor >50 mm
															at0088]    -- T4 - Tumor with extension to chest wall and/or skin
														}
													}
												}
											}
											ELEMENT[at0100] occurrences matches {0..1} matches {    -- cTis subcategory
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0008,    -- Tis (DCIS) - Ductal carcinoma in situ
															at0009]    -- Tis (Paget) - Paget disease of nipple with no tumor
														}
													}
												}
											}
											ELEMENT[at0089] occurrences matches {0..1} matches {    -- cT1 subcategory
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0090,    -- T1mi - Tumor ≤1 mm (microinvasion)
															at0091,    -- T1a - Tumor >1-5 mm
															at0092,    -- T1b - Tumor >5-10 mm
															at0093]    -- T1c - Tumor >10-20 mm
														}
													}
												}
											}
											ELEMENT[at0094] occurrences matches {0..1} matches {    -- cT4 subcategory
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0095,    -- T4a - Extension to chest wall
															at0096,    -- T4b - Ulceration or satellite nodules or edema
															at0097,    -- T4c - Both T4a and T4b
															at0098]    -- T4d - Inflammatory carcinoma
														}
													}
												}
											}
											ELEMENT[at0020] occurrences matches {0..1} matches {    -- cN - Regional lymph nodes
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0021,    -- NX - Regional lymph nodes cannot be assessed
															at0022,    -- N0 - No regional lymph node metastasis
															at0023,    -- N1 - Metastasis to movable ipsilateral level I, II axillary lymph node(s)
															at0101,    -- N2 - Metastasis in fixed axillary or internal mammary nodes
															at0102]    -- N3 - Metastasis in infraclavicular, internal mammary/axillary, or supraclavicular nodes
														}
													}
												}
											}
											ELEMENT[at0103] occurrences matches {0..1} matches {    -- cN2 subcategory
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0024,    -- N2a - Metastasis in ipsilateral level I, II axillary lymph nodes fixed to one another or other structures
															at0025]    -- N2b - Metastasis only in clinically detected ipsilateral internal mammary nodes
														}
													}
												}
											}
											ELEMENT[at0104] occurrences matches {0..1} matches {    -- cN3 subcategory
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0026,    -- N3a - Metastasis in ipsilateral infraclavicular lymph node(s)
															at0027,    -- N3b - Metastasis in ipsilateral internal mammary and axillary lymph node(s)
															at0028]    -- N3c - Metastasis in ipsilateral supraclavicular lymph node(s)
														}
													}
												}
											}
											ELEMENT[at0029] occurrences matches {0..1} matches {    -- cM - Distant metastasis
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0030,    -- M0 - No distant metastasis
															at0031]    -- M1 - Distant metastasis
														}
													}
												}
											}
										}
									}
									CLUSTER[at0042] occurrences matches {0..1} matches {    -- Pathological classification (pTNM)
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0043] occurrences matches {0..1} matches {    -- pT - Primary tumor
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0044,    -- pTX - Primary tumor cannot be assessed
															at0045,    -- pT0 - No evidence of primary tumor
															at0105,    -- pTis - Carcinoma in situ
															at0106,    -- pT1 - Tumor ≤20 mm in greatest dimension
															at0052,    -- pT2 - Tumor >20-50 mm
															at0053,    -- pT3 - Tumor >50 mm
															at0107]    -- pT4 - Tumor with extension to chest wall and/or skin
														}
													}
												}
											}
											ELEMENT[at0108] occurrences matches {0..1} matches {    -- pTis subcategory
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0046,    -- pTis (DCIS) - Ductal carcinoma in situ
															at0047]    -- pTis (Paget) - Paget disease of nipple with no tumor
														}
													}
												}
											}
											ELEMENT[at0109] occurrences matches {0..1} matches {    -- pT1 subcategory
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0048,    -- pT1mi - Tumor ≤1 mm
															at0049,    -- pT1a - Tumor >1-5 mm
															at0050,    -- pT1b - Tumor >5-10 mm
															at0051]    -- pT1c - Tumor >10-20 mm
														}
													}
												}
											}
											ELEMENT[at0110] occurrences matches {0..1} matches {    -- pT4 subcategory
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0054,    -- pT4a - Extension to chest wall
															at0055,    -- pT4b - Ulceration or satellite nodules or edema
															at0056,    -- pT4c - Both pT4a and pT4b
															at0057]    -- pT4d - Inflammatory carcinoma
														}
													}
												}
											}
											ELEMENT[at0058] occurrences matches {0..1} matches {    -- pN - Regional lymph nodes
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0059,    -- pNX - Regional lymph nodes cannot be assessed
															at0060,    -- pN0 - No regional lymph node metastasis histologically
															at0061,    -- pN0(i+) - Malignant cells ≤0.2 mm (isolated tumor cells)
															at0111,    -- pN1 - Micrometastases or metastases in 1-3 axillary/internal mammary nodes
															at0112,    -- pN2 - Metastases in 4-9 axillary or internal mammary nodes
															at0113]    -- pN3 - Metastases in ≥10 nodes or supraclavicular nodes
														}
													}
												}
											}
											ELEMENT[at0114] occurrences matches {0..1} matches {    -- pN1 subcategory
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0062,    -- pN1mi - Micrometastases (>0.2 mm but ≤2.0 mm)
															at0063,    -- pN1a - Metastases in 1-3 axillary lymph nodes
															at0064,    -- pN1b - Metastases in internal mammary nodes (sentinel node biopsy)
															at0065]    -- pN1c - Metastases in 1-3 axillary and internal mammary nodes
														}
													}
												}
											}
											ELEMENT[at0115] occurrences matches {0..1} matches {    -- pN2 subcategory
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0066,    -- pN2a - Metastases in 4-9 axillary lymph nodes
															at0067]    -- pN2b - Metastases in clinically detected internal mammary nodes only
														}
													}
												}
											}
											ELEMENT[at0116] occurrences matches {0..1} matches {    -- pN3 subcategory
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0068,    -- pN3a - Metastases in ≥10 axillary nodes or infraclavicular nodes
															at0069,    -- pN3b - Metastases in internal mammary and axillary nodes (clinically detected)
															at0070]    -- pN3c - Metastases in ipsilateral supraclavicular lymph nodes
														}
													}
												}
											}
											ELEMENT[at0071] occurrences matches {0..1} matches {    -- pM - Distant metastasis
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0072,    -- pM0 - No distant metastasis
															at0073]    -- pM1 - Distant metastasis confirmed microscopically
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0084] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0085] occurrences matches {0..1} matches {*}    -- Extension
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"TNM classification - Breast">
					description = <"TNM classification for breast cancer according to the UICC TNM 8th edition, including both clinical (cTNM) and pathological (pTNM) staging.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"@ internal @">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Clinical classification (cTNM)">
					description = <"Pre-treatment clinical classification based on physical examination, imaging, and biopsy.">
				>
				["at0005"] = <
					text = <"cT - Primary tumor">
					description = <"Clinical assessment of the primary tumor category.">
				>
				["at0006"] = <
					text = <"TX - Primary tumor cannot be assessed">
					description = <"">
				>
				["at0007"] = <
					text = <"T0 - No evidence of primary tumor">
					description = <"">
				>
				["at0008"] = <
					text = <"Tis (DCIS) - Ductal carcinoma in situ">
					description = <"">
				>
				["at0009"] = <
					text = <"Tis (Paget) - Paget disease of nipple with no tumor">
					description = <"Paget disease of the nipple not associated with invasive carcinoma and/or DCIS in the underlying breast parenchyma.">
				>
				["at0014"] = <
					text = <"T2 - Tumor >20-50 mm">
					description = <"">
				>
				["at0015"] = <
					text = <"T3 - Tumor >50 mm">
					description = <"">
				>
				["at0020"] = <
					text = <"cN - Regional lymph nodes">
					description = <"Clinical assessment of regional lymph nodes.">
				>
				["at0021"] = <
					text = <"NX - Regional lymph nodes cannot be assessed">
					description = <"e.g., previously removed.">
				>
				["at0022"] = <
					text = <"N0 - No regional lymph node metastasis">
					description = <"">
				>
				["at0023"] = <
					text = <"N1 - Metastasis to movable ipsilateral level I, II axillary lymph node(s)">
					description = <"">
				>
				["at0024"] = <
					text = <"N2a - Metastasis in ipsilateral level I, II axillary lymph nodes fixed to one another or other structures">
					description = <"">
				>
				["at0025"] = <
					text = <"N2b - Metastasis only in clinically detected ipsilateral internal mammary nodes">
					description = <"In the absence of clinically evident level I, II axillary lymph node metastasis.">
				>
				["at0026"] = <
					text = <"N3a - Metastasis in ipsilateral infraclavicular lymph node(s)">
					description = <"Level III axillary, with or without level I, II axillary node involvement.">
				>
				["at0027"] = <
					text = <"N3b - Metastasis in ipsilateral internal mammary and axillary lymph node(s)">
					description = <"Clinically detected ipsilateral internal mammary lymph node(s) with clinically evident level I, II axillary lymph node metastasis.">
				>
				["at0028"] = <
					text = <"N3c - Metastasis in ipsilateral supraclavicular lymph node(s)">
					description = <"With or without axillary or internal mammary lymph node involvement.">
				>
				["at0029"] = <
					text = <"cM - Distant metastasis">
					description = <"Clinical assessment of distant metastasis.">
				>
				["at0030"] = <
					text = <"M0 - No distant metastasis">
					description = <"">
				>
				["at0031"] = <
					text = <"M1 - Distant metastasis">
					description = <"">
				>
				["at0042"] = <
					text = <"Pathological classification (pTNM)">
					description = <"Post-surgical histopathological classification based on examination of the resected specimen.">
				>
				["at0043"] = <
					text = <"pT - Primary tumor">
					description = <"Pathological assessment of the primary tumor.">
				>
				["at0044"] = <
					text = <"pTX - Primary tumor cannot be assessed">
					description = <"">
				>
				["at0045"] = <
					text = <"pT0 - No evidence of primary tumor">
					description = <"">
				>
				["at0046"] = <
					text = <"pTis (DCIS) - Ductal carcinoma in situ">
					description = <"">
				>
				["at0047"] = <
					text = <"pTis (Paget) - Paget disease of nipple with no tumor">
					description = <"Paget disease of the nipple not associated with invasive carcinoma and/or DCIS in the underlying breast parenchyma.">
				>
				["at0048"] = <
					text = <"pT1mi - Tumor ≤1 mm">
					description = <"Microinvasion ≤1 mm in greatest dimension.">
				>
				["at0049"] = <
					text = <"pT1a - Tumor >1-5 mm">
					description = <"">
				>
				["at0050"] = <
					text = <"pT1b - Tumor >5-10 mm">
					description = <"">
				>
				["at0051"] = <
					text = <"pT1c - Tumor >10-20 mm">
					description = <"">
				>
				["at0052"] = <
					text = <"pT2 - Tumor >20-50 mm">
					description = <"">
				>
				["at0053"] = <
					text = <"pT3 - Tumor >50 mm">
					description = <"">
				>
				["at0054"] = <
					text = <"pT4a - Extension to chest wall">
					description = <"Extension to the chest wall, not including only pectoralis muscle adherence/invasion.">
				>
				["at0055"] = <
					text = <"pT4b - Ulceration or satellite nodules or edema">
					description = <"Ulceration and/or ipsilateral satellite nodules and/or edema (including peau d'orange) of the skin.">
				>
				["at0056"] = <
					text = <"pT4c - Both pT4a and pT4b">
					description = <"">
				>
				["at0057"] = <
					text = <"pT4d - Inflammatory carcinoma">
					description = <"">
				>
				["at0058"] = <
					text = <"pN - Regional lymph nodes">
					description = <"Pathological assessment of regional lymph nodes.">
				>
				["at0059"] = <
					text = <"pNX - Regional lymph nodes cannot be assessed">
					description = <"e.g., previously removed, or not removed for pathological study.">
				>
				["at0060"] = <
					text = <"pN0 - No regional lymph node metastasis histologically">
					description = <"No regional lymph node metastasis histologically, no additional examination for isolated tumor cells.">
				>
				["at0061"] = <
					text = <"pN0(i+) - Malignant cells ≤0.2 mm (isolated tumor cells)">
					description = <"Malignant cells in regional lymph node(s) no greater than 0.2 mm detected by H&E or IHC.">
				>
				["at0062"] = <
					text = <"pN1mi - Micrometastases (>0.2 mm but ≤2.0 mm)">
					description = <"">
				>
				["at0063"] = <
					text = <"pN1a - Metastases in 1-3 axillary lymph nodes">
					description = <"At least one metastasis greater than 2.0 mm.">
				>
				["at0064"] = <
					text = <"pN1b - Metastases in internal mammary nodes (sentinel node biopsy)">
					description = <"Metastases in internal mammary nodes with micrometastases or macrometastases detected by sentinel lymph node biopsy but not clinically detected.">
				>
				["at0065"] = <
					text = <"pN1c - Metastases in 1-3 axillary and internal mammary nodes">
					description = <"Metastases in 1-3 axillary lymph nodes and in internal mammary lymph nodes with micrometastases or macrometastases detected by sentinel lymph node biopsy but not clinically detected.">
				>
				["at0066"] = <
					text = <"pN2a - Metastases in 4-9 axillary lymph nodes">
					description = <"At least one tumor deposit greater than 2.0 mm.">
				>
				["at0067"] = <
					text = <"pN2b - Metastases in clinically detected internal mammary nodes only">
					description = <"In the absence of axillary lymph node metastases.">
				>
				["at0068"] = <
					text = <"pN3a - Metastases in ≥10 axillary nodes or infraclavicular nodes">
					description = <"Metastases in 10 or more axillary lymph nodes (at least one tumor deposit >2.0 mm) or metastases to the infraclavicular (level III axillary) lymph nodes.">
				>
				["at0069"] = <
					text = <"pN3b - Metastases in internal mammary and axillary nodes (clinically detected)">
					description = <"Metastases in clinically detected ipsilateral internal mammary lymph nodes in the presence of one or more positive axillary lymph nodes; or in more than 3 axillary lymph nodes and in internal mammary lymph nodes detected by sentinel lymph node biopsy but not clinically detected.">
				>
				["at0070"] = <
					text = <"pN3c - Metastases in ipsilateral supraclavicular lymph nodes">
					description = <"">
				>
				["at0071"] = <
					text = <"pM - Distant metastasis">
					description = <"Pathological assessment of distant metastasis.">
				>
				["at0072"] = <
					text = <"pM0 - No distant metastasis">
					description = <"">
				>
				["at0073"] = <
					text = <"pM1 - Distant metastasis confirmed microscopically">
					description = <"">
				>
				["at0084"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0085"] = <
					text = <"Extension">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR.">
				>
				["at0086"] = <
					text = <"Tumor size">
					description = <"The greatest dimension of the primary tumor measured in millimeters.">
				>
				["at0087"] = <
					text = <"T1 - Tumor ≤20 mm in greatest dimension">
					description = <"Tumor 20 mm or less in greatest dimension. Use the T1 subcategory element to specify T1mi, T1a, T1b, or T1c.">
				>
				["at0088"] = <
					text = <"T4 - Tumor with extension to chest wall and/or skin">
					description = <"Tumor of any size with direct extension to the chest wall and/or to the skin. Use the T4 subcategory element to specify T4a, T4b, T4c, or T4d.">
				>
				["at0089"] = <
					text = <"cT1 subcategory">
					description = <"Subcategory for T1 tumors based on size.">
				>
				["at0090"] = <
					text = <"T1mi - Tumor ≤1 mm (microinvasion)">
					description = <"Microinvasion ≤1 mm in greatest dimension.">
				>
				["at0091"] = <
					text = <"T1a - Tumor >1-5 mm">
					description = <"">
				>
				["at0092"] = <
					text = <"T1b - Tumor >5-10 mm">
					description = <"">
				>
				["at0093"] = <
					text = <"T1c - Tumor >10-20 mm">
					description = <"">
				>
				["at0094"] = <
					text = <"cT4 subcategory">
					description = <"Subcategory for T4 tumors based on type of extension.">
				>
				["at0095"] = <
					text = <"T4a - Extension to chest wall">
					description = <"Extension to the chest wall, not including only pectoralis muscle adherence/invasion.">
				>
				["at0096"] = <
					text = <"T4b - Ulceration or satellite nodules or edema">
					description = <"Ulceration and/or ipsilateral satellite nodules and/or edema (including peau d'orange) of the skin.">
				>
				["at0097"] = <
					text = <"T4c - Both T4a and T4b">
					description = <"">
				>
				["at0098"] = <
					text = <"T4d - Inflammatory carcinoma">
					description = <"">
				>
				["at0099"] = <
					text = <"Tis - Carcinoma in situ">
					description = <"Carcinoma in situ (DCIS or Paget disease). Use the Tis subcategory element to specify the type.">
				>
				["at0100"] = <
					text = <"cTis subcategory">
					description = <"Subcategory for Tis tumors based on histological type.">
				>
				["at0101"] = <
					text = <"N2 - Metastasis in fixed axillary or internal mammary nodes">
					description = <"Metastasis in ipsilateral level I, II axillary lymph nodes fixed to one another or to other structures, or in clinically detected ipsilateral internal mammary nodes in the absence of clinically evident axillary lymph node metastasis.">
				>
				["at0102"] = <
					text = <"N3 - Metastasis in infraclavicular, internal mammary/axillary, or supraclavicular nodes">
					description = <"Metastasis in ipsilateral infraclavicular lymph nodes, or in ipsilateral internal mammary and axillary lymph nodes, or in ipsilateral supraclavicular lymph nodes.">
				>
				["at0103"] = <
					text = <"cN2 subcategory">
					description = <"Subcategory for N2 regional lymph node metastasis.">
				>
				["at0104"] = <
					text = <"cN3 subcategory">
					description = <"Subcategory for N3 regional lymph node metastasis.">
				>
				["at0105"] = <
					text = <"pTis - Carcinoma in situ">
					description = <"Carcinoma in situ (DCIS or Paget disease). Use the pTis subcategory element to specify the type.">
				>
				["at0106"] = <
					text = <"pT1 - Tumor ≤20 mm in greatest dimension">
					description = <"Tumor 20 mm or less in greatest dimension. Use the pT1 subcategory element to specify pT1mi, pT1a, pT1b, or pT1c.">
				>
				["at0107"] = <
					text = <"pT4 - Tumor with extension to chest wall and/or skin">
					description = <"Tumor of any size with direct extension to the chest wall and/or to the skin. Use the pT4 subcategory element to specify pT4a, pT4b, pT4c, or pT4d.">
				>
				["at0108"] = <
					text = <"pTis subcategory">
					description = <"Subcategory for pTis tumors based on histological type.">
				>
				["at0109"] = <
					text = <"pT1 subcategory">
					description = <"Subcategory for pT1 tumors based on size.">
				>
				["at0110"] = <
					text = <"pT4 subcategory">
					description = <"Subcategory for pT4 tumors based on type of extension.">
				>
				["at0111"] = <
					text = <"pN1 - Micrometastases or metastases in 1-3 axillary/internal mammary nodes">
					description = <"Micrometastases, or metastases in 1-3 axillary lymph nodes and/or in internal mammary nodes.">
				>
				["at0112"] = <
					text = <"pN2 - Metastases in 4-9 axillary or internal mammary nodes">
					description = <"Metastases in 4-9 axillary lymph nodes, or in clinically detected internal mammary lymph nodes in the absence of axillary lymph node metastases.">
				>
				["at0113"] = <
					text = <"pN3 - Metastases in ≥10 nodes or supraclavicular nodes">
					description = <"Metastases in 10 or more axillary lymph nodes, or in infraclavicular lymph nodes, or in clinically detected internal mammary lymph nodes with axillary node metastases, or in supraclavicular lymph nodes.">
				>
				["at0114"] = <
					text = <"pN1 subcategory">
					description = <"Subcategory for pN1 regional lymph node metastasis.">
				>
				["at0115"] = <
					text = <"pN2 subcategory">
					description = <"Subcategory for pN2 regional lymph node metastasis.">
				>
				["at0116"] = <
					text = <"pN3 subcategory">
					description = <"Subcategory for pN3 regional lymph node metastasis.">
				>
			>
		>
	>
