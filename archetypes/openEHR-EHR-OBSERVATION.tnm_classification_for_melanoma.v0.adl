definition
	OBSERVATION[at0000] matches {    -- TNM classification for melanoma
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0006] occurrences matches {0..1} matches {    -- T - Primary tumour
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0007,    -- Tx - Tissue sample insufficient for tumor thickness measurement
													at0008,    -- T0 - Unknown primary tumor, melanoma in complete regression
													at0009,    -- Tis - In situ
													at0010,    -- T1a - < 0.8 mm, no ulceration
													at0011,    -- T1b - < 0.8 mm with ulceration, or 0.8–1.0 mm with/without ulceration
													at0012,    -- T2a - > 1.0–2.0 mm, no ulceration
													at0013,    -- T2b - > 1.0–2.0 mm, with ulceration
													at0014,    -- T3a - > 2.0–4.0 mm, no ulceration
													at0015,    -- T3b - > 2.0–4.0 mm, with ulceration
													at0016,    -- T4a - > 4.0 mm, no ulceration
													at0017]    -- T4b - > 4.0 mm, with ulceration
												}
											}
										}
									}
									ELEMENT[at0018] occurrences matches {0..1} matches {    -- N - Lymph nodes
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0019,    -- Nx - Not examined/No sentinel node biopsy performed. T1 melanomas excluded
													at0020,    -- N0 - No lymph node metastases
													at0021,    -- N1a - 1 lymph node with metastasis
													at0022,    -- N1b - 1 lymph node with clinical metastasis
													at0023,    -- N1c - No lymph node metastasis, but in transit, satellite and/or microsatellite metastases present
													at0024,    -- N2a - 2–3 lymph nodes with metastases
													at0025,    -- N2b - 2–3 lymph nodes with metastases and at least 1 clinical metastasis
													at0026,    -- N2c - 1 lymph node with metastasis and in transit, satellite and/or microsatellite metastases present
													at0027,    -- N3a - ≥ 4 lymph nodes with metastases
													at0028,    -- N3b - ≥ 4 lymph nodes with metastases and at least 1 clinical metastasis or conglomerate
													at0029]    -- N3c - ≥ 2 lymph nodes with metastases and in transit, satellite and/or microsatellite metastases present
												}
											}
										}
									}
									ELEMENT[at0030] occurrences matches {0..1} matches {    -- M - Distant metastasis
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0031,    -- M0 - No distant metastases
													at0032,    -- M1a - Distant metastasis to skin or muscle
													at0033,    -- M1b - Distant metastasis to lung
													at0034,    -- M1c - Distant metastasis to visceral organs
													at0035]    -- M1d - CNS metastases
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0005] occurrences matches {0..1} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

