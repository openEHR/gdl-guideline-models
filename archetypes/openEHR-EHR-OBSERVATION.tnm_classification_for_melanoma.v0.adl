	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the T, N, and M categories for the melanoma TNM classification.">
			keywords = <"tnm","melanoma","skin","cancer","oncology","uicc","ajcc","staging","metastasis","tumor">
			copyright = <"© Cambio CDS">
			use = <"Use to record the T, N, and M categories for the melanoma TNM classification.">
			misuse = <"Not to be used for staging other types of cancer.

Not to be used for non-melanoma skin cancers.">
		>
	>
