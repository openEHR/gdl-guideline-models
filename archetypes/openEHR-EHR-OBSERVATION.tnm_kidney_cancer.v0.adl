			language = <[ISO_639-1::en]>
			purpose = <"To record the T, N, and M categories for the kidney cancer TNM classification.">
			keywords = <"tnm","kidney","cancer","renal","cell","carcinoma","rcc","oncology","uicc","staging","metastasis","tumor">
			copyright = <"© Cambio CDS">
			use = <"Use to record the T, N, and M categories for the kidney cancer TNM classification.">
			misuse = <"Not to be used for staging other types of cancer. 

