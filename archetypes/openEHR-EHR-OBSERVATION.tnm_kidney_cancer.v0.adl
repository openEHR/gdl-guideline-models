definition
	OBSERVATION[at0000] matches {    -- TNM classification for kidney cancer
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0006] occurrences matches {0..1} matches {    -- T - Primary tumor
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0009,    -- TX - primary tumor cannot be assessed
													at0010,    -- T0 - no evidence of primary tumor
													at0011,    -- T1 - tumor ≤ 7 cm, limited to the kidney
													at0012,    -- T1a - tumor ≤ 4 cm
													at0013,    -- T1b - tumor > 4 cm but ≤ 7 cm
													at0014,    -- T2 - tumor > 7 cm, limited to the kidney
													at0015,    -- T2a - tumor > 7 cm but ≤ 10 cm
													at0016,    -- T2b - tumor > 10 cm, limited to the kidney
													at0017,    -- T3 - tumor extends into major veins or perinephric tissues but not into the ipsilateral adrenal gland and not beyond Gerota fascia
													at0018,    -- T3a - tumor grossly extends into the renal vein or its segmental branches, or invades perirenal/renal sinus fat but not beyond Gerota fascia
													at0019,    -- T3b - tumor grossly extends into the vena cava below the diaphragm
													at0020,    -- T3c - tumor grossly extends into the vena cava above the diaphragm or invades the wall of the vena cava
													at0021]    -- T4 - tumor invades beyond Gerota fascia (including contiguous extension into the ipsilateral adrenal gland)
												}
											}
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {    -- N - Lymph nodes
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0023,    -- N0 - no regional lymph node metastasis
													at0024]    -- N1 - metastasis in regional lymph node(s)
												}
											}
										}
									}
									ELEMENT[at0008] occurrences matches {0..1} matches {    -- M - Distant metastasis
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0025,    -- M0 - no distant metastasis
													at0026]    -- M1 - distant metastasis
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0004] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0005] occurrences matches {0..1} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

