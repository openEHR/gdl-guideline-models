  "id" : "2018_Leibovich_Model_for_Renal_Cell_Carcinoma_Assessment.v0.1.0",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Katja Mariko Wilde",
      "email" : "katja-wilde@t-online.de",
      "organisation" : "Cambio CDS",
      "date" : "2025-09-26"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To record prognostic interpretations (5-, 10-, 15-year PFS and CSS) derived from existing inputs: ccRCC PFS/CSS total scores and papRCC/chrRCC risk groups previously calculated by the 2018 Leibovich model, for adult patients with RCC.",
        "keywords" : [
          "Leibovich model",
          "RCC",
          "renal",
          "cell",
          "carcinoma"
        ],
        "use" : "Use to assess prognosis in adult patients with renal cell carcinoma (RCC), including clear cell RCC (ccRCC), papillary RCC (papRCC), and chromophobe RCC (chrRCC), based on results already calculated with the 2018 Leibovich model.\n\nFor ccRCC, the previously computed PFS and CSS scores are mapped to predicted survival probabilities at 5, 10, and 15 years.\n\nFor papRCC, the previously assigned risk group (based on tumor grade, perinephric/renal sinus fat invasion, and tumor thrombus) is mapped to predicted PFS and CSS probabilities at 5, 10, and 15 years.\n\nFor chrRCC, the previously assigned risk group (based on sarcomatoid differentiation, perinephric/renal sinus fat invasion, and nodal involvement) is mapped to predicted PFS and CSS probabilities at 5, 10, and 15 years.\n",
        "misuse" : "Not to be used for calculating the 2018 Leibovich model scores or assigning papRCC/chrRCC risk groups. Use instead the corresponding calculation guideline.\nNot to be used for recording information related to other renal cell carcinoma prognostic models.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Leibovich BC, Lohse CM, Cheville JC, Zaid HB, Boorjian SA, Frank I, Thompson RH, Parker WP. Predicting Oncologic Outcomes in Renal Cell Carcinoma After Surgery. Eur Urol. 2018 May;73(5):772-780. doi: 10.1016/j.eururo.2018.01.005. Epub 2018 Feb 3. PMID: 29398265.",
      "en" : "An assessment score used to predict progression-free and cancer-specific survival in patients with renal cell carcinoma (RCC)."
    }
  },
