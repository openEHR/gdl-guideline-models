    "rules" : {
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 4,
        "when" : [
          "$gt0003|Neutrophils, %|!=null",
          "$gt0004|WBC count, x10^9/L|!=null",
          "$gt0005|CRP level, mg/L|!=null",
          "$gt0006|Body temperature ≥38.5 C|!=null",
          "$gt0007|Vomiting|!=null",
          "$gt0008|Pain in right inferior fossa|!=null",
          "$gt0009|Rebound tenderness or muscular defense|!=null"
        ],
        "then" : [
          "$gt0011|Total score|.magnitude=$gt0003|Neutrophils, %|.value+$gt0004|WBC count, x10^9/L|.value+$gt0005|CRP level, mg/L|.value+$gt0006|Body temperature ≥38.5 C|.value+$gt0007|Vomiting|.value+$gt0008|Pain in right inferior fossa|.value+$gt0009|Rebound tenderness or muscular defense|.value"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 3,
        "when" : [
          "$gt0011|Total score|>=0",
          "$gt0011|Total score|<=4"
        ],
        "then" : [
          "$gt0013|Probability of appendicitis|=0|local::at0004|Low probability|",
          "$gt0014|Recommendation|=0|local::at0007|Consider outpatient follow-up if unaltered general condition|"
        ]
      },
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 2,
        "when" : [
          "$gt0011|Total score|>=5",
          "$gt0011|Total score|<=8"
        ],
        "then" : [
          "$gt0013|Probability of appendicitis|=1|local::at0005|Indeterminate group|",
          "$gt0014|Recommendation|=1|local::at0008|In-hospital active observation|"
        ]
      },
      "gt0018" : {
        "id" : "gt0018",
        "priority" : 1,
        "when" : [
          "$gt0011|Total score|>=9",
          "$gt0011|Total score|<=12"
        ],
        "then" : [
          "$gt0013|Probability of appendicitis|=2|local::at0006|High probability|",
          "$gt0014|Recommendation|=2|local::at0009|Consider surgical exploration|"
        ]
      }
    }
