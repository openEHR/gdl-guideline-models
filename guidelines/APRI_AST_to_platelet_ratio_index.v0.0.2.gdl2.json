{
  "id" : "APRI_AST_to_platelet_ratio_index.v0.0.2",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Winner Ng",
      "email" : "dokter.winner@gmail.com",
      "organisation" : "Cambio CDS",
      "date" : "2020-05-19"
    },
    "other_contributors" : [
      "Katja Wilde"
    ],
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To record the parameter and to interpret the chance of fibrosis or cirrhosis in CHC patients.",
        "keywords" : [
          "APRI",
          "AST",
          "SGOT",
          "platelet",
          "thrombocyte",
          "fibrosis",
          "cirrhosis",
          "hepatitis C"
        ],
        "use" : "APRI offers a non-invasive way to predict which patients have cirrhosis thus avoiding unnecessary liver biopsy.\n\nAPRI is calculated based on the following formula:\nAPRI = ((AST / AST Upper Limit of Normal) x 100) / Platelet count\n\nThe measurement unit for AST and AST Upper Limit of Normal is IU/L and for platelet count is in 10^9/L.\n\nThe interpretation is based on the 2011 meta-analysis in Hepatology by Lin et. al.\n- Significant fibrosis: APRI threshold of 0.7 was 77% sensitive and 72% specific.\n- Severe fibrosis: APRI threshold of 1.0 was 61% sensitive and 64% specific. APRI of >=2 was 36% sensitive and 93% specific.\n- Cirrhosis: APRI threshold of 1.0 was 76% sensitive and 72% specific. APRI of >=2 was 46% sensitive and 91% specific.",
        "misuse" : "Not intended to be used as a single method for determining the chance of fibrosis or cirrhosis in CHC patients.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "1. Wai CT, Greenson JK, Fontana RJ, et al. A simple noninvasive index can predict both significant fibrosis and cirrhosis in patients with chronic hepatitis C. Hepatology. 2003;38(2):518-26.\n2. Khan DA, Fatima Tuz Z, Khan FA, Mubarak A. Evaluation of diagnostic accuracy of APRI for prediction of fibrosis in hepatitis C patients. J Ayub Med Coll Abbottabad 2008; 20: 122-126.\n3. Lin ZH, Xin YN, Dong QJ, et al. Performance of the aspartate aminotransferase-to-platelet ratio index for the staging of hepatitis C-related fibrosis: an updated meta-analysis. Hepatology. 2011;53:726-36",
      "en" : "An index to determine the likelihood of hepatic fibrosis and cirrhosis in patients with chronic hepatitis C (CHC)."
    }
  },
  "definition" : {
    "data_bindings" : {
      "gt0004" : {
        "id" : "gt0004",
        "model_id" : "openEHR-EHR-OBSERVATION.apri_ast_platelet_ratio_index.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.apri_ast_platelet_ratio_index.v0",
        "type" : "INPUT",
        "elements" : {
          "gt0005" : {
            "id" : "gt0005",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0005]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "IU/l"
            ]
          }
        }
      },
      "gt0008" : {
        "id" : "gt0008",
        "model_id" : "openEHR-EHR-OBSERVATION.apri_ast_platelet_ratio_index.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.apri_ast_platelet_ratio_index.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0015" : {
            "id" : "gt0015",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0008]",
            "data_type" : "DV_QUANTITY"
          }
        }
      },
      "gt0010" : {
        "id" : "gt0010",
        "model_id" : "openEHR-EHR-EVALUATION.apri_ast_platelet_ratio_index.v0",
        "template_id" : "openEHR-EHR-EVALUATION.apri_ast_platelet_ratio_index.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0011" : {
            "id" : "gt0011",
            "path" : "/data[at0001]/items[at0002]"
          }
        }
      },
      "gt0020" : {
        "id" : "gt0020",
        "model_id" : "openEHR-EHR-OBSERVATION.laboratory_test_result.v1",
        "template_id" : "openEHR-EHR-OBSERVATION.laboratory_test_result.v1",
        "type" : "INPUT",
        "elements" : {
          "gt0021" : {
            "id" : "gt0021",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[openEHR-EHR-CLUSTER.laboratory_test_analyte.v1]/items[at0001]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "IU/L"
            ]
          },
          "gt0024" : {
            "id" : "gt0024",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[openEHR-EHR-CLUSTER.laboratory_test_analyte.v1]/items[at0024]",
            "data_type" : "DV_TEXT"
          }
        },
        "predicates" : [
          "/data[at0001]/events[at0002]/data[at0003]/items[openEHR-EHR-CLUSTER.laboratory_test_analyte.v1]/items[at0024] is_a local::gt0027|ASAT code|"
        ]
      },
      "gt0022" : {
        "id" : "gt0022",
        "model_id" : "openEHR-EHR-OBSERVATION.laboratory_test_result.v1",
        "template_id" : "openEHR-EHR-OBSERVATION.laboratory_test_result.v1",
        "type" : "INPUT",
        "elements" : {
          "gt0023" : {
            "id" : "gt0023",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[openEHR-EHR-CLUSTER.laboratory_test_analyte.v1]/items[at0001]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "10*9/L"
            ]
          },
          "gt0025" : {
            "id" : "gt0025",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[openEHR-EHR-CLUSTER.laboratory_test_analyte.v1]/items[at0024]",
            "data_type" : "DV_TEXT"
          }
        },
        "predicates" : [
          "/data[at0001]/events[at0002]/data[at0003]/items[openEHR-EHR-CLUSTER.laboratory_test_analyte.v1]/items[at0024] is_a local::gt0026|Platelet count code|"
        ]
      }
    },
    "rules" : {
      "gt0012" : {
        "id" : "gt0012",
        "priority" : 5,
        "when" : [
          "$gt0021|ASAT|!=null",
          "$gt0005|AST upper limit of normal|!=null",
          "$gt0023|Platelet count (10*9/L)|!=null"
        ],
        "then" : [
          "$gt0015|APRI|.magnitude=(($gt0021|ASAT|.magnitude/$gt0005|AST upper limit of normal|.magnitude)*100)/$gt0023|Platelet count (10*9/L)|.magnitude",
          "$gt0015|APRI|.precision=2",
          "$gt0015|APRI|.unit='1'"
        ]
      },
      "gt0013" : {
        "id" : "gt0013",
        "priority" : 4,
        "when" : [
          "$gt0015|APRI|<=0.7,1"
        ],
        "then" : [
          "$gt0011|APRI interpretation|=0|local::at0003|Scores < 0.7 were not sensitive or specific enough to determine level of fibrosis or cirrhosis|"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 3,
        "when" : [
          "$gt0015|APRI|>0.7,1",
          "$gt0015|APRI|<=1,1"
        ],
        "then" : [
          "$gt0011|APRI interpretation|=1|local::at0004|Scores ≥ 0.7 were 77% sensitive and 72% specific for significant fibrosis|"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 2,
        "when" : [
          "$gt0015|APRI|>1,1",
          "$gt0015|APRI|<=2,1"
        ],
        "then" : [
          "$gt0011|APRI interpretation|=2|local::at0005|Scores ≥1 were 61% sensitive and 64% specific for severe fibrosis and 76% sensitive and 72% specific for cirrhosis|"
        ]
      },
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 1,
        "when" : [
          "$gt0015|APRI|>2,1"
        ],
        "then" : [
          "$gt0011|APRI interpretation|=3|local::at0006|Scores ≥2 were 36% sensitive and 93% specific for severe fibrosis and 46% sensitive and 91% specific for cirrhosis|"
        ]
      }
    }
  },
