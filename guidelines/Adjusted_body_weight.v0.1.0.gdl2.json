          }
        }
      },
      "gt0015" : {
        "id" : "gt0015",
        "model_id" : "openEHR-EHR-OBSERVATION.ideal_body_weight.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.ideal_body_weight.v0",
        "type" : "INPUT",
        "elements" : {
          "gt0017" : {
            "id" : "gt0017",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0016]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "kg",
              "[lb_av]"
            ]
          }
        }
      }
    },
    "rules" : {
      "gt0009" : {
        "id" : "gt0009",
        "priority" : 2,
        "when" : [
          "$gt0017|Ideal body weight|.unit=='[lb_av]'",
          "$gt0005|Actual body weight|.unit=='[lb_av]'",
          "$gt0005|Actual body weight|.magnitude>$gt0017|Ideal body weight|.magnitude"
        ],
        "then" : [
          "$gt0008|Adjusted Body Weight|.magnitude=$gt0017|Ideal body weight|.magnitude+0.4*($gt0005|Actual body weight|.magnitude-$gt0017|Ideal body weight|.magnitude)",
          "$gt0008|Adjusted Body Weight|.unit='[lb_av]'",
          "$gt0011|Actual body weight > IBW|.magnitude=($gt0005|Actual body weight|.magnitude/$gt0017|Ideal body weight|.magnitude)*100",
          "$gt0011|Actual body weight > IBW|.unit='%'"
        ]
      },
      "gt0012" : {
        "id" : "gt0012",
        "priority" : 1,
        "when" : [
          "$gt0017|Ideal body weight|.unit=='kg'",
          "$gt0005|Actual body weight|.unit=='kg'",
          "$gt0005|Actual body weight|.magnitude>$gt0017|Ideal body weight|.magnitude"
        ],
        "then" : [
          "$gt0008|Adjusted Body Weight|.unit='kg'",
          "$gt0008|Adjusted Body Weight|.magnitude=$gt0017|Ideal body weight|.magnitude+0.4*($gt0005|Actual body weight|.magnitude-$gt0017|Ideal body weight|.magnitude)",
          "$gt0011|Actual body weight > IBW|.magnitude=($gt0005|Actual body weight|.magnitude/$gt0017|Ideal body weight|.magnitude)*100",
          "$gt0011|Actual body weight > IBW|.unit='%'"
        ]
      }
    }
  },
