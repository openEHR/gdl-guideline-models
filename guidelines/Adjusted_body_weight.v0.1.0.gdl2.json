    ],
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate adjusted body weight (ABW) from ideal body weight derived from the Devine formula and the patient's actual body weight in obese patients.",
        "keywords" : [
          "body weight",
          "weight",
          "actual body weight",
          "ideal body weight",
          "adjusted body weight",
          "gender",
          "obesity",
          "height"
        ],
        "use" : "Ideal Body Weight (Devine formula):\n\nIdeal body weight (IBW) (men) = 50 kg + 2.3 kg x (height, in - 60)\n\nIdeal body weight (IBW) (women) = 45.5 kg + 2.3 kg x  (height, in - 60)\n\nIn obese patients, actual body weight is more than the ideal body weight. To calculate dosage for medications which are weight-based, adjusted body weight is used in these patients.\n\nAdjusted Body Weight (ABW), for use in obese patients (where actual body weight > IBW): ABW = IBW + 0.4 x (actual body weight - IBW)",
        "misuse" : "Use Adjusted Body Weight (ABW) only when actual body weight > ideal body weight.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Devine BJ. Gentamicin therapy. Drug Intell Clin Pharm. 1974;8(10):650-5.",
      "en" : "Adjusted body weight is calculated from ideal body weight and actual body weight, when actual > ideal."
    }
  },
