    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "This tool helps to calculate the value of the anion gap, corrected anion gap and delta gap used in assessing an anion-gap metabolic acidosis.",
        "keywords" : [
          "Anion",
          "gap",
          "acidosis"
        ],
        "use" : "Use when serum albumin and urea and electrolytes are available to generate a calcuation of the anion gap both with and without adjustment from the serum albumin value. The delta gap and delta ratio can also be calculated from these values, which helps to provide further information about the type of acidosis.\n\nFormulae:  \n-  Anion Gap (AG) = Na - (Cl + HCO3-)\n-  Corrected Anion Gap = Anion Gap + (2.5 * (40 - Albumin))   \n-  Delta Gap = Anion Gap - 12 (nl anion gap)\\n   - Delta ratio = (AG – 12)/(24 - [HCO3-])",
        "misuse" : "Do not use on its own for diagnostic purposes.",
        "copyright" : "Cambio Healthcare Systems"
      }
    },
    "other_details" : {
      "references" : "Oh MS, Carroll HJ. The anion gap. N. Engl. J. Med. 1977; 297 (15): 814–7.doi:10.1056/NEJM197710132971507. PMID 895822",
      "en" : "Anion gap calculation"
    }
  },
