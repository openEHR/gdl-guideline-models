    "rules" : {
      "gt0022" : {
        "id" : "gt0022",
        "priority" : 1,
        "when" : [
          "$gt0004|Sodium (Na+)|!=null",
          "$gt0007|Bicarbonate (HCO3-)|!=null",
          "$gt0010|Chloride (Cl-)|!=null",
          "$gt0013|Potassium (K+)|!=null"
        ],
        "then" : [
          "$gt0015|Anion gap|.magnitude=($gt0004|Sodium (Na+)|.magnitude+$gt0013|Potassium (K+)|.magnitude)-($gt0007|Bicarbonate (HCO3-)|.magnitude+$gt0010|Chloride (Cl-)|.magnitude)",
          "$gt0015|Anion gap|.unit='mmol/l'",
          "$gt0015|Anion gap|.precision=2"
        ]
      }
    }
