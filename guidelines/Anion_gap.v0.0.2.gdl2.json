    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the anion gap based on serum electrolyte concentrations.",
        "keywords" : [
          "Anion",
          "gap",
          "acidosis",
          "metabolic",
          "sodium",
          "chloride",
          "bicarbonate",
          "electrolytes",
          "nephrology"
        ],
        "use" : "Use to calculate the anion gap to aid in the evaluation of metabolic acidosis.\n\nFormula:  \n\nAnion Gap (AG) = ((Na+) + (K+)) - ((Cl-) + (HCO3-))",
        "misuse" : "Do not use on its own for diagnostic purposes.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Oh MS, Carroll HJ. The anion gap. N. Engl. J. Med. 1977; 297 (15): 814–7.doi:10.1056/NEJM197710132971507. PMID 895822\n\nEmmett M, Narins RG. Clinical use of the anion gap. Medicine (Baltimore). 1977 Jan;56(1):38-54. PMID: 401925.\n\nThe anion gap. Lancet. 1977 Jun 18;1(8025):1304-5. PMID: 68397.\n\nKraut JA, Madias NE. Serum anion gap: its uses and limitations in clinical medicine. Clin J Am Soc Nephrol. 2007 Jan;2(1):162-74. doi: 10.2215/CJN.03020906. Epub 2006 Dec 6. PMID: 17699401.",
      "en" : "Anion gap calculation"
    }
  },
