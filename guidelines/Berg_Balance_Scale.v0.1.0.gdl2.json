    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the total score for the Berg Balance Scale and derive a fall risk interpretation.",
        "keywords" : [
          "Berg",
          "balance",
          "scale",
          "stroke",
          "Parkinson",
          "multiple",
          "sclerosis",
          "fall",
          "risk",
          "traumatic",
          "brain",
          "injury",
          "lower",
          "extremity",
          "amputation",
          "functional",
          "rehabilitation"
        ],
        "use" : "Berg Balance Scale evaluates both dynamic and static balance through 14 mobility-related tasks. Each task is graded on a 5-point ordinal scale that ranges from 0 to 4 for a maximum score of 56.\n\nInputs:\n- Sitting unsupported\n-  Standing unsupported\n- Standing with eyes closed\n- Standing with feet together\n- Standing on one foot\n- Turning to look behind\n- Grab an object from the floor\n- Reaching forward with outstretched arms while standing\n- Placing one foot in front of the other\n- Going from sitting to standing\n- Going from standing to sitting\n- Transfer from a seat with an armrest to a seat without an armrest\n- Turn 360 degrees\n- Place alternating foot on a step or stool while standing unsupported\n\nOutputs:\n- Total score\n- Fall risk ( BBS ≥45: Not increased; BBS &lt;45: Increased)",
        "misuse" : "Not to be used for general fall risk assessment without completing the full Berg Balance Scale.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Bogle Thorbahn LD, Newton RA. Use of the Berg Balance Test to predict falls in elderly persons. Phys Ther. 1996 Jun;76(6):576-83; discussion 584-5. doi: 10.1093/ptj/76.6.576. PMID: 8650273.\n\nBerg KO, Wood-Dauphinee SL, Williams JI, Maki B. Measuring balance in the elderly: validation of an instrument. Can J Public Health. 1992 Jul-Aug;83 Suppl 2:S7-11. PMID: 1468055.\n\nMiranda N, Tiu TK. Berg Balance Testing. 2023 Feb 17. In: StatPearls [Internet]. Treasure Island (FL): StatPearls Publishing; 2025 Jan–. PMID: 34662032.",
      "en" : "The Berg Balance Scale is a test used to assess functional balance. It can be used to assess patients with stroke or various neurological conditions, such as Parkinson’s disease, multiple sclerosis, traumatic brain injury, as well as acquired conditions like lower extremity amputation."
    }
  },
