    "rules" : {
      "gt0042" : {
        "id" : "gt0042",
        "priority" : 3,
        "when" : [
          "$gt0024|Sitting unsupported|!=null",
          "$gt0025|Standing unsupported|!=null",
          "$gt0026|Standing with eyes closed|!=null",
          "$gt0027|Standing with feet together|!=null",
          "$gt0028|Standing on one leg|!=null",
          "$gt0029|Turning to look behind|!=null",
          "$gt0030|Grab an object from the floor|!=null",
          "$gt0031|Reaching forward with outstretched arms while standing|!=null",
          "$gt0032|Placing one foot in front of the other|!=null",
          "$gt0033|Going from sitting to standing|!=null",
          "$gt0034|Going from standing to sitting|!=null",
          "$gt0035|Transfer from a seat with an armrest to a seat without an armrest|!=null",
          "$gt0036|Turn 360 degrees|!=null",
          "$gt0037|Place alternating foot on a step or stool while standing unsupported|!=null"
        ],
        "then" : [
          "$gt0039|Total score|.magnitude=$gt0024|Sitting unsupported|.value+$gt0025|Standing unsupported|.value+$gt0026|Standing with eyes closed|.value+$gt0027|Standing with feet together|.value+$gt0028|Standing on one leg|.value+$gt0029|Turning to look behind|.value+$gt0030|Grab an object from the floor|.value+$gt0031|Reaching forward with outstretched arms while standing|.value+$gt0032|Placing one foot in front of the other|.value+$gt0033|Going from sitting to standing|.value+$gt0034|Going from standing to sitting|.value+$gt0035|Transfer from a seat with an armrest to a seat without an armrest|.value+$gt0036|Turn 360 degrees|.value+$gt0037|Place alternating foot on a step or stool while standing unsupported|.value"
        ]
      },
      "gt0045" : {
        "id" : "gt0045",
        "priority" : 2,
        "when" : [
          "$gt0039|Total score|>=45"
        ],
        "then" : [
          "$gt0041|Fall risk|=$gt0043|Not increased|.term"
        ]
      },
      "gt0046" : {
        "id" : "gt0046",
        "priority" : 1,
        "when" : [
          "$gt0039|Total score|<45"
        ],
        "then" : [
          "$gt0041|Fall risk|=$gt0044|Increased|.term"
        ]
      }
    }
