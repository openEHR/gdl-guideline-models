{
  "uuid" : "4bb1f7f4-94fc-4055-be02-c38afe97062d",
  "id" : "Body_Roundness_Index.v0.0.1",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Kevin Arjona",
      "email" : "kevin.arjona@cambio.se",
      "organisation" : "Cambio CDS",
      "date" : "2026-08-04"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the BRI using height and waist circumference.",
        "keywords" : [
          "BRI",
          "body",
          "roundness ",
          "index",
          "anthropometry",
          "obesity",
          "cardiovascular",
          "risk",
          "metabolic"
        ],
        "use" : "Use to calculate BRI to quantify body shape and evaluate visceral adiposity and cardiovascular/metabolic health risk.\n\nFormula.\n\nBRI = 364.2 - 365.5 * sqrt( 1 - ( (Waist / (2 * pi))^2 / (0.5 * Height)^2",
        "misuse" : "Do not use in patients under 20 years old",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Thomas DM, Bredlau C, Bosy-Westphal A, Mueller M, Shen W, Gallagher D, Maeda Y, McDougall A, Peterson CM, Ravussin E, Heymsfield SB. Relationships between body roundness with body fat and visceral adipose tissue emerging from a new geometrical model. Obesity (Silver Spring). 2013 Nov;21(11):2264-71. doi: 10.1002/oby.20408. Epub 2013 Jun 11. PMID: 23519954; PMCID: PMC3692604.\n\nRico-Martín S, Calderón-García JF, Sánchez-Rey P, Franco-Antonio C, Martínez Alvarez M, Sánchez Muñoz-Torrero JF. Effectiveness of body roundness index in predicting metabolic syndrome: A systematic review and meta-analysis. Obes Rev. 2020 Jul;21(7):e13023. doi: 10.1111/obr.13023. Epub 2020 Apr 8. PMID: 32267621.\n\nZhang X, Ma N, Lin Q, Chen K, Zheng F, Wu J, Dong X, Niu W. Body Roundness Index and All-Cause Mortality Among US Adults. JAMA Netw Open. 2024 Jun 3;7(6):e2415051. doi: 10.1001/jamanetworkopen.2024.15051. Erratum in: JAMA Netw Open. 2024 Jul 1;7(7):e2426540. doi: 10.1001/jamanetworkopen.2024.26540. PMID: 38837158; PMCID: PMC11154161.",
      "en" : "The Body Roundness Index (BRI) is employed in routine health screenings to assess body shape and estimate body fat, identifying individuals at increased risk of obesity-related conditions and all-cause mortality."
    }
  },
  "definition" : {
    "data_bindings" : {
      "gt0002" : {
        "id" : "gt0002",
        "model_id" : "openEHR-EHR-OBSERVATION.height.v2",
        "template_id" : "openEHR-EHR-OBSERVATION.height.v2",
        "type" : "INPUT",
        "elements" : {
          "gt0003" : {
            "id" : "gt0003",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "cm"
            ]
          }
        }
      },
      "gt0005" : {
        "id" : "gt0005",
        "model_id" : "openEHR-EHR-OBSERVATION.waist_circumference.v1",
        "template_id" : "openEHR-EHR-OBSERVATION.waist_circumference.v1",
        "type" : "INPUT",
        "elements" : {
          "gt0006" : {
            "id" : "gt0006",
            "path" : "/data[at0001]/events[at0010]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "cm"
            ]
          }
        }
      },
      "gt0009" : {
        "id" : "gt0009",
        "model_id" : "openEHR-EHR-EVALUATION.body_roundness_index.v0",
        "template_id" : "openEHR-EHR-EVALUATION.body_roundness_index.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0010" : {
            "id" : "gt0010",
            "path" : "/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "1"
            ]
          },
          "gt0011" : {
            "id" : "gt0011",
            "path" : "/data[at0003]/items[at0005]",
            "data_type" : "DV_CODED_TEXT"
          }
        }
      }
    },
    "rules" : {
      "gt0004" : {
        "id" : "gt0004",
        "priority" : 6,
        "when" : [
          "$gt0003|Height/Length|!=null",
          "$gt0006|Waist circumference|!=null"
        ],
        "then" : [
          "$gt0010|BRI|.magnitude=364.2-(365.5*((1-(($gt0006|Waist circumference|.magnitude/(2*3.1416))^2)/((0.5*$gt0003|Height/Length|.magnitude)^2))^0.5))",
          "$gt0010|BRI|.precision=2"
        ]
      },
      "gt0012" : {
        "id" : "gt0012",
        "priority" : 5,
        "when" : [
          "$gt0010|BRI|>=1.05",
          "$gt0010|BRI|<3.41"
        ],
        "then" : [
          "$gt0011|HR of All-Cause Mortality (95%CI)|=local::at0006|0.57 (0.49-0.67)|"
        ]
      },
      "gt0013" : {
        "id" : "gt0013",
        "priority" : 4,
        "when" : [
          "$gt0010|BRI|>=3.41",
          "$gt0010|BRI|<4.45"
        ],
        "then" : [
          "$gt0011|HR of All-Cause Mortality (95%CI)|=local::at0007|0.81 (0.69-0.95)|"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 3,
        "when" : [
          "$gt0010|BRI|>=4.45",
          "$gt0010|BRI|<5.46"
        ],
        "then" : [
          "$gt0011|HR of All-Cause Mortality (95%CI)|=local::at0008|1 (reference)|"
        ]
      },
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 2,
        "when" : [
          "$gt0010|BRI|>=5.46",
          "$gt0010|BRI|<6.91"
        ],
        "then" : [
          "$gt0011|HR of All-Cause Mortality (95%CI)|=local::at0009|1.48 (1.30-1.69)|"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 1,
        "when" : [
          "$gt0010|BRI|>=6.91"
        ],
        "then" : [
          "$gt0011|HR of All-Cause Mortality (95%CI)|=local::at0010|1.62 (1.42-1.85)|"
        ]
      }
    }
  },
