{
  "uuid" : "",
  "id" : "Body_surface_area_dosing_calculation.v0.0.1-draft",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Kevin Arjona",
      "email" : "kevin.arjona@cambio.se",
      "organisation" : "Cambio CDS",
      "date" : "2026-04-13"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : " To calculate estimated body surface area using the Mosteller, Du Bois and Haycock formulas. ",
        "keywords" : [
          "body",
          "surface",
          "area",
          "dubois",
          "mosteller",
          "haycock",
          "bsa",
          "weight",
          "height",
          "formula"
        ],
        "use" : "Use the most recent height and weight measurements to ensure accuracy.\n\nUse in conjunction with other assessments and patient history.\n\nUse of this formula is less precise for neonates and infants, as well as for individuals at extreme values of height and weight.\n\nUse for calculating dosages for medications, such as chemotherapy, and measuring cardiac index.\n\nUse for calculating the BSA based on the following formulas.  \n\nDu Bois formula: weight (kg)^0.425 × height (cm)^0.725 × 0.007184\n\nMosteller formula: (Height(cm) x Weight(kg) / 3600 ) ^½. \n\nHaycock formula: 0,024265 x Weight(kg)^0,5378 x Height(cm)^0,3964",
        "misuse" : "Not to be used for calculating BSA based on other formulas. ",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Du Bois D, Du Bois EF. A formula to estimate the approximate surface area if height and weight be known. 1916. Nutrition. 1989 Sep-Oct;5(5):303-11; discussion 312-3. PMID: 2520314.\n\nMosteller RD. Simplified calculation of body-surface area. N Engl J Med. 1987 Oct 22;317(17):1098. doi: 10.1056/NEJM198710223171717. PMID: 3657876.\n\nWu Q, Zhou Y, Fan X, Ma H, Gu W, Sun F. Evaluation of nine formulas for estimating the body surface area of children with hematological malignancies. Front Pediatr. 2022 Sep 7;10:989049. doi: 10.3389/fped.2022.989049. PMID: 36160791; PMCID: PMC9489993.",
      "en" : "A  calculation score used to estimate an individual's total external surface area using the Mosteller, Du Bois and Haycock formulas. "
    }
  },
  "definition" : {
    "data_bindings" : {
      "gt0002" : {
        "id" : "gt0002",
        "model_id" : "openEHR-EHR-OBSERVATION.body_weight.v2",
        "template_id" : "openEHR-EHR-OBSERVATION.body_weight.v2",
        "type" : "INPUT",
        "elements" : {
          "gt0003" : {
            "id" : "gt0003",
            "path" : "/data[at0002]/events[at0003]/data[at0001]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "kg",
              "[lb_av]",
              "g"
            ]
          }
        }
      },
      "gt0004" : {
        "id" : "gt0004",
        "model_id" : "openEHR-EHR-OBSERVATION.height.v2",
        "template_id" : "openEHR-EHR-OBSERVATION.height.v2",
        "type" : "INPUT",
        "elements" : {
          "gt0005" : {
            "id" : "gt0005",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "cm",
              "[in_i]"
            ]
          }
        }
      },
      "gt0006" : {
        "id" : "gt0006",
        "model_id" : "openEHR-EHR-OBSERVATION.body_surface_area.v1",
        "template_id" : "openEHR-EHR-OBSERVATION.body_surface_area.v1",
        "type" : "OUTPUT",
        "elements" : {
          "gt0007" : {
            "id" : "gt0007",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "m2"
            ]
          }
        }
      },
      "gt0008" : {
        "id" : "gt0008",
        "model_id" : "openEHR-EHR-CLUSTER.dosage.v2",
        "template_id" : "openEHR-EHR-CLUSTER.dosage.v2",
        "type" : "INPUT",
        "elements" : {
          "gt0009" : {
            "id" : "gt0009",
            "path" : "/items[at0144]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "g",
              "mg"
            ]
          }
        }
      },
      "gt0010" : {
        "id" : "gt0010",
        "model_id" : "openEHR-EHR-OBSERVATION.coronavirus_anxiety_scale.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.coronavirus_anxiety_scale.v0",
        "type" : "INPUT",
        "elements" : {
          "gt0011" : {
            "id" : "gt0011",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0005]",
            "data_type" : "DV_ORDINAL",
            "allowed_values" : [
              "0|local::at0006",
              "1|local::at0007",
              "2|local::at0008",
              "3|local::at0009",
              "4|local::at0010"
            ]
          }
        }
      }
    },
    "pre_conditions" : [
      "$gt0003|Weight|!=null",
      "$gt0005|Height/Length|!=null"
    ],
    "rules" : {
      "gt0012" : {
        "id" : "gt0012",
        "priority" : 6,
        "when" : [
          "$gt0003|Weight|.unit=='kg'",
          "$gt0005|Height/Length|.unit=='cm'",
          "$gt0011|I felt dizzy, lightheaded, or faint when I read or listened to news about the coronavirus|==0|local::at0006|Not at all|"
        ],
        "then" : [
          "$gt0007|Body Surface Area|.magnitude=(($gt0003|Weight|.magnitude^0.425)*($gt0005|Height/Length|.magnitude^0.725))*0.007184",
          "$gt0007|Body Surface Area|.precision=2",
          "$gt0007|Body Surface Area|.unit='m2'"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 5,
        "when" : [
          "$gt0003|Weight|.unit=='kg'",
          "$gt0005|Height/Length|.unit=='cm'",
          "$gt0011|I felt dizzy, lightheaded, or faint when I read or listened to news about the coronavirus|==1|local::at0007|Rare, less than a day or two|"
        ],
        "then" : [
          "$gt0007|Body Surface Area|.magnitude=($gt0003|Weight|.magnitude*$gt0005|Height|.magnitude/3600)^0.5",
          "$gt0007|Body Surface Area|.precision=2",
          "$gt0007|Body Surface Area|.unit='m2'"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 4,
        "when" : [
          "$gt0003|Weight|.unit=='kg'",
          "$gt0005|Height/Length|.unit=='cm'",
          "$gt0011|I felt dizzy, lightheaded, or faint when I read or listened to news about the coronavirus|==2|local::at0008|Several days|"
        ],
        "then" : [
          "$gt0007|Body Surface Area|.magnitude=0,024265*($gt0003|Weight|.magnitude^0.5378)*($gt0005|Height|.magnitude^0,3964)",
          "$gt0007|Body Surface Area|.precision=2",
          "$gt0007|Body Surface Area|.unit='m2'"
        ]
      },
      "gt0013" : {
        "id" : "gt0013",
        "priority" : 3,
        "when" : [
          "$gt0003|Weight|.unit=='[lb_av]'",
          "$gt0005|Height/Length|.unit=='[in_i]'",
          "$gt0011|I felt dizzy, lightheaded, or faint when I read or listened to news about the coronavirus|==0|local::at0006|Not at all|"
        ],
        "then" : [
          "$gt0007|Body Surface Area|.magnitude=(((($gt0003|Weight|.magnitude/2.2046)^0.425)*(($gt0005|Height/Length|.magnitude*2.54)^0.725))*0.007184)*10.764",
          "$gt0007|Body Surface Area|.precision=2",
          "$gt0007|Body Surface Area|.unit='[ft_i]2'"
        ]
      },
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 2,
        "when" : [
          "$gt0003|Weight|.unit=='[lb_av]'",
          "$gt0005|Height/Length|.unit=='[in_i]'",
          "$gt0011|I felt dizzy, lightheaded, or faint when I read or listened to news about the coronavirus|==1|local::at0007|Rare, less than a day or two|"
        ],
        "then" : [
          "$gt0007|Body Surface Area|.magnitude=(($gt0003|Weight|.magnitude*0.453592)*($gt0005|Height|.magnitude*2.54))/3131",
          "$gt0007|Body Surface Area|.precision=2",
          "$gt0007|Body Surface Area|.unit='[ft_i]2'"
        ]
      },
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 1,
        "when" : [
          "$gt0003|Weight|.unit=='[lb_av]'",
          "$gt0005|Height/Length|.unit=='[in_i]'",
          "$gt0011|I felt dizzy, lightheaded, or faint when I read or listened to news about the coronavirus|==2|local::at0008|Several days|"
        ],
        "then" : [
          "$gt0007|Body Surface Area|.magnitude=0.024265*($gt0003|Weight|.magnitude^0.3964)*($gt0005|Height|.magnitude^0.5378)",
          "$gt0007|Body Surface Area|.precision=2",
          "$gt0007|Body Surface Area|.unit='[ft_i]2'"
        ]
      }
    }
  },
