{
  "uuid" : "419a1ef7-ca53-4a4d-9fee-ede36d63908b",
  "id" : "Body_surface_area_dosing_calculation.v0.0.1",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Kevin Arjona",
      "email" : "kevin.arjona@cambio.se",
      "organisation" : "Cambio CDS",
      "date" : "2026-04-13"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : " To calculate estimated body surface area using the Mosteller, Du Bois and Haycock formulas. ",
        "keywords" : [
          "body",
          "surface",
          "area",
          "dubois",
          "mosteller",
          "haycock",
          "bsa",
          "weight",
          "height",
          "formula"
        ],
        "use" : "Use the most recent height and weight measurements to ensure accuracy.\n\nUse in conjunction with other assessments and patient history.\n\nUse of this formula is less precise for neonates and infants, as well as for individuals at extreme values of height and weight.\n\nUse for calculating dosages for medications, such as chemotherapy, and measuring cardiac index.\n\nUse for calculating the BSA based on the following formulas.  \n\nDu Bois formula: weight (kg)^0.425 × height (cm)^0.725 × 0.007184\n\nMosteller formula: (Height(cm) x Weight(kg) / 3600 ) ^½. \n\nHaycock formula: 0,024265 x Weight(kg)^0,5378 x Height(cm)^0,3964",
        "misuse" : "Not to be used for calculating BSA based on other formulas. ",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Du Bois D, Du Bois EF. A formula to estimate the approximate surface area if height and weight be known. 1916. Nutrition. 1989 Sep-Oct;5(5):303-11; discussion 312-3. PMID: 2520314.\n\nMosteller RD. Simplified calculation of body-surface area. N Engl J Med. 1987 Oct 22;317(17):1098. doi: 10.1056/NEJM198710223171717. PMID: 3657876.\n\nWu Q, Zhou Y, Fan X, Ma H, Gu W, Sun F. Evaluation of nine formulas for estimating the body surface area of children with hematological malignancies. Front Pediatr. 2022 Sep 7;10:989049. doi: 10.3389/fped.2022.989049. PMID: 36160791; PMCID: PMC9489993.",
      "en" : "A  calculation score used to estimate an individual's total external surface area using the Mosteller, Du Bois and Haycock formulas. "
    }
  },
  "definition" : {
    "data_bindings" : {
      "gt0002" : {
        "id" : "gt0002",
        "model_id" : "openEHR-EHR-OBSERVATION.body_weight.v2",
