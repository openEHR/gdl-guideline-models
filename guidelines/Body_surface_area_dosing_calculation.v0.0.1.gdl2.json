              "m2"
            ]
          }
        }
      },
      "gt0008" : {
        "id" : "gt0008",
        "model_id" : "openEHR-EHR-CLUSTER.dosage.v2",
        "template_id" : "openEHR-EHR-CLUSTER.dosage.v2",
        "type" : "INPUT",
        "elements" : {
          "gt0009" : {
            "id" : "gt0009",
            "path" : "/items[at0144]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "mg"
            ]
          }
        }
      },
      "gt0018" : {
        "id" : "gt0018",
        "model_id" : "openEHR-EHR-CLUSTER.dosage.v2",
        "template_id" : "openEHR-EHR-CLUSTER.dosage.v2",
        "type" : "OUTPUT",
        "elements" : {
          "gt0019" : {
            "id" : "gt0019",
            "path" : "/items[at0181]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "g",
              "mg"
            ]
          }
        }
      },
      "gt0021" : {
        "id" : "gt0021",
        "model_id" : "openEHR-EHR-OBSERVATION.body_surface_area_dosing.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.body_surface_area_dosing.v0",
        "type" : "INPUT",
        "elements" : {
          "gt0022" : {
            "id" : "gt0022",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0006]",
            "data_type" : "DV_CODED_TEXT",
            "allowed_values" : [
              "local::at0008",
              "local::at0009",
              "local::at0010"
            ]
          }
        }
      }
    },
    "pre_conditions" : [
      "$gt0003|Weight|!=null",
      "$gt0005|Height/Length|!=null",
      "$gt0009|Dosage (mg/m2)|!=null",
      "$gt0022|Formula|!=null"
    ],
    "rules" : {
      "gt0012" : {
        "id" : "gt0012",
        "priority" : 4,
        "when" : [
          "$gt0003|Weight|.unit=='kg'",
          "$gt0005|Height/Length|.unit=='cm'",
          "$gt0022|Formula|==local::at0008|Du Bois|"
        ],
        "then" : [
          "$gt0007|Body Surface Area|.magnitude=(($gt0003|Weight|.magnitude^0.425)*($gt0005|Height/Length|.magnitude^0.725))*0.007184",
          "$gt0007|Body Surface Area|.precision=2",
          "$gt0007|Body Surface Area|.unit='m2'"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 3,
        "when" : [
          "$gt0003|Weight|.unit=='kg'",
          "$gt0005|Height/Length|.unit=='cm'",
          "$gt0022|Formula|==local::at0009|Mosteller|"
        ],
        "then" : [
          "$gt0007|Body Surface Area|.magnitude=($gt0003|Weight|.magnitude*$gt0005|Height|.magnitude/3600)^0.5",
          "$gt0007|Body Surface Area|.precision=2",
          "$gt0007|Body Surface Area|.unit='m2'"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 2,
        "when" : [
          "$gt0003|Weight|.unit=='kg'",
          "$gt0005|Height/Length|.unit=='cm'",
          "$gt0022|Formula|==local::at0010|Haycock|"
        ],
        "then" : [
          "$gt0007|Body Surface Area|.magnitude=0.024265*($gt0003|Weight|.magnitude^0.5378)*($gt0005|Height|.magnitude^0.3964)",
          "$gt0007|Body Surface Area|.precision=2",
          "$gt0007|Body Surface Area|.unit='m2'"
        ]
      },
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 1,
        "when" : [
          "$gt0007|Body Surface Area|!=null"
        ],
        "then" : [
          "$gt0019|Dosage /m2|.magnitude=$gt0009|Dosage (mg/m2)|.magnitude*$gt0007|Body Surface Area|.magnitude",
          "$gt0019|Dosage /m2|.precision=2",
          "$gt0019|Dosage /m2|.unit='mg'"
        ]
      }
    }
  },
