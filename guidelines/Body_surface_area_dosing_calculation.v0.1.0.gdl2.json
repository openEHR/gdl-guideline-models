        "model_id" : "openEHR-EHR-OBSERVATION.height.v2",
        "template_id" : "openEHR-EHR-OBSERVATION.height.v2",
        "type" : "INPUT",
        "elements" : {
          "gt0005" : {
            "id" : "gt0005",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "cm"
            ]
          }
        }
      },
      "gt0006" : {
        "id" : "gt0006",
        "model_id" : "openEHR-EHR-OBSERVATION.body_surface_area.v1",
        "template_id" : "openEHR-EHR-OBSERVATION.body_surface_area.v1",
        "type" : "OUTPUT",
        "elements" : {
          "gt0007" : {
            "id" : "gt0007",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "m2"
            ]
          }
        }
      },
      "gt0021" : {
        "id" : "gt0021",
        "model_id" : "openEHR-EHR-OBSERVATION.body_surface_area_dosing.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.body_surface_area_dosing.v0",
        "type" : "INPUT",
        "elements" : {
          "gt0022" : {
            "id" : "gt0022",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0006]",
            "data_type" : "DV_CODED_TEXT",
            "allowed_values" : [
              "local::at0008",
              "local::at0009",
              "local::at0010"
            ]
          }
        }
      },
      "gt0023" : {
        "id" : "gt0023",
        "model_id" : "openEHR-EHR-INSTRUCTION.medication_order.v3",
        "template_id" : "openEHR-EHR-INSTRUCTION.medication_order.v3",
        "type" : "INPUT",
        "elements" : {
          "gt0025" : {
            "id" : "gt0025",
            "path" : "/activities[at0001]/description[at0002]/items[at0129]/items[openEHR-EHR-CLUSTER.dosage.v2]/items[at0144]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "mg"
            ]
          }
        }
      },
      "gt0026" : {
        "id" : "gt0026",
        "model_id" : "openEHR-EHR-INSTRUCTION.medication_order.v3",
        "template_id" : "openEHR-EHR-INSTRUCTION.medication_order.v3",
        "type" : "OUTPUT",
        "elements" : {
          "gt0028" : {
            "id" : "gt0028",
            "path" : "/activities[at0001]/description[at0002]/items[at0129]/items[openEHR-EHR-CLUSTER.dosage.v2]/items[at0181]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "g",
              "mg"
            ]
          }
        }
      }
    },
    "pre_conditions" : [
      "$gt0003|Weight|!=null",
      "$gt0005|Height/Length|!=null",
      "$gt0025|Dosage (mg/m2)|!=null",
      "$gt0022|Formula|!=null"
    ],
    "rules" : {
      "gt0012" : {
        "id" : "gt0012",
        "priority" : 4,
        "when" : [
          "$gt0003|Weight|.unit=='kg'",
          "$gt0005|Height/Length|.unit=='cm'",
          "$gt0022|Formula|==local::at0008|Du Bois|"
        ],
        "then" : [
          "$gt0007|Body Surface Area|.magnitude=(($gt0003|Weight|.magnitude^0.425)*($gt0005|Height/Length|.magnitude^0.725))*0.007184",
          "$gt0007|Body Surface Area|.precision=2",
          "$gt0007|Body Surface Area|.unit='m2'"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 3,
        "when" : [
          "$gt0003|Weight|.unit=='kg'",
          "$gt0005|Height/Length|.unit=='cm'",
          "$gt0022|Formula|==local::at0009|Mosteller|"
        ],
        "then" : [
          "$gt0007|Body Surface Area|.magnitude=($gt0003|Weight|.magnitude*$gt0005|Height|.magnitude/3600)^0.5",
          "$gt0007|Body Surface Area|.precision=2",
          "$gt0007|Body Surface Area|.unit='m2'"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 2,
        "when" : [
          "$gt0003|Weight|.unit=='kg'",
          "$gt0005|Height/Length|.unit=='cm'",
          "$gt0022|Formula|==local::at0010|Haycock|"
        ],
        "then" : [
          "$gt0007|Body Surface Area|.magnitude=0.024265*($gt0003|Weight|.magnitude^0.5378)*($gt0005|Height|.magnitude^0.3964)",
          "$gt0007|Body Surface Area|.precision=2",
          "$gt0007|Body Surface Area|.unit='m2'"
        ]
      },
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 1,
        "when" : [
          "$gt0007|Body Surface Area|!=null"
        ],
        "then" : [
          "$gt0028|Dosage /m2|.magnitude=$gt0025|Dosage (mg/m2)|.magnitude*$gt0007|Body Surface Area|.magnitude",
          "$gt0028|Dosage /m2|.precision=2",
          "$gt0028|Dosage /m2|.unit='mg'"
        ]
      }
    }
  },
