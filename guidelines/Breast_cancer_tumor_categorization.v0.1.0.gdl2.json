  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Katja Mariko Wilde",
      "email" : "katja-wilde@t-online.de",
      "organisation" : "Cambio CDS",
      "date" : "2025-11-14"
    },
    "lifecycle_state" : "IN_REVIEW",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To determine the molecular subtype of invasive breast cancer by applying rule-based logic to recorded pathology and biomarker data (NHG grade, ER%, PR%, Ki-67%, HER2 IHC/ISH, and gene expression risk).",
        "keywords" : [
          "breast",
          "cancer",
          "tumor",
          "categorization",
          "molecular",
          "subtype",
          "ER",
          "PR",
          "HER2",
          "Ki-67",
          "NHG",
          "gene expression",
          "oncology"
        ],
        "use" : "Use to classify invasive breast cancer into molecular subtypes as defined in the Swedish National Breast Cancer Care Programme (Chapter 10 Kategorisering av tumören).\nThe guideline evaluates the following parameters:\n\nNHG grade: 1, 2, 3\n\nER status: Positive if ≥ 10% cells positive\n\nPR status: Positive if ≥ 10% cells positive\n\nKi-67 category: Low ≤ 5%, Intermediate 6–29%, High ≥ 30%\n\nHER2 amplification: Positive if IHC 3+ or IHC 2+ with (ISH ratio ≥ 2 and copies ≥ 4) or (ISH ratio &lt; 2 and copies ≥ 6)\n\nGene expression risk: Low-risk / High-risk\n\nBased on these inputs, the algorithm determines one of the following molecular subtypes:\n\nLow-risk luminal (HER2-)\n\nHigh-risk luminal (HER2-)\n\nHER2-positive luminal\n\nHER2-positive non-luminal\n\nTriple-negative\n\nA discordance advisory comment is triggered if NHG = 1 and Ki-67 High, or NHG = 3 and Ki-67 Low, suggesting case review and possible gene expression testing.",
        "misuse" : "Not to be used for recording information related to TNM staging, full histopathology reports, or treatment decisions.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Regionala cancercentrum i samverkan. Nationellt vårdprogram bröstcancer: Kapitel 10 Kategorisering av tumören. Kunskapsbanken, 2025. Available at: https://kunskapsbanken.cancercentrum.se/diagnoser/brostcancer/vardprogram/kategorisering-av-tumoren2/",
      "en" : "A categorization used to define invasive breast cancer into molecular subtypes based on histologic grade, estrogen receptor (ER), progesterone receptor (PR), HER2 status, Ki-67 proliferation index, and gene expression risk according to the Swedish National Breast Cancer Care Programme."
    }
  },
