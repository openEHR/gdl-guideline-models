    "rules" : {
      "gt0029" : {
        "id" : "gt0029",
        "priority" : 17,
        "when" : [
          "$gt0006|ER result|!=null",
          "$gt0006|ER result|.magnitude>=10"
        ],
        "then" : [
          "$gt0023|ER status|=local::at0004|Positive|"
        ]
      },
      "gt0030" : {
        "id" : "gt0030",
        "priority" : 16,
        "when" : [
          "$gt0006|ER result|!=null",
          "$gt0006|ER result|.magnitude<10"
        ],
        "then" : [
          "$gt0023|ER status|=local::at0005|Negative|"
        ]
      },
      "gt0031" : {
        "id" : "gt0031",
        "priority" : 15,
        "when" : [
          "$gt0009|PR result|!=null",
          "$gt0009|PR result|.magnitude>=10"
        ],
        "then" : [
          "$gt0024|PR status|=local::at0007|Positive|"
        ]
      },
      "gt0032" : {
        "id" : "gt0032",
        "priority" : 14,
        "when" : [
          "$gt0009|PR result|!=null",
          "$gt0009|PR result|.magnitude<10"
        ],
        "then" : [
          "$gt0024|PR status|=local::at0008|Negative|"
        ]
      },
      "gt0033" : {
        "id" : "gt0033",
        "priority" : 13,
        "when" : [
          "$gt0012|Ki-67 result|!=null",
          "$gt0012|Ki-67 result|.magnitude<=5"
        ],
        "then" : [
          "$gt0025|Ki-67 category|=local::at0010|Low ≤5%|"
        ]
      },
      "gt0034" : {
        "id" : "gt0034",
        "priority" : 12,
        "when" : [
          "$gt0012|Ki-67 result|!=null",
          "$gt0012|Ki-67 result|.magnitude>=6",
          "$gt0012|Ki-67 result|.magnitude<=29"
        ],
        "then" : [
          "$gt0025|Ki-67 category|=local::at0011|Intermediate 6-29%|"
        ]
      },
      "gt0035" : {
        "id" : "gt0035",
        "priority" : 11,
        "when" : [
          "$gt0012|Ki-67 result|!=null",
          "$gt0012|Ki-67 result|.magnitude>=30"
        ],
        "then" : [
          "$gt0025|Ki-67 category|=local::at0012|High ≥30%|"
        ]
      },
      "gt0036" : {
        "id" : "gt0036",
        "priority" : 10,
        "when" : [
          "($gt0018|HER2 IHC|==local::at0019|3+|)||($gt0018|HER2 IHC|==local::at0018|2+|&&$gt0019|HER2 ISH ratio|==local::at0021|≥ 2.0|&&$gt0020|HER2 copies per cell|==local::at0026|4.0 – 5.9|)||($gt0018|HER2 IHC|==local::at0018|2+|&&$gt0019|HER2 ISH ratio|==local::at0022|< 2.0|&&$gt0020|HER2 copies per cell|==local::at0027|≥ 6.0|)||($gt0018|HER2 IHC|==local::at0018|2+|&&$gt0019|HER2 ISH ratio|==local::at0021|≥ 2.0|&&$gt0020|HER2 copies per cell|==local::at0027|≥ 6.0|)"
        ],
        "then" : [
          "$gt0026|HER2 amplification|=local::at0014|Positive|"
        ]
      },
      "gt0037" : {
        "id" : "gt0037",
        "priority" : 9,
        "when" : [
          "($gt0018|HER2 IHC|==local::at0015|0|)||($gt0018|HER2 IHC|==local::at0016|0+|)||($gt0018|HER2 IHC|==local::at0017|1+|)||($gt0018|HER2 IHC|==local::at0018|2+|&&$gt0019|HER2 ISH ratio|==local::at0022|< 2.0|&&$gt0020|HER2 copies per cell|==local::at0025|< 4.0|)||($gt0018|HER2 IHC|==local::at0018|2+|&&$gt0019|HER2 ISH ratio|==local::at0022|< 2.0|&&$gt0020|HER2 copies per cell|==local::at0026|4.0 – 5.9|)||($gt0018|HER2 IHC|==local::at0018|2+|&&$gt0019|HER2 ISH ratio|==local::at0021|≥ 2.0|&&$gt0020|HER2 copies per cell|==local::at0025|< 4.0|)"
        ],
        "then" : [
          "$gt0026|HER2 amplification|=local::at0015|Negative|"
        ]
      },
      "gt0038" : {
        "id" : "gt0038",
        "priority" : 8,
        "when" : [
          "$gt0023|ER status|!=null",
          "$gt0024|PR status|!=null",
          "$gt0026|HER2 amplification|!=null",
          "$gt0023|ER status|==local::at0005|Negative|",
          "$gt0024|PR status|==local::at0008|Negative|",
          "$gt0026|HER2 amplification|==local::at0015|Negative|"
        ],
        "then" : [
          "$gt0027|Molecular subtype|=local::at0017|Triple-negative|"
        ]
      },
      "gt0039" : {
        "id" : "gt0039",
        "priority" : 7,
        "when" : [
          "$gt0023|ER status|!=null",
          "$gt0024|PR status|!=null",
          "$gt0026|HER2 amplification|!=null",
          "$gt0023|ER status|==local::at0005|Negative|",
          "$gt0024|PR status|==local::at0008|Negative|",
          "$gt0026|HER2 amplification|==local::at0014|Positive|"
        ],
        "then" : [
          "$gt0027|Molecular subtype|=local::at0018|HER2-positive / Non-luminal|"
        ]
      },
      "gt0040" : {
        "id" : "gt0040",
        "priority" : 6,
        "when" : [
          "$gt0023|ER status|!=null",
          "$gt0024|PR status|!=null",
          "$gt0026|HER2 amplification|!=null",
          "$gt0023|ER status|==local::at0004|Positive|",
          "$gt0026|HER2 amplification|==local::at0014|Positive|"
        ],
        "then" : [
          "$gt0027|Molecular subtype|=local::at0019|HER2-positive / Luminal|"
        ]
      },
      "gt0041" : {
        "id" : "gt0041",
        "priority" : 5,
        "when" : [
          "$gt0023|ER status|!=null",
          "$gt0017|NHG grade|!=null",
          "$gt0026|HER2 amplification|!=null",
          "$gt0023|ER status|==local::at0004|Positive|",
          "$gt0026|HER2 amplification|==local::at0015|Negative|",
          "($gt0017|NHG grade|==local::at0011|Grade 1|)||($gt0017|NHG grade|==local::at0012|Grade 2|&&$gt0025|Ki-67 category|==local::at0010|Low ≤5%|)||($gt0021|Gene expression risk|==local::at0030|Low-risk|)"
        ],
        "then" : [
          "$gt0027|Molecular subtype|=local::at0020|Luminal A, low-risk luminal (HER-negative)|"
        ]
      },
      "gt0042" : {
        "id" : "gt0042",
        "priority" : 4,
        "when" : [
          "$gt0023|ER status|!=null",
          "$gt0017|NHG grade|!=null",
          "$gt0026|HER2 amplification|!=null",
          "$gt0023|ER status|==local::at0004|Positive|",
          "$gt0026|HER2 amplification|==local::at0015|Negative|",
          "($gt0017|NHG grade|==local::at0013|Grade 3|)||($gt0017|NHG grade|==local::at0012|Grade 2|&&$gt0025|Ki-67 category|==local::at0012|High ≥30%|)||($gt0021|Gene expression risk|==local::at0031|High-risk|)"
        ],
        "then" : [
          "$gt0027|Molecular subtype|=local::at0021|Luminal B, high-risk luminal (HER-negative)|"
        ]
      },
      "gt0043" : {
        "id" : "gt0043",
        "priority" : 3,
        "when" : [
          "($gt0017|NHG grade|==local::at0011|Grade 1|&&$gt0025|Ki-67 category|==local::at0012|High ≥30%|)||($gt0017|NHG grade|==local::at0013|Grade 3|&&$gt0025|Ki-67 category|==local::at0010|Low ≤5%|)"
        ],
        "then" : [
          "$gt0028|Discordance flag|=$gt0044|Grade/Ki-67 discordance – recommend case review and consider gene expression testing.|.term"
        ]
      },
      "gt0045" : {
        "id" : "gt0045",
        "priority" : 2,
        "when" : [
          "$gt0027|Molecular subtype|==null"
        ],
        "then" : [
          "$gt0028|Discordance flag|=$gt0046|Molecular subtype could not be categorized based on ER, PR, HER2, grade, Ki-67 and gene expression risk.|.term"
        ]
      },
      "gt0047" : {
        "id" : "gt0047",
        "priority" : 1,
        "when" : [
          "($gt0017|NHG grade|==local::at0011|Grade 1|&&$gt0025|Ki-67 category|==local::at0012|High ≥30%|)||($gt0017|NHG grade|==local::at0013|Grade 3|&&$gt0025|Ki-67 category|==local::at0010|Low ≤5%|)",
          "$gt0027|Molecular subtype|==null"
        ],
        "then" : [
          "$gt0028|Discordance flag|=$gt0048|Grade/Ki-67 discordance – recommend case review and consider gene expression testing. Molecular subtype could not be categorized based on ER, PR, HER2, grade, Ki-67 and gene expression risk.|.term"
        ]
      }
    }
  },
