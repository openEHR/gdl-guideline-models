{"uuid": "3ef4832f-92b3-457f-b2ac-6735045de596", "id": "Brinavess_infusion.v0.1.0", "gdl_version": "2.1", "concept": "gt0001", "language": {"original_language": "ISO_639-1::en"}, "description": {"original_author": {"name": "Kevin Arjona", "email": "kevin.arjona@cambio.se", "organisation": "Cambio CDS", "date": "2026-03-17"}, "lifecycle_state": "PUBLISHED", "details": {"en": {"id": "en", "purpose": "To calculate and record the appropriate initial and, if needed, secondary dose of Brinavess for the rapid conversion of recent onset atrial fibrillation to sinus rhythm.", "keywords": ["vernakalant", "dosage", "brinavess", "atrial", "fibrillation", "dosing", "antiarrhythmic", "infusion"], "use": "Use to calculate the weight-based dosing for Brinavess.\n\nInitial dose: 3 mg/kg.\n\nSecond dose (if sinus rhythm is not restored 15 minutes after the first infusion): 2 mg/kg.\n", "misuse": "Not to be used for patients with severe aortic stenosis, systolic blood pressure &lt; 100 mmHg, or heart failure (NYHA III-IV). Not to be used for children (&lt; 18 years).", "copyright": "© Cambio CDS"}}, "other_details": {"references": "FASS Vårdpersonal [Internet]. Brinavess (Vernakalant); [cited 2026 Mar 17]. Available from: https://fass.se/health/product/20090911000033/fass-text\n\nInternetmedicin.se - Brinavessdos kalkylator. Available from: https://verktyg.internetmedicin.se/kalkylatorer/brinavessdos", "en": "Calculation of the recommended first and second infusion doses of Brinavess (vernakalant) based on patient body weight."}}, "definition": {"data_bindings": {"gt0005": {"id": "gt0005", "model_id": "openEHR-EHR-OBSERVATION.body_weight.v2", "template_id": "openEHR-EHR-OBSERVATION.body_weight.v2", "type": "INPUT", "elements": {"gt0006": {"id": "gt0006", "path": "/data[at0002]/events[at0003]/data[at0001]/items[at0004]", "data_type": "DV_QUANTITY", "units": ["kg"]}}}, "gt0017": {"id": "gt0017", "model_id": "openEHR-EHR-OBSERVATION.brinavess_infusion.v0", "template_id": "openEHR-EHR-OBSERVATION.brinavess_infusion.v0", "type": "OUTPUT", "elements": {"gt0012": {"id": "gt0012", "path": "/data[at0001]/events[at0002]/data[at0003]/items[at0004]", "data_type": "DV_QUANTITY", "units": ["mg"]}, "gt0019": {"id": "gt0019", "path": "/data[at0001]/events[at0002]/data[at0003]/items[at0005]", "data_type": "DV_QUANTITY", "units": ["mL/h"]}, "gt0022": {"id": "gt0022", "path": "/data[at0001]/events[at0002]/data[at0003]/items[at0010]", "data_type": "DV_QUANTITY", "units": ["mL"]}, "gt0013": {"id": "gt0013", "path": "/data[at0001]/events[at0002]/data[at0003]/items[at0006]", "data_type": "DV_QUANTITY", "units": ["mg"]}, "gt0021": {"id": "gt0021", "path": "/data[at0001]/events[at0002]/data[at0003]/items[at0007]", "data_type": "DV_QUANTITY", "units": ["mL/h"]}, "gt0023": {"id": "gt0023", "path": "/data[at0001]/events[at0002]/data[at0003]/items[at0011]", "data_type": "DV_QUANTITY", "units": ["mL"]}}}}, "pre_conditions": ["$gt0006|Weight|!=null"], "rules": {"gt0007": {"id": "gt0007", "priority": 3, "when": ["$gt0006|Weight|.magnitude<113"], "then": ["$gt0012|Initial dose|.magnitude=$gt0006|Weight|.magnitude*3", "$gt0012|Initial dose|.unit='mg'", "$gt0012|Initial dose|.precision=1", "$gt0022|Initial infusion volume|.magnitude=($gt0006|Weight|.magnitude*3)/4", "$gt0022|Initial infusion volume|.unit='mL'", "$gt0022|Initial infusion volume|.precision=1", "$gt0013|Second dose|.magnitude=$gt0006|Weight|.magnitude*2", "$gt0013|Second dose|.precision=1", "$gt0013|Second dose|.unit='mg'", "$gt0023|Second infusion volume|.magnitude=($gt0006|Weight|.magnitude*2)/4", "$gt0023|Second infusion volume|.unit='mL'", "$gt0023|Second infusion volume|.precision=1"]}, "gt0024": {"id": "gt0024", "priority": 2, "when": ["$gt0006|Weight|.magnitude<113", "$gt0022|Initial infusion volume|!=null", "$gt0023|Second infusion volume|!=null"], "then": ["$gt0019|Initial infusion rate|.magnitude=$gt0022|Initial infusion volume|.magnitude*6", "$gt0021|Second infusion rate|.magnitude=$gt0023|Second infusion volume|.magnitude*6", "$gt0019|Initial infusion rate|.precision=1", "$gt0021|Second infusion rate|.precision=1", "$gt0019|Initial infusion rate|.unit='mL/h'", "$gt0021|Second infusion rate|.unit='mL/h'"]}, "gt0008": {"id": "gt0008", "priority": 1, "when": ["$gt0006|Weight|.magnitude>=113"], "then": ["$gt0012|Initial dose|=339,mg", "$gt0022|Initial infusion volume|=84.7,mL", "$gt0019|Initial infusion rate|=508.5,mL/h", "$gt0013|Second dose|=226,mg", "$gt0023|Second infusion volume|=56.5,mL", "$gt0021|Second infusion rate|=339,mL/h"]}}}, "ontology": {"term_definitions": {"en": {"id": "en", "terms": {"gt0001": {"id": "gt0001", "text": "Brinavess infusion", "description": "Calculation of the recommended first and second infusion doses of Brinavess (vernakalant) based on patient body weight."}, "gt0005": {"id": "gt0005", "text": "openEHR-EHR-OBSERVATION.body_weight.v2"}, "gt0006": {"id": "gt0006", "text": "Weight"}, "gt0007": {"id": "gt0007", "text": "Infusion dose and volume  <113 kg", "description": "The drug is diluted to a concentration of 4 mg/ml before infusion for 10 minutes"}, "gt0008": {"id": "gt0008", "text": "Infusions >=113 kg", "description": "The drug is diluted to a concentration of 4 mg/ml before infusion for 10 minutes"}, "gt0014": {"id": "gt0014", "text": "ml/h"}, "gt0017": {"id": "gt0017", "text": "openEHR-EHR-OBSERVATION.brinavess_infusion.v0"}, "gt0012": {"id": "gt0012", "text": "Initial dose"}, "gt0019": {"id": "gt0019", "text": "Initial infusion rate"}, "gt0022": {"id": "gt0022", "text": "Initial infusion volume"}, "gt0013": {"id": "gt0013", "text": "Second dose"}, "gt0021": {"id": "gt0021", "text": "Second infusion rate"}, "gt0023": {"id": "gt0023", "text": "Second infusion volume"}, "gt0024": {"id": "gt0024", "text": "Infusion rate  <113 kg", "description": "Calculates infusion rates from the initial and second infusion volumes over 10 minutes."}}}}}, "date": "2026-03-17", "tags": [], "keywords": ["vernakalant", "dosage", "brinavess", "atrial", 