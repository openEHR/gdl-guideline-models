            ]
          },
          "gt0024" : {
            "id" : "gt0024",
            "path" : "/activities[at0001]/description[at0002]/items[at0129]/items[openEHR-EHR-CLUSTER.dosage.v2]/items[at0134]",
            "data_type" : "DV_QUANTITY",
