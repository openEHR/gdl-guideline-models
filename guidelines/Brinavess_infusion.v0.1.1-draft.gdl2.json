    },
    "pre_conditions" : [
      "$gt0006|Weight|!=null"
    ],
    "rules" : {
      "gt0025" : {
        "id" : "gt0025",
        "priority" : 1,
        "when" : [
          "$gt0006|Weight|<113,kg"
        ],
        "then" : [
          "$gt0019|Initial infusion dose|.magnitude=($gt0006|Weight|.magnitude*3)/4",
          "$gt0019|Initial infusion dose|.unit='mL'",
          "$gt0019|Initial infusion dose|.precision=1",
          "$gt0023|Infusion 2 dose|.magnitude=($gt0006|Weight|.magnitude*2)/4",
          "$gt0023|Infusion 2 dose|.unit='mL/h'",
          "$gt0023|Infusion 2 dose|.precision=1"
        ]
      }
    }
