      "gt0019" : {
        "id" : "gt0019",
        "model_id" : "openEHR-EHR-EVALUATION.cha2ds2va_score_assessment.v0",
        "template_id" : "openEHR-EHR-EVALUATION.cha2ds2va_score_assessment.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0020" : {
            "id" : "gt0020",
            "path" : "/data[at0001]/items[at0002]",
            "data_type" : "DV_CODED_TEXT"
          },
          "gt0021" : {
            "id" : "gt0021",
            "path" : "/data[at0001]/items[at0013]",
            "data_type" : "DV_TEXT"
          }
        }
      }
    },
    "rules" : {
      "gt0018" : {
        "id" : "gt0018",
        "priority" : 11,
        "when" : [
          "$gt0010|Congestive Heart Failure|!=null",
          "$gt0011|Hypertension|!=null",
          "$gt0012|Age|!=null",
          "$gt0013|Diabetes|!=null",
          "$gt0014|Stroke/TIA/Thromboembolism|!=null",
          "$gt0015|Vascular disease|!=null"
        ],
        "then" : [
          "$gt0017|Total score|.magnitude=$gt0010|Congestive Heart Failure|.value+$gt0011|Hypertension|.value+$gt0012|Age|.value+$gt0013|Diabetes|.value+$gt0014|Stroke/TIA/Thromboembolism|.value+$gt0015|Vascular disease|.value"
        ]
      },
      "gt0022" : {
        "id" : "gt0022",
        "priority" : 10,
        "when" : [
          "$gt0017|Total score|==0"
        ],
        "then" : [
          "$gt0020|Annual risk of ischemic stroke|=local::at0003|0.5%|",
          "$gt0021|Recommendation|=$gt0023|No treatment|.term"
        ]
      },
      "gt0026" : {
        "id" : "gt0026",
        "priority" : 9,
        "when" : [
          "$gt0017|Total score|==1"
        ],
        "then" : [
          "$gt0020|Annual risk of ischemic stroke|=local::at0004|1.5%|",
          "$gt0021|Recommendation|=$gt0024|\tAnticoagulants should be considered|.term"
        ]
      },
      "gt0027" : {
        "id" : "gt0027",
        "priority" : 8,
        "when" : [
          "$gt0017|Total score|==2"
        ],
        "then" : [
          "$gt0020|Annual risk of ischemic stroke|=local::at0005|2.9%|"
        ]
      },
      "gt0028" : {
        "id" : "gt0028",
        "priority" : 7,
        "when" : [
          "$gt0017|Total score|==3"
        ],
        "then" : [
          "$gt0020|Annual risk of ischemic stroke|=local::at0006|5.1%|"
        ]
      },
      "gt0029" : {
        "id" : "gt0029",
        "priority" : 6,
        "when" : [
          "$gt0017|Total score|==4"
        ],
        "then" : [
          "$gt0020|Annual risk of ischemic stroke|=local::at0007|7.3%|"
        ]
      },
      "gt0030" : {
        "id" : "gt0030",
        "priority" : 5,
        "when" : [
          "$gt0017|Total score|==5"
        ],
        "then" : [
          "$gt0020|Annual risk of ischemic stroke|=local::at0008|11.2%|"
        ]
      },
      "gt0031" : {
        "id" : "gt0031",
        "priority" : 4,
        "when" : [
          "$gt0017|Total score|==6"
        ],
        "then" : [
          "$gt0020|Annual risk of ischemic stroke|=local::at0009|15.5%|"
        ]
      },
      "gt0032" : {
        "id" : "gt0032",
        "priority" : 3,
        "when" : [
          "$gt0017|Total score|==7"
        ],
        "then" : [
          "$gt0020|Annual risk of ischemic stroke|=local::at0010|14.7%|"
        ]
      },
      "gt0033" : {
        "id" : "gt0033",
        "priority" : 2,
        "when" : [
          "$gt0017|Total score|==8"
        ],
        "then" : [
          "$gt0020|Annual risk of ischemic stroke|=local::at0011|19.5%|"
        ]
      },
      "gt0034" : {
        "id" : "gt0034",
        "priority" : 1,
        "when" : [
          "$gt0017|Total score|>=2",
          "$gt0017|Total score|<=8"
        ],
        "then" : [
          "$gt0021|Recommendation|=$gt0025|Anticoagulants are recommended|.term"
        ]
      }
    }
  },
