    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the eGFR using the CKiD U25 formula.",
        "keywords" : [
          "renal",
          "ckid",
          "egfr",
          "gfr",
          "kidney",
          "pediatric",
          "creatinine",
          "cystatin c",
          "nephrology"
        ],
        "use" : "Use in children and young adults aged 1 to 25 years with chronic kidney disease to estimate glomerular filtration rate, which is essential for staging CKD, dosing medications, and monitoring disease progression.",
        "misuse" : "Not to be used in adults older than 25 years; use the CKD-EPI equation instead. Not validated for assessing acute kidney injury (AKI) where creatinine levels are unstable.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Pierce CB, Muñoz A, Ng DK, Warady BA, Furth SL, Schwartz GJ. Age- and sex-dependent clinical equations to estimate glomerular filtration rates in children and young adults with chronic kidney disease. Kidney Int. 2021 Apr;99(4):948-956. doi: 10.1016/j.kint.2020.10.047. Epub 2020 Dec 8. PMID: 33301749; PMCID: PMC9083470.\n\nNg DK, Furth SL, Warady BA, Crews DC, Seegmiller JC, Schwartz GJ; CKiD Study Investigators. Self-reported Race, Serum Creatinine, Cystatin C, and GFR in Children and Young Adults With Pediatric Kidney Diseases: A Report From the Chronic Kidney Disease in Children (CKiD) Study. Am J Kidney Dis. 2022 Aug;80(2):174-185.e1. doi: 10.1053/j.ajkd.2021.10.013. Epub 2021 Dec 30. PMID: 34974031; PMCID: PMC9243196.",
      "en" : "eGFR calculated for children and under 25 yrs."
    }
  },
