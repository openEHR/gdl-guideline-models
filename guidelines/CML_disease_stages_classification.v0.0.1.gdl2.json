    "pre_conditions" : [
      "$gt0003|Blasts in blood or bone marrow|!=null",
      "$gt0004|Basophils in blood ≥ 20%|!=null",
      "$gt0005|Extramedullary blast proliferation excluding the spleen|!=null",
      "$gt0006|Persistent thrombocytopenia not related to treatment|!=null",
      "$gt0007|Cytogenetic abnormalities in Ph+ cells|!=null",
      "$gt0008|Large foci or clusters of blasts in marrow|!=null",
      "$gt0009|Thrombocytosis unresponsive to treatment|!=null",
      "$gt0010|Increased spleen size and rising white blood cell count that does not respond to treatment|!=null",
      "$gt0011|Blasts plus promyelocytes in blood or bone marrow > 30 %, with blasts < 30 %|!=null",
      "$gt0012|TKI resistance|!=null"
    ],
    "rules" : {
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 6,
        "when" : [
          "$gt0003|Blasts in blood or bone marrow|==local::at0008|10-14%|||$gt0003|Blasts in blood or bone marrow|==local::at0007|< 10%|",
          "$gt0004|Basophils in blood ≥ 20%|==local::at0013|Absent|",
          "$gt0005|Extramedullary blast proliferation excluding the spleen|==local::at0016|Absent|",
          "$gt0006|Persistent thrombocytopenia not related to treatment|==local::at0019|Absent|",
          "$gt0007|Cytogenetic abnormalities in Ph+ cells|==local::at0022|None|",
          "$gt0008|Large foci or clusters of blasts in marrow|==local::at0026|Absent|",
          "$gt0009|Thrombocytosis unresponsive to treatment|==local::at0029|Absent|",
          "$gt0010|Increased spleen size and rising white blood cell count that does not respond to treatment|==local::at0032|Absent|",
          "$gt0011|Blasts plus promyelocytes in blood or bone marrow > 30 %, with blasts < 30 %|==local::at0035|Absent|",
          "$gt0012|TKI resistance|==local::at0038|Absent|"
        ],
        "then" : [
          "$gt0015|European Leukemia Net disease phase|=local::at0010|Chronic phase: CP|"
        ]
      },
      "gt0019" : {
        "id" : "gt0019",
        "priority" : 5,
        "when" : [
          "$gt0003|Blasts in blood or bone marrow|==local::at0007|< 10%|",
          "$gt0004|Basophils in blood ≥ 20%|==local::at0013|Absent|",
          "$gt0005|Extramedullary blast proliferation excluding the spleen|==local::at0016|Absent|",
          "$gt0006|Persistent thrombocytopenia not related to treatment|==local::at0019|Absent|",
          "$gt0007|Cytogenetic abnormalities in Ph+ cells|==local::at0022|None|",
          "$gt0008|Large foci or clusters of blasts in marrow|==local::at0026|Absent|",
          "$gt0009|Thrombocytosis unresponsive to treatment|==local::at0029|Absent|",
          "$gt0010|Increased spleen size and rising white blood cell count that does not respond to treatment|==local::at0032|Absent|",
          "$gt0011|Blasts plus promyelocytes in blood or bone marrow > 30 %, with blasts < 30 %|==local::at0035|Absent|",
          "$gt0012|TKI resistance|==local::at0038|Absent|"
        ],
        "then" : [
          "$gt0014|World Health Organization disease phase|=local::at0006|Chronic phase: CP|"
        ]
      },
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 4,
        "when" : [
          "$gt0003|Blasts in blood or bone marrow|==local::at0010|20-29%|||$gt0003|Blasts in blood or bone marrow|==local::at0009|15-19%|",
          "$gt0004|Basophils in blood ≥ 20%|==local::at0014|Present|",
          "$gt0006|Persistent thrombocytopenia not related to treatment|==local::at0020|Present|",
          "$gt0007|Cytogenetic abnormalities in Ph+ cells|==local::at0024|New major route during treatment|",
          "$gt0011|Blasts plus promyelocytes in blood or bone marrow > 30 %, with blasts < 30 %|==local::at0036|Present|"
        ],
        "then" : [
          "$gt0015|European Leukemia Net disease phase|=local::at0011|Accelerated phase: AP|"
        ]
      },
      "gt0021" : {
        "id" : "gt0021",
        "priority" : 3,
        "when" : [
          "$gt0003|Blasts in blood or bone marrow|==local::at0008|10-14%|||$gt0003|Blasts in blood or bone marrow|==local::at0009|15-19%|",
          "$gt0004|Basophils in blood ≥ 20%|==local::at0014|Present|",
          "$gt0006|Persistent thrombocytopenia not related to treatment|==local::at0020|Present|",
          "$gt0007|Cytogenetic abnormalities in Ph+ cells|==local::at0023|Major route at diagnosis|||$gt0007|Cytogenetic abnormalities in Ph+ cells|==local::at0024|New major route during treatment|",
          "$gt0010|Increased spleen size and rising white blood cell count that does not respond to treatment|==local::at0033|Present|",
          "$gt0012|TKI resistance|==local::at0039|Present|"
        ],
        "then" : [
          "$gt0014|World Health Organization disease phase|=local::at0007|Accelerated phase: AP|"
        ]
      },
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 2,
        "when" : [
          "$gt0003|Blasts in blood or bone marrow|==local::at0011|≥ 30%|",
          "$gt0005|Extramedullary blast proliferation excluding the spleen|==local::at0017|Present|"
        ],
        "then" : [
          "$gt0015|European Leukemia Net disease phase|=local::at0012|Blast crisis: BC|"
        ]
      },
      "gt0018" : {
        "id" : "gt0018",
        "priority" : 1,
        "when" : [
          "$gt0003|Blasts in blood or bone marrow|==local::at0011|≥ 30%|||$gt0003|Blasts in blood or bone marrow|==local::at0010|20-29%|",
          "$gt0005|Extramedullary blast proliferation excluding the spleen|==local::at0017|Present|",
          "$gt0008|Large foci or clusters of blasts in marrow|==local::at0027|Present|"
        ],
        "then" : [
          "$gt0014|World Health Organization disease phase|=local::at0008|Blast crisis: BC|"
        ]
      }
    }
