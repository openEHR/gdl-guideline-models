    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To assign the disease phase for the CML disease stages classification.",
        "keywords" : [
          "cml",
          "kml",
          "who",
          "chronic",
          "myeloid",
          "leukemia",
          " eln",
          "european",
          "leukemianet",
          "oncology",
          "world",
          "health",
          "organization",
          "blast"
        ],
        "use" : "Use to assess the disease phase of chronic myeloid leukemia based on ELN and WHO criteria. \n\nThe guideline maps the individual parameters to the corresponding disease phase:\n\nChronic phase: blasts below the required threshold and no criteria for accelerated or blast phase met;\n\nAccelerated phase: intermediate blast percentages, high basophils, specific cytogenetic abnormalities, or lack of response to treatment;\n\nBlast crisis: high blast percentages, extramedullary blast proliferation, or large blast clusters in the marrow.",
        "misuse" : "Not to be used to classify acute leukemias or other myeloproliferative neoplasms.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Nationellt vårdprogram kronisk myeloisk leukemi [Internet]. Regionala cancercentrum i samverkan; 2024 [cited 2026 Jul 24]. Available from: https://kunskapsbanken.cancercentrum.se/diagnoser/kml/vardprogram/kategorisering-i-sjukdomsfaser-samt-riskgruppering/",
      "en" : "An assessment tool used to classify the disease phase of chronic myeloid leukemia according to the ELN and WHO systems."
    }
  },
