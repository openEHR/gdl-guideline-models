    "pre_conditions" : [
      "$gt0004|Age|>=40,a",
      "$gt0004|Age|<70,a"
    ],
    "rules" : {
      "gt0058" : {
        "id" : "gt0058",
        "priority" : 23,
        "when" : [
          "$gt0003|Gender|==local::at0005|Male|"
        ],
        "then" : [
          "$gt0057|Local variable: scale1|=0-0.1565",
          "$gt0056|Local variable: scale2|=0.8009"
        ]
      },
      "gt0059" : {
        "id" : "gt0059",
        "priority" : 22,
        "when" : [
          "$gt0003|Gender|==local::at0006|Female|"
        ],
        "then" : [
          "$gt0057|Local variable: scale1|=0-0.3143",
          "$gt0056|Local variable: scale2|=0.7701"
        ]
      },
      "gt0050" : {
        "id" : "gt0050",
        "priority" : 21,
        "when" : [
          "$gt0004|Age|!=null"
        ],
        "then" : [
          "$gt0076|Centered age|.magnitude=($gt0004|Age|.magnitude-60)/5",
          "$gt0076|Centered age|.precision=3",
          "$gt0076|Centered age|.unit='a'"
        ]
      },
      "gt0033" : {
        "id" : "gt0033",
        "priority" : 20,
        "when" : [
          "$gt0006|SBP|!=null"
        ],
        "then" : [
          "$gt0077|Centered SBP|.magnitude=($gt0006|SBP|.magnitude-120)/20",
          "$gt0077|Centered SBP|.precision=3",
          "$gt0077|Centered SBP|.unit='mm[Hg]'"
        ]
      },
      "gt0034" : {
        "id" : "gt0034",
        "priority" : 19,
        "when" : [
          "$gt0065|Total cholesterol value|!=null",
          "$gt0065|Total cholesterol value|.unit=='mmol/L'"
        ],
        "then" : [
          "$gt0078|Centered total cholesterol|.magnitude=$gt0065|Total cholesterol value|.magnitude-6",
          "$gt0078|Centered total cholesterol|.precision=3",
          "$gt0078|Centered total cholesterol|.unit='mmol/L'"
        ]
      },
      "gt0035" : {
        "id" : "gt0035",
        "priority" : 18,
        "when" : [
          "$gt0069|HDL-C value|!=null",
          "$gt0069|HDL-C value|.unit=='mmol/L'"
        ],
        "then" : [
          "$gt0079|Centered HDL-C|.magnitude=($gt0069|HDL-C value|.magnitude-1.3)/0.5",
          "$gt0079|Centered HDL-C|.precision=3",
          "$gt0079|Centered HDL-C|.unit='mmol/L'"
        ]
      },
      "gt0036" : {
        "id" : "gt0036",
        "priority" : 17,
        "when" : [
          "$gt0008|Smoking|!=null"
        ],
        "then" : [
          "$gt0022|Local variable: cage*smallbin|=$gt0076|Centered age|.magnitude*$gt0008|Smoking|.value"
        ]
      },
      "gt0037" : {
        "id" : "gt0037",
        "priority" : 16,
        "when" : [
          "$gt0004|Age|!=null",
          "$gt0006|SBP|!=null"
        ],
        "then" : [
          "$gt0023|Local variable: cage*csbp|=$gt0076|Centered age|.magnitude*$gt0077|Centered SBP|.magnitude"
        ]
      },
      "gt0038" : {
        "id" : "gt0038",
        "priority" : 15,
        "when" : [
          "$gt0009|Diabetes|!=0"
        ],
        "then" : [
          "$gt0024|Local variable: cage*hxdiabbin|=$gt0076|Centered age|.magnitude*$gt0009|Diabetes|.value"
        ]
      },
      "gt0039" : {
        "id" : "gt0039",
        "priority" : 14,
        "then" : [
          "$gt0025|Local variable: cage*ctchol|=$gt0076|Centered age|.magnitude*$gt0078|Centered total cholesterol|.magnitude"
        ]
      },
      "gt0040" : {
        "id" : "gt0040",
        "priority" : 13,
        "then" : [
          "$gt0026|Local variable: cage*chdl|=$gt0076|Centered age|.magnitude*$gt0079|Centered HDL-C|.magnitude"
        ]
      },
      "gt0041" : {
        "id" : "gt0041",
        "priority" : 12,
        "when" : [
          "$gt0014|Diabetes age at diagnosis (yrs)|!=null"
        ],
        "then" : [
          "$gt0027|Local variable: cagediab|=(($gt0014|Diabetes age at diagnosis (yrs)|.magnitude-50)/5)*$gt0009|Diabetes|.value"
        ]
      },
      "gt0042" : {
        "id" : "gt0042",
        "priority" : 11,
        "when" : [
          "$gt0073|HbA1c value|!=null",
          "$gt0073|HbA1c value|.unit=='mmol/mol'"
        ],
        "then" : [
          "$gt0082|Centered HbA1c|.magnitude=($gt0073|HbA1c value|.magnitude-31)/9.34",
          "$gt0082|Centered HbA1c|.precision=3",
          "$gt0082|Centered HbA1c|.unit='1'"
        ]
      },
      "gt0043" : {
        "id" : "gt0043",
        "priority" : 10,
        "when" : [
          "$gt0013|Ln eGFR|!=null"
        ],
        "then" : [
          "$gt0029|Local variable: clnegfr|=(log($gt0013|Ln eGFR|.magnitude)-4.5)/0.15"
        ]
      },
      "gt0047" : {
        "id" : "gt0047",
        "priority" : 9,
        "then" : [
          "$gt0030|Local variable: ln eGFR squared|=$gt0029|Local variable: clnegfr|*$gt0029|Local variable: clnegfr|"
        ]
      },
      "gt0048" : {
        "id" : "gt0048",
        "priority" : 8,
        "then" : [
          "$gt0031|Local variable: chba1c*cage|=$gt0076|Centered age|.magnitude*$gt0082|Centered HbA1c|.magnitude"
        ]
      },
      "gt0049" : {
        "id" : "gt0049",
        "priority" : 7,
        "then" : [
          "$gt0032|Local variable: clnegfr*cage|=$gt0076|Centered age|.magnitude*$gt0029|Local variable: clnegfr|"
        ]
      },
      "gt0052" : {
        "id" : "gt0052",
        "priority" : 6,
        "when" : [
          "$gt0003|Gender|.code=='at0005'"
        ],
        "then" : [
          "$gt0051|Local variable: Linear predictor|=$gt0076|Centered age|.magnitude*0.5368+$gt0008|Smoking|.value*0.4774+$gt0077|Centered SBP|.magnitude*0.1322+$gt0009|Diabetes|.value*0.6457+$gt0078|Centered total cholesterol|.magnitude*0.1102-$gt0079|Centered HDL-C|.magnitude*0.1087-$gt0022|Local variable: cage*smallbin|*0.0672-$gt0023|Local variable: cage*csbp|*0.0268-$gt0024|Local variable: cage*hxdiabbin|*0.0983-$gt0025|Local variable: cage*ctchol|*0.0181+$gt0026|Local variable: cage*chdl|*0.0095-$gt0027|Local variable: cagediab|*0.0998+$gt0082|Centered HbA1c|.magnitude*0.0955-$gt0029|Local variable: clnegfr|*0.0591+$gt0030|Local variable: ln eGFR squared|*0.0058-$gt0031|Local variable: chba1c*cage|*0.0134+$gt0032|Local variable: clnegfr*cage|*0.0115"
        ]
      },
      "gt0060" : {
        "id" : "gt0060",
        "priority" : 5,
        "when" : [
          "$gt0003|Gender|.code=='at0006'"
        ],
        "then" : [
          "$gt0051|Local variable: Linear predictor|=$gt0076|Centered age|.magnitude*0.6624+$gt0008|Smoking|.value*0.6139+$gt0077|Centered SBP|.magnitude*0.1421+$gt0009|Diabetes|.value*0.8096+$gt0078|Centered total cholesterol|.magnitude*0.1127-$gt0079|Centered HDL-C|.magnitude*0.1568-$gt0022|Local variable: cage*smallbin|*0.1122-$gt0023|Local variable: cage*csbp|*0.0167-$gt0024|Local variable: cage*hxdiabbin|*0.1272-$gt0025|Local variable: cage*ctchol|*0.02+$gt0026|Local variable: cage*chdl|*0.0186-$gt0027|Local variable: cagediab|*0.118+$gt0082|Centered HbA1c|.magnitude*0.1173-$gt0029|Local variable: clnegfr|*0.064+$gt0030|Local variable: ln eGFR squared|*0.0062-$gt0031|Local variable: chba1c*cage|*0.0196+$gt0032|Local variable: clnegfr*cage|*0.0169"
        ]
      },
      "gt0053" : {
        "id" : "gt0053",
        "priority" : 4,
        "when" : [
          "$gt0003|Gender|.code=='at0005'"
        ],
        "then" : [
          "$gt0054|Local variable: Baseline survival|=0.9605"
        ]
      },
      "gt0061" : {
        "id" : "gt0061",
        "priority" : 3,
        "when" : [
          "$gt0003|Gender|.code=='at0006'"
        ],
        "then" : [
          "$gt0054|Local variable: Baseline survival|=0.9776"
        ]
      },
      "gt0086" : {
        "id" : "gt0086",
        "priority" : 2,
        "when" : [
          "$gt0051|Local variable: Linear predictor|!=null",
          "$gt0054|Local variable: Baseline survival|!=null"
        ],
        "then" : [
          "$gt0080|Un-calibrated 10-year risk|.magnitude=1-$gt0054|Local variable: Baseline survival|^exp($gt0051|Local variable: Linear predictor|)",
          "$gt0080|Un-calibrated 10-year risk|.precision=5",
          "$gt0080|Un-calibrated 10-year risk|.unit='1'"
        ]
      },
      "gt0055" : {
        "id" : "gt0055",
        "priority" : 1,
        "then" : [
          "$gt0016|10-year risk |.precision=1",
          "$gt0016|10-year risk |.magnitude=(1-exp(0-exp($gt0057|Local variable: scale1|+$gt0056|Local variable: scale2|*log(0-log(1-$gt0080|Un-calibrated 10-year risk|.magnitude)))))*100",
          "$gt0016|10-year risk |.unit='%'",
          "$gt0081|Calibrated 10-year risk|.magnitude=$gt0016|10-year risk |.magnitude",
          "$gt0081|Calibrated 10-year risk|.precision=1",
          "$gt0081|Calibrated 10-year risk|.unit='%'"
        ]
      }
    }
  },
