            ]
          }
        }
      },
      "gt0075" : {
        "id" : "gt0075",
        "model_id" : "openEHR-EHR-OBSERVATION.score2.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.score2.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0076" : {
            "id" : "gt0076",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "a"
            ]
          },
          "gt0077" : {
