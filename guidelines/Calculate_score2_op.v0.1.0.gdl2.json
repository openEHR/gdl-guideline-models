    "pre_conditions" : [
      "$gt0004|Age|.unit=='a'",
      "$gt0004|Age|>=70,a",
      "$gt0006|SBP|.unit=='mm[Hg]'",
      "$gt0012|Total cholesterol value|.unit=='mmol/L'",
      "$gt0016|HDL-C value|.unit=='mmol/L'",
      "$gt0065|Risk region|!=null"
    ],
    "rules" : {
      "gt0080" : {
        "id" : "gt0080",
        "priority" : 31,
        "when" : [
          "$gt0004|Age|!=null"
        ],
        "then" : [
          "$gt0019|Centered age|.magnitude=$gt0004|Age|.magnitude-73",
          "$gt0019|Centered age|.precision=3",
          "$gt0019|Centered age|.unit='a'"
        ]
      },
      "gt0081" : {
        "id" : "gt0081",
        "priority" : 30,
        "when" : [
          "$gt0006|SBP|!=null"
        ],
        "then" : [
          "$gt0020|Centered SBP|.magnitude=$gt0006|SBP|.magnitude-150",
          "$gt0020|Centered SBP|.precision=3",
          "$gt0020|Centered SBP|.unit='mm[Hg]'"
        ]
      },
      "gt0082" : {
        "id" : "gt0082",
        "priority" : 29,
        "when" : [
          "$gt0012|Total cholesterol value|!=null",
          "$gt0012|Total cholesterol value|.unit=='mmol/L'"
        ],
        "then" : [
          "$gt0021|Centered TC|.magnitude=$gt0012|Total cholesterol value|.magnitude-6",
          "$gt0021|Centered TC|.precision=3",
          "$gt0021|Centered TC|.unit='mmol/L'"
        ]
      },
      "gt0083" : {
        "id" : "gt0083",
        "priority" : 28,
        "when" : [
          "$gt0016|HDL-C value|!=null",
          "$gt0016|HDL-C value|.unit=='mmol/L'"
        ],
        "then" : [
          "$gt0022|Centered HDL-C|.magnitude=$gt0016|HDL-C value|.magnitude-1.4",
          "$gt0022|Centered HDL-C|.precision=3",
          "$gt0022|Centered HDL-C|.unit='mmol/L'"
        ]
      },
      "gt0084" : {
        "id" : "gt0084",
        "priority" : 27,
        "when" : [
          "$gt0019|Centered age|!=null",
          "$gt0062|Diabetes|!=null"
        ],
        "then" : [
          "$gt0074|Age x diabetes|=$gt0019|Centered age|.magnitude*$gt0062|Diabetes|.value"
        ]
      },
      "gt0085" : {
        "id" : "gt0085",
        "priority" : 26,
        "when" : [
          "$gt0019|Centered age|!=null",
          "$gt0008|Smoking|!=null"
        ],
        "then" : [
          "$gt0075|Age x smoking|=$gt0019|Centered age|.magnitude*$gt0008|Smoking|.value"
        ]
      },
      "gt0086" : {
        "id" : "gt0086",
        "priority" : 25,
        "when" : [
          "$gt0019|Centered age|!=null",
          "$gt0020|Centered SBP|!=null"
        ],
        "then" : [
          "$gt0076|Age x SBP|=$gt0019|Centered age|.magnitude*$gt0020|Centered SBP|.magnitude"
        ]
      },
      "gt0087" : {
        "id" : "gt0087",
        "priority" : 23,
        "when" : [
          "$gt0019|Centered age|!=null",
          "$gt0021|Centered TC|!=null"
        ],
        "then" : [
          "$gt0077|Age x total cholesterol|=$gt0019|Centered age|.magnitude*$gt0021|Centered TC|.magnitude"
        ]
      },
      "gt0088" : {
        "id" : "gt0088",
        "priority" : 22,
        "when" : [
          "$gt0019|Centered age|!=null",
          "$gt0022|Centered HDL-C|!=null"
        ],
        "then" : [
          "$gt0078|Age x HDL-C|=$gt0019|Centered age|.magnitude*$gt0022|Centered HDL-C|.magnitude"
        ]
      },
      "gt0066" : {
        "id" : "gt0066",
        "priority" : 24,
        "when" : [
          "$gt0003|Gender|.code=='at0005'",
          "$gt0065|Risk region|.code=='at0012'"
        ],
        "then" : [
          "$gt0057|Scale 1|=0-0.34",
          "$gt0056|Scale 2|=1.19"
        ]
      },
      "gt0067" : {
        "id" : "gt0067",
        "priority" : 23,
        "when" : [
          "$gt0003|Gender|.code=='at0006'",
          "$gt0065|Risk region|.code=='at0012'"
        ],
        "then" : [
          "$gt0057|Scale 1|=0-0.52",
          "$gt0056|Scale 2|=1.01"
        ]
      },
      "gt0068" : {
        "id" : "gt0068",
        "priority" : 22,
        "when" : [
          "$gt0003|Gender|.code=='at0005'",
          "$gt0065|Risk region|.code=='at0013'"
        ],
        "then" : [
          "$gt0057|Scale 1|=0.01",
          "$gt0056|Scale 2|=1.25"
        ]
      },
      "gt0069" : {
        "id" : "gt0069",
        "priority" : 21,
        "when" : [
          "$gt0003|Gender|.code=='at0006'",
          "$gt0065|Risk region|.code=='at0013'"
        ],
        "then" : [
          "$gt0057|Scale 1|=0-0.1",
          "$gt0056|Scale 2|=1.1"
        ]
      },
      "gt0070" : {
        "id" : "gt0070",
        "priority" : 20,
        "when" : [
          "$gt0003|Gender|.code=='at0005'",
          "$gt0065|Risk region|.code=='at0014'"
        ],
        "then" : [
          "$gt0057|Scale 1|=0.08",
          "$gt0056|Scale 2|=1.15"
        ]
      },
      "gt0071" : {
        "id" : "gt0071",
        "priority" : 19,
        "when" : [
          "$gt0003|Gender|.code=='at0006'",
          "$gt0065|Risk region|.code=='at0014'"
        ],
        "then" : [
          "$gt0057|Scale 1|=0.38",
          "$gt0056|Scale 2|=1.09"
        ]
      },
      "gt0072" : {
        "id" : "gt0072",
        "priority" : 18,
        "when" : [
          "$gt0003|Gender|.code=='at0005'",
          "$gt0065|Risk region|.code=='at0015'"
        ],
        "then" : [
          "$gt0057|Scale 1|=0.05",
          "$gt0056|Scale 2|=0.7"
        ]
      },
      "gt0073" : {
        "id" : "gt0073",
        "priority" : 17,
        "when" : [
          "$gt0003|Gender|.code=='at0006'",
          "$gt0065|Risk region|.code=='at0015'"
        ],
        "then" : [
          "$gt0057|Scale 1|=0.38",
          "$gt0056|Scale 2|=0.69"
        ]
      },
      "gt0052" : {
        "id" : "gt0052",
        "priority" : 5,
        "when" : [
          "$gt0003|Gender|.code=='at0005'",
          "$gt0019|Centered age|!=null",
          "$gt0020|Centered SBP|!=null",
          "$gt0021|Centered TC|!=null",
          "$gt0022|Centered HDL-C|!=null",
          "$gt0008|Smoking|!=null",
          "$gt0062|Diabetes|!=null"
        ],
        "then" : [
          "$gt0051|Linear predictor|=$gt0019|Centered age|.magnitude*0.0634+$gt0062|Diabetes|.value*0.4245+$gt0008|Smoking|.value*0.3524+$gt0020|Centered SBP|.magnitude*0.0094+$gt0021|Centered TC|.magnitude*0.085+$gt0022|Centered HDL-C|.magnitude*(0-0.3564)+$gt0074|Age x diabetes|*(0-0.0174)+$gt0075|Age x smoking|*(0-0.0247)+$gt0076|Age x SBP|*(0-5.0E-4)+$gt0077|Age x total cholesterol|*0.0073+$gt0078|Age x HDL-C|*0.0091"
        ]
      },
      "gt0060" : {
        "id" : "gt0060",
        "priority" : 4,
        "when" : [
          "$gt0003|Gender|.code=='at0006'",
          "$gt0019|Centered age|!=null",
          "$gt0020|Centered SBP|!=null",
          "$gt0021|Centered TC|!=null",
          "$gt0022|Centered HDL-C|!=null",
          "$gt0008|Smoking|!=null",
          "$gt0062|Diabetes|!=null"
        ],
        "then" : [
          "$gt0051|Linear predictor|=$gt0019|Centered age|.magnitude*0.0789+$gt0062|Diabetes|.value*0.601+$gt0008|Smoking|.value*0.4921+$gt0020|Centered SBP|.magnitude*0.0102+$gt0021|Centered TC|.magnitude*0.0605+$gt0022|Centered HDL-C|.magnitude*(0-0.304)+$gt0074|Age x diabetes|*(0-0.0107)+$gt0075|Age x smoking|*(0-0.0255)+$gt0076|Age x SBP|*(0-4.0E-4)+$gt0077|Age x total cholesterol|*(0-9.0E-4)+$gt0078|Age x HDL-C|*0.0154"
        ]
      },
      "gt0053" : {
        "id" : "gt0053",
        "priority" : 3,
        "when" : [
          "$gt0051|Linear predictor|!=null",
          "$gt0003|Gender|.code=='at0005'"
        ],
        "then" : [
          "$gt0023|Un-calibrated 10-year risk|.magnitude=1-0.7576^exp($gt0051|Linear predictor|-0.0929)",
          "$gt0023|Un-calibrated 10-year risk|.precision=5",
          "$gt0023|Un-calibrated 10-year risk|.unit='1'"
        ]
      },
      "gt0061" : {
        "id" : "gt0061",
        "priority" : 2,
        "when" : [
          "$gt0051|Linear predictor|!=null",
          "$gt0003|Gender|.code=='at0006'"
        ],
        "then" : [
          "$gt0023|Un-calibrated 10-year risk|.magnitude=1-0.8082^exp($gt0051|Linear predictor|-0.229)",
          "$gt0023|Un-calibrated 10-year risk|.precision=5",
          "$gt0023|Un-calibrated 10-year risk|.unit='1'"
        ]
      },
      "gt0055" : {
        "id" : "gt0055",
        "priority" : 1,
        "then" : [
          "$gt0024|Calibrated 10-year risk|.precision=1",
          "$gt0024|Calibrated 10-year risk|.magnitude=(1-exp(0-exp($gt0057|Scale 1|+$gt0056|Scale 2|*log(0-log(1-$gt0023|Un-calibrated 10-year risk|.magnitude)))))*100",
          "$gt0024|Calibrated 10-year risk|.unit='%'"
        ]
      }
    }
  },
