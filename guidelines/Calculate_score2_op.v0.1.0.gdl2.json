    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To estimate 10-year incident cardiovascular disease risk in older persons",
        "keywords" : [
          "SCORE2-OP",
          "cardiovascular disease",
          "risk"
        ],
        "use" : "Use in European patients aged 70 years and older without known cardiovascular disease or severe chronic kidney disease. Estimate 10-year cardiovascular disease risk from age, sex, diabetes, smoking, systolic blood pressure, total cholesterol, HDL cholesterol, and geographical risk region. Consider SCORE2 for adults aged 40-69 years."
      }
    },
    "other_details" : {
      "references" : "1. SCORE2-OP risk prediction algorithms: estimating incident cardiovascular event risk in older persons in four geographical risk regions SCORE2-OP working group and ESC Cardiovascular risk collaboration European Heart Journal, Volume 42, Issue 25, 1 July 2021, Pages 2455–2467, https://doi.org/10.1093/eurheartj/ehab312",
      "en" : "Coefficients and regional recalibration factors follow the SCORE2-OP publication supplement. Checked against the MDCalc SCORE2-OP calculator."
    }
  },
