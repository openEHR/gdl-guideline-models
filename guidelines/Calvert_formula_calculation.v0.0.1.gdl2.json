  "description" : {
    "original_author" : {
      "name" : "Kevin Arjona",
      "email" : "kevin.arjona@cambio.se",
      "organisation" : "Cambio CDS",
      "date" : "2026-03-13"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the required Carboplatin dose to reach a target AUC based on the patient's renal function.",
        "keywords" : [
          "carboplatin",
          "calvert",
          "AUC",
          "GFR",
          "chemotherapy",
          "oncology",
          "dosing"
        ],
        "use" : "Use to calculate the dose of carboplatin  when Target AUC and GFR are known.\nFormula: \nChildren &lt; 20: clearance = 42.5 * height / serum creatinine * (weight / 70)⁰.⁷\n\nMen ≥ 20 years: clearance = 1.23 * (140 - age) * weight / serum creatinine\n\nWomen ≥ 20 years: clearance = 1.04 * (140 - age) * weight / serum creatinine\n\ndose = (clearance + 25) * AUC\n\nClearance in mL/min, height in cm, serum creatinine in µmol/L, weight in kg, age in years, AUC in mg/mL/min.\n",
        "misuse" : "Not to be used for calculating doses of chemotherapy agents other than Carboplatin. ",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "van Warmerdam LJ, Rodenhuis S, ten Bokkel Huinink WW, Maes RA, Beijnen JH. The use of the Calvert formula to determine the optimal carboplatin dosage. J Cancer Res Clin Oncol. 1995;121(8):478-86. doi: 10.1007/BF01218365. PMID: 7642691; PMCID: PMC12200317.\n\nCalvert AH, Newell DR, Gumbrell LA, O'Reilly S, Burnell M, Boxall FE, Siddik ZH, Judson IR, Gore ME, Wiltshaw E. Carboplatin dosage: prospective evaluation of a simple formula based on renal function. J Clin Oncol. 1989 Nov;7(11):1748-56. doi: 10.1200/JCO.1989.7.11.1748. PMID: 2681557.",
      "en" : "Calculation of the Carboplatin total dose using Calvert's formula."
    }
  },
