    "pre_conditions" : [
      "$gt0003|Gender|!=null",
      "$gt0004|Age|!=null",
      "$gt0006|Weight|!=null",
      "$gt0008|Height/Length|!=null",
      "$gt0010|Serum Creatinine|!=null",
      "$gt0012|AUC|!=null"
    ],
    "rules" : {
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 4,
        "when" : [
          "$gt0004|Age|.magnitude<20"
        ],
        "then" : [
          "$gt0021|Creatinine clearance|=42.5*($gt0008|Height/Length|.magnitude/$gt0010|Serum Creatinine|.magnitude)*($gt0006|Weight|.magnitude/70)^0.7"
        ]
      },
      "gt0019" : {
        "id" : "gt0019",
        "priority" : 3,
        "when" : [
          "$gt0004|Age|.magnitude>=20",
          "$gt0003|Gender|==local::at0005|Male|"
        ],
        "then" : [
          "$gt0021|Creatinine clearance|.magnitude=1.23*(140-$gt0004|Age|.magnitude)*($gt0006|Weight|.magnitude/$gt0010|Serum Creatinine|.magnitude)"
        ]
      },
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 2,
        "when" : [
          "$gt0004|Age|.magnitude>=20",
          "$gt0003|Gender|==local::at0006|Female|"
        ],
        "then" : [
          "$gt0021|Creatinine clearance|=1.04*(140-$gt0004|Age|.magnitude)*($gt0006|Weight|.magnitude/$gt0010|Serum Creatinine|.magnitude)"
        ]
      },
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 1,
        "when" : [
          "$gt0021|Creatinine clearance|!=null"
        ],
        "then" : [
          "$gt0018|Carboplatin dosage|=($gt0021|Creatinine clearance|+25)*$gt0012|AUC|"
        ]
      }
    }
  },
