    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To support healthcare professionals in determining correct drip rate for IV infusions when using gravity-based administration sets.",
        "keywords" : [
          "infusion",
          "drip rate",
          "IV therapy",
          "calculation",
          "drops per minute",
          "dropptakt"
        ],
        "use" : "Used in hospital or clinical settings where infusion pumps are not used and drip rate  must be manually calculated.",
        "misuse" : "Not intended for automated infusion pumps or critical care scenarios where precise infusion devices are required. Incorrect inputs may lead to unsafe infusion rates.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "en" : "Calculates intravenous drip rate (drops per minute) based on total infusion volume,  infusion duration, and drip factor. Intended for clinical support in manual IV administration.",
      "references" : "Morris, G. (2021). Clinical Calculations: With Applications to General and Specialty Areas (9th ed.). Elsevier.\nhttps://verktyg.internetmedicin.se/kalkylatorer/dropptakt"
    }
  },
