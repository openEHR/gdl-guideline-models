          }
        }
      }
    },
    "rules" : {
      "gt0002" : {
        "id" : "gt0002",
        "priority" : 4,
        "when" : [
          "$gt0004|Age|!=null",
          "$gt0030|Platelet count|!=null",
          "$gt0033|Spleen size below costal margin|!=null",
          "$gt0031|Blasts in peripheral blood|!=null"
        ],
        "then" : [
          "$gt0035|Total score|.magnitude=(0.0025*(($gt0004|Age|.magnitude/10)^3))+(0.0615*$gt0033|Spleen size below costal margin|.magnitude)+(0.1052*$gt0031|Blasts in peripheral blood|.magnitude)+(0.4104/(($gt0030|Platelet count|.magnitude/1000)^0.5))",
          "$gt0035|Total score|.precision=4"
        ]
      },
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 3,
        "when" : [
          "$gt0035|Total score|<=1.568"
        ],
        "then" : [
          "$gt0014|Risk assessment|=$gt0018|Low-risk group|.term"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 2,
        "when" : [
          "$gt0035|Total score|>1.568",
          "$gt0035|Total score|<=2.2185"
        ],
        "then" : [
          "$gt0014|Risk assessment|=$gt0019|Intermediate-risk group|.term"
        ]
      },
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 1,
        "when" : [
          "$gt0035|Total score|>2.2185"
        ],
        "then" : [
          "$gt0014|Risk assessment|=$gt0020|High-risk group|.term"
        ]
      }
    }
  },
