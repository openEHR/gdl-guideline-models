        "model_id" : "openEHR-EHR-OBSERVATION.elts.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.elts.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0035" : {
            "id" : "gt0035",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0007]",
