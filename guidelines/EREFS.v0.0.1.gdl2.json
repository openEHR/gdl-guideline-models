  "description" : {
    "original_author" : {
      "name" : "Katja Mariko Wilde",
      "email" : "katja-wilde@t-online.de",
      "organisation" : "Cambio CDS",
      "date" : "2025-10-07"
    },
    "lifecycle_state" : "REVIEWED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the total sum for the Eosinophilic Esophagitis Endoscopic Reference Score (EREFS) to assess the severity of endoscopic features in adult and pediatric patients with eosinophilic esophagitis (EoE). Apply during baseline and follow-up upper endoscopy to define and monitor endoscopic disease activity.",
        "keywords" : [
          "eosinophilic",
          "esophagitis",
          "endoscopic",
          "reference",
          "score",
          "erefs",
          "edema",
          "rings",
          "exudates",
          "furrows",
          "strictures"
        ],
        "use" : "Use to assess endoscopic disease severity in adults and children with suspected or confirmed eosinophilic esophagitis (EoE) during upper endoscopy.\nThe score is calculated by adding the points of the individual variables:\nEdema: Absent 0 points, Present 1 point\nRings: None 0 points, Mild (subtle) 1 point, Moderate 2 points, Severe (fixed rings) 3 points\nExudates: None 0 points, Mild (≤10% mucosal surface) 1 point, Severe (>10%) 2 points\nFurrows: Absent 0 points, Present 1 point\nStrictures: None 0 points, Present 1 point\n\nThe total EREFS score is the sum of all component points and reflects overall endoscopic disease activity.\nIn addition, two subscores can be calculated:\nInflammatory subscore: Edema + Exudates + Furrows\nFibrostenotic subscore: Rings + Strictures\n\nThe esophageal segment with the highest severity should be used for the EREFS.",
        "misuse" : "Not to be used for recording histologic findings, patient symptoms, or other endoscopic classification systems unrelated to eosinophilic esophagitis.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Hirano I, Moy N, Heckman MG, Thomas CS, Gonsalves N, Achem SR. Endoscopic assessment of the oesophageal features of eosinophilic oesophagitis: validation of a novel classification and grading system. Gut. 2013 Apr;62(4):489-95. doi: 10.1136/gutjnl-2011-301817. Epub 2012 May 22. PMID: 22619364.",
      "en" : "An assessment score used to evaluate the severity of endoscopic findings in patients with eosinophilic esophagitis (EoE)."
    }
  },
