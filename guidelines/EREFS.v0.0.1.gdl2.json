    "rules" : {
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 1,
        "when" : [
          "$gt0003|Edema|!=null",
          "$gt0004|Rings|!=null",
          "$gt0005|Exudates|!=null",
          "$gt0006|Furrows|!=null",
          "$gt0007|Strictures|!=null"
        ],
        "then" : [
          "$gt0009|Total score|.magnitude=$gt0003|Edema|.value+$gt0004|Rings|.value+$gt0005|Exudates|.value+$gt0006|Furrows|.value+$gt0007|Strictures|.value",
