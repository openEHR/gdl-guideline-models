    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate and assess the most likely eye disease diagnosis based on the symptom matrix.",
        "keywords" : [
          "eye",
          "ophthalmology",
          "vision",
          "conjunctivitis",
          "iritis",
          "glaucoma",
          "keratitis",
          "retinal",
          "detachment"
        ],
        "use" : "Use to record the symptom hits and output the most likely diagnosis. The guideline works by counting the \"hits\" (matching symptoms) for each specific diagnosis in the matrix;\nconjunctivitis: redness, burning or itching, pus.\n\niritis: redness, photophobia, eye pain, floaters.\n\nkeratitis: redness, foreign body sensation, photophobia, eye pain.\n\nacute glaucoma: redness, eye pain, halos around lights.\n\nposterior vitreous detachment: floaters, flashes of light.\n\nretinal detachment: floaters, flashes of light, dark shadow in visual field.\n\nmacular degeneration: metamorphopsia.\n\nThe diagnosis that accumulates the highest number of matching symptom points is considered the most likely.",
        "misuse" : "Not to be used for traumatic eye injuries.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Ögonbesvär, lathund. Praktisk Medicin [Internet]. 2025 [cited 2026 May 23]. Available from: https://www.praktiskmedicin.se/sjukdomar/ogonbesvar-lathund/\n\nÖgonsjukdomar kalkylator. Internetmedicin [Internet]. 2025 [cited 2026 May 23]. Available from: https://verktyg.internetmedicin.se/kalkylatorer/ogonsjukdomar",
      "en" : "An assessment tool to evaluate how likely different eye diagnoses are given the patient's symptoms based on a clinical matrix."
    }
  },
