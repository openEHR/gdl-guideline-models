    "pre_conditions" : [
      "$gt0003|Red eye|!=null",
      "$gt0004|Foreign body sensation|!=null",
      "$gt0005|Photophobia|!=null",
      "$gt0006|Burning or itching|!=null",
      "$gt0007|Pus|!=null",
      "$gt0008|Eye pain|!=null",
      "$gt0009|Floaters in visual field|!=null",
      "$gt0010|Flashes of light|!=null",
      "$gt0011|Dark shadow in visual field|!=null",
      "$gt0012|Metamorphopsia|!=null",
      "$gt0013|Halos around lights|!=null"
    ],
    "rules" : {
      "gt0023" : {
        "id" : "gt0023",
        "priority" : 7,
        "when" : [
          "$gt0003|Red eye|==local::at0012|Present|",
          "$gt0008|Eye pain|==local::at0027|Present|",
          "$gt0013|Halos around lights|==local::at0042|Present|"
        ],
        "then" : [
          "$gt0015|Diagnosis|=$gt0022|Acute glaucoma|.term"
        ]
      },
      "gt0024" : {
        "id" : "gt0024",
        "priority" : 6,
        "when" : [
          "$gt0012|Metamorphopsia|==local::at0039|Present|"
        ],
        "then" : [
          "$gt0026|Diagnosis|=$gt0021|Macular degeneration|.term"
        ]
      },
      "gt0027" : {
        "id" : "gt0027",
        "priority" : 5,
        "when" : [
          "$gt0009|Floaters in visual field|==local::at0030|Present|",
          "$gt0010|Flashes of light|==local::at0036|Present|",
          "$gt0011|Dark shadow in visual field|==local::at0033|Present|"
        ],
        "then" : [
          "$gt0029|Diagnosis|=$gt0020|Retinal detachment|.term"
        ]
      },
      "gt0038" : {
        "id" : "gt0038",
        "priority" : 4,
        "when" : [
          "$gt0009|Floaters in visual field|==local::at0030|Present|",
          "$gt0010|Flashes of light|==local::at0036|Present|"
        ],
        "then" : [
          "$gt0031|Diagnosis|=$gt0019|Posterior vitreous detachment|.term"
        ]
      },
      "gt0039" : {
        "id" : "gt0039",
        "priority" : 3,
        "when" : [
          "$gt0003|Red eye|==local::at0012|Present|",
          "$gt0005|Photophobia|==local::at0018|Present|",
          "$gt0008|Eye pain|==local::at0027|Present|",
          "$gt0009|Floaters in visual field|==local::at0030|Present|"
        ],
        "then" : [
          "$gt0033|Diagnosis|=$gt0018|Iritis|.term"
        ]
      },
      "gt0040" : {
        "id" : "gt0040",
        "priority" : 2,
        "when" : [
          "$gt0003|Red eye|==local::at0012|Present|",
          "$gt0006|Burning or itching|==local::at0021|Present|",
          "$gt0007|Pus|==local::at0024|Present|"
        ],
        "then" : [
          "$gt0035|Diagnosis|=$gt0017|Conjunctivitis|.term"
        ]
      },
      "gt0041" : {
        "id" : "gt0041",
        "priority" : 1,
        "when" : [
          "$gt0003|Red eye|==local::at0012|Present|",
          "$gt0004|Foreign body sensation|==local::at0015|Present|",
          "$gt0005|Photophobia|==local::at0018|Present|",
          "$gt0008|Eye pain|==local::at0027|Present|"
        ],
        "then" : [
          "$gt0037|Diagnosis|=$gt0016|Keratitis|.term"
        ]
      }
    }
