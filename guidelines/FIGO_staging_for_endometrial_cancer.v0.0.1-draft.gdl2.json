    "rules" : {
      "gt0024" : {
        "id" : "gt0024",
        "priority" : 9,
        "when" : [
          "$gt0021|Clinical and pathological findings|==local::at0007|Tumor confined to the corpus uteri|"
        ],
        "then" : [
          "$gt0023|Stage group|=local::at0005|I|"
        ]
      },
      "gt0025" : {
        "id" : "gt0025",
        "priority" : 8,
        "when" : [
          "$gt0021|Clinical and pathological findings|==local::at0008|No invasion or invasion < half the thickness of the myometrium|"
        ],
        "then" : [
          "$gt0023|Stage group|=local::at0006|IA|"
        ]
      },
      "gt0026" : {
        "id" : "gt0026",
        "priority" : 7,
        "when" : [
          "$gt0021|Clinical and pathological findings|==local::at0009|Invasion ≥ half the thickness of the myometrium|"
        ],
        "then" : [
          "$gt0023|Stage group|=local::at0007|IB|"
        ]
      },
      "gt0027" : {
        "id" : "gt0027",
        "priority" : 6,
        "when" : [
          "$gt0021|Clinical and pathological findings|==local::at0010|Invasion into the cervical stroma but not outside the uterus|"
        ],
        "then" : [
          "$gt0023|Stage group|=local::at0008|II|"
        ]
      },
      "gt0028" : {
        "id" : "gt0028",
        "priority" : 5,
        "when" : [
          "$gt0021|Clinical and pathological findings|==local::at0011|Local and/or regional spread|"
        ],
        "then" : [
          "$gt0023|Stage group|=local::at0009|III|"
        ]
      },
      "gt0029" : {
        "id" : "gt0029",
        "priority" : 4,
        "when" : [
          "$gt0021|Clinical and pathological findings|==local::at0012|Invasion of uterine serosa and/or adnexa|"
        ],
        "then" : [
          "$gt0023|Stage group|=local::at0010|IIIA|"
        ]
      },
      "gt0030" : {
        "id" : "gt0030",
        "priority" : 3,
        "when" : [
          "$gt0021|Clinical and pathological findings|==local::at0013|Vaginal growth and/or parametrial growth|"
        ],
        "then" : [
          "$gt0023|Stage group|=local::at0011|IIIB|"
        ]
      },
      "gt0031" : {
        "id" : "gt0031",
        "priority" : 2,
        "when" : [
          "$gt0021|Clinical and pathological findings|==local::at0014|Metastases to pelvic nodes and/or paraaortic lymph nodes|"
        ],
        "then" : [
          "$gt0023|Stage group|=local::at0012|IIIC|"
        ]
      },
      "gt0032" : {
        "id" : "gt0032",
        "priority" : 1,
        "when" : [
          "$gt0021|Clinical and pathological findings|==local::at0015|Positive pelvic nodes|"
        ],
        "then" : [
          "$gt0023|Stage group|=local::at0013|IIIC1|"
        ]
      }
    }
