    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To assess the prognostic stage group for endometrial cancer.",
        "keywords" : [
          "figo",
          "endometrial",
          "cancer",
          "uterine",
          "staging",
          "oncology",
          "gynecology",
          "tumor"
        ],
        "use" : "Use to assess the clinical or pathological stage group for endometrial cancer. \n\nThe guideline maps the individual tumor extent findings to the overall prognostic stage:\n\nstage I: tumor confined to the corpus uteri;\n\nstage IA: No invasion or invasion &lt; half the thickness of the myometrium;\n\nstage IB: Invasion ≥ half the thickness of the myometrium;\n\nstage II: Invasion into the cervical stroma but not outside the uterus;\n\nstage III:Local and/or regional spread;\n\nstage IIIA: Invasion of uterine serosa and/or adnexa;\n\nstage IIIB: Vaginal growth and/or parametrial growth;\n\nstage IIIC: Metastases to pelvic nodes and/or paraaortic lymph nodes;\n\nstage IIIC1: Positive pelvic nodes;\n\nstage IIIC2: para-aortic node involvement;\n\nstage IVA: tumor invades bladder or bowel mucosa;\n\nstage IVB: distant metastases including intra-abdominal or inguinal lymph nodes.\n",
        "misuse" : "Not to be used to record the staging for other gynecological cancers.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "en" : "An assessment tool used to assign the prognostic stage group for endometrial cancer according to the FIGO 2009 staging system."
    }
  },
  "definition" : {
