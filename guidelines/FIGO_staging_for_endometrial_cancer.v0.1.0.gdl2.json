    "rules" : {
      "gt0024" : {
        "id" : "gt0024",
        "priority" : 13,
        "when" : [
          "$gt0040|Myometrial invasion|==local::at0024|Not assessed|",
          "$gt0041|Cervical stromal invasion|==local::at0026|Absent|",
          "$gt0042|Uterine serosal or adnexal involvement|==local::at0030|Absent|",
          "$gt0043|Vaginal or parametrial involvement|==local::at0034|Absent|",
          "$gt0044|Pelvic lymph node status|==local::at0039|No metastasis identified|||$gt0044|Pelvic lymph node status|==local::at0040|Isolated tumour cells only (N0(i+))|",
          "$gt0045|Para-aortic lymph node status|==local::at0044|No metastasis identified|||$gt0045|Para-aortic lymph node status|==local::at0045|Isolated tumour cells only (N0(i+))|",
          "$gt0046|Bladder or rectal mucosal invasion|==local::at0048|Absent|",
          "$gt0047|Distant metastasis status|==local::at0053|No distant metastasis identified|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0005|I|"
        ]
      },
      "gt0025" : {
        "id" : "gt0025",
        "priority" : 12,
        "when" : [
          "$gt0040|Myometrial invasion|==local::at0021|No myometrial invasion|||$gt0040|Myometrial invasion|==local::at0022|Less than half of myometrial thickness|",
          "$gt0041|Cervical stromal invasion|==local::at0026|Absent|",
          "$gt0042|Uterine serosal or adnexal involvement|==local::at0030|Absent|",
          "$gt0043|Vaginal or parametrial involvement|==local::at0034|Absent|",
          "$gt0044|Pelvic lymph node status|==local::at0039|No metastasis identified|||$gt0044|Pelvic lymph node status|==local::at0040|Isolated tumour cells only (N0(i+))|",
          "$gt0045|Para-aortic lymph node status|==local::at0044|No metastasis identified|||$gt0045|Para-aortic lymph node status|==local::at0045|Isolated tumour cells only (N0(i+))|",
          "$gt0046|Bladder or rectal mucosal invasion|==local::at0048|Absent|",
          "$gt0047|Distant metastasis status|==local::at0053|No distant metastasis identified|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0006|IA|"
        ]
      },
      "gt0026" : {
        "id" : "gt0026",
        "priority" : 11,
        "when" : [
          "$gt0040|Myometrial invasion|==local::at0023|At least half of myometrial thickness|",
          "$gt0041|Cervical stromal invasion|==local::at0026|Absent|",
          "$gt0042|Uterine serosal or adnexal involvement|==local::at0030|Absent|",
          "$gt0043|Vaginal or parametrial involvement|==local::at0034|Absent|",
          "$gt0044|Pelvic lymph node status|==local::at0039|No metastasis identified|||$gt0044|Pelvic lymph node status|==local::at0040|Isolated tumour cells only (N0(i+))|",
          "$gt0045|Para-aortic lymph node status|==local::at0044|No metastasis identified|||$gt0045|Para-aortic lymph node status|==local::at0045|Isolated tumour cells only (N0(i+))|",
          "$gt0046|Bladder or rectal mucosal invasion|==local::at0048|Absent|",
          "$gt0047|Distant metastasis status|==local::at0053|No distant metastasis identified|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0007|IB|"
        ]
      },
      "gt0027" : {
        "id" : "gt0027",
        "priority" : 10,
        "when" : [
          "$gt0041|Cervical stromal invasion|==local::at0027|Present|",
          "$gt0042|Uterine serosal or adnexal involvement|==local::at0030|Absent|",
          "$gt0043|Vaginal or parametrial involvement|==local::at0034|Absent|",
          "$gt0044|Pelvic lymph node status|==local::at0039|No metastasis identified|||$gt0044|Pelvic lymph node status|==local::at0040|Isolated tumour cells only (N0(i+))|",
          "$gt0045|Para-aortic lymph node status|==local::at0044|No metastasis identified|||$gt0045|Para-aortic lymph node status|==local::at0045|Isolated tumour cells only (N0(i+))|",
          "$gt0046|Bladder or rectal mucosal invasion|==local::at0048|Absent|",
          "$gt0047|Distant metastasis status|==local::at0053|No distant metastasis identified|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0008|II|"
        ]
      },
      "gt0028" : {
        "id" : "gt0028",
        "priority" : 9,
        "when" : [
          "$gt0042|Uterine serosal or adnexal involvement|==local::at0031|Present|||$gt0043|Vaginal or parametrial involvement|==local::at0035|Present|||$gt0044|Pelvic lymph node status|==local::at0041|Metastasis identified|||$gt0045|Para-aortic lymph node status|==local::at0046|Metastasis identified|",
          "$gt0047|Distant metastasis status|==local::at0053|No distant metastasis identified|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0009|III|"
        ]
      },
      "gt0029" : {
        "id" : "gt0029",
        "priority" : 8,
        "when" : [
          "$gt0042|Uterine serosal or adnexal involvement|==local::at0031|Present|",
          "$gt0043|Vaginal or parametrial involvement|==local::at0034|Absent|",
          "$gt0044|Pelvic lymph node status|==local::at0039|No metastasis identified|||$gt0044|Pelvic lymph node status|==local::at0040|Isolated tumour cells only (N0(i+))|",
          "$gt0045|Para-aortic lymph node status|==local::at0044|No metastasis identified|||$gt0045|Para-aortic lymph node status|==local::at0045|Isolated tumour cells only (N0(i+))|",
          "$gt0046|Bladder or rectal mucosal invasion|==local::at0048|Absent|",
          "$gt0047|Distant metastasis status|==local::at0053|No distant metastasis identified|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0010|IIIA|"
        ]
      },
      "gt0030" : {
        "id" : "gt0030",
        "priority" : 7,
        "when" : [
          "$gt0043|Vaginal or parametrial involvement|==local::at0035|Present|",
          "$gt0044|Pelvic lymph node status|==local::at0039|No metastasis identified|||$gt0044|Pelvic lymph node status|==local::at0040|Isolated tumour cells only (N0(i+))|",
          "$gt0045|Para-aortic lymph node status|==local::at0044|No metastasis identified|||$gt0045|Para-aortic lymph node status|==local::at0045|Isolated tumour cells only (N0(i+))|",
          "$gt0046|Bladder or rectal mucosal invasion|==local::at0048|Absent|",
          "$gt0047|Distant metastasis status|==local::at0053|No distant metastasis identified|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0011|IIIB|"
        ]
      },
      "gt0031" : {
        "id" : "gt0031",
        "priority" : 6,
        "when" : [
          "$gt0044|Pelvic lymph node status|==local::at0041|Metastasis identified|||$gt0045|Para-aortic lymph node status|==local::at0046|Metastasis identified|",
          "$gt0047|Distant metastasis status|==local::at0053|No distant metastasis identified|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0012|IIIC|"
        ]
      },
      "gt0032" : {
        "id" : "gt0032",
        "priority" : 5,
        "when" : [
          "$gt0044|Pelvic lymph node status|==local::at0041|Metastasis identified|",
          "$gt0045|Para-aortic lymph node status|==local::at0044|No metastasis identified|||$gt0045|Para-aortic lymph node status|==local::at0045|Isolated tumour cells only (N0(i+))|",
          "$gt0047|Distant metastasis status|==local::at0053|No distant metastasis identified|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0013|IIIC1|"
        ]
      },
      "gt0033" : {
        "id" : "gt0033",
        "priority" : 4,
        "when" : [
          "$gt0045|Para-aortic lymph node status|==local::at0046|Metastasis identified|",
          "$gt0047|Distant metastasis status|==local::at0053|No distant metastasis identified|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0014|IIIC2|"
        ]
      },
      "gt0034" : {
        "id" : "gt0034",
        "priority" : 3,
        "when" : [
          "$gt0046|Bladder or rectal mucosal invasion|==local::at0049|Present|",
          "$gt0047|Distant metastasis status|==local::at0052|Not assessed|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0015|IV|"
        ]
      },
      "gt0035" : {
        "id" : "gt0035",
        "priority" : 2,
        "when" : [
          "$gt0046|Bladder or rectal mucosal invasion|==local::at0049|Present|",
          "$gt0047|Distant metastasis status|==local::at0053|No distant metastasis identified|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0016|IVA|"
        ]
      },
      "gt0036" : {
        "id" : "gt0036",
        "priority" : 1,
        "when" : [
          "$gt0047|Distant metastasis status|==local::at0054|Intra-abdominal and/or inguinal metastasis|||$gt0047|Distant metastasis status|==local::at0055|Other distant metastasis|"
        ],
        "then" : [
          "$gt0023|FIGO stage|=local::at0017|IVB|"
        ]
      }
    }
  },
