    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate and assess the total sum for the Fracture index",
        "keywords" : [
          "fracture",
          "index",
          "osteoporosis",
          "hip",
          "risk",
          "prediction",
          "postmenopausal",
          "rheumatology",
          "female"
        ],
        "use" : "Use to calculate the total Fracture index by summing the individual ordinal values of the component parameters and assess the result. \n\nThe variables and assigned points are:\n\nage: &lt; 65 years = 0, 65-69 years = 1, 70-74 years = 2, 75-79 years = 3, 80-84 years = 4, ≥ 85 years = 5;\n\nfracture after age 50: no = 0, yes = 1;\n\nmaternal hip fracture after age 50: no = 0, yes = 1;\n\nweight ≤ 125 lbs (56.7 kg): no = 0, yes = 1;\n\ncurrent smoker: no = 0, yes = 1;\n\nuses arms to stand from chair: no = 0, yes = 1.\n\nif BMD is available:\n\n≥-1 = 0, Between -1 and -2= 2, Between -2 and -2.5= 3, &lt;-2.5 = 4\n",
        "misuse" : "Not to be used for male patients or premenopausal women.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Black DM, Steinbuch M, Palermo L, Dargent-Molina P, Lindsay R, Hoseyni MS, Johnell O. An assessment tool for predicting fracture risk in postmenopausal women. Osteoporos Int. 2001;12(7):519-28. doi: 10.1007/s001980170072. PMID: 11527048.",
      "en" : "An assessment score used to predict the 5-year risk of hip fractures in postmenopausal women."
    }
  },
