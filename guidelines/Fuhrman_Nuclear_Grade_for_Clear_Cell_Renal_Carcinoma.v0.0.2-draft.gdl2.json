    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To support consistent documentation and decision support based on the Fuhrman Nuclear Grade for renal cell carcinoma. This archetype captures observed nuclear morphology and calculates the final tumor grade (1 to 4) used for prognosis and treatment planning.",
        "keywords" : [
          "fuhrman",
          "renal cell carcinoma",
          "nuclear grade",
          "oncology",
          "pathology",
          "clear cell",
          "tumor grading",
          "histology",
          "renal",
          "carcinoma",
          "renal cell"
        ],
        "use" : "This archetype is intended for use by pathologists or clinicians to record nuclear characteristics of tumor cells in clear cell renal cell carcinoma. It is also used by CDS tools to calculate the final Fuhrman grade based on observed nuclear diameter, shape, nucleoli, and presence of bizarre or spindle-like nuclei.",
        "misuse" : "This archetype should not be used for other tumor types or non-histologically confirmed diagnoses. It is not intended for pediatric use or cases where sufficient morphological data is not available. It should not replace clinical judgment in cases with ambiguous or mixed features.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "en" : "The Fuhrman Nuclear Grade classification is used for determining the histological severity of clear cell renal cell carcinoma, where the grade is assigned based on nuclear diameter, shape, and nucleolar prominence.",
      "references" : "Fuhrman SA, Lasky LC, Limas C. Prognostic significance of morphologic parameters in renal cell carcinoma. Am J Surg Pathol. 1982 Oct;6(7):655–63.\nMDCalc. Fuhrman Nuclear Grade for Clear Cell Renal Carcinoma. https://www.mdcalc.com/calc/3012/fuhrman-nuclear-grade-clear-cell-renal-carcinoma"
    }
  },
