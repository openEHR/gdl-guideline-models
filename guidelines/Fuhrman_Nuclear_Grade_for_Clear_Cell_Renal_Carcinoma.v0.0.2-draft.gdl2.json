    "rules" : {
      "gt0009" : {
        "id" : "gt0009",
        "priority" : 3,
        "when" : [
          "$gt0011|Nuclear diameter|!=null",
          "$gt0011|Nuclear diameter|==local::at0007|Small (~10µm)|",
          "$gt0012|Nuclear shape|!=null&&$gt0012|Nuclear shape|==local::at0011|Round, uniform|",
          "$gt0013|Nucleoli|!=null&&$gt0013|Nucleoli|==local::at0015|Absent, inconspicuous|"
        ],
        "then" : [
          "$gt0021|Nuclear grade|='at0022'"
        ]
      },
      "gt0023" : {
        "id" : "gt0023",
        "priority" : 2,
        "when" : [
          "$gt0011|Nuclear diameter|!=null&&$gt0011|Nuclear diameter|==local::at0008|Larger (~15µm)|",
          "$gt0012|Nuclear shape|!=null",
          "$gt0013|Nucleoli|!=null",
          "$gt0022|Bizarre often multilobed nuclei and/or spindle cells|!=null&&$gt0022|Bizarre often multilobed nuclei and/or spindle cells|==local::at0020|No|"
        ],
        "then" : [
          "$gt0021|Nuclear grade|='at0023'"
        ]
      },
      "gt0024" : {
        "id" : "gt0024",
        "priority" : 1,
        "when" : [
          "$gt0011|Nuclear diameter|!=null&&$gt0011|Nuclear diameter|==local::at0009|Even larger (~20µm)|",
          "$gt0012|Nuclear shape|!=null&&$gt0012|Nuclear shape|==local::at0013|Obvious irregular outline|",
          "$gt0013|Nucleoli|!=null&&$gt0013|Nucleoli|=="
        ]
      }
