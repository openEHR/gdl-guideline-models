  "ontology" : {
    "term_definitions" : {
      "en" : {
        "id" : "en",
        "terms" : {
          "gt0001" : {
            "id" : "gt0001",
            "text" : "Fuhrman Nuclear Grade for Clear Cell Renal Carcinoma",
            "description" : "The Fuhrman Nuclear Grade is a histopathological classification system used to stratify the severity of clear cell renal cell carcinoma (ccRCC). It assesses nuclear features across three criteria: size, shape, and nucleolar prominence, and assigns a grade from 1 to 4 based on the most severe observed feature."
          },
          "gt0009" : {
            "id" : "gt0009",
            "text" : "Grade 1 rule",
            "description" : "The nuclei of the tumor cells are small (< 10 µm), hyperchromatic, and round (resembling mature lymphocytes), with no visible nucleoli and little detail in the chromatin, as shown in the image below."
          },
