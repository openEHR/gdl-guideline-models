    "rules" : {
      "gt0080" : {
        "id" : "gt0080",
        "priority" : 18,
        "when" : [
          "$gt0003|Haemoglobin|!=null",
          "$gt0003|Haemoglobin|.magnitude>=130",
          "$gt0077|Sex|!=null&&$gt0077|Sex|==1|local::at0016|Male|"
        ],
        "then" : [
          "$gt0033|Haemoglobin (Hb)|.value=0|local::at0036|Hb >13 g/dl in men (or >12 g/dl in women)|"
        ]
      },
      "gt0081" : {
        "id" : "gt0081",
        "priority" : 17,
        "when" : [
          "$gt0003|Haemoglobin|!=null",
          "$gt0003|Haemoglobin|.magnitude>=120&&$gt0003|Haemoglobin|.magnitude<=129",
          "$gt0077|Sex|!=null&&$gt0077|Sex|==1|local::at0016|Male|"
        ],
        "then" : [
          "$gt0033|Haemoglobin (Hb)|.value=1|local::at0037|Hb 12 - 13 g/dl in men (or 10 - 12 g/dl in women)|"
        ]
      },
      "gt0082" : {
        "id" : "gt0082",
        "priority" : 16,
        "when" : [
          "$gt0003|Haemoglobin|!=null",
          "$gt0003|Haemoglobin|.magnitude>=100&&$gt0003|Haemoglobin|.magnitude<=119",
          "$gt0077|Sex|!=null&&$gt0077|Sex|==1|local::at0016|Male|"
        ],
        "then" : [
          "$gt0033|Haemoglobin (Hb)|.value=3|local::at0038|Hb 10 - 12 g/dl in men|"
        ]
      },
      "gt0083" : {
        "id" : "gt0083",
        "priority" : 15,
        "when" : [
          "$gt0003|Haemoglobin|!=null",
          "$gt0003|Haemoglobin|.magnitude<100",
          "$gt0077|Sex|!=null&&$gt0077|Sex|==1|local::at0016|Male|"
        ],
        "then" : [
          "$gt0033|Haemoglobin (Hb)|.value=6|local::at0039|Hb <10 g/dl in men or women|"
        ]
      },
      "gt0084" : {
        "id" : "gt0084",
        "priority" : 14,
        "when" : [
          "$gt0077|Sex|!=null&&$gt0077|Sex|==0|local::at0015|Female|",
          "$gt0003|Haemoglobin|.magnitude>=120"
        ],
        "then" : [
          "$gt0033|Haemoglobin (Hb)|=0|local::at0036|Hb >13 g/dl in men (or >12 g/dl in women)|"
        ]
      },
      "gt0085" : {
        "id" : "gt0085",
        "priority" : 13,
        "when" : [
          "$gt0077|Sex|!=null&&$gt0077|Sex|==0|local::at0015|Female|",
          "$gt0003|Haemoglobin|.magnitude>=100&&$gt0003|Haemoglobin|.magnitude<=119"
        ],
        "then" : [
          "$gt0033|Haemoglobin (Hb)|=1|local::at0037|Hb 12 - 13 g/dl in men (or 10 - 12 g/dl in women)|"
        ]
      },
      "gt0086" : {
        "id" : "gt0086",
        "priority" : 12,
        "when" : [
          "$gt0077|Sex|!=null&&$gt0077|Sex|==0|local::at0015|Female|",
          "$gt0003|Haemoglobin|.magnitude<100"
        ],
        "then" : [
          "$gt0033|Haemoglobin (Hb)|=6|local::at0039|Hb <10 g/dl in men or women|"
        ]
      },
      "gt0087" : {
        "id" : "gt0087",
        "priority" : 11,
        "when" : [
          "$gt0005|Urea|!=null",
          "$gt0005|Urea|.magnitude<6.5"
        ],
        "then" : [
          "$gt0032|Blood Urea Nitrogen (BUN)|.value=0|local::at0031|BUN <18.2 mg/dl|"
        ]
      },
      "gt0088" : {
        "id" : "gt0088",
        "priority" : 10,
        "when" : [
          "$gt0005|Urea|!=null",
          "$gt0005|Urea|.magnitude>=6.5&&$gt0005|Urea|.magnitude<8"
        ],
        "then" : [
          "$gt0032|Blood Urea Nitrogen (BUN)|.value=2|local::at0032|BUN = 18.2 - <22.4 mg/dl|"
        ]
      },
      "gt0089" : {
        "id" : "gt0089",
        "priority" : 9,
        "when" : [
          "$gt0005|Urea|!=null",
          "$gt0005|Urea|.magnitude>=8&&$gt0005|Urea|.magnitude<10"
        ],
        "then" : [
          "$gt0032|Blood Urea Nitrogen (BUN)|.value=3|local::at0033|BUN = 22.4 - <28 mg/dl|"
        ]
      },
      "gt0090" : {
        "id" : "gt0090",
        "priority" : 8,
        "when" : [
          "$gt0005|Urea|!=null",
          "$gt0005|Urea|.magnitude>=10&&$gt0005|Urea|.magnitude<=25"
        ],
        "then" : [
          "$gt0032|Blood Urea Nitrogen (BUN)|.value=4|local::at0034|BUN = 28 - <70.01 mg/dl|"
        ]
      },
      "gt0091" : {
        "id" : "gt0091",
        "priority" : 7,
        "when" : [
          "$gt0005|Urea|!=null",
          "$gt0005|Urea|.magnitude>25"
        ],
        "then" : [
          "$gt0032|Blood Urea Nitrogen (BUN)|.value=6|local::at0035|BUN >=70.01 mg/dl|"
        ]
      },
      "gt0092" : {
        "id" : "gt0092",
        "priority" : 6,
        "when" : [
          "$gt0011|Rate|!=null",
          "$gt0011|Rate|.magnitude>=110"
        ],
        "then" : [
          "$gt0035|Systolic blood pressure (SBP)|.value=0|local::at0027|SBP >=110 mmHg|"
        ]
      },
      "gt0093" : {
        "id" : "gt0093",
        "priority" : 5,
        "when" : [
          "$gt0011|Rate|!=null",
          "$gt0011|Rate|.magnitude>=100&&$gt0011|Rate|.magnitude<=109"
        ],
        "then" : [
          "$gt0035|Systolic blood pressure (SBP)|.value=1|local::at0028|SBP = 100 - 109 mmHg|"
        ]
      },
      "gt0094" : {
        "id" : "gt0094",
        "priority" : 4,
        "when" : [
          "$gt0011|Rate|!=null",
          "$gt0011|Rate|.magnitude>=90&&$gt0011|Rate|.magnitude<=99"
        ],
        "then" : [
          "$gt0035|Systolic blood pressure (SBP)|.value=2|local::at0029|SBP = 90 - 99 mmHg|"
        ]
      },
      "gt0095" : {
        "id" : "gt0095",
        "priority" : 3,
        "when" : [
          "$gt0011|Rate|!=null",
          "$gt0011|Rate|.magnitude<90"
        ],
        "then" : [
          "$gt0035|Systolic blood pressure (SBP)|.value=3|local::at0030|SBP <90 mmHg|"
        ]
      },
      "gt0096" : {
        "id" : "gt0096",
        "priority" : 2,
        "when" : [
