          }
        }
      }
    },
    "rules" : {
      "gt0013" : {
        "id" : "gt0013",
        "priority" : 5,
        "when" : [
          "$gt0003|Tremor|!=null",
          "$gt0004|Sweating|!=null",
          "$gt0005|Hallucinations|!=null",
          "$gt0006|Orientation|!=null",
          "$gt0007|Agitation|!=null"
        ],
        "then" : [
          "$gt0009|Total score|.magnitude=$gt0003|Tremor|.value+$gt0004|Sweating|.value+$gt0005|Hallucinations|.value+$gt0006|Orientation|.value+$gt0007|Agitation|.value"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 4,
        "when" : [
          "$gt0009|Total score|==0"
        ],
        "then" : [
          "$gt0011|Recommended Medication|=$gt0015|No benzodiazepine|.term",
          "$gt0012|Reassessment Interval|=$gt0016|Reassess in 2 hours|.term"
        ]
      },
      "gt0021" : {
        "id" : "gt0021",
        "priority" : 3,
        "when" : [
          "$gt0009|Total score|>=1",
          "$gt0009|Total score|<=3"
        ],
        "then" : [
          "$gt0011|Recommended Medication|=$gt0017|Diazepam 10 mg PO/IV ×1; Alt: Lorazepam 2 mg|.term",
          "$gt0012|Reassessment Interval|=$gt0016|Reassess in 2 hours|.term"
        ]
      },
      "gt0022" : {
        "id" : "gt0022",
        "priority" : 2,
        "when" : [
          "$gt0009|Total score|>=4",
          "$gt0009|Total score|<=8"
        ],
        "then" : [
          "$gt0011|Recommended Medication|=$gt0018|Diazepam 20 mg PO/IV ×1; Alt: Lorazepam 4 mg |.term",
          "$gt0012|Reassessment Interval|=$gt0019|Reassess in 1 hour|.term"
        ]
      },
      "gt0023" : {
        "id" : "gt0023",
        "priority" : 1,
        "when" : [
          "$gt0009|Total score|>=9",
          "$gt0009|Total score|<=10"
        ],
        "then" : [
          "$gt0011|Recommended Medication|=$gt0018|Diazepam 20 mg PO/IV ×1; Alt: Lorazepam 4 mg |.term",
          "$gt0012|Reassessment Interval|=$gt0019|Reassess in 1 hour|.term"
        ]
      }
    }
  },
