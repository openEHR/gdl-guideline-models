    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To support identification of patients at low or high probability of cirrhosis and to assist in predicting likelihood of sustained virological response to antiviral therapy.",
        "keywords" : [
          "Chronic hepatitis C",
          "liver cirrhosis",
          "fibrosis assessment",
          "GUCI",
          "non-invasive index",
          "antiviral response prediction"
        ],
        "use" : "Used in adult patients with chronic hepatitis C to non-invasively estimate the probability of liver cirrhosis and support risk stratification and treatment planning.",
        "misuse" : "Not validated for other liver diseases, acute hepatic conditions, or pediatric patients, and must not replace clinical judgment, imaging, elastography, or biopsy when indicated.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "https://pubmed.ncbi.nlm.nih.gov/16109665/\nhttps://login.proxybibl.vgregion.se/login?qurl=https://pubmed.ncbi.nlm.nih.gov%2f18938750%2f",
      "en" : "A laboratory-based clinical decision guideline that estimates the probability of established liver cirrhosis in adult patients with chronic hepatitis C. The index combines AST (ASAT), AST upper reference limit, INR, and platelet count into a composite score reflecting hepatic necroinflammatory activity and portal hypertension–related thrombocytopenia."
    }
  },
