          }
        }
      }
    },
    "rules" : {
      "gt0009" : {
        "id" : "gt0009",
        "priority" : 1,
        "when" : [
          "$gt0003|ASAT|!=null",
          "$gt0004|Övre referens|!=null",
          "$gt0005|PK-INR|!=null",
          "$gt0006|TPK|!=null"
        ],
        "then" : [
          "$gt0008|GUCI-score|.magnitude=$gt0003|ASAT|.magnitude*$gt0005|PK-INR|.magnitude*100",
          "$gt0008|GUCI-score|.precision=2"
        ]
      }
    }
