          "gt0001" : {
            "id" : "gt0001",
            "text" : "Göteborg University Cirrhosis Index (GUCI)",
            "description" : "A laboratory-based clinical decision guideline that estimates the probability of established liver cirrhosis in adult patients with chronic hepatitis C. The index combines AST (ASAT), AST upper reference limit, INR, and platelet count into a composite score reflecting hepatic necroinflammatory activity and portal hypertension–related thrombocytopenia."
          },
