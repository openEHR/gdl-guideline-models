    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the GUCI from structured laboratory results and present the calculated result in a reproducible way.",
        "keywords" : [
          "guci",
          "göteborg",
          "cirrhosis",
          "index",
          "hepatitis c",
          "aspartate aminotransferase",
          "asat",
          "international normalised ratio",
          "platelet count",
          "thrombocytes",
          "liver fibrosis"
        ],
        "use" : "Use to calculate the Göteborg University Cirrhosis Index from:\n\naspartate aminotransferase;\nupper reference limit for aspartate aminotransferase;\ninternational normalized ratio; and\nplatelet count.",
        "misuse" : "Not to be used for calculating fibrosis scores other than GUCI, such as APRI or FIB-4. Not to be used when the required laboratory values are unavailable or not comparable in unit and scale.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "https://pubmed.ncbi.nlm.nih.gov/16109665/\nhttps://login.proxybibl.vgregion.se/login?qurl=https://pubmed.ncbi.nlm.nih.gov%2f18938750%2f",
      "en" : "A clinical decision support guideline used to calculate the Göteborg University Cirrhosis Index from laboratory data in adults with chronic hepatitis C."
    }
  },
