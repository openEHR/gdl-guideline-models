      },
      "gt0015" : {
        "id" : "gt0015",
        "model_id" : "openEHR-EHR-OBSERVATION.guci_index.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.guci_index.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0016" : {
            "id" : "gt0016",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0008]",
            "data_type" : "DV_QUANTITY"
          }
        }
      }
    },
    "rules" : {
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 1,
        "when" : [
          "$gt0011|ASAT|!=null",
          "$gt0012|Övre referens|!=null",
          "$gt0013|PK-INR|!=null",
          "$gt0014|TPK|!=null",
          "$gt0011|ASAT|.magnitude>=0",
          "$gt0012|Övre referens|.magnitude>=0.5",
          "$gt0013|PK-INR|.magnitude>=0.5",
          "$gt0014|TPK|.magnitude>=0.5"
        ],
        "then" : [
          "$gt0016|GUCI-score|.magnitude=($gt0011|ASAT|.magnitude*$gt0013|PK-INR|.magnitude*100)/($gt0014|TPK|.magnitude*$gt0012|Övre referens|.magnitude)",
          "$gt0016|GUCI-score|.precision=2"
        ]
      }
    }
  },
