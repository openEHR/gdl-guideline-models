    "rules" : {
      "gt0009" : {
        "id" : "gt0009",
        "priority" : 1,
        "when" : [
          "$gt0003|ASAT|!=null",
          "$gt0004|Övre referens|!=null",
          "$gt0005|PK-INR|!=null",
          "$gt0006|TPK|!=null"
        ],
        "then" : [
          "$gt0008|GUCI-score|.magnitude=$gt0003|ASAT|.magnitude*$gt0005|PK-INR|.magnitude*100",
          "$gt0008|GUCI-score|.precision=2"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 2,
        "when" : [
          "$gt0012|ASAT result|!=null",
          "$gt0017|Upper reference result|!=null",
          "$gt0023|TPK result|!=null",
          "$gt0028|PK-INR|!=null"
        ],
        "then" : [
          "$gt0008|GUCI-score|.magnitude=$gt0012|ASAT result|.magnitude*$gt0028|PK-INR|.magnitude*100",
          "$gt0008|GUCI-score|.precision=2"
        ]
      }
    }
