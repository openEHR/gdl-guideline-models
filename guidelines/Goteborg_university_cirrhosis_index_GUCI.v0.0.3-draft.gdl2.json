          "gt0001" : {
            "id" : "gt0001",
            "text" : "Göteborg University Cirrhosis Index (GUCI)",
            "description" : "Calculates the Göteborg University Cirrhosis Index (GUCI) to estimate the probability of liver cirrhosis in patients with chronic hepatitis C."
          },
          "gt0007" : {
            "id" : "gt0007",
            "text" : "openEHR-EHR-OBSERVATION.guci_index.v0"
          },
