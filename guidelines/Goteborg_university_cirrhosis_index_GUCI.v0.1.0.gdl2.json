    "rules" : {
      "gt0005" : {
        "id" : "gt0005",
        "priority" : 1,
        "when" : [
          "$gt0004|AST result|!=null",
          "$gt0015|TPK result|!=null",
          "$gt0021|PK-INR result|!=null",
          "$gt0023|Upper reference|!=null"
        ],
        "then" : [
          "$gt0018|GUCI-score|.magnitude=($gt0004|AST result|.magnitude*$gt0021|PK-INR result|.magnitude*100)/($gt0015|TPK result|.magnitude*$gt0023|Upper reference|.magnitude)",
          "$gt0018|GUCI-score|.precision=2",
          "$gt0018|GUCI-score|.unit='1'"
        ]
      }
    }
