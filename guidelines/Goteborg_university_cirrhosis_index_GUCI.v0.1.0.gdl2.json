    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the GUCI score to estimate the probability of liver cirrhosis in adult patients with chronic hepatitis C.",
        "keywords" : [
          "GUCI",
          "cirrhosis",
          "hepatitis",
          "fibrosis",
          "liver",
          "antiviral",
          "INR",
          "platelets",
          "AST"
        ],
        "use" : "Use in adult patients with chronic hepatitis C.\nGUCI &lt; 1.0 is associated with low risk of liver cirrhosis (NPV 97%).\nGUCI &lt; 0.33 is associated with 80% probability of sustained virological response to antiviral therapy (interferon and ribavirin).\nGUCI &gt; 1.11 corresponds to a sustained virological response rate of only 20%.",
        "misuse" : "Not validated for other liver diseases, acute hepatic conditions, or pediatric patients, and must not replace clinical judgment, imaging, elastography, or biopsy when indicated.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Islam S, Antonsson L, Westin J, Lagging M. Cirrhosis in hepatitis C virus-infected patients can be excluded using an index of standard biochemical serum markers. Scand J Gastroenterol. 2005 Jul;40(7):867-72. doi: 10.1080/00365520510015674. PMID: 16109665.\n\nWestin J, Ydreborg M, Islam S, Alsiö A, Dhillon AP, Pawlotsky JM, Zeuzem S, Schalm SW, Ferrari C, Neumann AU, Hellstrand K, Lagging M; DITTO-HCV Study Group. A non-invasive fibrosis score predicts treatment outcome in chronic hepatitis C virus infection. Scand J Gastroenterol. 2008 Jan;43(1):73-80. doi: 10.1080/00365520701514461. PMID: 18938750.",
      "en" : "Calculates the Göteborg University Cirrhosis Index (GUCI) to estimate the probability of liver cirrhosis in patients with chronic hepatitis C."
    }
  },
