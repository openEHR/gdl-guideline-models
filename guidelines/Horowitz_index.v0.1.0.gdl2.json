            "id" : "gt0027",
            "path" : "/data/events/time",
            "data_type" : "DV_DATE_TIME"
          },
          "gt0025" : {
            "id" : "gt0025",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[openEHR-EHR-CLUSTER.laboratory_test_analyte.v1]/items[at0001]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "kPa",
              "mm[Hg]"
            ]
          }
        }
      },
      "gt0028" : {
        "id" : "gt0028",
        "model_id" : "openEHR-EHR-OBSERVATION.respiration.v2",
        "template_id" : "openEHR-EHR-OBSERVATION.respiration.v2",
        "type" : "INPUT",
        "elements" : {
          "gt0030" : {
            "id" : "gt0030",
            "path" : "/data/events/time",
            "data_type" : "DV_DATE_TIME"
          },
          "gt0029" : {
            "id" : "gt0029",
            "path" : "/data[at0001]/events[at0002]/state[at0022]/items[openEHR-EHR-CLUSTER.inspired_oxygen.v1]/items[at0052]"
          }
        }
      },
      "gt0031" : {
        "id" : "gt0031",
        "model_id" : "openEHR-EHR-OBSERVATION.pf_ratio.v1",
        "template_id" : "openEHR-EHR-OBSERVATION.pf_ratio.v1",
        "type" : "OUTPUT",
        "elements" : {
          "gt0032" : {
            "id" : "gt0032",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "kPa",
              "mm[Hg]"
            ]
          },
          "gt0033" : {
            "id" : "gt0033",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0007]",
            "data_type" : "DV_TEXT"
          }
        }
      }
    },
    "rules" : {
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 5,
        "when" : [
          "$gt0025|PaO2|!=null",
          "$gt0029|FiO₂|!=null"
        ],
        "then" : [
          "$gt0032|P/F Ratio|.magnitude=$gt0025|PaO2|.magnitude/($gt0029|FiO₂|/100)",
          "$gt0032|P/F Ratio|.unit=$gt0025|PaO2|.unit",
          "$gt0032|P/F Ratio|.precision=1"
        ]
      },
      "gt0019" : {
        "id" : "gt0019",
        "priority" : 4,
        "when" : [
          "$gt0032|P/F Ratio|<=100,mm[Hg]||$gt0032|P/F Ratio|<=13,kPa"
        ],
        "then" : [
          "$gt0033|Clinical interpretation|=$gt0034|Severe ARDS|.term"
        ]
      },
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 3,
        "when" : [
          "$gt0032|P/F Ratio|<=200,mm[Hg]||$gt0032|P/F Ratio|<=27,kPa",
          "$gt0032|P/F Ratio|>100,mm[Hg]||$gt0032|P/F Ratio|>13,kPa"
        ],
        "then" : [
          "$gt0033|Clinical interpretation|=$gt0035|Moderate ARDS|.term"
        ]
      },
      "gt0021" : {
        "id" : "gt0021",
        "priority" : 2,
        "when" : [
          "$gt0032|P/F Ratio|<=300,mm[Hg]||$gt0032|P/F Ratio|<=40,kPa",
          "$gt0032|P/F Ratio|>200,mm[Hg]||$gt0032|P/F Ratio|>27,kPa"
        ],
        "then" : [
          "$gt0033|Clinical interpretation|=$gt0036|Mild ARDS|.term"
        ]
      },
      "gt0022" : {
        "id" : "gt0022",
        "priority" : 1,
        "when" : [
          "$gt0032|P/F Ratio|>300,mm[Hg]||$gt0032|P/F Ratio|>40,kPa"
        ],
        "then" : [
          "$gt0033|Clinical interpretation|=$gt0037|Normal|.term"
        ]
      }
    }
  },
