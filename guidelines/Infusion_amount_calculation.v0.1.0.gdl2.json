            "text" : "Drop time"
          },
          "gt0004" : {
            "id" : "gt0004",
            "text" : "Drop rate"
          },
          "gt0007" : {
            "id" : "gt0007",
            "text" : "Calculating Infusion amount",
            "description" : "Amount = (time * rate * 60) / 20"
          },
          "gt0008" : {
            "id" : "gt0008",
            "text" : "openEHR-EHR-OBSERVATION.infusion_factors.v0"
          },
          "gt0009" : {
