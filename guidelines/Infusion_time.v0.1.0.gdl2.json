  "id" : "Infusion_time.v0.1.0",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Mahmoud Elachi",
      "email" : "mel.achi@gmail.com",
      "organisation" : "Cambio CDS",
      "date" : "2026-06-17"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To support healthcare professionals in estimating how long an infusion will take in clinical settings.",
        "keywords" : [
          "fluid volume",
          "infusion",
          "infusion time",
          "IV therapy",
          "duration",
          "fluid administration"
        ],
        "use" : "Used in hospitals and clinical environments to plan and monitor IV fluid administration.\nTime = 20 * 1000 / 60 * amount / rate\nTime in hours, rate in drops per minute, Assumption: 20 drops per milliliter.",
        "misuse" : "Not to record rate, volume or time other than for infusion fluids.",
        "copyright" : "Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "https://verktyg.internetmedicin.se/kalkylatorer/infusionstid",
      "en" : "Calculates the duration of an intravenous infusion based on total infusion volume and infusion rate. The result is expressed as a time duration."
    }
  },
  "definition" : {
    "data_bindings" : {
      "gt0002" : {
        "id" : "gt0002",
        "model_id" : "openEHR-EHR-OBSERVATION.infusion_factors.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.infusion_factors.v0",
        "type" : "INPUT",
        "elements" : {
          "gt0003" : {
            "id" : "gt0003",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "ml",
              "l"
            ]
          },
          "gt0010" : {
            "id" : "gt0010",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0006]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "drops/min"
            ]
          }
        }
      },
      "gt0005" : {
        "id" : "gt0005",
        "model_id" : "openEHR-EHR-OBSERVATION.infusion_factors.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.infusion_factors.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0011" : {
            "id" : "gt0011",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0005]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "h"
            ]
          }
        }
      }
    },
    "rules" : {
      "gt0007" : {
        "id" : "gt0007",
        "priority" : 1,
        "when" : [
          "$gt0003|Infusion volume|!=null",
          "$gt0003|Infusion volume|.unit=='l'",
          "$gt0010|Drop rate|!=null"
        ],
        "then" : [
          "$gt0011|infusion time|.magnitude=(20*1000/60)*($gt0003|Infusion volume|.magnitude/$gt0010|Drop rate|.magnitude)",
          "$gt0011|infusion time|.unit='h'",
          "$gt0011|infusion time|.precision=1"
        ]
      },
      "gt0012" : {
        "id" : "gt0012",
        "priority" : 1,
        "when" : [
          "$gt0003|Infusion volume|!=null",
          "$gt0003|Infusion volume|.unit=='ml'",
          "$gt0010|Drop rate|!=null"
        ],
        "then" : [
          "$gt0011|infusion time|.magnitude=(20/60)*($gt0003|Infusion volume|.magnitude/$gt0010|Drop rate|.magnitude)",
          "$gt0011|infusion time|.unit='h'",
          "$gt0011|infusion time|.precision=1"
        ]
      }
    }
  },
