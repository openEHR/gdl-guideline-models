    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the predicted 5-year probability of kidney failure in adults with chronic kidney disease using the Kidney Failure Risk Calculator (KFRE).",
        "keywords" : [
          "kidney",
          "failure",
          "risk",
          "equation",
          "kfre",
          "calculator",
          "chronic",
          "disease",
          "ckd"
        ],
        "use" : "Use to predict the 5-year risk of progression to kidney failure in adult patients with chronic kidney disease (CKD).\nThe prediction is calculated using the following variables:\nAge (years)\nSex (male/female)\nRegion (North America / Non–North America)\neGFR (mL/min/1.73 m²)\nUrine albumin to creatinine ratio (mg/g)\nAlbumin (g/dL)\nPhosphorus (mg/dL)\nBicarbonate (mEq/L)\nCalcium (mg/dL)",
        "misuse" : "Not to be used for recording information related to other chronic kidney disease risk prediction models or renal outcome calculators.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Tangri N, Stevens LA, Griffith J, et al. A Predictive Model for Progression of Chronic Kidney Disease to Kidney Failure. JAMA. 2011;305(15):1553–1559. doi:10.1001/jama.2011.451",
      "en" : "A calculation model used to estimate the 5-year probability of kidney failure in adults (≥18 years) with chronic kidney disease (CKD)."
    }
  },
