    "pre_conditions" : [
      "$gt0003|Age|.magnitude>=18&&$gt0003|Age|.magnitude<=110",
      "$gt0007|Relative eGFR|.magnitude>=0&&$gt0007|Relative eGFR|.magnitude<=200",
      "$gt0010|Urine albumin to creatinine ratio result|.magnitude>0&&$gt0010|Urine albumin to creatinine ratio result|.magnitude<=25000",
      "$gt0013|Albumin result|.magnitude>=0&&$gt0013|Albumin result|.magnitude<=7",
      "$gt0016|Phosphorous result|.magnitude>=0&&$gt0016|Phosphorous result|.magnitude<=100",
      "$gt0019|Bicarbonate result|.magnitude>0&&$gt0019|Bicarbonate result|.magnitude<=100",
      "$gt0022|Calcium result|.magnitude>=4&&$gt0022|Calcium result|.magnitude<=18"
    ],
    "rules" : {
      "gt0030" : {
        "id" : "gt0030",
        "priority" : 4,
        "when" : [
          "$gt0035|Age|!=null",
          "$gt0036|Gender|!=null",
          "$gt0005|Region|!=null",
          "$gt0007|Relative eGFR|!=null",
          "$gt0010|Urine albumin to creatinine ratio result|!=null",
          "$gt0013|Albumin result|!=null",
          "$gt0016|Phosphorous result|!=null",
          "$gt0019|Bicarbonate result|!=null",
          "$gt0022|Calcium result|!=null",
          "$gt0036|Gender|==local::at0005|Male|",
          "$gt0005|Region|==local::at0013|North America|"
        ],
        "then" : [
          "$gt0024|5-year risk of kidney failure|.magnitude=(1-0.9096^exp(0-0.1992*(($gt0035|Age|.magnitude/10)-7.036)+0.1602*(1-0.5642)-0.4919*(($gt0007|Relative eGFR|.magnitude/5)-7.222)+0.3364*(log($gt0010|Urine albumin to creatinine ratio result|.magnitude)-5.137)-0.3441*($gt0013|Albumin result|.magnitude-3.997)+0.2604*($gt0016|Phosphorous result|.magnitude-3.916)-0.07354*($gt0019|Bicarbonate result|.magnitude-25.57)-0.2228*($gt0022|Calcium result|.magnitude-9.355)))*100",
          "$gt0024|5-year risk of kidney failure|.precision=2",
          "$gt0024|5-year risk of kidney failure|.unit='%'"
        ]
      },
      "gt0031" : {
        "id" : "gt0031",
        "priority" : 3,
        "when" : [
          "$gt0003|Age|!=null",
          "$gt0004|Sex|!=null",
          "$gt0005|Region|!=null",
          "$gt0007|Relative eGFR|!=null",
          "$gt0010|Urine albumin to creatinine ratio result|!=null",
          "$gt0013|Albumin result|!=null",
          "$gt0016|Phosphorous result|!=null",
          "$gt0019|Bicarbonate result|!=null",
          "$gt0022|Calcium result|!=null",
          "$gt0004|Sex|==local::at0010|Female|",
          "$gt0005|Region|==local::at0013|North America|"
        ],
        "then" : [
          "$gt0024|5-year risk of kidney failure|.magnitude=(1-0.9096^exp(0-0.1992*(($gt0003|Age|.magnitude/10)-7.036)+0.1602*(0-0.5642)-0.4919*(($gt0007|Relative eGFR|.magnitude/5)-7.222)+0.3364*(log($gt0010|Urine albumin to creatinine ratio result|.magnitude)-5.137)-0.3441*($gt0013|Albumin result|.magnitude-3.997)+0.2604*($gt0016|Phosphorous result|.magnitude-3.916)-0.07354*($gt0019|Bicarbonate result|.magnitude-25.57)-0.2228*($gt0022|Calcium result|.magnitude-9.355)))*100",
          "$gt0024|5-year risk of kidney failure|.precision=2",
          "$gt0024|5-year risk of kidney failure|.unit='%'"
        ]
      },
      "gt0033" : {
        "id" : "gt0033",
        "priority" : 2,
        "when" : [
          "$gt0003|Age|!=null",
          "$gt0004|Sex|!=null",
          "$gt0005|Region|!=null",
          "$gt0007|Relative eGFR|!=null",
          "$gt0010|Urine albumin to creatinine ratio result|!=null",
          "$gt0013|Albumin result|!=null",
          "$gt0016|Phosphorous result|!=null",
          "$gt0019|Bicarbonate result|!=null",
          "$gt0022|Calcium result|!=null",
          "$gt0004|Sex|==local::at0011|Male|",
          "$gt0005|Region|==local::at0014|Non-North America|"
        ],
        "then" : [
          "$gt0024|5-year risk of kidney failure|.magnitude=(1-0.9245^exp(0-0.1992*(($gt0003|Age|.magnitude/10)-7.036)+0.1602*(1-0.5642)-0.4919*(($gt0007|Relative eGFR|.magnitude/5)-7.222)+0.3364*(log($gt0010|Urine albumin to creatinine ratio result|.magnitude)-5.137)-0.3441*($gt0013|Albumin result|.magnitude-3.997)+0.2604*($gt0016|Phosphorous result|.magnitude-3.916)-0.07354*($gt0019|Bicarbonate result|.magnitude-25.57)-0.2228*($gt0022|Calcium result|.magnitude-9.355)))*100",
          "$gt0024|5-year risk of kidney failure|.precision=2",
          "$gt0024|5-year risk of kidney failure|.unit='%'"
        ]
      },
      "gt0032" : {
        "id" : "gt0032",
        "priority" : 1,
        "when" : [
          "$gt0003|Age|!=null",
          "$gt0004|Sex|!=null",
          "$gt0005|Region|!=null",
          "$gt0007|Relative eGFR|!=null",
          "$gt0010|Urine albumin to creatinine ratio result|!=null",
          "$gt0013|Albumin result|!=null",
          "$gt0016|Phosphorous result|!=null",
          "$gt0019|Bicarbonate result|!=null",
          "$gt0022|Calcium result|!=null",
          "$gt0004|Sex|==local::at0010|Female|",
          "$gt0005|Region|==local::at0014|Non-North America|"
        ],
        "then" : [
          "$gt0024|5-year risk of kidney failure|.magnitude=(1-0.9245^exp(0-0.1992*(($gt0003|Age|.magnitude/10)-7.036)+0.1602*(0-0.5642)-0.4919*(($gt0007|Relative eGFR|.magnitude/5)-7.222)+0.3364*(log($gt0010|Urine albumin to creatinine ratio result|.magnitude)-5.137)-0.3441*($gt0013|Albumin result|.magnitude-3.997)+0.2604*($gt0016|Phosphorous result|.magnitude-3.916)-0.07354*($gt0019|Bicarbonate result|.magnitude-25.57)-0.2228*($gt0022|Calcium result|.magnitude-9.355)))*100",
          "$gt0024|5-year risk of kidney failure|.precision=2",
          "$gt0024|5-year risk of kidney failure|.unit='%'"
        ]
      }
