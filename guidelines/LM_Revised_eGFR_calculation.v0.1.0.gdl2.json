            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0013]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "a",
              "mo",
              "wk",
              "d"
            ]
          }
        }
      },
      "gt0017" : {
        "id" : "gt0017",
        "model_id" : "openEHR-EHR-OBSERVATION.laboratory_test_result.v1",
        "template_id" : "openEHR-EHR-OBSERVATION.laboratory_test_result.v1",
        "type" : "INPUT",
        "elements" : {
          "gt0018" : {
            "id" : "gt0018",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[openEHR-EHR-CLUSTER.laboratory_test_analyte.v1]/items[at0024]",
            "data_type" : "DV_TEXT"
          },
          "gt0019" : {
            "id" : "gt0019",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[openEHR-EHR-CLUSTER.laboratory_test_analyte.v1]/items[at0001]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "umol/L"
            ]
          }
        },
        "predicates" : [
          "/data[at0001]/events[at0002]/data[at0003]/items[openEHR-EHR-CLUSTER.laboratory_test_analyte.v1]/items[at0024] is_a local::gt0020|Plasma Creatinine code|"
        ]
      },
      "gt0021" : {
        "id" : "gt0021",
        "model_id" : "openEHR-EHR-OBSERVATION.estimated_glomerular_filtration_rate.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.estimated_glomerular_filtration_rate.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0022" : {
            "id" : "gt0022",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "mL/min/{1.73_m2}"
            ]
          }
        }
      }
    },
    "rules" : {
      "gt0013" : {
        "id" : "gt0013",
        "priority" : 4,
        "when" : [
          "$gt0003|Gender|==local::at0006|Female|",
          "$gt0019|Plasma Creatinine result|.magnitude<150",
          "$gt0004|Age|!=null"
        ],
        "then" : [
          "$gt0022|Relative eGFR|.magnitude=2.718^((2.5+(0.0121*(150-$gt0019|Plasma Creatinine result|.magnitude)))-(0.0158*$gt0004|Age|.magnitude)+(0.438*log($gt0004|Age|.magnitude)))",
          "$gt0022|Relative eGFR|.unit='mL/min/{1.73_m2}'",
          "$gt0022|Relative eGFR|.precision=0"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 3,
        "when" : [
          "$gt0003|Gender|==local::at0006|Female|",
          "$gt0019|Plasma Creatinine result|.magnitude>=150",
          "$gt0004|Age|!=null"
        ],
        "then" : [
          "$gt0022|Relative eGFR|.magnitude=2.718^((2.5-(0.926*log($gt0019|Plasma Creatinine result|.magnitude/150)))-(0.0158*$gt0004|Age|.magnitude)+(0.438*log($gt0004|Age|.magnitude)))",
          "$gt0022|Relative eGFR|.unit='mL/min/{1.73_m2}'",
          "$gt0022|Relative eGFR|.precision=0"
        ]
      },
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 2,
        "when" : [
          "$gt0003|Gender|==local::at0005|Male|",
          "$gt0019|Plasma Creatinine result|.magnitude<180",
          "$gt0004|Age|!=null"
        ],
        "then" : [
          "$gt0022|Relative eGFR|.magnitude=2.718^((2.56+(0.00968*(180-$gt0019|Plasma Creatinine result|.magnitude)))-(0.0158*$gt0004|Age|.magnitude)+(0.438*log($gt0004|Age|.magnitude)))",
          "$gt0022|Relative eGFR|.unit='mL/min/{1.73_m2}'",
          "$gt0022|Relative eGFR|.precision=0"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 1,
        "when" : [
          "$gt0003|Gender|==local::at0005|Male|",
          "$gt0019|Plasma Creatinine result|.magnitude>=180",
          "$gt0004|Age|!=null"
        ],
        "then" : [
          "$gt0022|Relative eGFR|.magnitude=2.718^((2.56-(0.926*log($gt0019|Plasma Creatinine result|.magnitude/180)))-(0.0158*$gt0004|Age|.magnitude)+(0.438*log($gt0004|Age|.magnitude)))",
          "$gt0022|Relative eGFR|.unit='mL/min/{1.73_m2}'",
          "$gt0022|Relative eGFR|.precision=0"
        ]
      }
    }
