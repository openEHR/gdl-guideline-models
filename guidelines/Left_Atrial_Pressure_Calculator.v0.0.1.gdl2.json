        "template_id" : "openEHR-EHR-OBSERVATION.left_atrial_pressure.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0007" : {
            "id" : "gt0007",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0007]",
            "data_type" : "DV_QUANTITY",
            "units" : [
