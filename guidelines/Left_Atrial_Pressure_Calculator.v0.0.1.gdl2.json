            ]
          }
        }
      },
      "gt0010" : {
        "id" : "gt0010",
        "model_id" : "openEHR-EHR-EVALUATION.health_risk.v1",
        "template_id" : "openEHR-EHR-EVALUATION.health_risk.v1",
        "type" : "OUTPUT",
        "elements" : {
          "gt0011" : {
            "id" : "gt0011",
            "path" : "/data[at0001]/items[at0015]",
            "data_type" : "DV_TEXT"
          }
        }
      }
    },
    "rules" : {
      "gt0008" : {
        "id" : "gt0008",
        "priority" : 1,
        "when" : [
          "$gt0003|Systolic|!=null",
          "$gt0005|Maximum mitral regurgitation velocity|!=null"
        ],
        "then" : [
          "$gt0007|Left Atrial Pressure (LAP)|.magnitude=$gt0003|Systolic|.magnitude-(4*($gt0005|Maximum mitral regurgitation velocity|.magnitude^2))",
          "$gt0007|Left Atrial Pressure (LAP)|.unit='mmHg'",
          "$gt0011|LAP normal range|=$gt0009|6 – 12 mmHg|.term"
        ]
      }
    }
  },
