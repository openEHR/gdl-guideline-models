  "description" : {
    "original_author" : {
      "name" : "Kevin Arjona",
      "email" : "kevin.arjona@cambio.se",
      "organisation" : "Cambio CDS",
      "date" : "2026-08-27"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the LAP using Doppler echocardiography parameters.",
        "keywords" : [
          "lap",
          "left",
          "atrial",
          "pressure",
          "echocardiography",
          "dysfunction",
          "heart",
          "failure",
          "cardiology",
          "systolic",
          "regurgitation",
          "mitral"
        ],
        "use" : "Use to calculate LAP using the maximum mitral regurgitation velocity and systolic blood pressure\n\nFormula:\n\nLeft atrial pressure = SBP – 4 x (MR VMAX)2\n\nWhere:\n\nMR VMAX = maximum mitral regurgitation velocity\nSBP = systolic blood pressure",
        "misuse" : "Do not use in patients with heavy mitral annular calcification, mitral valve prostheses, severe mitral stenosis, or severe mitral regurgitation without clinical adjustment.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Gorcsan J 3rd, Snow FR, Paulsen W, Nixon JV. Noninvasive estimation of left atrial pressure in patients with congestive heart failure and mitral regurgitation by Doppler echocardiography. Am Heart J. 1991 Mar;121(3 Pt 1):858-63. doi: 10.1016/0002-8703(91)90199-r. PMID: 2000753.\n\nNishimura RA, Tajik AJ. Determination of left-sided pressure gradients by utilizing Doppler aortic and mitral regurgitant signals: validation by simultaneous dual catheter and Doppler studies. J Am Coll Cardiol. 1988 Feb;11(2):317-21. doi: 10.1016/0735-1097(88)90096-4. PMID: 3339169.\n\nGe Z, Zhang Y, Fan D, Zhang M, Duran CM. Simultaneous measurement of left atrial pressure by Doppler echocardiography and catheterization. Int J Cardiol. 1992 Nov;37(2):243-51. doi: 10.1016/0167-5273(92)90215-o. PMID: 1452383.",
      "en" : "using the maximum mitral regurgitation velocity and systolic blood pressure"
    }
  },
