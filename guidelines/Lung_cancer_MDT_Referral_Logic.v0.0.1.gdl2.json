    "rules" : {
      "gt0019" : {
        "id" : "gt0019",
        "priority" : 5,
        "when" : [
          "$gt0012|N stage|==local::at0027|N2|||$gt0012|N stage|==local::at0028|N3|"
        ],
        "then" : [
          "$gt0003|Referral recommended|=true"
        ]
      },
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 4,
        "when" : [
