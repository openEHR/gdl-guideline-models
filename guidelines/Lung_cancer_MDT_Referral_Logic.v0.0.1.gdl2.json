      "gt0021" : {
        "id" : "gt0021",
        "priority" : 3,
        "when" : [
          "$gt0017|Tumor location|==local::at0034|Central|"
        ]
      },
      "gt0022" : {
        "id" : "gt0022",
        "priority" : 2,
        "when" : [
          "$gt0018|Signs of mediastinal invasion|==true"
        ],
        "then" : [
          "$gt0003|Referral recommended|=true"
        ]
      },
      "gt0023" : {
        "id" : "gt0023",
        "priority" : 1,
        "when" : [
          "$gt0012|N stage|!=local::at0027|N2|||$gt0012|N stage|!=local::at0028|N3|",
          "$gt0016|PET-CT Lymph Node Uptake|!=true",
          "$gt0017|Tumor location|!=local::at0034|Central|",
          "$gt0018|Signs of mediastinal invasion|!=true"
        ],
        "then" : [
          "$gt0003|Referral recommended|=false"
        ]
      }
    }
