  "description" : {
    "original_author" : {
      "name" : "Mahmoud Elachi",
      "email" : "mel.achi@gmail.com",
      "organisation" : "Cambio CDS"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To record morphology and immunohistochemical findings relevant for subtyping lung cancer according to current national guidelines.",
        "keywords" : [
          "lung cancer",
          "histopathology",
          "biomarker",
          "immunohistochemistry",
          "diagnosis"
        ],
        "use" : "Used during pathological assessment of lung tumor tissue. Supports diagnostic classification into adenocarcinoma, squamous cell carcinoma, small-cell lung cancer, or other subtypes.",
        "misuse" : "Not intended for molecular genetic testing or treatment planning. Do not use for non-lung tumors.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Regionala cancercentrum i samverkan. Nationellt vårdprogram lungcancer. Kunskapsbanken, 2025.\nAvailable at: kunskapsbanken.cancercentrum.se/diagnoser/lungcancer/vardprogram/",
      "en" : "A clinical decision guideline for classifying the histopathological subtype of lung cancer in patients with suspected or confirmed malignancy, based on tumor morphology and immunohistochemical markers such as TTF-1, p40, CK5/6, synaptophysin, chromogranin A, and Ki-67."
    }
  },
