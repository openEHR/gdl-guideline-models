    "rules" : {
      "gt0006" : {
        "id" : "gt0006",
        "priority" : 7,
        "when" : [
          "$gt0003|Tumor morphology|==local::at0059|Glandular|&&$gt0007|TTF-1 result|==local::at0070|Positive|"
        ],
        "then" : [
          "$gt0005|Histological subtype|=local::at0094|Adenocarcinoma|"
        ]
      },
      "gt0008" : {
        "id" : "gt0008",
        "priority" : 6,
        "when" : [
          "$gt0003|Tumor morphology|==local::at0060|Keratinizing|&&($gt0009|p40 result|==local::at0074|Positive|||$gt0010|CK5/6 result|==local::at0078|Positive|)"
        ],
        "then" : [
          "$gt0005|Histological subtype|=local::at0095|Squamous cell carcinoma|"
        ]
      },
      "gt0013" : {
        "id" : "gt0013",
        "priority" : 5,
        "when" : [
          "$gt0003|Tumor morphology|==local::at0061|Small-cell|&&($gt0011|Synaptophysin result|==local::at0082|Positive|||$gt0012|Chromogranin result|==local::at0086|Positive|)"
        ],
        "then" : [
          "$gt0005|Histological subtype|=local::at0096|Small-cell carcinoma|"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 4,
        "when" : [
          "$gt0003|Tumor morphology|!=null&&$gt0003|Tumor morphology|==local::at0059|Glandular|",
          "$gt0007|TTF-1 result|==local::at0071|Negative|||$gt0007|TTF-1 result|==local::at0072|Not done|||$gt0007|TTF-1 result|==null"
        ],
        "then" : [
          "$gt0005|Histological subtype|=local::at0097|Other|"
        ]
      },
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 3,
        "when" : [
          "$gt0003|Tumor morphology|!=null&&$gt0003|Tumor morphology|==local::at0060|Keratinizing|",
          "$gt0009|p40 result|==local::at0075|Negative|||$gt0009|p40 result|==local::at0076|Not done|||$gt0009|p40 result|==null",
          "$gt0010|CK5/6 result|==local::at0079|Negative|||$gt0010|CK5/6 result|==local::at0080|Not done|||$gt0010|CK5/6 result|==null"
        ],
        "then" : [
          "$gt0005|Histological subtype|=local::at0097|Other|"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 2,
        "when" : [
          "$gt0003|Tumor morphology|!=null&&$gt0003|Tumor morphology|==local::at0061|Small-cell|",
          "$gt0011|Synaptophysin result|==local::at0083|Negative|||$gt0011|Synaptophysin result|==local::at0084|Not done|||$gt0011|Synaptophysin result|==null",
          "$gt0012|Chromogranin result|==local::at0087|Negative|||$gt0012|Chromogranin result|==local::at0088|Not done|||$gt0012|Chromogranin result|==null"
        ],
        "then" : [
          "$gt0005|Histological subtype|=local::at0097|Other|"
        ]
      },
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 1,
        "when" : [
          "$gt0003|Tumor morphology|!=local::at0059|Glandular|",
          "$gt0003|Tumor morphology|!=local::at0060|Keratinizing|",
          "$gt0003|Tumor morphology|!=local::at0061|Small-cell|"
        ],
        "then" : [
          "$gt0005|Histological subtype|=local::at0098|Unclassified|"
        ]
      }
    }
