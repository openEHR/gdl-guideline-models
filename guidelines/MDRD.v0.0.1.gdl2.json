          },
          "gt0008" : {
            "id" : "gt0008",
            "text" : "Estimated Glomerular Filtration Rate"
          },
          "gt0009" : {
            "id" : "gt0009",
            "text" : "Calculate clearance for women",
            "description" : "clearance = 186,3 * (S-creatinine / 88,4)-1,154 * age-0,203 (* 0,742 om kvinna) Clearance i ml/min/1,73 m2, S-creatinine i µmol/L, age i yr."
          },
          "gt0010" : {
            "id" : "gt0010",
            "text" : "Calculate clearance for men",
            "description" : "clearance = 186,3 * (S-creatinine / 88,4)-1,154 * age-0,203 (* 0,742 om kvinna) Clearance i ml/min/1,73 m2, S-creatinine i µmol/L, age i yr."
          }
        }
      }
    }
  }
}