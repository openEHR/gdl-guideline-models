    "pre_conditions" : [
      "$gt0042|Respiratory Rate|!=null",
      "$gt0043|Heart Rate|!=null",
      "$gt0044|Systolic Blood Pressure|!=null",
      "$gt0045|Temperature|!=null",
      "$gt0046|Level of consciousness|!=null",
      "$gt0047|Urine output/24 hr|!=null"
    ],
    "rules" : {
      "gt0040" : {
        "id" : "gt0040",
        "priority" : 1,
        "when" : [
          "$gt0042|Respiratory Rate|!=null",
          "$gt0043|Heart Rate|!=null",
          "$gt0044|Systolic Blood Pressure|!=null",
          "$gt0045|Temperature|!=null",
          "$gt0046|Level of consciousness|!=null",
          "$gt0047|Urine output/24 hr|!=null"
        ],
        "then" : [
          "$gt0049|Total score|=$gt0042|Respiratory Rate|.value+$gt0043|Heart Rate|.value+$gt0044|Systolic Blood Pressure|.value+$gt0045|Temperature|.value+$gt0046|Level of consciousness|.value+$gt0047|Urine output/24 hr|.value"
        ]
      }
