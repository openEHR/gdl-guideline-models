          "$gt0023|Substrate concentration [S]|.unit=='mol/L'"
        ],
        "then" : [
          "$gt0030|S in mmol/L|.magnitude=$gt0023|Substrate concentration [S]|.magnitude*1000",
          "$gt0030|S in mmol/L|.unit='mmol/L'",
          "$gt0030|S in mmol/L|.precision=2",
          "$gt0031|S in umol/L|.magnitude=$gt0023|Substrate concentration [S]|.magnitude*1000000",
          "$gt0031|S in umol/L|.unit='umol/L'",
          "$gt0031|S in umol/L|.precision=2",
          "$gt0032|S in nmol/L|.magnitude=$gt0023|Substrate concentration [S]|.magnitude*1000000000",
          "$gt0032|S in nmol/L|.unit='nmol/L'",
          "$gt0032|S in nmol/L|.precision=2"
        ]
      },
      "gt0123" : {
        "id" : "gt0123",
        "priority" : 9,
        "when" : [
          "$gt0024|Maximum rate (Vmax)|!=null",
