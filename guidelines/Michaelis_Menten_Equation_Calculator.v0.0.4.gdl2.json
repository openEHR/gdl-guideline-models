        "then" : [
          "$gt0106|Local: V0 in 1/s|=$gt0017|Reaction rate (V0)|.magnitude"
        ]
      },
      "gt0118" : {
        "id" : "gt0118",
        "priority" : 19,
        "when" : [
          "$gt0017|Reaction rate (V0)|!=null",
          "$gt0017|Reaction rate (V0)|.magnitude!=null",
          "$gt0017|Reaction rate (V0)|.unit=='1/min'"
        ],
        "then" : [
          "$gt0106|Local: V0 in 1/s|=$gt0017|Reaction rate (V0)|.magnitude/60"
        ]
      },
      "gt0103" : {
        "id" : "gt0103",
        "priority" : 18,
        "when" : [
          "$gt0019|Maximum rate (Vmax)|!=null",
          "$gt0019|Maximum rate (Vmax)|.magnitude!=null",
          "$gt0019|Maximum rate (Vmax)|.unit=='1/s'"
        ],
        "then" : [
          "$gt0107|Local: Vmax in 1/s|=$gt0019|Maximum rate (Vmax)|.magnitude"
        ]
      },
      "gt0119" : {
        "id" : "gt0119",
        "priority" : 17,
        "when" : [
          "$gt0019|Maximum rate (Vmax)|!=null",
          "$gt0019|Maximum rate (Vmax)|.magnitude!=null",
          "$gt0019|Maximum rate (Vmax)|.unit=='1/min'"
        ],
        "then" : [
          "$gt0107|Local: Vmax in 1/s|=$gt0019|Maximum rate (Vmax)|.magnitude/60"
        ]
      },
      "gt0110" : {
        "id" : "gt0110",
        "priority" : 16,
        "when" : [
          "$gt0017|Reaction rate (V0)|==null",
          "$gt0018|Substrate concentration [S]|!=null",
          "$gt0018|Substrate concentration [S]|.magnitude!=null",
          "$gt0019|Maximum rate (Vmax)|!=null",
          "$gt0019|Maximum rate (Vmax)|.magnitude!=null",
          "$gt0020|Michaelis constant (Km)|!=null",
          "$gt0020|Michaelis constant (Km)|.magnitude!=null",
          "$gt0104|Local: S in mol/L|!=null",
          "$gt0105|Local: Km in mol/L|!=null",
          "$gt0107|Local: Vmax in 1/s|!=null",
          "$gt0104|Local: S in mol/L|+$gt0105|Local: Km in mol/L|>0"
        ],
        "then" : [
          "$gt0022|Reaction rate (V0)|.magnitude=($gt0107|Local: Vmax in 1/s|*$gt0104|Local: S in mol/L|)/($gt0104|Local: S in mol/L|+$gt0105|Local: Km in mol/L|)",
          "$gt0022|Reaction rate (V0)|.unit='1/s'",
          "$gt0022|Reaction rate (V0)|.precision=6"
        ]
      },
      "gt0111" : {
        "id" : "gt0111",
        "priority" : 15,
        "when" : [
          "$gt0019|Maximum rate (Vmax)|==null",
          "$gt0017|Reaction rate (V0)|!=null",
          "$gt0017|Reaction rate (V0)|.magnitude!=null",
          "$gt0018|Substrate concentration [S]|!=null",
          "$gt0018|Substrate concentration [S]|.magnitude!=null",
          "$gt0020|Michaelis constant (Km)|!=null",
          "$gt0020|Michaelis constant (Km)|.magnitude!=null",
          "$gt0104|Local: S in mol/L|!=null",
          "$gt0105|Local: Km in mol/L|!=null",
          "$gt0106|Local: V0 in 1/s|!=null",
          "$gt0104|Local: S in mol/L|>0"
        ],
        "then" : [
          "$gt0024|Maximum rate (Vmax)|.magnitude=$gt0106|Local: V0 in 1/s|*($gt0104|Local: S in mol/L|+$gt0105|Local: Km in mol/L|)/$gt0104|Local: S in mol/L|",
          "$gt0024|Maximum rate (Vmax)|.unit='1/s'",
          "$gt0024|Maximum rate (Vmax)|.precision=6"
        ]
      },
      "gt0112" : {
        "id" : "gt0112",
        "priority" : 14,
        "when" : [
          "$gt0018|Substrate concentration [S]|==null",
          "$gt0017|Reaction rate (V0)|!=null",
          "$gt0017|Reaction rate (V0)|.magnitude!=null",
          "$gt0019|Maximum rate (Vmax)|!=null",
          "$gt0019|Maximum rate (Vmax)|.magnitude!=null",
          "$gt0020|Michaelis constant (Km)|!=null",
          "$gt0020|Michaelis constant (Km)|.magnitude!=null",
          "$gt0105|Local: Km in mol/L|!=null",
          "$gt0106|Local: V0 in 1/s|!=null",
          "$gt0107|Local: Vmax in 1/s|!=null",
          "$gt0107|Local: Vmax in 1/s|>$gt0106|Local: V0 in 1/s|"
        ],
        "then" : [
          "$gt0023|Substrate concentration [S]|.magnitude=($gt0106|Local: V0 in 1/s|*$gt0105|Local: Km in mol/L|)/($gt0107|Local: Vmax in 1/s|-$gt0106|Local: V0 in 1/s|)",
          "$gt0023|Substrate concentration [S]|.unit='mol/L'",
          "$gt0023|Substrate concentration [S]|.precision=6"
        ]
      },
      "gt0113" : {
        "id" : "gt0113",
        "priority" : 13,
        "when" : [
          "$gt0020|Michaelis constant (Km)|==null",
          "$gt0017|Reaction rate (V0)|!=null",
          "$gt0017|Reaction rate (V0)|.magnitude!=null",
          "$gt0018|Substrate concentration [S]|!=null",
          "$gt0018|Substrate concentration [S]|.magnitude!=null",
          "$gt0019|Maximum rate (Vmax)|!=null",
          "$gt0019|Maximum rate (Vmax)|.magnitude!=null",
          "$gt0104|Local: S in mol/L|!=null",
          "$gt0106|Local: V0 in 1/s|!=null",
          "$gt0107|Local: Vmax in 1/s|!=null",
          "$gt0106|Local: V0 in 1/s|>0"
        ],
        "then" : [
          "$gt0025|Michaelis constant (Km)|.magnitude=($gt0107|Local: Vmax in 1/s|*$gt0104|Local: S in mol/L|/$gt0106|Local: V0 in 1/s|)-$gt0104|Local: S in mol/L|",
          "$gt0025|Michaelis constant (Km)|.unit='mol/L'",
          "$gt0025|Michaelis constant (Km)|.precision=6"
        ]
      },
      "gt0120" : {
        "id" : "gt0120",
        "priority" : 12,
        "when" : [
          "$gt0025|Michaelis constant (Km)|!=null",
          "$gt0025|Michaelis constant (Km)|.magnitude!=null",
          "$gt0025|Michaelis constant (Km)|.unit=='mol/L'"
        ],
        "then" : [
          "$gt0026|Km in mmol/L|.magnitude=$gt0025|Michaelis constant (Km)|.magnitude*1000",
          "$gt0026|Km in mmol/L|.unit='mmol/L'",
          "$gt0026|Km in mmol/L|.precision=2",
          "$gt0027|Km in umol/L|.magnitude=$gt0025|Michaelis constant (Km)|.magnitude*1000000",
          "$gt0027|Km in umol/L|.unit='umol/L'",
          "$gt0027|Km in umol/L|.precision=2",
          "$gt0028|Km in nmol/L|.magnitude=$gt0025|Michaelis constant (Km)|.magnitude*1000000000",
          "$gt0028|Km in nmol/L|.unit='nmol/L'",
          "$gt0028|Km in nmol/L|.precision=2"
        ]
      },
      "gt0121" : {
        "id" : "gt0121",
        "priority" : 11,
        "when" : [
          "$gt0022|Reaction rate (V0)|!=null",
          "$gt0022|Reaction rate (V0)|.magnitude!=null",
          "$gt0022|Reaction rate (V0)|.unit=='1/s'"
        ],
        "then" : [
          "$gt0029|V0 in 1/min|.magnitude=$gt0022|Reaction rate (V0)|.magnitude*60",
          "$gt0029|V0 in 1/min|.unit='1/min'",
          "$gt0029|V0 in 1/min|.precision=2"
        ]
      },
      "gt0122" : {
        "id" : "gt0122",
        "priority" : 10,
        "when" : [
          "$gt0023|Substrate concentration [S]|!=null",
