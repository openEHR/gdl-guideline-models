    "default_actions" : [
      "$gt0030|Gene expression indication|=local::at0037|Not applicable|",
      "$gt0031|Germline BRCA1/2 testing indication|=local::at0042|Not applicable|",
      "$gt0032|Somatic PIK3CA testing indication|=local::at0045|Not applicable|",
      "$gt0033|Broad genomic profiling indication|=local::at0048|Not applicable|"
    ],
    "rules" : {
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 7,
        "when" : [
          "$gt0007|Menopausal status|==local::at0023|Postmenopausal|",
          "$gt0008|Lymph node status|==local::at0025|Node-negative (N0)|",
          "$gt0003|ER status|==local::at0008|Positive|",
          "$gt0004|HER2 status|==local::at0012|Negative|",
          "$gt0009|Uncertain tumor risk categorization prior to selection of cytostatic treatment|==true"
        ],
        "then" : [
          "$gt0030|Gene expression indication|=local::at0038|Recommended|"
        ]
      },
      "gt0024" : {
        "id" : "gt0024",
        "priority" : 6,
        "when" : [
          "$gt0007|Menopausal status|==local::at0023|Postmenopausal|",
          "$gt0003|ER status|==local::at0008|Positive|",
          "$gt0004|HER2 status|==local::at0012|Negative|",
          "$gt0008|Lymph node status|==local::at0026|1-3 positive lymph nodes (N1-3)|",
          "$gt0006|NHG grade|==local::at0019|Grade 2|",
          "$gt0005|Ki-67 category|==local::at0015|Intermediate|"
        ],
        "then" : [
          "$gt0030|Gene expression indication|=local::at0039|May be considered|"
        ]
      },
      "gt0025" : {
        "id" : "gt0025",
        "priority" : 5,
        "when" : [
          "$gt0007|Menopausal status|==local::at0022|Premenopausal|",
          "$gt0003|ER status|==local::at0008|Positive|",
          "$gt0004|HER2 status|==local::at0012|Negative|",
          "$gt0008|Lymph node status|==local::at0025|Node-negative (N0)|"
        ],
        "then" : [
          "$gt0030|Gene expression indication|=local::at0040|With Oncotype Dx may be considered|"
        ]
      },
      "gt0026" : {
        "id" : "gt0026",
        "priority" : 4,
        "when" : [
          "$gt0010|Possible candidate for PARP inhibitors|==true"
        ],
        "then" : [
          "$gt0031|Germline BRCA1/2 testing indication|=local::at0043|Recommended|"
        ]
      },
      "gt0027" : {
        "id" : "gt0027",
        "priority" : 3,
        "when" : [
          "$gt0011|Possible candidate for PI3K inhibitor|==true"
        ],
        "then" : [
          "$gt0032|Somatic PIK3CA testing indication|=local::at0046|Recommended|"
        ]
      },
      "gt0028" : {
        "id" : "gt0028",
        "priority" : 2,
        "when" : [
          "$gt0012|Disease stage|==local::at0032|Metastatic breast cancer|",
          "($gt0034|Eligible for ESCAT I targeted treatments|==true)||(($gt0035|Evidence-based treatment options exhausted|==true)&&($gt0036|Suitable for relevant clinical trials|==true))"
        ],
        "then" : [
          "$gt0033|Broad genomic profiling indication|=local::at0049|May be considered|"
        ]
      }
    }
  },
