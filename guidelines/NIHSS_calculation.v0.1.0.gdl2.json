    "rules" : {
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 1,
        "when" : [
          "$gt0003|1a. LOC Responsiveness|!=null",
          "$gt0004|1b. LOC Questions|!=null",
          "$gt0005|1c. LOC Commands|!=null",
          "$gt0006|2. Horizontal eye movement|!=null",
          "$gt0007|3. Visual|!=null",
          "$gt0008|4. Facial palsy|!=null",
          "$gt0009|5a. Left arm motor|!=null",
          "$gt0010|5b. Right arm motor|!=null",
          "$gt0011|6a. Left leg motor|!=null",
          "$gt0012|6b. Right leg motor|!=null",
          "$gt0013|7. Limb ataxia|!=null",
          "$gt0014|8. Sensory|!=null",
          "$gt0015|9. Best language|!=null",
          "$gt0016|10. Dysarthria|!=null",
          "$gt0017|11. Extinction and Inattention|!=null"
        ],
        "then" : [
          "$gt0019|Total score|.magnitude=$gt0003|1a. LOC Responsiveness|.value+$gt0004|1b. LOC Questions|.value+$gt0005|1c. LOC Commands|.value+$gt0006|2. Horizontal eye movement|.value+$gt0007|3. Visual|.value+$gt0008|4. Facial palsy|.value+$gt0009|5a. Left arm motor|.value+$gt0010|5b. Right arm motor|.value+$gt0011|6a. Left leg motor|.value+$gt0012|6b. Right leg motor|.value+$gt0013|7. Limb ataxia|.value+$gt0014|8. Sensory|.value+$gt0015|9. Best language|.value+$gt0016|10. Dysarthria|.value+$gt0017|11. Extinction and Inattention|.value"
        ]
      }
    }
