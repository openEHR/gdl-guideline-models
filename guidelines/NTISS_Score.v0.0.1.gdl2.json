  "ontology" : {
    "term_definitions" : {
      "en" : {
        "id" : "en",
        "terms" : {
          "gt0001" : {
            "id" : "gt0001",
            "text" : "NTISS Score",
            "description" : "The NTISS Score (Neonatal Therapeutic Intervention Scoring System) is a severity-of-illness index for neonatal intensive care, derived by modifying the Therapeutic Intervention Scoring System (TISS), that quantifies the intensity and complexity of therapeutic interventions a newborn receives during a defined scoring period."
          },
