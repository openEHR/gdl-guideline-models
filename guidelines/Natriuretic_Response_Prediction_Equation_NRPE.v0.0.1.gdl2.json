    "lifecycle_state" : "REVIEWED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the Natriuretic Response Prediction Equation (NRPE) to estimate early natriuretic response in adult patients (≥18 years) hospitalized with acute decompensated heart failure (ADHF) receiving intravenous loop diuretics.",
        "keywords" : [
          "NRPE",
          "natriuretic",
          "response",
          "prediction",
          "equation",
          "ADHF",
          "acute",
          "decompensated",
          "heart",
          "failure"
        ],
        "use" : "Use to rapidly determine natriuretic response in adult patients with ADHF receiving IV loop diuretics. The equation is calculated using body surface area (BSA), estimated glomerular filtration rate (eGFR), serum creatinine, urine creatinine, and urine sodium concentration.\nThe calculated NRPE value predicts 6-hour natriuresis and supports discrimination between poor, suboptimal, and excellent natriuretic responders.",
        "misuse" : "Not to be used for calculations outside the context of IV loop diuretic therapy in hospitalized patients with acute decompensated heart failure (ADHF), as applicability in other clinical settings is uncertain.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Testani JM, Hanberg JS, Cheng S, Rao V, Onyebeke C, Laur O, Kula A, Chen M, Wilson FP, Darlington A, Bellumkonda L, Jacoby D, Tang WH, Parikh CR. Rapid and Highly Accurate Prediction of Poor Loop Diuretic Natriuretic Response in Patients With Heart Failure. Circ Heart Fail. 2016 Jan;9(1):e002370. doi: 10.1161/CIRCHEARTFAILURE.115.002370. PMID: 26721915; PMCID: PMC4741370.",
      "en" : "An assessment equation used to predict early natriuretic response in adults hospitalized with acute decompensated heart failure (ADHF) receiving intravenous loop diuretics."
    }
  },
