    "rules" : {
      "gt0024" : {
        "id" : "gt0024",
        "priority" : 5,
        "when" : [
          "$gt0003|Relative eGFR|!=null",
          "$gt0005|Height/Length|!=null",
          "$gt0007|Weight|!=null",
          "$gt0010|Serum creatinine result|!=null",
          "$gt0016|Urine creatinine result|!=null",
          "$gt0019|Urine sodium concentration result|!=null"
        ],
        "then" : [
          "$gt0022|Predicted 6-hour urine output|.magnitude=$gt0003|Relative eGFR|.magnitude*((0.007184*($gt0005|Height/Length|.magnitude^0.725)*($gt0007|Weight|.magnitude^0.425))/1.73)*($gt0010|Serum creatinine result|.magnitude/$gt0016|Urine creatinine result|.magnitude)*60.0*3.25",
          "$gt0022|Predicted 6-hour urine output|.precision=0",
          "$gt0022|Predicted 6-hour urine output|.unit='mL'"
        ]
      },
      "gt0025" : {
        "id" : "gt0025",
        "priority" : 4,
        "when" : [
          "$gt0003|Relative eGFR|!=null",
          "$gt0005|Height/Length|!=null",
          "$gt0007|Weight|!=null",
          "$gt0010|Serum creatinine result|!=null",
          "$gt0016|Urine creatinine result|!=null",
          "$gt0019|Urine sodium concentration result|!=null"
        ],
        "then" : [
          "$gt0021|Predicted 6-hour sodium (Na) output|.magnitude=$gt0003|Relative eGFR|.magnitude*((0.007184*($gt0005|Height/Length|.magnitude^0.725)*($gt0007|Weight|.magnitude^0.425))/1.73)*($gt0010|Serum creatinine result|.magnitude/$gt0016|Urine creatinine result|.magnitude)*60.0*3.25*($gt0019|Urine sodium concentration result|.magnitude/1000.0)",
          "$gt0021|Predicted 6-hour sodium (Na) output|.precision=1",
          "$gt0021|Predicted 6-hour sodium (Na) output|.unit='mmol'"
        ]
      },
      "gt0026" : {
        "id" : "gt0026",
        "priority" : 3,
        "when" : [
          "$gt0021|Predicted 6-hour sodium (Na) output|!=null",
          "$gt0021|Predicted 6-hour sodium (Na) output|.magnitude<=50"
        ],
        "then" : [
          "$gt0023|Response Category|=$gt0027|Poor natriuretic response (≤50 mmol Na)|.term"
        ]
      },
      "gt0030" : {
        "id" : "gt0030",
        "priority" : 2,
        "when" : [
          "$gt0021|Predicted 6-hour sodium (Na) output|!=null",
          "$gt0021|Predicted 6-hour sodium (Na) output|.magnitude>50",
          "$gt0021|Predicted 6-hour sodium (Na) output|.magnitude<=100"
        ],
        "then" : [
          "$gt0023|Response Category|=$gt0028|Suboptimal natriuretic response (>50 to ≤100 mmol Na)|.term"
        ]
      },
      "gt0031" : {
        "id" : "gt0031",
        "priority" : 1,
        "when" : [
          "$gt0021|Predicted 6-hour sodium (Na) output|!=null",
          "$gt0021|Predicted 6-hour sodium (Na) output|.magnitude>100"
        ],
        "then" : [
          "$gt0023|Response Category|=$gt0029|Excellent natriuretic response (>100 mmol Na)|.term"
        ]
      }
    }
  },
