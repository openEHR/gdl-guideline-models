  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Dennis Forslund",
      "email" : "models@cambiocds.com",
      "organisation" : "Cambio CDS",
      "date" : "2016-11-20"
    },
    "other_contributors" : [
      "Jimmy Axelsson",
      "Linda Guttormsdottir",
      "Katja Mariko Wilde"
    ],
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To estimate fluid requirements during the first 24 hours after burn injury by using the Parkland formula.",
        "keywords" : [
          "Parkland",
          "formula",
          "burns",
          "fluid",
          "resuscitation",
          "body",
          "surface",
          "area",
          "tbsa",
          "weight",
          "total"
        ],
        "use" : "Use to estimate fluid requirements during the first 24 hours after burn injury using the Parkland formula.\n\nFormula: Fluid requirement [l] = TBSA burned (%) × body weight [kg] × 4 / 1000\n\nWhere:\n- TBSA = total body surface area burned\n\nThe calculated result represents the estimated total fluid requirement for the first 24 hours after burn injury.\n\nHalf of the calculated fluid volume should generally be administered during the first 8 hours after the burn injury, and the remaining half during the following 16 hours.",
        "misuse" : "Should only be used as guideline along with clinical assessment. Validation studies have found that although the Parkland formula provides an accurate estimate for the first eight hours of fluid requirements, it underestimated the fluid need for the rest of the time period. However, successful resuscitation was performed by use of the formula, hence it can be used for rough estimation to support clinical assessment. ",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Baxter CR. Fluid volume and electrolyte changes of the early postburn period. Clin Plast Surg. 1974 Oct;1(4):693-703. PMID: 4609676.\n\nCartotto RC, Innes M, Musgrave MA, Gomez M, Cooper AB. How well does the Parkland formula estimate actual fluid resuscitation volumes? J Burn Care Rehabil. 2002 Jul-Aug;23(4):258-65. doi: 10.1097/00004630-200207000-00006. PMID: 12142578.",
      "en" : "The Parkland formula for burns is used to estimate fluid requirements during the first 24 hours in burn patients."
    }
  },
  "definition" : {
    "data_bindings" : {
      "gt0002" : {
        "id" : "gt0002",
        "model_id" : "openEHR-EHR-OBSERVATION.parkland_formula_for_burns.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.parkland_formula_for_burns.v0",
        "type" : "INPUT",
        "elements" : {
          "gt0003" : {
            "id" : "gt0003",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0010]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "%"
            ]
          }
        }
      },
      "gt0004" : {
        "id" : "gt0004",
        "model_id" : "openEHR-EHR-OBSERVATION.body_weight.v2",
        "template_id" : "openEHR-EHR-OBSERVATION.body_weight.v2",
        "type" : "INPUT",
        "elements" : {
          "gt0005" : {
            "id" : "gt0005",
            "path" : "/data[at0002]/events[at0003]/data[at0001]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "kg",
              "[lb_av]"
            ]
          }
        }
      },
      "gt0006" : {
        "id" : "gt0006",
        "model_id" : "openEHR-EHR-OBSERVATION.parkland_formula_for_burns.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.parkland_formula_for_burns.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0007" : {
            "id" : "gt0007",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0009]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "l"
            ]
          },
          "gt0008" : {
            "id" : "gt0008",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0013]",
            "data_type" : "DV_TEXT"
          }
        }
      }
    },
    "rules" : {
      "gt0009" : {
        "id" : "gt0009",
        "priority" : 1,
        "when" : [
          "$gt0003|Estimated body burn|!=null",
          "$gt0005|Weight|!=null",
          "$gt0005|Weight|.unit=='kg'"
        ],
        "then" : [
          "$gt0007|Fluid requirement|.magnitude=$gt0003|Estimated body burn|.magnitude*$gt0005|Weight|.magnitude*4/1000",
          "$gt0007|Fluid requirement|.unit='L'",
          "$gt0007|Fluid requirement|.precision=1",
          "$gt0008|Comment|=$gt0010|It is recommended that half the volume be administered during the first 8 hours, and the remaining half during the following 16 hours.|.term"
        ]
      },
      "gt0011" : {
        "id" : "gt0011",
        "priority" : 2,
        "when" : [
          "$gt0005|Weight|!=null",
          "$gt0005|Weight|.unit=='[lb_av]'"
        ],
        "then" : [
          "$gt0005|Weight|.magnitude=$gt0005|Weight|.magnitude/2.20462262",
          "$gt0005|Weight|.unit='kg'",
          "$gt0005|Weight|.precision=3"
        ]
      }
    }
  },
