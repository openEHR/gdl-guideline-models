    "rules" : {
      "gt0013" : {
        "id" : "gt0013",
        "priority" : 6,
        "when" : [
          "$gt0003|AST >200 U/L|!=null",
          "$gt0004|Abdominal wall trauma, distension, or tenderness on exam|!=null",
          "$gt0005|Abnormal chest X-ray|!=null",
          "$gt0006|Complaint of abdominal pain|!=null",
          "$gt0007|Abnormal amylase or lipase|!=null"
        ],
        "then" : [
          "$gt0009|Total score|.magnitude=$gt0003|AST >200 U/L|.value+$gt0004|Abdominal wall trauma, distension, or tenderness on exam|.value+$gt0005|Abnormal chest X-ray|.value+$gt0006|Complaint of abdominal pain|.value+$gt0007|Abnormal amylase or lipase|.value"
        ]
      },
      "gt0024" : {
        "id" : "gt0024",
        "priority" : 5,
        "when" : [
          "$gt0009|Total score|==0"
        ],
        "then" : [
          "$gt0011|Risk of intra-abdominal injury|=$gt0014|0.7%|.term",
          "$gt0012|Risk of intra-abdominal injury requiring acute intervention|=$gt0015|0%|.term"
        ]
      },
      "gt0025" : {
        "id" : "gt0025",
        "priority" : 4,
        "when" : [
          "$gt0009|Total score|==1"
        ],
        "then" : [
          "$gt0011|Risk of intra-abdominal injury|=$gt0016|4.5%|.term",
          "$gt0012|Risk of intra-abdominal injury requiring acute intervention|=$gt0017|0.6%|.term"
        ]
      },
      "gt0026" : {
        "id" : "gt0026",
        "priority" : 3,
        "when" : [
          "$gt0009|Total score|==2"
        ],
        "then" : [
          "$gt0011|Risk of intra-abdominal injury|=$gt0018|16.8%|.term",
          "$gt0012|Risk of intra-abdominal injury requiring acute intervention|=$gt0019|4.8%|.term"
        ]
      },
      "gt0027" : {
        "id" : "gt0027",
        "priority" : 2,
        "when" : [
          "$gt0009|Total score|==3"
        ],
        "then" : [
          "$gt0011|Risk of intra-abdominal injury|=$gt0020|37.8%|.term",
          "$gt0012|Risk of intra-abdominal injury requiring acute intervention|=$gt0021|8.9%|.term"
        ]
      },
      "gt0028" : {
        "id" : "gt0028",
        "priority" : 1,
        "when" : [
          "$gt0009|Total score|>=4"
        ],
        "then" : [
          "$gt0011|Risk of intra-abdominal injury|=$gt0022|62.6%|.term",
          "$gt0012|Risk of intra-abdominal injury requiring acute intervention|=$gt0023|15.2%|.term"
        ]
      }
    }
  },
