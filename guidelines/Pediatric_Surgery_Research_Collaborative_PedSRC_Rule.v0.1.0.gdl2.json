    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the total sum for the Pediatric Surgery Research Collaborative (PedSRC) rule to estimate risk of intra-abdominal injury after blunt abdominal trauma in pediatric patients.",
        "keywords" : [
          "PedSRC",
          "pediatric",
          "surgery",
          "research",
          "collaborative",
          "rule",
          "blunt",
          "abdominal",
          "trauma"
        ],
        "use" : "Use to assess pediatric patients (&lt;16 years) presenting within 6 hours of blunt abdominal trauma who have not yet undergone abdominal CT.\nThe score is calculated by adding the points of the individual variables:\nAST &gt;200 U/L: No 0 points, Yes 1 point\nAbdominal wall trauma, distension, or tenderness on exam: No 0 points, Yes 1 point\nAbnormal chest X-ray: No 0 points, Yes 1 point\nComplaint of abdominal pain: No 0 points, Yes 1 point\nAbnormal amylase or lipase: No 0 points, Yes 1 point\nThe total PedSRC score (0–5) can then be used to display predicted risks for any IAI and IAI requiring acute intervention (IAI-I) and to guide imaging decisions.\n",
        "misuse" : "Not to be used for recording information related to other pediatric blunt abdominal trauma rules.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Streck CJ, Vogel AM, Zhang J, Huang EY, Santore MT, Tsao K, Falcone RA, Dassinger MS, Russell RT, Blakely ML; Pediatric Surgery Research Collaborative. Identifying Children at Very Low Risk for Blunt Intra-Abdominal Injury in Whom CT of the Abdomen Can Be Avoided Safely. J Am Coll Surg. 2017 Apr;224(4):449-458.e3. doi: 10.1016/j.jamcollsurg.2016.12.041. Epub 2017 Jan 24. PMID: 28130170.",
      "en" : "An assessment score used to identify pediatric patients (&lt;16 years) at very low risk of intra-abdominal injury after blunt abdominal trauma."
    }
  },
