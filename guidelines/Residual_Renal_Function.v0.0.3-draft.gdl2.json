    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the residual renal function of patients undergoing dialysis.",
        "keywords" : [
          "hemodialysis",
          "residual",
          "renal",
          "function",
          "dialysis",
          "disease",
          "esrd",
          "creatinine",
          "clearance",
          "kidney",
          "urea",
          "end-stage"
        ],
        "use" : "Applicable to adult dialysis patients with measurable urine output.\nRequires accurate input values for:\n\nInterdialytic urine volume (mL)\n\nUrine urea concentration (mg/dL)\n\nBlood urea nitrogen (BUN) levels (post- and pre-dialysis)\n\nDuration of the interdialytic period (hours).\n\nFill all input fields to calculate the RRF in milliliters per minute per 1.73 m² (mL/min/1.73 m²).",
        "misuse" : "Not to be used for patients with anuria (no urine output).\n\nNot intended to measure residual renal function in patients without dialysis dependency.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Wang AY, Lai KN. The importance of residual renal function in dialysis patients. Kidney Int. 2006 May;69(10):1726-32. doi: 10.1038/sj.ki.5000382. PMID: 16612329.\n\nThomas J, Teitelbaum I. Preservation of residual renal function in dialysis patients. Adv Perit Dial. 2011;27:112-7. PMID: 22073841.\n\nMoist LM, Port FK, Orzol SM, Young EW, Ostbye T, Wolfe RA, Hulbert-Shearon T, Jones CA, Bloembergen WE. Predictors of loss of residual renal function among new dialysis patients. J Am Soc Nephrol. 2000 Mar;11(3):556-564. doi: 10.1681/ASN.V113556. PMID: 10703680.",
      "en" : "A guideline designed to calculate residual renal function (RRF) in dialysis patients. The calculation is based on interdialytic urine volume, urine urea concentration, BUN measurements, and interdialytic period."
    }
  },
