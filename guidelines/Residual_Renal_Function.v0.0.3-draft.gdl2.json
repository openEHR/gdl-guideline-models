    "rules" : {
      "gt0013" : {
        "id" : "gt0013",
        "priority" : 1,
        "when" : [
          "$gt0043|Mean BUN|!=null"
        ],
        "then" : [
          "$gt0044|Residual Renal Function|.magnitude=($gt0037|Interdialytic urine volume|.magnitude*$gt0039|Urine urea concentration (\tmg/dL)|.magnitude)/$gt0038|Interdialytic period|.magnitude/($gt0043|Mean BUN|.magnitude*10)",
          "$gt0044|Residual Renal Function|.precision=3",
          "$gt0044|Residual Renal Function|.unit='ml/min'"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 2,
        "when" : [
          "$gt0037|Interdialytic urine volume|!=null"
        ],
        "then" : [
          "$gt0043|Mean BUN|.magnitude=(($gt0040|BUN after 1st dialysis of week (mg/dL)|.magnitude+$gt0041|BUN prior to 2nd dialysis of week (mg/dL)|.magnitude)/2)*10",
          "$gt0043|Mean BUN|.precision=3",
          "$gt0043|Mean BUN|.unit='mg/L'"
        ]
      }
    }
  },
