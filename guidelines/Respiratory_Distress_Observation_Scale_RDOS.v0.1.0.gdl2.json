    "rules" : {
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 5,
        "when" : [
          "$gt0003|Heart rate per minute|!=null",
          "$gt0004|Respiratory rate per minute|!=null",
          "$gt0005|Restlessness|!=null",
          "$gt0006|Paradoxical breathing pattern|!=null",
          "$gt0007|Accessory muscle use|!=null",
          "$gt0008|Grunting at end-expiration|!=null",
          "$gt0009|Nasal flaring|!=null",
          "$gt0010|Look of fear|!=null"
        ],
        "then" : [
          "$gt0012|Total score|.magnitude=$gt0003|Heart rate per minute|.value+$gt0004|Respiratory rate per minute|.value+$gt0005|Restlessness|.value+$gt0006|Paradoxical breathing pattern|.value+$gt0007|Accessory muscle use|.value+$gt0008|Grunting at end-expiration|.value+$gt0009|Nasal flaring|.value+$gt0010|Look of fear|.value"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 4,
        "when" : [
          "$gt0012|Total score|>=0&&$gt0012|Total score|<=2"
        ],
        "then" : [
          "$gt0014|Severity|=$gt0017|No distress|.term"
        ]
      },
      "gt0021" : {
        "id" : "gt0021",
        "priority" : 3,
        "when" : [
          "$gt0012|Total score|==3"
        ],
        "then" : [
          "$gt0014|Severity|=$gt0018|Mild distress|.term"
        ]
      },
      "gt0022" : {
        "id" : "gt0022",
        "priority" : 2,
        "when" : [
          "$gt0012|Total score|>=4&&$gt0012|Total score|<=6"
        ],
        "then" : [
          "$gt0014|Severity|=$gt0019|Moderate distress|.term"
        ]
      },
      "gt0023" : {
        "id" : "gt0023",
        "priority" : 1,
        "when" : [
          "$gt0012|Total score|>=7"
        ],
        "then" : [
          "$gt0014|Severity|=$gt0020|Severe distress|.term"
        ]
      }
    }
  },
