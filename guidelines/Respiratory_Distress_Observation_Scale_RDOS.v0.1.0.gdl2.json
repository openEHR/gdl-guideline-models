  "description" : {
    "original_author" : {
      "name" : "Katja Mariko Wilde",
      "email" : "katja-wilde@t-online.de",
      "organisation" : "Cambio CDS",
      "date" : "2025-10-20"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the total sum for the RDOS (Respiratory Distress Observation Scale) score to assess the severity of respiratory distress in patients who are unable to self-report symptoms, particularly in ICU and palliative care settings.",
        "keywords" : [
          "rdos",
          "respiratory",
          "distress",
          "observation",
          "scale"
        ],
        "use" : "Use to assess respiratory distress in patients who cannot self-report symptoms.\nThe score is calculated by adding the points of the individual variables:\nHeart rate per minute: &lt;90 beats = 0 points; 90–109 beats  = 1 point; ≥110 beats  = 2 points\nRespiratory rate per minute: ≤18 breaths = 0 points; 19–30 breaths = 1 point; &gt;30 breaths = 2 points\nRestlessness: None = 0 points; Occasional, slight movements = 1 point; Frequent movements = 2 points\nParadoxical breathing pattern: None = 0 points; Present = 2 points\nAccessory muscle use: None = 0 points; Slight rise = 1 point; Pronounced rise = 2 points\nGrunting at end-expiration: None = 0 points; Present = 2 points\nNasal flaring: None = 0 points; Present = 2 points\nLook of fear: None = 0 points; Present = 2 points\n\nThe total RDOS score reflects respiratory distress severity:\n0–2 = No distress\n3 = Mild distress\n4–6 = Moderate distress\n≥7 = Severe distress",
        "misuse" : "Not to be used in patients under neuromuscular blockade or with neuromuscular disease.\nNot to be used for recording information related to other respiratory distress scoring systems.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Campbell ML, Templin T, Walch J. A Respiratory Distress Observation Scale for patients unable to self-report dyspnea. J Palliat Med. 2010 Mar;13(3):285-90. doi: 10.1089/jpm.2009.0229. PMID: 20078243.",
      "en" : "An assessment scale used to quantify respiratory distress in patients who are unable to self-report symptoms, based on observable clinical signs."
    }
  },
