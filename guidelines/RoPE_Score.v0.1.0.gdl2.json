    "pre_conditions" : [
      "$gt0036|History of hypertension|!=null",
      "$gt0037|History of diabetes|!=null",
      "$gt0038|History of stroke or TIA|!=null",
      "$gt0039|Smoker|!=null",
      "$gt0040|Cortical infarct on imaging|!=null",
      "$gt0035|Age|!=null"
    ],
    "rules" : {
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 8,
        "when" : [
          "$gt0036|History of hypertension|!=null",
          "$gt0037|History of diabetes|!=null",
          "$gt0038|History of stroke or TIA|!=null",
          "$gt0039|Smoker|!=null",
          "$gt0040|Cortical infarct on imaging|!=null",
          "$gt0035|Age|!=null"
        ],
        "then" : [
          "$gt0042|Total score|.magnitude=$gt0035.value+$gt0036.value+$gt0037.value+$gt0038.value+$gt0039.value+$gt0040.value"
        ]
      },
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 7,
        "when" : [
          "$gt0042|Total score|>=0",
          "$gt0042|Total score|<4"
        ],
        "then" : [
          "$gt0032|PFO-attributable fraction (95% CI) %|='0%'",
          "$gt0033|Estimated stroke/TIA recurrence at 2 years %|='20%'"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 6,
        "when" : [
          "$gt0042|Total score|==4"
        ],
        "then" : [
          "$gt0032|PFO-attributable fraction (95% CI) %|='38%'",
          "$gt0033|Estimated stroke/TIA recurrence at 2 years %|='12%'"
        ]
      },
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 5,
        "when" : [
          "$gt0042|Total score|==5"
        ],
        "then" : [
          "$gt0032|PFO-attributable fraction (95% CI) %|='34%'",
          "$gt0033|Estimated stroke/TIA recurrence at 2 years %|='7%'"
        ]
      },
      "gt0018" : {
        "id" : "gt0018",
        "priority" : 4,
        "when" : [
          "$gt0042|Total score|==6"
        ],
        "then" : [
          "$gt0032|PFO-attributable fraction (95% CI) %|='62%'",
          "$gt0033|Estimated stroke/TIA recurrence at 2 years %|='8%'"
        ]
      },
      "gt0019" : {
        "id" : "gt0019",
        "priority" : 3,
        "when" : [
          "$gt0042|Total score|==7"
        ],
        "then" : [
          "$gt0032|PFO-attributable fraction (95% CI) %|='72%'",
          "$gt0033|Estimated stroke/TIA recurrence at 2 years %|='6%'"
        ]
      },
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 2,
        "when" : [
          "$gt0042|Total score|==8"
        ],
        "then" : [
          "$gt0032|PFO-attributable fraction (95% CI) %|='84% '",
          "$gt0033|Estimated stroke/TIA recurrence at 2 years %|='6% '"
        ]
      },
      "gt0021" : {
        "id" : "gt0021",
        "priority" : 1,
        "when" : [
          "$gt0042|Total score|>8",
          "$gt0042|Total score|<=10"
        ],
        "then" : [
          "$gt0032|PFO-attributable fraction (95% CI) %|='88% '",
          "$gt0033|Estimated stroke/TIA recurrence at 2 years %|='2% '"
        ]
      }
    }
