      "gt0011" : {
        "id" : "gt0011",
        "model_id" : "openEHR-EHR-EVALUATION.health_risk.v1",
        "template_id" : "openEHR-EHR-EVALUATION.health_risk.v1",
        "type" : "OUTPUT",
        "elements" : {
          "gt0012" : {
            "id" : "gt0012",
            "path" : "/data[at0001]/items[at0003]",
            "data_type" : "DV_TEXT"
          }
        }
      }
    },
    "pre_conditions" : [
      "$gt0003|Age|!=null",
      "$gt0004|Comorbidities|!=null",
      "$gt0005|Shock signs|!=null",
      "$gt0006|Stigmata|!=null",
      "$gt0007|Endoscopy findings|!=null"
    ],
    "rules" : {
      "gt0010" : {
        "id" : "gt0010",
        "priority" : 4,
        "when" : [
          "$gt0003|Age|!=null"
        ],
        "then" : [
          "$gt0009|Total score|.magnitude=$gt0003|Age|.value+$gt0004|Comorbidities|.value+$gt0005|Shock signs|.value+$gt0006|Stigmata|.value+$gt0007|Endoscopy findings|.value"
        ]
      },
      "gt0013" : {
        "id" : "gt0013",
        "priority" : 3,
        "when" : [
          "$gt0009|Total score|>=0",
          "$gt0009|Total score|<=2"
        ],
        "then" : [
          "$gt0012|Risk assessment|=$gt0014|Low risk|.term"
        ]
      },
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 2,
        "when" : [
          "$gt0009|Total score|>=3",
          "$gt0009|Total score|<=8"
        ],
        "then" : [
          "$gt0012|Risk assessment|=$gt0015|Intermediate risk|.term"
        ]
      },
      "gt0018" : {
        "id" : "gt0018",
        "priority" : 1,
        "when" : [
          "$gt0009|Total score|>=9",
          "$gt0009|Total score|<=11"
        ],
        "then" : [
          "$gt0012|Risk assessment|=$gt0016|High risk|.term"
        ]
      }
    }
  },
