  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Maryam Razavi",
      "email" : "maryam.razavi@cambio.se",
      "organisation" : "CambioCDS",
      "date" : "2020-12-17"
    },
    "other_contributors" : [
      "Kevin Arjona"
    ],
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the total sum for the Rockall score and determine severity of GI bleeding.",
        "keywords" : [
          "endoscopy",
          "upper",
          "GI",
          "bleeding",
          "score"
        ],
        "use" : "Use in patients with clinical upper GI bleeding who have undergone endoscopy. The Rockall score formula is the addition of the selected points. Variables and assigned points:\n\n\n- age: &lt; 60 years = 0, 60-79 years = 1, ≥ 80 years = 2.\n\n\n- shock signs: no shock, systolic blood pressure ≥ 100 mmHg, heart rate &lt; 100/ min = 0, tachycardia, systolic blood pressure ≥ 100 mmHg, heart rate &gt; 100/ min = 1, hypotension, systolic blood pressure &lt; 100 mmHg = 2.\n\n\n- comorbidities: no major comorbidity = 0, heart failure, ischemic heart disease, other significant comorbidity = 2, renal failure, liver failure, and/or disseminated malignancy = 3.\n\n\n- endoscopy findings: Mallory-Weiss tear, no lesion, no signs of recent bleeding = 0, all other diagnoses = 1, malignancy of upper GI tract = 2.\n\n\n- stigmata: none or dark spot = 0, blood in the upper GI tract, adherent clot, visible or spurting vessel = 2.",
        "misuse" : "- Not to be used for patients with lower gastrointestinal bleeding.\n- Not to be used for patients who have not completed endoscopy. ",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Rockall TA, Logan RF, Devlin HB, Northfield TC. Risk assessment after acute upper gastrointestinal haemorrhage. Gut. 1996 Mar;38(3):316-21. doi: 10.1136/gut.38.3.316. PMID: 8675081; PMCID: PMC1383057.\n\nTham TC, James C, Kelly M. Predicting outcome of acute non-variceal upper gastrointestinal haemorrhage without endoscopy using the clinical Rockall Score. Postgrad Med J. 2006 Nov;82(973):757-9. doi: 10.1136/pmj.2006.048462. PMID: 17099097; PMCID: PMC2660506.\n\nSanders DS, Perry MJ, Jones SG, McFarlane E, Johnson AG, Gleeson DC, Lobo AJ. Effectiveness of an upper-gastrointestinal haemorrhage unit: a prospective analysis of 900 consecutive cases using the Rockall score as a method of risk standardisation. Eur J Gastroenterol Hepatol. 2004 May;16(5):487-94. doi: 10.1097/00042737-200405000-00009. PMID: 15097042.\n\nVreeburg EM, Terwee CB, Snel P, Rauws EA, Bartelsman JF, Meulen JH, Tytgat GN. Validation of the Rockall risk scoring system in upper gastrointestinal bleeding. Gut. 1999 Mar;44(3):331-5. doi: 10.1136/gut.44.3.331. PMID: 10026316; PMCID: PMC1727413.",
      "en" : "The Rockall score is an assessment score used to identify patients at risk of adverse outcomes, such as rebleeding or death, following acute upper gastrointestinal bleeding."
    }
  },
