  "id" : "Sokal_Index_for_CML.v0.0.1",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Emma Malm",
      "email" : "emma.snygg@hotmail.com",
      "organisation" : "Cambio CDS",
      "date" : "2021-02-25"
    },
    "other_contributors" : [
      "Kevin Arjona"
    ],
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate and assess the calculated value and risk group for the Sokal index.",
        "keywords" : [
          "CML",
          "leukemia",
          "sokal",
          "index",
          "myelogenous",
          "chronic",
          "myeloid",
          "survival",
          "risk",
          "score",
          "oncology",
          "hematology"
        ],
        "use" : "Use to calculate the Sokal index and assess the corresponding risk group in patients with chronic myeloid leukemia. \n\nThe calculation requires continuous variables:\n\nage: patient age in years;\n\nspleen size below costal margin: measured in cm;\n\nplatelet count: measured in 10^9/l;\n\nperipheral blood blasts: measured as a percentage;\n\nthe formula calculates the score as Exp(0.0116 * (age - 43.4) + 0.0345 * (spleen size - 7.51) + 0.188 * ((platelet count / 700)^2 - 0.563) + 0.0887 * (blasts - 2.10)).\n\nThe score is then mapped to a prognostic risk group:\n\nlow risk: score &lt; 0.8, 2-year Survival  90%, Median Survival 5 years;\n\nintermediate risk: score 0.8 to 1.2, 2-year Survival  65-90%, Median Survival 2.5-5 years;\n\nhigh risk: score &gt; 1.2, 2-year Survival 65%, Median Survival 2.5 years.\n",
        "misuse" : "Not to be used for assessment of the Sokal index in patients under 18 years of age. \n\nNot to be used for patients with other myeloproliferative neoplasms.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Sokal JE, Cox EB, Baccarani M, Tura S, Gomez GA, Robertson JE, Tso CY, Braun TJ, Clarkson BD, Cervantes F, et al. Prognostic discrimination in \"good-risk\" chronic granulocytic leukemia. Blood. 1984 Apr;63(4):789-99. PMID: 6584184.",
      "en" : "The Sokal index is a calculation and assessment tool used to predict prognosis in chronic myeloid leukemia and stratify patients into risk groups."
    }
  },
  "definition" : {
    "data_bindings" : {
      "gt0002" : {
        "id" : "gt0002",
        "model_id" : "openEHR-EHR-OBSERVATION.sokal.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.sokal.v0",
        "type" : "INPUT",
        "elements" : {
          "gt0004" : {
