    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the weighted composite score for facial nerve function.",
        "keywords" : [
          "facial",
          "palsy",
          "nerve",
          "paralysis",
          "sunnybrook",
          "Bell"
        ],
        "use" : "Use to grade facial paralysis and assess the severity of peripheral facial palsy.\n\nUse to calculate the score based on the formula: (Voluntary Movement Score * 4) - (Resting Symmetry Score * 5) - (Synkinesis Score * 1).",
        "misuse" : "Not intended for central facial palsy assessment.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Ross BG, Fradet G, Nedzelski JM. Development of a sensitive clinical facial grading system. Otolaryngol Head Neck Surg. 1996 Mar;114(3):380-6. doi: 10.1016/S0194-59989670206-1. PMID: 8649870.",
      "en" : "Calculation of the Sunnybrook Facial Grading System score."
    }
  },
