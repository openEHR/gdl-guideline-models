    },
    "pre_conditions" : [
      "$gt0003|Resting symmetry eye|!=null",
      "$gt0004|Resting symmetry cheek|!=null",
      "$gt0005|Resting symmetry mouth|!=null",
      "$gt0006|Voluntary movement forehead wrinkle|!=null",
      "$gt0007|Voluntary movement gentle eye closure|!=null",
      "$gt0008|Voluntary movement open mouth smile|!=null",
      "$gt0009|Voluntary movement snarl|!=null",
      "$gt0010|Voluntary movement lip pucker|!=null",
      "$gt0011|Synkinesis forehead wrinkle|!=null",
      "$gt0012|Synkinesis gentle eye closure|!=null",
      "$gt0013|Synkinesis open mouth smile|!=null",
      "$gt0014|Synkinesis snarl|!=null",
      "$gt0015|Synkinesis lip pucker|!=null"
    ],
    "rules" : {
      "gt0021" : {
        "id" : "gt0021",
        "priority" : 4,
        "when" : [
          "$gt0003|Resting symmetry eye|!=null"
        ],
        "then" : [
          "$gt0017|Resting symmetry score|=($gt0003|Resting symmetry eye|.value+$gt0004|Resting symmetry cheek|.value+$gt0005|Resting symmetry mouth|.value)*5"
        ]
      },
      "gt0022" : {
        "id" : "gt0022",
        "priority" : 3,
        "when" : [
          "$gt0003|Resting symmetry eye|!=null"
        ],
        "then" : [
          "$gt0018|Voluntary movement score|=($gt0006|Voluntary movement forehead wrinkle|.value+$gt0007|Voluntary movement gentle eye closure|.value+$gt0008|Voluntary movement open mouth smile|.value+$gt0009|Voluntary movement snarl|.value+$gt0010|Voluntary movement lip pucker|.value)*4"
        ]
      },
      "gt0023" : {
        "id" : "gt0023",
        "priority" : 2,
        "when" : [
          "$gt0003|Resting symmetry eye|!=null"
        ],
        "then" : [
          "$gt0019|Synkinesis score|=$gt0011|Synkinesis forehead wrinkle|.value+$gt0012|Synkinesis gentle eye closure|.value+$gt0013|Synkinesis open mouth smile|.value+$gt0014|Synkinesis snarl|.value+$gt0015|Synkinesis lip pucker|.value"
        ]
      },
      "gt0024" : {
        "id" : "gt0024",
        "priority" : 1,
        "when" : [
          "$gt0003|Resting symmetry eye|!=null"
        ],
        "then" : [
          "$gt0020|Composite score|=$gt0018|Voluntary movement score|-$gt0017|Resting symmetry score|-$gt0019|Synkinesis score|"
        ]
      }
    }
  },
