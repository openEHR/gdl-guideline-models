    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To assess the prognostic stage group for endometrial cancer.",
        "keywords" : [
          "tnm",
          "endometrial",
          "cancer",
          "uterine",
          "staging",
          "oncology",
          "stage",
          "group",
          "ajcc"
        ],
        "use" : "Use to assess the clinical or pathological stage group for endometrial cancer. \n\nThe guideline maps the individual TNM components to the overall prognostic stage:\n\nstage I: T1, N0, M0;\n\nstage IA: T1a, N0, M0;\n\nstage IB: T1b, N0, M0;\n\nstage II: T2, N0, M0;\n\nstage III: T3, N0, M0;\n\nstage IIIA: T3a, N0, M0;\n\nstage IIIB: T3b, N0, M0;\n\nstage IIIC1:T1-T3, N1/N1mi/N1a, M0;\n\nstage IIIC2: T1-T3, N2/N2mi/N2a, M0;\n\nstage IVA: T4, any N, M0;\n\nstage IVB: any T, any N, M1.",
        "misuse" : "Not to be used on other types of cancer.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "O'Sullivan B, Brierley J, Byrd D, Bosman F, Kehoe S, Kossary C, Piñeros M, Van Eycken E, Weir HK, Gospodarowicz M. The TNM classification of malignant tumours-towards common understanding and reasonable expectations. Lancet Oncol. 2017 Jul;18(7):849-851. doi: 10.1016/S1470-2045(17)30438-2. PMID: 28677562; PMCID: PMC5851445.\n",
      "en" : "An assessment tool used to assign the prognostic stage group for endometrial cancer based on the TNM classification system."
    }
  },
