            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0013]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "a",
              "mo"
            ]
          }
        }
      },
      "gt0004" : {
        "id" : "gt0004",
        "model_id" : "openEHR-EHR-OBSERVATION.body_weight.v2",
        "template_id" : "openEHR-EHR-OBSERVATION.body_weight.v2",
        "type" : "OUTPUT",
        "elements" : {
          "gt0005" : {
            "id" : "gt0005",
            "path" : "/data[at0002]/events[at0003]/data[at0001]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "kg",
              "[lb_av]",
              "g"
            ]
          }
        }
      }
    },
    "rules" : {
      "gt0006" : {
        "id" : "gt0006",
        "priority" : 3,
        "when" : [
          "$gt0003|Age|!=null&&$gt0003|Age|.unit=='mo'"
        ],
        "then" : [
          "$gt0005|Weight|.magnitude=($gt0003|Age|.magnitude/2)+4",
          "$gt0005|Weight|.unit='kg'",
          "$gt0005|Weight|.precision=2"
        ]
      },
      "gt0007" : {
        "id" : "gt0007",
        "priority" : 2,
        "when" : [
          "$gt0003|Age|!=null&&$gt0003|Age|.unit=='a'",
          "$gt0003|Age|.magnitude>=1&&$gt0003|Age|.magnitude<=5"
        ],
        "then" : [
          "$gt0005|Weight|.magnitude=($gt0003|Age|.magnitude*2)+8",
          "$gt0005|Weight|.unit='kg'",
          "$gt0005|Weight|.precision=2"
        ]
      },
      "gt0008" : {
        "id" : "gt0008",
        "priority" : 1,
        "when" : [
          "$gt0003|Age|!=null&&$gt0003|Age|.unit=='a'",
          "$gt0003|Age|.magnitude>=6&&$gt0003|Age|.magnitude<=12"
        ],
        "then" : [
          "$gt0005|Weight|.magnitude=($gt0003|Age|.magnitude*3)+7",
          "$gt0005|Weight|.unit='kg'",
          "$gt0005|Weight|.precision=2"
        ]
      }
    }
  },
