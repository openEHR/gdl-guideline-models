    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To support safe and rapid paediatric emergency management by providing standardised age-based weight estimation and weight-adjusted dosing calculations during acute resuscitation.",
        "keywords" : [
          "Paediatric emergency",
          "WETBAG",
          "weight estimation",
          "drug dosing",
          "fluid bolus",
          "defibrillation energy",
          "airway equipment",
          "paediatric resuscitation"
        ],
        "use" : "Intended for use in emergency departments, prehospital settings, and acute paediatric care environments for children aged 0–12 years requiring urgent intervention.",
        "misuse" : "Not intended to replace measured body weight when available.\nNot validated for adolescents or adults.\nDoes not substitute for clinical judgment or comprehensive patient assessment.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "en" : "A clinical decision support guideline for calculating estimated body weight, weight-based medication dosages, defibrillation energy, airway equipment size, and fluid resuscitation volumes in paediatric emergency scenarios, based on the WETBAG mnemonic.",
      "references" : "https://slf.se/swesem/app/uploads/2019/05/initialt-omhandertagande-190520.pdf\nhttps://verktyg.internetmedicin.se/kalkylatorer/wetbags-5a"
    }
  },
