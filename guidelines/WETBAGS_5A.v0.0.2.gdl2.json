    "rules" : {
      "gt0006" : {
        "id" : "gt0006",
        "priority" : 17,
        "when" : [
          "$gt0003|Age|!=null&&$gt0003|Age|.unit=='mo'&&$gt0003|Age|.magnitude<=144",
          "$gt0003|Age|.magnitude>=0"
        ],
        "then" : [
          "$gt0005|Weight|.magnitude=($gt0003|Age|.magnitude/2)+4",
          "$gt0005|Weight|.unit='kg'",
          "$gt0005|Weight|.precision=2"
        ]
      },
      "gt0007" : {
        "id" : "gt0007",
        "priority" : 16,
        "when" : [
          "$gt0003|Age|!=null&&$gt0003|Age|.unit=='a'",
          "$gt0003|Age|.magnitude>=1&&$gt0003|Age|.magnitude<=5"
        ],
        "then" : [
          "$gt0005|Weight|.magnitude=($gt0003|Age|.magnitude*2)+8",
          "$gt0005|Weight|.unit='kg'",
          "$gt0005|Weight|.precision=2"
        ]
      },
      "gt0008" : {
        "id" : "gt0008",
        "priority" : 15,
        "when" : [
          "$gt0003|Age|!=null&&$gt0003|Age|.unit=='a'",
          "$gt0003|Age|.magnitude>=6&&$gt0003|Age|.magnitude<=12"
        ],
        "then" : [
          "$gt0005|Weight|.magnitude=($gt0003|Age|.magnitude*3)+7",
          "$gt0005|Weight|.unit='kg'",
          "$gt0005|Weight|.precision=2"
        ]
      },
      "gt0018" : {
        "id" : "gt0018",
        "priority" : 14,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0010|Defibrillation|.magnitude=$gt0005|Weight|.magnitude*4",
          "$gt0010|Defibrillation|.unit='J'",
          "$gt0010|Defibrillation|.precision=2",
          "$gt0011|Cardioversion|.magnitude=$gt0005|Weight|.magnitude*1",
          "$gt0011|Cardioversion|.unit='J'",
          "$gt0011|Cardioversion|.precision=2"
        ]
      },
      "gt0019" : {
        "id" : "gt0019",
        "priority" : 13,
        "when" : [
          "$gt0003|Age|!=null&&$gt0003|Age|.unit=='a'&&$gt0003|Age|.magnitude>=0&&$gt0003|Age|.magnitude<=12"
        ],
        "then" : [
          "$gt0012|Tube size|.magnitude=($gt0003|Age|.magnitude/4)+4",
          "$gt0012|Tube size|.unit='mm'",
          "$gt0012|Tube size|.precision=2"
        ]
      },
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 12,
        "when" : [
          "$gt0003|Age|!=null&&$gt0003|Age|.unit=='mo'&&$gt0003|Age|.magnitude<12&&$gt0003|Age|.magnitude>=0"
        ],
        "then" : [
          "$gt0012|Tube size|.magnitude=($gt0003|Age|.magnitude/48)+4",
          "$gt0012|Tube size|.unit='mm'",
          "$gt0012|Tube size|.precision=2"
        ]
      },
      "gt0021" : {
        "id" : "gt0021",
        "priority" : 11,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0013|Bolus|.magnitude=$gt0005|Weight|.magnitude*20",
          "$gt0014|Bolus trauma|.magnitude=$gt0005|Weight|.magnitude*10",
          "$gt0013|Bolus|.unit='mL'",
          "$gt0014|Bolus trauma|.unit='mL'"
        ]
      },
      "gt0022" : {
        "id" : "gt0022",
        "priority" : 10,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0015|Adrenaline|.magnitude=($gt0005|Weight|.magnitude*10)/1000",
          "$gt0015|Adrenaline|.unit='mg iv/im'",
          "$gt0015|Adrenaline|.precision=2"
        ]
      },
      "gt0023" : {
        "id" : "gt0023",
        "priority" : 9,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0017|Glucose|.magnitude=$gt0005|Weight|.magnitude*2",
          "$gt0017|Glucose|.unit='mL 10%'"
        ]
      },
      "gt0031" : {
        "id" : "gt0031",
        "priority" : 8,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0024|Stesolid IV|.magnitude=$gt0005|Weight|.magnitude*0.25",
          "$gt0024|Stesolid IV|.unit='mg'",
          "$gt0024|Stesolid IV|.precision=2"
        ]
      },
      "gt0032" : {
        "id" : "gt0032",
        "priority" : 7,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0025|Stesolid PR|.magnitude=$gt0005|Weight|.magnitude*0.5",
          "$gt0025|Stesolid PR|.unit='mg'",
          "$gt0025|Stesolid PR|.precision=2"
        ]
      },
      "gt0033" : {
        "id" : "gt0033",
        "priority" : 6,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0026|Adrenalin (inh)|.magnitude=5",
          "$gt0026|Adrenalin (inh)|.unit='ml (1 mg/ml)'"
        ]
      },
      "gt0034" : {
        "id" : "gt0034",
        "priority" : 5,
        "when" : [
          "$gt0003|Age|!=null&&$gt0003|Age|.magnitude<5&&$gt0003|Age|.magnitude>0"
        ],
        "then" : [
          "$gt0027|Albuterol (inh)|.magnitude=2.5",
          "$gt0027|Albuterol (inh)|.unit='mg'",
          "$gt0027|Albuterol (inh)|.precision=2"
        ]
      },
      "gt0035" : {
        "id" : "gt0035",
        "priority" : 4,
        "when" : [
          "$gt0003|Age|!=null&&$gt0003|Age|.magnitude>=5&&$gt0003|Age|.magnitude<=12"
        ],
        "then" : [
          "$gt0027|Albuterol (inh)|.magnitude=5",
          "$gt0027|Albuterol (inh)|.unit='mg'"
        ]
      },
      "gt0036" : {
        "id" : "gt0036",
        "priority" : 3,
        "when" : [
          "$gt0003|Age|!=null&&$gt0003|Age|.magnitude!=0&&$gt0003|Age|.magnitude<=12&&$gt0003|Age|.magnitude>=0"
        ],
        "then" : [
          "$gt0028|Atrovent|.magnitude=0.25",
          "$gt0028|Atrovent|.unit='mg'",
          "$gt0028|Atrovent|.precision=2"
        ]
      },
      "gt0037" : {
        "id" : "gt0037",
        "priority" : 2,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0029|Atropin|.magnitude=$gt0005|Weight|.magnitude*0.02",
          "$gt0029|Atropin|.unit='mg iv'",
          "$gt0029|Atropin|.precision=2"
        ]
      },
      "gt0038" : {
        "id" : "gt0038",
        "priority" : 1,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0030|Amiodaron|.magnitude=$gt0005|Weight|.magnitude*5",
          "$gt0030|Amiodaron|.unit='mg i 5% glukos'",
          "$gt0030|Amiodaron|.precision=2"
        ]
      }
    }
  },
