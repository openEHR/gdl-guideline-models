    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To recommend weight-based emergency drug doses, fluid boluses, defibrillation energy, and equipment sizes for pediatric patients, using the WETBAGS-5A framework.",
        "keywords" : [
          "WETBAG",
          "weight estimation",
          "drug dosing",
          "fluid bolus",
          "defibrillation energy",
          "airway equipment",
          "paediatric resuscitation",
          "WETBAGS-5A"
        ],
        "use" : "Use to calculate weight-based emergency drug doses, fluid boluses, defibrillation energy, and endotracheal tube size in children aged 0–12 years, using the WETBAGS-5A framework.",
        "misuse" : "Not to be used for patients older than 12 years. Not to be used for chronic medication dosing or non-emergency prescribing. Not a substitute for clinical judgment.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "en" : "A clinical decision support guideline for calculating estimated body weight, weight-based medication dosages, defibrillation energy, airway equipment size, and fluid resuscitation volumes in paediatric emergency scenarios, based on the WETBAG mnemonic.",
      "references" : "Svenska Sällskapet för Akutmedicin (SWESEM). Initialt omhändertagande. 2019 [cited 2026]. Available from: https://slf.se/swesem/app/uploads/2019/05/initialt-omhandertagande-190520.pdf\n\nhttps://verktyg.internetmedicin.se/kalkylatorer/wetbags-5a"
    }
  },
