    "pre_conditions" : [
      "$gt0003|Age|.magnitude<=144&&$gt0003|Age|.unit=='mo'||$gt0003|Age|.magnitude<=12&&$gt0003|Age|.unit=='a'"
    ],
    "rules" : {
      "gt0006" : {
        "id" : "gt0006",
        "priority" : 17,
        "when" : [
          "$gt0003|Age|!=null",
          "$gt0003|Age|.magnitude>=0",
          "$gt0003|Age|.magnitude<=11",
          "$gt0003|Age|.unit=='mo'"
        ],
        "then" : [
          "$gt0005|Weight|.magnitude=($gt0003|Age|.magnitude/2)+4",
          "$gt0005|Weight|.unit='kg'",
          "$gt0005|Weight|.precision=2"
        ]
      },
      "gt0007" : {
        "id" : "gt0007",
        "priority" : 16,
        "when" : [
          "$gt0003|Age|!=null",
          "$gt0003|Age|.unit=='a'",
          "$gt0003|Age|.magnitude>=1",
          "$gt0003|Age|.magnitude<=5"
        ],
        "then" : [
          "$gt0005|Weight|.magnitude=($gt0003|Age|.magnitude*2)+8",
          "$gt0005|Weight|.unit='kg'",
          "$gt0005|Weight|.precision=2"
        ]
      },
      "gt0008" : {
        "id" : "gt0008",
        "priority" : 15,
        "when" : [
          "$gt0003|Age|!=null",
          "$gt0003|Age|.unit=='a'",
          "$gt0003|Age|.magnitude>=6",
          "$gt0003|Age|.magnitude<=12"
        ],
        "then" : [
          "$gt0005|Weight|.magnitude=($gt0003|Age|.magnitude*3)+7",
          "$gt0005|Weight|.unit='kg'",
          "$gt0005|Weight|.precision=2"
        ]
      },
      "gt0018" : {
        "id" : "gt0018",
        "priority" : 14,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0040|Defibrillation|.magnitude=$gt0005|Weight|.magnitude*4",
          "$gt0040|Defibrillation|.unit='J'",
          "$gt0040|Defibrillation|.precision=2",
          "$gt0041|Cardioversion|.magnitude=$gt0005|Weight|.magnitude*1",
          "$gt0041|Cardioversion|.unit='J'",
          "$gt0041|Cardioversion|.precision=2"
        ]
      },
      "gt0019" : {
        "id" : "gt0019",
        "priority" : 13,
        "when" : [
          "$gt0005|Weight|!=null",
          "$gt0003|Age|!=null&&$gt0003|Age|.unit=='a'&&$gt0003|Age|.magnitude>=0&&$gt0003|Age|.magnitude<=12"
        ],
        "then" : [
          "$gt0042|Tube size|.magnitude=($gt0003|Age|.magnitude/4)+4",
          "$gt0042|Tube size|.unit='mm'",
          "$gt0042|Tube size|.precision=2"
        ]
      },
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 12,
        "when" : [
          "$gt0005|Weight|!=null",
          "$gt0003|Age|!=null&&$gt0003|Age|.unit=='mo'&&$gt0003|Age|.magnitude<12&&$gt0003|Age|.magnitude>=0"
        ],
        "then" : [
          "$gt0042|Tube size|.magnitude=($gt0003|Age|.magnitude/48)+4",
          "$gt0042|Tube size|.unit='mm'",
          "$gt0042|Tube size|.precision=2"
        ]
      },
      "gt0021" : {
        "id" : "gt0021",
        "priority" : 11,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0043|Bolus|.magnitude=$gt0005|Weight|.magnitude*20",
          "$gt0044|Bolus trauma|.magnitude=$gt0005|Weight|.magnitude*10",
          "$gt0043|Bolus|.unit='mL'",
          "$gt0044|Bolus trauma|.unit='mL'"
        ]
      },
      "gt0022" : {
        "id" : "gt0022",
        "priority" : 10,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0045|Adrenaline, iv/im|.magnitude=($gt0005|Weight|.magnitude*10)/1000",
          "$gt0045|Adrenaline, iv/im|.unit='mg'",
          "$gt0045|Adrenaline, iv/im|.precision=2"
        ]
      },
      "gt0023" : {
        "id" : "gt0023",
        "priority" : 9,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0047|Glucose, 10%|.magnitude=$gt0005|Weight|.magnitude*2",
          "$gt0047|Glucose, 10%|.unit='mL'"
        ]
      },
      "gt0031" : {
        "id" : "gt0031",
        "priority" : 8,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0048|Stesolid IV|.magnitude=$gt0005|Weight|.magnitude*0.25",
          "$gt0048|Stesolid IV|.unit='mg'",
          "$gt0048|Stesolid IV|.precision=2"
        ]
      },
      "gt0032" : {
        "id" : "gt0032",
        "priority" : 7,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0049|Stesolid PR|.magnitude=$gt0005|Weight|.magnitude*0.5",
          "$gt0049|Stesolid PR|.unit='mg'",
          "$gt0049|Stesolid PR|.precision=2"
        ]
      },
      "gt0033" : {
        "id" : "gt0033",
        "priority" : 6,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0050|Adrenalin (inh) (1 mg/ml)|.magnitude=5",
          "$gt0050|Adrenalin (inh) (1 mg/ml)|.unit='mL'"
        ]
      },
      "gt0034" : {
        "id" : "gt0034",
        "priority" : 5,
        "when" : [
          "$gt0005|Weight|!=null",
          "$gt0003|Age|!=null&&$gt0003|Age|.magnitude<5&&$gt0003|Age|.magnitude>0"
        ],
        "then" : [
          "$gt0050|Adrenalin (inh) (1 mg/ml)|.magnitude=2.5",
          "$gt0050|Adrenalin (inh) (1 mg/ml)|.unit='mg'",
          "$gt0050|Adrenalin (inh) (1 mg/ml)|.precision=2"
        ]
      },
      "gt0035" : {
        "id" : "gt0035",
        "priority" : 4,
        "when" : [
          "$gt0005|Weight|!=null",
          "$gt0003|Age|!=null&&$gt0003|Age|.magnitude>=5&&$gt0003|Age|.magnitude<=12"
        ],
        "then" : [
          "$gt0050|Adrenalin (inh) (1 mg/ml)|.magnitude=5",
          "$gt0050|Adrenalin (inh) (1 mg/ml)|.unit='mg'"
        ]
      },
      "gt0036" : {
        "id" : "gt0036",
        "priority" : 3,
        "when" : [
          "$gt0005|Weight|!=null",
          "$gt0003|Age|!=null&&$gt0003|Age|.magnitude!=0&&$gt0003|Age|.magnitude<=12&&$gt0003|Age|.magnitude>=0"
        ],
        "then" : [
          "$gt0052|Atrovent|.magnitude=0.25",
          "$gt0052|Atrovent|.unit='mg'",
          "$gt0052|Atrovent|.precision=2"
        ]
      },
      "gt0037" : {
        "id" : "gt0037",
        "priority" : 2,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0053|Atropin, iv|.magnitude=$gt0005|Weight|.magnitude*0.02",
          "$gt0053|Atropin, iv|.unit='mg'",
          "$gt0053|Atropin, iv|.precision=2"
        ]
      },
      "gt0038" : {
        "id" : "gt0038",
        "priority" : 1,
        "when" : [
          "$gt0005|Weight|!=null"
        ],
        "then" : [
          "$gt0054|Amiodaron, mg in 5% glucose|.magnitude=$gt0005|Weight|.magnitude*5",
          "$gt0054|Amiodaron, mg in 5% glucose|.unit='mg'",
          "$gt0054|Amiodaron, mg in 5% glucose|.precision=2"
        ]
      }
    }
