            "id" : "gt0006",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0016]",
            "data_type" : "DV_ORDINAL",
            "allowed_values" : [
              "0|local::at0017",
              "1|local::at0018"
            ]
          },
