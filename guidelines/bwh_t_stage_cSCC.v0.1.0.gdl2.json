          }
        }
      },
      "gt0008" : {
        "id" : "gt0008",
        "model_id" : "openEHR-EHR-OBSERVATION.bwh_t_stage.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.bwh_t_stage.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0009" : {
            "id" : "gt0009",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0020]",
            "data_type" : "DV_COUNT"
          },
          "gt0010" : {
            "id" : "gt0010",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0021]",
            "data_type" : "DV_CODED_TEXT"
          },
          "gt0011" : {
            "id" : "gt0011",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0026]",
            "data_type" : "DV_CODED_TEXT"
          }
        }
      }
    },
    "rules" : {
      "gt0012" : {
        "id" : "gt0012",
        "priority" : 7,
        "when" : [
          "$gt0003|Clinical tumour diameter ≥ 2 cm|!=null",
          "$gt0004|Invasion beyond subcutaneous fat|!=null",
          "$gt0005|Poor differentiation present|!=null",
          "$gt0006|Perineural invasion of nerve ≥ 0.1 mm|!=null"
        ],
        "then" : [
          "$gt0009|Risk factor count|.magnitude=$gt0003|Clinical tumour diameter ≥ 2 cm|.value+$gt0004|Invasion beyond subcutaneous fat|.value+$gt0005|Poor differentiation present|.value+$gt0006|Perineural invasion of nerve ≥ 0.1 mm|.value"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 6,
        "when" : [
          "$gt0009|Risk factor count|==0"
        ],
        "then" : [
          "$gt0010|BWH T stage|=local::at0022|BWH-T1|"
        ]
      },
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 5,
        "when" : [
          "$gt0009|Risk factor count|==1"
        ],
        "then" : [
          "$gt0010|BWH T stage|=local::at0023|BWH-T2a|"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 4,
        "when" : [
          "$gt0009|Risk factor count|>=2&&$gt0009|Risk factor count|<=3"
        ],
        "then" : [
          "$gt0010|BWH T stage|=local::at0024|BWH-T2b|"
        ]
      },
      "gt0013" : {
        "id" : "gt0013",
        "priority" : 3,
        "when" : [
          "$gt0007|Bone invasion|==true||$gt0009|Risk factor count|==4"
        ],
        "then" : [
          "$gt0010|BWH T stage|=local::at0025|BWH-T3|"
        ]
      },
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 2,
        "when" : [
          "$gt0010|BWH T stage|==local::at0022|BWH-T1|||$gt0010|BWH T stage|==local::at0023|BWH-T2a|"
        ],
        "then" : [
          "$gt0011|Postoperative risk group|=local::at0027|Low risk|"
        ]
      },
      "gt0018" : {
        "id" : "gt0018",
        "priority" : 1,
        "when" : [
          "$gt0010|BWH T stage|==local::at0024|BWH-T2b|||$gt0010|BWH T stage|==local::at0025|BWH-T3|"
        ],
        "then" : [
          "$gt0011|Postoperative risk group|=local::at0028|High risk|"
        ]
      }
    }
  },
