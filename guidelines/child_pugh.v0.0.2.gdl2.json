    "rules" : {
      "gt0021" : {
        "id" : "gt0021",
        "priority" : 10,
        "when" : [
          "$gt0004|Bilirubin result|<35"
        ],
        "then" : [
          "$gt0023|Total Bilirubin Score|=1|local::at0012|<2 mg/dL (<34.2 µmol/L)|"
        ]
      },
      "gt0026" : {
        "id" : "gt0026",
        "priority" : 9,
        "when" : [
          "$gt0004|Bilirubin result|>=35",
          "$gt0004|Bilirubin result|<=51"
        ],
        "then" : [
          "$gt0023|Total Bilirubin Score|=2|local::at0013|2-3 mg/dL (34.2-51.3 µmol/L)|"
        ]
      },
      "gt0027" : {
        "id" : "gt0027",
        "priority" : 8,
        "when" : [
          "$gt0004|Bilirubin result|>51"
        ],
        "then" : [
          "$gt0023|Total Bilirubin Score|=3|local::at0014|>3 mg/dL (>51.3 µmol/L)|"
        ]
      },
      "gt0028" : {
        "id" : "gt0028",
        "priority" : 7,
        "when" : [
          "$gt0007|Albumin result|>35"
        ],
        "then" : [
          "$gt0024|Albumin Score|=1|local::at0018|>3.5 g/dL (>35 g/L)|"
        ]
      },
      "gt0029" : {
        "id" : "gt0029",
        "priority" : 6,
        "when" : [
          "$gt0007|Albumin result|<=35",
          "$gt0007|Albumin result|>=28"
        ],
        "then" : [
          "$gt0024|Albumin Score|=2|local::at0019|2.8-3.5 g/dL (28-35 g/L)|"
        ]
      },
      "gt0030" : {
        "id" : "gt0030",
        "priority" : 5,
        "when" : [
          "$gt0007|Albumin result|<28"
        ],
        "then" : [
          "$gt0024|Albumin Score|=3|local::at0020|<2.8 g/dL (<28 g/L)|"
        ]
      },
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 4,
        "when" : [
          "$gt0023|Total Bilirubin Score|!=null",
          "$gt0024|Albumin Score|!=null",
          "$gt0034|INR|!=null",
          "$gt0015|Ascites|!=null",
          "$gt0016|Hepatic encephalopathy|!=null"
        ],
        "then" : [
          "$gt0018|Total score|.magnitude=$gt0023|Total Bilirubin Score|.value+$gt0024|Albumin Score|.value+$gt0034|INR|.value+$gt0015|Ascites|.value+$gt0016|Hepatic encephalopathy|.value"
        ]
      },
      "gt0035" : {
        "id" : "gt0035",
        "priority" : 3,
        "when" : [
          "$gt0018|Total score|>=5",
          "$gt0018|Total score|<=6"
        ],
        "then" : [
          "$gt0019|Grade|=local::at0030|Class A 5 to 6 points|"
        ]
      },
      "gt0036" : {
        "id" : "gt0036",
        "priority" : 2,
        "when" : [
          "$gt0018|Total score|>=7",
          "$gt0018|Total score|<=9"
        ],
        "then" : [
          "$gt0019|Grade|=local::at0031|Class B 7 to 9 points|"
        ]
      },
      "gt0037" : {
        "id" : "gt0037",
        "priority" : 1,
        "when" : [
          "$gt0018|Total score|>=10"
        ],
        "then" : [
          "$gt0019|Grade|=local::at0032|Class C 10 to 15 points|"
        ]
      }
    }
  },
