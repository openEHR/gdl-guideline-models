    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the total Child-Pugh score and assign the corresponding Child-Pugh class based on clinical and laboratory parameters.",
        "keywords" : [
          "child pugh",
          "cirrhosis",
          "liver function",
          "hepatic encephalopathy",
          "ascites",
          "bilirubin",
          "albumin",
          "inr"
        ],
        "use" : "Use to assess liver function severity in adult patients with chronic liver disease or cirrhosis.\n\nThe Child-Pugh score is calculated by assigning 1-3 points to each of the following parameters:\n- Serum bilirubin (bilirubin without PBC (primary biliary cholangitis) [µmol/L]; or bilirubin in PBC [µmol/L])\n- INR\n- Serum albumin\n- Ascites severity\n- Hepatic encephalopathy grade\n\nNote: For serum bilirubin, select only one bilirubin input: either total bilirubin (without PBC) or adjusted bilirubin (in PBC). Do not select both.\n\nThe total score (5–15 points) is used to classify liver function into:\n- Child-Pugh A (5–6 points)\n- Child-Pugh B (7–9 points)\n- Child-Pugh C (≥10 points)",
        "misuse" : "Not to be used as a standalone assessment for treatment selection or surgical eligibility.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Regionala cancercentrum i samverkan. Nationellt vårdprogram levercellscancer: Kapitel 8 Diagnostik och staging. Kunskapsbanken, 2024. Available at: kunskapsbanken.cancercentrum.se/diagnoser/levercellscancer/vardprogram/diagnostik",
      "en" : "An assessment score used to classify the severity of liver function impairment in patients with chronic liver disease and cirrhosis."
    }
  },
