    "rules" : {
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 5,
        "when" : [
          "$gt0038|Bilirubin without PBC|!=null",
          "$gt0039|Bilirubin in PBC|==null",
          "$gt0034|INR|!=null",
          "$gt0015|Ascites|!=null",
          "$gt0016|Hepatic encephalopathy|!=null",
          "$gt0040|Serum albumin|!=null"
        ],
        "then" : [
          "$gt0018|Total score|.magnitude=$gt0038|Bilirubin without PBC|.value+$gt0040|Serum albumin|.value+$gt0034|INR|.value+$gt0015|Ascites|.value+$gt0016|Hepatic encephalopathy|.value"
        ]
      },
      "gt0041" : {
        "id" : "gt0041",
        "priority" : 4,
        "when" : [
          "$gt0038|Bilirubin without PBC|==null",
          "$gt0039|Bilirubin in PBC|!=null",
          "$gt0034|INR|!=null",
          "$gt0015|Ascites|!=null",
          "$gt0016|Hepatic encephalopathy|!=null",
          "$gt0040|Serum albumin|!=null"
        ],
        "then" : [
          "$gt0018|Total score|.magnitude=$gt0039|Bilirubin in PBC|.value+$gt0040|Serum albumin|.value+$gt0034|INR|.value+$gt0015|Ascites|.value+$gt0016|Hepatic encephalopathy|.value"
        ]
      },
      "gt0035" : {
        "id" : "gt0035",
        "priority" : 3,
        "when" : [
          "$gt0018|Total score|>=5",
          "$gt0018|Total score|<=6"
        ],
        "then" : [
          "$gt0019|Grade|=local::at0030|Class A 5 to 6 points|"
        ]
      },
      "gt0036" : {
        "id" : "gt0036",
        "priority" : 2,
        "when" : [
          "$gt0018|Total score|>=7",
          "$gt0018|Total score|<=9"
        ],
        "then" : [
          "$gt0019|Grade|=local::at0031|Class B 7 to 9 points|"
        ]
      },
      "gt0037" : {
        "id" : "gt0037",
        "priority" : 1,
        "when" : [
          "$gt0018|Total score|>=10"
        ],
        "then" : [
          "$gt0019|Grade|=local::at0032|Class C 10 to 15 points|"
        ]
      }
    }
  },
