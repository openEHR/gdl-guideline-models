        "terms" : {
          "gt0001" : {
            "id" : "gt0001",
            "text" : "Drip rate",
            "description" : "Calculates intravenous drip rate (drops per minute) based on total infusion volume,  infusion duration, and drip factor. Intended for clinical support in manual IV administration."
          },
          "gt0008" : {
            "id" : "gt0008",
            "text" : "Input exist and default rule ",
            "description" : "drops/min = 20 × amount_ml / 60 / time_hours"
          },
