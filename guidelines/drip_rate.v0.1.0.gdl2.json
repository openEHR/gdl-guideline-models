  "id" : "drip_rate.v0.1.0",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Mahmoud Elachi",
      "email" : "mel.achi@gmail.com",
      "organisation" : "Cambio CDS",
      "date" : "2026-06-18"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To support healthcare professionals in determining correct drip rate for IV infusions when using gravity-based administration sets.",
        "keywords" : [
          "infusion",
          "drip rate",
          "IV therapy",
          "calculation",
          "IV"
        ],
        "use" : "Used in hospital or clinical settings where infusion pumps are not used and drip rate  must be manually calculated.",
        "misuse" : "Not intended for automated infusion pumps or critical care scenarios where precise infusion devices are required. Incorrect inputs may lead to unsafe infusion rates.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "en" : "Calculates intravenous drip rate (drops per minute) based on total infusion volume,  infusion duration, and drip factor. Intended for clinical support in manual IV administration.",
      "references" : "Morris, G. (2021). Clinical Calculations: With Applications to General and Specialty Areas (9th ed.). Elsevier.\nhttps://verktyg.internetmedicin.se/kalkylatorer/dropptakt"
    }
  },
  "definition" : {
    "data_bindings" : {
      "gt0009" : {
        "id" : "gt0009",
        "model_id" : "openEHR-EHR-OBSERVATION.infusion_factors.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.infusion_factors.v0",
        "type" : "INPUT",
        "elements" : {
          "gt0010" : {
            "id" : "gt0010",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "mL"
            ]
          },
          "gt0011" : {
            "id" : "gt0011",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0005]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "h"
            ]
          }
        }
      },
      "gt0012" : {
        "id" : "gt0012",
        "model_id" : "openEHR-EHR-OBSERVATION.infusion_factors.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.infusion_factors.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0013" : {
            "id" : "gt0013",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0009]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "drops/min"
            ]
          }
        }
      }
    },
    "rules" : {
      "gt0008" : {
        "id" : "gt0008",
        "priority" : 1,
        "when" : [
          "$gt0010|Infusion amount|!=null",
          "$gt0011|Infusion time|!=null",
          "$gt0010|Infusion amount|.magnitude>0",
          "$gt0011|Infusion time|.magnitude>0"
        ],
        "then" : [
          "$gt0013|Calculated drop rate|.magnitude=(20*$gt0010|Infusion amount|.magnitude)/60/$gt0011|Infusion time|.magnitude",
          "$gt0013|Calculated drop rate|.unit='drops/min'"
        ]
      }
    }
  },
  "ontology" : {
    "term_definitions" : {
      "en" : {
        "id" : "en",
        "terms" : {
          "gt0001" : {
            "id" : "gt0001",
            "text" : "Drip rate",
            "description" : "Calculates intravenous drip rate (drops per minute) based on total infusion volume,  infusion duration, and drip factor. Intended for clinical support in manual IV administration."
          },
          "gt0008" : {
            "id" : "gt0008",
            "text" : "Calculate drop rate",
            "description" : "drops/min = 20 × amount_ml / 60 / time_hours"
          },
          "gt0009" : {
            "id" : "gt0009",
            "text" : "openEHR-EHR-OBSERVATION.infusion_factors.v0"
          },
          "gt0010" : {
            "id" : "gt0010",
            "text" : "Infusion amount"
          },
          "gt0011" : {
            "id" : "gt0011",
            "text" : "Infusion time"
          },
          "gt0012" : {
            "id" : "gt0012",
            "text" : "openEHR-EHR-OBSERVATION.infusion_factors.v0"
          },
          "gt0013" : {
            "id" : "gt0013",
            "text" : "Calculated drop rate"
          }
        }
      }
    }
  }
}