    "rules" : {
      "gt0024" : {
        "id" : "gt0024",
        "priority" : 20,
        "when" : [
          "$gt0057|Platelet count value|<1"
        ],
        "then" : [
          "$gt0071|Warning Plt|=$gt0074|Too low, please change to proceed.|.term"
        ]
      },
      "gt0028" : {
        "id" : "gt0028",
        "priority" : 19,
        "when" : [
          "$gt0057|Platelet count value|>=1",
          "$gt0057|Platelet count value|<10"
        ],
        "then" : [
          "$gt0071|Warning Plt|=$gt0075|Very low, double-check.|.term"
        ]
      },
      "gt0029" : {
        "id" : "gt0029",
        "priority" : 18,
        "when" : [
          "$gt0057|Platelet count value|>750",
          "$gt0057|Platelet count value|<=3200"
        ],
        "then" : [
          "$gt0071|Warning Plt|=$gt0076|Very high, double-check.|.term"
        ]
      },
      "gt0030" : {
        "id" : "gt0030",
        "priority" : 17,
        "when" : [
          "$gt0057|Platelet count value|>3200"
        ],
        "then" : [
          "$gt0071|Warning Plt|=$gt0077|Too high, please change to proceed.|.term"
        ]
      },
      "gt0031" : {
        "id" : "gt0031",
        "priority" : 16,
        "when" : [
          "$gt0047|AST value|<1"
        ],
        "then" : [
          "$gt0073|Warning AST|=$gt0074|Too low, please change to proceed.|.term"
        ]
      },
      "gt0032" : {
        "id" : "gt0032",
        "priority" : 15,
        "when" : [
          "$gt0047|AST value|>=1",
          "$gt0047|AST value|<4"
        ],
        "then" : [
          "$gt0073|Warning AST|=$gt0075|Very low, double-check.|.term"
        ]
      },
      "gt0033" : {
        "id" : "gt0033",
        "priority" : 14,
        "when" : [
          "$gt0047|AST value|>4000",
          "$gt0047|AST value|<=10000"
        ],
        "then" : [
          "$gt0073|Warning AST|=$gt0076|Very high, double-check.|.term"
        ]
      },
      "gt0034" : {
        "id" : "gt0034",
        "priority" : 13,
        "when" : [
          "$gt0047|AST value|>10000"
        ],
        "then" : [
          "$gt0073|Warning AST|=$gt0077|Too high, please change to proceed.|.term"
        ]
      },
      "gt0035" : {
        "id" : "gt0035",
        "priority" : 12,
        "when" : [
          "$gt0050|ALT value|<1"
        ],
        "then" : [
          "$gt0072|Warning ALT|=$gt0074|Too low, please change to proceed.|.term"
        ]
      },
      "gt0037" : {
        "id" : "gt0037",
        "priority" : 11,
        "when" : [
          "$gt0050|ALT value|>=1",
          "$gt0050|ALT value|<4"
        ],
        "then" : [
          "$gt0072|Warning ALT|=$gt0075|Very low, double-check.|.term"
        ]
      },
      "gt0038" : {
        "id" : "gt0038",
        "priority" : 10,
        "when" : [
          "$gt0050|ALT value|>4000",
          "$gt0050|ALT value|<=10000"
        ],
        "then" : [
          "$gt0072|Warning ALT|=$gt0076|Very high, double-check.|.term"
        ]
      },
      "gt0036" : {
        "id" : "gt0036",
        "priority" : 9,
        "when" : [
          "$gt0050|ALT value|>10000"
        ],
        "then" : [
          "$gt0072|Warning ALT|=$gt0077|Too high, please change to proceed.|.term"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 8,
        "when" : [
          "$gt0003|Age|!=null",
          "$gt0050|ALT value|!=null",
          "$gt0047|AST value|!=null",
          "$gt0057|Platelet count value|!=null",
          "!fired($gt0024|Set warning Too low to Plt|)",
          "!fired($gt0030|Set warning Too high to Plt|)",
          "!fired($gt0031|Set warning Too low to AST|)",
          "!fired($gt0034|Set warning Too high to AST|)",
          "!fired($gt0035|Set warning Too low to ALT|)",
          "!fired($gt0036|Set warning Too high to ALT|)"
        ],
        "then" : [
          "$gt0068|FIB-4 score|.magnitude=$gt0003|Age|.magnitude*$gt0047|AST value|.magnitude/($gt0057|Platelet count value|.magnitude*$gt0050|ALT value|.magnitude^0.5)",
          "$gt0068|FIB-4 score|.unit='1'",
          "$gt0068|FIB-4 score|.precision=2"
        ]
      },
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 7,
        "when" : [
          "$gt0068|FIB-4 score|<1.45"
        ],
        "then" : [
          "$gt0069|Approximate fibrosis stage|=$gt0078|Ishak 0-1|.term"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 6,
        "when" : [
          "$gt0068|FIB-4 score|>=1.45",
          "$gt0068|FIB-4 score|<=3.25"
        ],
        "then" : [
          "$gt0069|Approximate fibrosis stage|=$gt0079|Ishak 2-3|.term"
        ]
      },
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 5,
        "when" : [
          "$gt0068|FIB-4 score|>3.25"
        ],
        "then" : [
          "$gt0069|Approximate fibrosis stage|=$gt0080|Ishak 4-6|.term"
        ]
      },
      "gt0018" : {
        "id" : "gt0018",
        "priority" : 4,
        "when" : [
          "$gt0003|Age|.magnitude<=35",
          "$gt0047|AST value|!=null",
          "$gt0050|ALT value|!=null",
          "$gt0057|Platelet count value|!=null"
        ],
        "then" : [
          "$gt0070|Diagnose advanced fibrosis|=$gt0081|Use alternative fibrosis assessment|.term"
        ]
      },
      "gt0019" : {
        "id" : "gt0019",
        "priority" : 3,
        "when" : [
          "((($gt0003|Age|.magnitude>35)&&($gt0003|Age|.magnitude<65))&&($gt0068|FIB-4 score|<1.3))||(($gt0003|Age|.magnitude>=65)&&($gt0068|FIB-4 score|<2))"
        ],
        "then" : [
          "$gt0070|Diagnose advanced fibrosis|=$gt0083|Advanced fibrosis excluded|.term"
        ]
      },
      "gt0020" : {
        "id" : "gt0020",
        "priority" : 2,
        "when" : [
          "(((($gt0003|Age|.magnitude>35)&&($gt0003|Age|.magnitude<65))&&($gt0068|FIB-4 score|>=1.3))&&($gt0068|FIB-4 score|<=2.67))||((($gt0003|Age|.magnitude>=65)&&($gt0068|FIB-4 score|>=2))&&($gt0068|FIB-4 score|<=2.67))"
        ],
        "then" : [
          "$gt0070|Diagnose advanced fibrosis|=$gt0084|Further investigation|.term"
        ]
      },
      "gt0021" : {
        "id" : "gt0021",
        "priority" : 1,
        "when" : [
          "$gt0003|Age|.magnitude>35",
          "$gt0068|FIB-4 score|>2.67"
        ],
        "then" : [
          "$gt0070|Diagnose advanced fibrosis|=$gt0082|Advanced fibrosis (METAVIR stage F3-F4) likely|.term"
        ]
      }
    }
