            ]
          }
        },
        "predicates" : [
          "/data[at0001]/events[at0002]/data[at0003]/items[openEHR-EHR-CLUSTER.laboratory_test_analyte.v1]/items[at0024] is_a local::gt0013|Sodium code|"
        ]
      },
      "gt0011" : {
        "id" : "gt0011",
        "model_id" : "openEHR-EHR-OBSERVATION.free_water_deficit_hypernatremia.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.free_water_deficit_hypernatremia.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0012" : {
            "id" : "gt0012",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0009]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "l"
            ]
          }
        }
      }
    },
    "rules" : {
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 6,
        "when" : [
          "$gt0003|Weight|!=null",
          "$gt0003|Weight|.unit=='[lb_av]'"
        ],
        "then" : [
          "$gt0003|Weight|.magnitude=$gt0003|Weight|.magnitude/2.20462262",
          "$gt0003|Weight|.unit='kg'",
          "$gt0003|Weight|.precision=3"
        ]
      },
      "gt0016" : {
        "id" : "gt0016",
        "priority" : 5,
        "when" : [
          "$gt0003|Weight|!=null",
          "$gt0005|Gender|!=null",
          "$gt0007|Age range|==local::at0006|Child|",
          "$gt0010|S-Na+ result|!=null"
        ],
        "then" : [
          "$gt0012|Free water deficit|.magnitude=0.6*$gt0003|Weight|.magnitude*(($gt0010|S-Na+ result|.magnitude/140)-1)",
          "$gt0012|Free water deficit|.unit='l'",
          "$gt0012|Free water deficit|.precision=2"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 4,
        "when" : [
          "$gt0003|Weight|!=null",
          "$gt0005|Gender|==local::at0005|Male|",
          "$gt0007|Age range|==local::at0007|Adult|",
          "$gt0010|S-Na+ result|!=null"
        ],
        "then" : [
          "$gt0012|Free water deficit|.magnitude=0.6*$gt0003|Weight|.magnitude*(($gt0010|S-Na+ result|.magnitude/140)-1)",
          "$gt0012|Free water deficit|.unit='l'",
          "$gt0012|Free water deficit|.precision=2"
        ]
      },
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 3,
        "when" : [
          "$gt0003|Weight|!=null",
          "$gt0005|Gender|==local::at0006|Female|",
          "$gt0007|Age range|==local::at0007|Adult|",
          "$gt0010|S-Na+ result|!=null"
        ],
        "then" : [
          "$gt0012|Free water deficit|.magnitude=0.5*$gt0003|Weight|.magnitude*(($gt0010|S-Na+ result|.magnitude/140)-1)",
          "$gt0012|Free water deficit|.unit='l'",
          "$gt0012|Free water deficit|.precision=2"
        ]
      },
      "gt0018" : {
        "id" : "gt0018",
        "priority" : 2,
        "when" : [
          "$gt0003|Weight|!=null",
          "$gt0005|Gender|==local::at0005|Male|",
          "$gt0007|Age range|==local::at0008|Elderly|",
          "$gt0010|S-Na+ result|!=null"
        ],
        "then" : [
          "$gt0012|Free water deficit|.magnitude=0.5*$gt0003|Weight|.magnitude*(($gt0010|S-Na+ result|.magnitude/140)-1)",
          "$gt0012|Free water deficit|.unit='l'",
          "$gt0012|Free water deficit|.precision=2"
        ]
      },
      "gt0019" : {
        "id" : "gt0019",
        "priority" : 1,
        "when" : [
          "$gt0003|Weight|!=null",
          "$gt0005|Gender|==local::at0006|Female|",
          "$gt0007|Age range|==local::at0008|Elderly|",
          "$gt0010|S-Na+ result|!=null"
        ],
        "then" : [
          "$gt0012|Free water deficit|.magnitude=0.45*$gt0003|Weight|.magnitude*(($gt0010|S-Na+ result|.magnitude/140)-1)",
          "$gt0012|Free water deficit|.unit='l'",
          "$gt0012|Free water deficit|.precision=2"
        ]
      }
    }
  },
