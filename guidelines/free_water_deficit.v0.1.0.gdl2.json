{
  "uuid" : "e179731a-fecb-487a-8690-8a78ac4f71f9",
  "id" : "free_water_deficit.v0.1.0",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Katja Mariko Wilde",
      "email" : "katja-wilde@t-online.de",
      "organisation" : "Cambio CDS",
      "date" : "2026-05-18"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To estimate free water deficit using serum sodium concentration, body weight, and patient category.",
        "keywords" : [
          "water",
          "deficit",
          "sodium",
          "dehydration",
          "hypernatremia"
        ],
        "use" : "Use to estimate free water deficit in patients with dehydration.\n\nFormula: Free water deficit [l] = K × weight [kg] × ((S-Na+ [mmol/l] / 140) - 1)\n\nWhere:\n- S-Na+ = serum sodium concentration\n- K = estimated total body water fraction\n\nK values:\n- Child: 0.6\n- Adult male: 0.6\n- Adult female: 0.5\n- Elderly male: 0.5\n- Elderly female: 0.45\n\nThe calculated result estimates the amount of free water deficit in liters.",
        "misuse" : "Not to be used as the sole basis for fluid management or electrolyte correction. Clinical assessment and monitoring are required.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Morley JE. Dehydration, Hypernatremia, and Hyponatremia. Clin Geriatr Med. 2015 Aug;31(3):389-99. doi: 10.1016/j.cger.2015.04.007. Epub 2015 May 11. PMID: 26195098.",
      "en" : "A clinical assessment used to estimate free water deficit in patients with dehydration using serum sodium concentration, body weight, and estimated total body water."
    }
  },
