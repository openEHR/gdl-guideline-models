    "rules" : {
      "gt0025" : {
        "id" : "gt0025",
        "priority" : 2,
        "when" : [
          "$gt0016|Haemoglobin, men (g/dL)|!=null",
          "$gt0018|Blood urea (mmol/L)|!=null",
          "$gt0019|Systolic blood pressure (mmHg)|!=null",
          "$gt0020|Pulse ≥ 100 / min|!=null",
          "$gt0021|Melena|!=null",
          "$gt0022|Syncope|!=null",
          "$gt0023|Hepatic disease|!=null",
          "$gt0024|Cardiac failure|!=null",
          "$gt0017|Haemoglobin, women (g/dL)|==null"
        ],
        "then" : [
          "$gt0013|Total score|.magnitude=$gt0016|Haemoglobin, men (g/dL)|.value+$gt0018|Blood urea (mmol/L)|.value+$gt0019|Systolic blood pressure (mmHg)|.value+$gt0020|Pulse ≥ 100 / min|.value+$gt0021|Melena|.value+$gt0022|Syncope|.value+$gt0023|Hepatic disease|.value+$gt0024|Cardiac failure|.value"
        ]
      },
      "gt0026" : {
        "id" : "gt0026",
        "priority" : 1,
        "when" : [
          "$gt0017|Haemoglobin, women (g/dL)|!=null",
          "$gt0018|Blood urea (mmol/L)|!=null",
          "$gt0019|Systolic blood pressure (mmHg)|!=null",
          "$gt0020|Pulse ≥ 100 / min|!=null",
          "$gt0021|Melena|!=null",
          "$gt0022|Syncope|!=null",
          "$gt0023|Hepatic disease|!=null",
          "$gt0024|Cardiac failure|!=null",
          "$gt0016|Haemoglobin, men (g/dL)|==null"
        ],
        "then" : [
          "$gt0013|Total score|.magnitude=$gt0017|Haemoglobin, women (g/dL)|.value+$gt0018|Blood urea (mmol/L)|.value+$gt0019|Systolic blood pressure (mmHg)|.value+$gt0020|Pulse ≥ 100 / min|.value+$gt0021|Melena|.value+$gt0022|Syncope|.value+$gt0023|Hepatic disease|.value+$gt0024|Cardiac failure|.value"
        ]
      }
