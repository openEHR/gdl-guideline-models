    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the total sum for the Glasgow-Blatchford score to assess the risk of needing transfusion, endoscopy, or surgery in patients with upper gastrointestinal bleeding.",
        "keywords" : [
          "GBS",
          "UGIB",
          "blood urea",
          "upper",
          "GI",
          "bleeding",
          "gastrointestinal",
          "Glasgow",
          "Blatchford"
        ],
        "use" : "Use to evaluate the risk of clinical intervention in patients presenting with upper gastrointestinal bleeding.",
        "misuse" : "Not to be used as the sole basis for clinical decisions without clinical judgment. Not to be used for lower gastrointestinal bleeding.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "en" : "An assessment score used to evaluate the risk of need for clinical intervention in patients presenting with upper gastrointestinal bleeding.",
      "references" : "Blatchford O, Murray WR, Blatchford M. A risk score to predict need for treatment for upper-gastrointestinal haemorrhage. Lancet. 2000 Oct 14;356(9238):1318-21. doi: 10.1016/S0140-6736(00)02816-6. PMID: 11073021."
    }
  },
