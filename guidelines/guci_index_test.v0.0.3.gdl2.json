    "rules" : {
      "gt0005" : {
        "id" : "gt0005",
        "priority" : 1,
        "when" : [
          "$gt0004|AST result|!=null",
          "$gt0012|PK-INR|!=null",
          "$gt0012|PK-INR|!=null",
          "$gt0009|Upper reference result|!=null"
        ],
        "then" : [
          "$gt0018|GUCI-score|.magnitude=($gt0004|AST result|.magnitude*$gt0012|PK-INR|.magnitude*100)/($gt0015|TPK result|.magnitude*$gt0009|Upper reference result|.magnitude)"
        ]
      }
