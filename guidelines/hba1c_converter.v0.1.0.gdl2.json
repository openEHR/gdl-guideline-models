{
  "uuid" : "7bb73fd6-a372-4abf-ab89-ed4394a9d4de",
  "id" : "hba1c_converter.v0.1.0",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Katja Mariko Wilde",
      "email" : "katja-wilde@t-online.de",
      "organisation" : "Cambio CDS",
      "date" : "2026-04-20"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To convert a given HbA1c value or average blood glucose value into equivalent values across different HbA1c reporting standards and glucose units.",
        "keywords" : [
          "hba1c",
          "haemoglobin",
          "glucose",
          "conversion",
          "ifcc",
          "mono-s",
          "dcct",
          "jds"
        ],
        "use" : "Use this guideline to convert between HbA1c reporting systems and estimated average glucose values.\n\nInput:\n- Source value (numeric)\n- Convert from: Average glucose (mmol/L), Average glucose (mg/dL), IFCC (mmol/mol), DCCT (%), Mono-S (%), JDS (%)\n\nOutputs:\n- Average glucose (mmol/L)\n- Average glucose (mg/dL)\n- IFCC (mmol/mol)\n- DCCT (%)\n- Mono-S (%)\n- JDS (%)\n\nConversions are based on the following relationships:\n\nHbA1c conversions:\n- DCCT = 0.09148 × IFCC + 2.152\n- IFCC = 10.93 × DCCT − 23.5\n- Mono-S = 0.0957 × IFCC + 1.016\n- IFCC = 10.45 × Mono-S − 10.62\n- JDS = 0.09274 × IFCC + 1.724\n- IFCC = 10.78 × JDS − 18.59\n\nAverage glucose conversions:\n- Average glucose (mg/dL) = 28.7 × DCCT − 46.7\n- Average glucose (mmol/L) = Average glucose (mg/dL) / 18\n- Average glucose (mg/dL) = 18 × Average glucose (mmol/L)\n\nNote:\nEstimated average glucose values are approximations and may have greater uncertainty, particularly in specific populations such as children.",
        "misuse" : "Not to be used for recording directly measured laboratory HbA1c or blood glucose values without conversion.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Björn A. HbA1c according to different standards. Linköping University, Department of Mathematics; 2016 Mar 9.",
      "en" : "A structured guideline used to convert HbA1c values and average blood glucose values between current and historical HbA1c reporting systems, including IFCC, DCCT, Mono-S, JDS, and average glucose units (mmol/L and mg/dL)."
    }
  },
  "definition" : {
    "data_bindings" : {
      "gt0002" : {
        "id" : "gt0002",
        "model_id" : "openEHR-EHR-OBSERVATION.hba1c_converter.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.hba1c_converter.v0",
        "type" : "INPUT",
        "elements" : {
          "gt0003" : {
            "id" : "gt0003",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0006]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "mmol/L",
              "mg/dL",
              "mmol/mol",
              "%"
            ]
          },
          "gt0004" : {
            "id" : "gt0004",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0007]",
            "data_type" : "DV_CODED_TEXT",
            "allowed_values" : [
              "local::at0008",
              "local::at0009",
              "local::at0010",
              "local::at0011",
              "local::at0012",
              "local::at0013"
            ]
          }
        }
      },
      "gt0005" : {
        "id" : "gt0005",
        "model_id" : "openEHR-EHR-OBSERVATION.hba1c_converter.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.hba1c_converter.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0006" : {
            "id" : "gt0006",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0014]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "mmol/L"
            ]
          },
          "gt0007" : {
            "id" : "gt0007",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0015]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "mg/dL"
            ]
          },
          "gt0008" : {
            "id" : "gt0008",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0016]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "mmol/mol"
            ]
          },
          "gt0009" : {
            "id" : "gt0009",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0017]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "%"
            ]
          },
          "gt0010" : {
            "id" : "gt0010",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0018]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "%"
            ]
          },
          "gt0011" : {
            "id" : "gt0011",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0019]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "%"
            ]
          }
        }
      }
    },
    "rules" : {
      "gt0018" : {
        "id" : "gt0018",
        "priority" : 7,
        "when" : [
          "$gt0003|Source value|!=null",
          "$gt0003|Source value|.unit=='mmol/mol'",
          "$gt0004|Convert from|==local::at0010|IFCC (mmol/mol)|"
        ],
        "then" : [
          "$gt0008|IFCC (mmol/mol)|.magnitude=$gt0003|Source value|.magnitude",
          "$gt0008|IFCC (mmol/mol)|.unit='mmol/mol'",
          "$gt0008|IFCC (mmol/mol)|.precision=2"
        ]
      },
      "gt0017" : {
        "id" : "gt0017",
        "priority" : 6,
        "when" : [
          "$gt0003|Source value|!=null",
          "$gt0004|Convert from|==local::at0008|Average glucose (mmol/L)|"
        ],
        "then" : [
          "$gt0008|IFCC (mmol/mol)|.magnitude=10.93*(((18*$gt0003|Source value|.magnitude)+46.7)/28.7)-23.5",
          "$gt0008|IFCC (mmol/mol)|.unit='mmol/mol'",
          "$gt0008|IFCC (mmol/mol)|.precision=2"
        ]
      },
      "gt0019" : {
        "id" : "gt0019",
        "priority" : 5,
        "when" : [
          "$gt0003|Source value|!=null",
          "$gt0004|Convert from|==local::at0009|Average glucose (mg/dL)|"
        ],
        "then" : [
          "$gt0008|IFCC (mmol/mol)|.magnitude=10.93*(($gt0003|Source value|.magnitude+46.7)/28.7)-23.5",
          "$gt0008|IFCC (mmol/mol)|.unit='mmol/mol'",
          "$gt0008|IFCC (mmol/mol)|.precision=2"
        ]
      },
      "gt0012" : {
        "id" : "gt0012",
        "priority" : 4,
        "when" : [
          "$gt0003|Source value|!=null",
          "$gt0004|Convert from|==local::at0012|DCCT (%)|"
        ],
        "then" : [
          "$gt0008|IFCC (mmol/mol)|.magnitude=10.93*$gt0003|Source value|.magnitude-23.5",
          "$gt0008|IFCC (mmol/mol)|.unit='mmol/mol'",
          "$gt0008|IFCC (mmol/mol)|.precision=2"
        ]
      },
      "gt0013" : {
        "id" : "gt0013",
        "priority" : 3,
        "when" : [
          "$gt0003|Source value|!=null",
          "$gt0004|Convert from|==local::at0011|Mono-S (%)|"
        ],
        "then" : [
          "$gt0008|IFCC (mmol/mol)|.magnitude=10.45*$gt0003|Source value|.magnitude-10.62",
          "$gt0008|IFCC (mmol/mol)|.unit='mmol/mol'",
          "$gt0008|IFCC (mmol/mol)|.precision=2"
        ]
      },
      "gt0014" : {
        "id" : "gt0014",
        "priority" : 2,
        "when" : [
          "$gt0003|Source value|!=null",
          "$gt0004|Convert from|==local::at0013|JDS (%)|"
        ],
        "then" : [
          "$gt0008|IFCC (mmol/mol)|.magnitude=10.78*$gt0003|Source value|.magnitude-18.59",
          "$gt0008|IFCC (mmol/mol)|.unit='mmol/mol'",
          "$gt0008|IFCC (mmol/mol)|.precision=2"
        ]
      },
      "gt0015" : {
        "id" : "gt0015",
        "priority" : 1,
        "when" : [
          "$gt0008|IFCC (mmol/mol)|!=null"
        ],
        "then" : [
          "$gt0009|Mono-S (%)|.magnitude=0.0957*$gt0008|IFCC (mmol/mol)|.magnitude+1.016",
          "$gt0009|Mono-S (%)|.unit='%'",
          "$gt0009|Mono-S (%)|.precision=2",
          "$gt0010|DCCT (%)|.magnitude=0.09148*$gt0008|IFCC (mmol/mol)|.magnitude+2.152",
          "$gt0010|DCCT (%)|.unit='%'",
          "$gt0010|DCCT (%)|.precision=2",
          "$gt0011|JDS (%)|.magnitude=0.09274*$gt0008|IFCC (mmol/mol)|.magnitude+1.724",
          "$gt0011|JDS (%)|.unit='%'",
          "$gt0011|JDS (%)|.precision=2",
          "$gt0007|Average glucose (mg/dL)|.magnitude=28.7*(0.09148*$gt0008|IFCC (mmol/mol)|.magnitude+2.152)-46.7",
          "$gt0007|Average glucose (mg/dL)|.unit='mg/dL'",
          "$gt0007|Average glucose (mg/dL)|.precision=2",
          "$gt0006|Average glucose (mmol/L)|.magnitude=(28.7*(0.09148*$gt0008|IFCC (mmol/mol)|.magnitude+2.152)-46.7)/18",
          "$gt0006|Average glucose (mmol/L)|.unit='mmol/L'",
          "$gt0006|Average glucose (mmol/L)|.precision=2"
        ]
      }
    }
  },
