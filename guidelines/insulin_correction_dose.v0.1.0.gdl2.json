  "id" : "insulin_correction_dose.v0.1.0",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Mahmoud Elachi",
      "email" : "mel.achi@gmail.com",
      "organisation" : "Cambio CDS",
      "date" : "2026-07-13"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To provide a calculated advisory bolus insulin correction dose for patients with insulin-treated diabetes and a temporarily elevated plasma glucose, based on total daily insulin dose.",
        "keywords" : [
          "insulin",
          "glucose",
          "bolus dose",
          "correction dose",
          "100-rule",
          "diabetes mellitus",
          "hyperglycemia",
          "blood glucose"
        ],
        "use" : "Use to record the total daily insulin dose and the calculated correction dose for a patient with insulin-treated diabetes and a temporarily elevated plasma glucose.",
        "misuse" : "Use to record the total daily insulin dose and the calculated correction dose for a patient with insulin-treated diabetes and a temporarily elevated plasma glucose.\nNot to be used in patients without a stable, known total daily insulin dose.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "en" : "A calculation of the additional bolus dose of rapid-acting insulin required to correct a temporarily elevated plasma glucose, based on a patient's total daily insulin dose.",
      "references" : "de Bock M, Codner E, Craig ME, Huynh T, Maahs DM, Mahmud FH, Marcovecchio L, DiMeglio LA. ISPAD Clinical Practice Consensus Guidelines 2022: glycemic targets and glucose monitoring for children, adolescents, and young people with diabetes. Pediatr Diabetes. 2022 Dec;23(8):1270-1276. doi: 10.1111/pedi.13455. PMID: 36537523; PMCID: PMC10107615."
    }
  },
  "definition" : {
    "data_bindings" : {
      "gt0002" : {
        "id" : "gt0002",
        "model_id" : "openEHR-EHR-OBSERVATION.insulin_dosage_calculator.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.insulin_dosage_calculator.v0",
        "type" : "INPUT",
        "elements" : {
          "gt0003" : {
            "id" : "gt0003",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "mmol"
            ]
          },
          "gt0004" : {
            "id" : "gt0004",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0005]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "E"
            ]
          }
        }
      },
      "gt0005" : {
        "id" : "gt0005",
        "model_id" : "openEHR-EHR-OBSERVATION.insulin_dosage_calculator.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.insulin_dosage_calculator.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0006" : {
            "id" : "gt0006",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0006]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "E"
            ]
          }
        }
      }
    },
    "rules" : {
      "gt0007" : {
        "id" : "gt0007",
        "priority" : 1,
        "when" : [
          "$gt0003|P-glucose|!=null",
          "$gt0004|Daily dose of insulin|!=null",
          "$gt0003|P-glucose|.magnitude>=8",
          "$gt0004|Daily dose of insulin|.magnitude>0"
        ],
        "then" : [
          "$gt0006|Bolus dose|.magnitude=($gt0003|P-glucose|.magnitude-8)*($gt0004|Daily dose of insulin|.magnitude/100)",
          "$gt0006|Bolus dose|.unit='E'",
          "$gt0006|Bolus dose|.precision=1"
        ]
      }
    }
  },
  "ontology" : {
    "term_definitions" : {
      "en" : {
        "id" : "en",
        "terms" : {
          "gt0001" : {
            "id" : "gt0001",
            "text" : "insulin correction dose",
            "description" : "Calculates a bolus (correction) dose of rapid-acting insulin to correct a temporarily elevated plasma glucose in patients on insulin therapy, using the 100-rule"
          },
          "gt0002" : {
            "id" : "gt0002",
            "text" : "openEHR-EHR-OBSERVATION.insulin_dosage_calculator.v0"
          },
          "gt0003" : {
            "id" : "gt0003",
            "text" : "P-glucose"
          },
          "gt0004" : {
            "id" : "gt0004",
            "text" : "Daily dose of insulin"
          },
          "gt0005" : {
            "id" : "gt0005",
            "text" : "openEHR-EHR-OBSERVATION.insulin_dosage_calculator.v0"
          },
          "gt0006" : {
            "id" : "gt0006",
            "text" : "Bolus dose"
          },
          "gt0007" : {
            "id" : "gt0007",
            "text" : "Calculate Insulin bolus dose",
            "description" : "dose = (P-glucose - 8) * daily dose / 100"
          }
        }
      }
    }
  }
}