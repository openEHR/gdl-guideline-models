    "rules" : {
      "gt0025" : {
        "id" : "gt0025",
        "priority" : 4,
        "when" : [
          "$gt0003|Age|!=null",
          "$gt0004|Impaired fasting glucose/diabetes|!=null",
          "$gt0006|Body mass index|!=null",
          "$gt0009|Aspartate aminotransferase result|!=null",
          "$gt0016|Alanine aminotransferase result|!=null",
          "$gt0019|Platelet count result|!=null",
          "$gt0022|Albumin result|!=null"
        ],
        "then" : [
          "$gt0024|Total score|.magnitude=0-1.675+(0.037*$gt0003|Age|.magnitude)+(0.094*$gt0006|Body mass index|.magnitude)+(1.13*$gt0004|Impaired fasting glucose/diabetes|.value)+(0.99*($gt0009|Aspartate aminotransferase result|.magnitude/$gt0016|Alanine aminotransferase result|.magnitude))-(0.013*$gt0019|Platelet count result|.magnitude)-(0.66*$gt0022|Albumin result|.magnitude/10)",
          "$gt0024|Total score|.unit='1'",
          "$gt0024|Total score|.precision=3"
        ]
      },
      "gt0030" : {
        "id" : "gt0030",
        "priority" : 3,
        "when" : [
          "$gt0024|Total score|!=null",
          "$gt0024|Total score|<(0-1.455)"
        ],
        "then" : [
          "$gt0026|Correlated Fibrosis Severity|=$gt0027|F0-F2|.term"
        ]
      },
      "gt0031" : {
        "id" : "gt0031",
        "priority" : 2,
        "when" : [
          "$gt0024|Total score|!=null",
          "$gt0024|Total score|>=(0-1.455)",
          "$gt0024|Total score|<=0.675"
        ],
        "then" : [
          "$gt0026|Correlated Fibrosis Severity|=$gt0028|Indeterminant score|.term"
        ]
      },
      "gt0032" : {
        "id" : "gt0032",
        "priority" : 1,
        "when" : [
          "$gt0024|Total score|!=null",
          "$gt0024|Total score|>0.675"
        ],
        "then" : [
          "$gt0026|Correlated Fibrosis Severity|=$gt0029|F3-F4|.term"
        ]
      }
    }
  },
