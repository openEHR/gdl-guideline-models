            "units" : [
              "min"
            ]
          }
        }
      }
    },
    "rules" : {
      "gt0008" : {
        "id" : "gt0008",
        "priority" : 1,
        "when" : [
          "$gt0003|Cylinder volume|!=null",
          "$gt0004|Cylinder pressure|!=null",
          "$gt0005|Oxygen flow rate|!=null"
        ],
        "then" : [
          "$gt0007|Oxygen cylinder duration|.magnitude=$gt0003|Cylinder volume|.magnitude*$gt0004|Cylinder pressure|.magnitude/$gt0005|Oxygen flow rate|.magnitude",
          "$gt0007|Oxygen cylinder duration|.unit='min'",
          "$gt0007|Oxygen cylinder duration|.precision=0"
        ]
      }
    }
