    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the estimated remaining duration of oxygen supply for a medical oxygen cylinder.",
        "keywords" : [
          "oxygen",
          "cylinder",
          "medical",
          "flow rate",
          "pressure",
          "duration"
        ],
        "use" : "Use this guideline to estimate how long oxygen in a medical oxygen cylinder will last.\n\nInputs:\n- Cylinder volume (L)\n- Cylinder pressure (bar)\n- Oxygen flow rate (L/min)\n\nOutput:\n- Estimated oxygen cylinder duration (min)\n\nCalculation: Oxygen cylinder duration (min) = cylinder volume (L) × cylinder pressure (bar) / oxygen flow rate (L/min)",
        "misuse" : "Not to be used as the sole basis for clinical oxygen therapy planning or patient monitoring. The calculation provides an estimate only and does not account for system leakage, reserve volume, or variations in oxygen delivery equipment.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "King D, Houseman B, Decker M. Gas Cylinders. 2023 Apr 23. In: StatPearls [Internet]. Treasure Island (FL): StatPearls Publishing; 2026 Jan–. PMID: 30020722.",
      "en" : "A structured guideline used to estimate the remaining duration of oxygen supply in a medical oxygen cylinder based on cylinder volume, cylinder pressure, and oxygen flow rate."
    }
  },
