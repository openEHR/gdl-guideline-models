  "id" : "pH_corrected_calcium.v0.0.2",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Mahmoud Elachi",
      "email" : "mel.achi@gmail.com",
      "organisation" : "Cambio CDS"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To standardise interpretation of ionised calcium measurements in patients with acid–base disturbances by adjusting measured values to physiologic pH.",
        "keywords" : [
          "ionized calcium",
          "calcium ion",
          "pH correction",
          "blood ph",
          "acid–base balance",
          "calcium homeostasis",
          "blood gas analysis",
          "electrolyte disorders"
        ],
        "use" : "Intended for adult patients where ionised calcium and blood pH are measured from the same blood sample, particularly in emergency medicine, intensive care, preoperative care, and metabolic assessment.",
        "misuse" : "Not intended for use with total serum calcium.\nNot validated in extreme pH values outside physiologic range.\nShould not be used as a standalone diagnostic tool without clinical context.\nNot validated in severe protein-binding disorders.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "https://pubmed.ncbi.nlm.nih.gov/7237795/",
      "en" : "Estimates ionised calcium concentration adjusted to physiologic pH (7.40) based on the experimentally observed relationship between pH and ionised calcium."
    }
  },
  "definition" : {
    "data_bindings" : {
      "gt0002" : {
        "id" : "gt0002",
        "model_id" : "openEHR-EHR-OBSERVATION.ph_korrigerat_kalcium.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.ph_korrigerat_kalcium.v0",
        "type" : "INPUT",
        "elements" : {
          "gt0003" : {
            "id" : "gt0003",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0004]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "mmol"
            ]
          },
          "gt0004" : {
            "id" : "gt0004",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0005]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "1",
              "units"
            ]
          }
        }
      },
      "gt0005" : {
        "id" : "gt0005",
        "model_id" : "openEHR-EHR-OBSERVATION.ph_korrigerat_kalcium.v0",
        "template_id" : "openEHR-EHR-OBSERVATION.ph_korrigerat_kalcium.v0",
        "type" : "OUTPUT",
        "elements" : {
          "gt0006" : {
            "id" : "gt0006",
            "path" : "/data[at0001]/events[at0002]/data[at0003]/items[at0006]",
            "data_type" : "DV_QUANTITY",
            "units" : [
              "mmol/L"
            ]
          }
        }
      }
    },
    "rules" : {
      "gt0008" : {
        "id" : "gt0008",
        "priority" : 2,
        "when" : [
          "$gt0004|pH|!=null"
        ],
        "then" : [
          "$gt0008|Calcualtion|=1-0.53*(7.4-$gt0004|pH|.magnitude)"
        ]
      },
      "gt0007" : {
        "id" : "gt0007",
        "priority" : 1,
        "when" : [
          "$gt0003|Calciumjon|!=null",
          "$gt0004|pH|!=null",
          "$gt0004|pH|.magnitude>=6.5&&$gt0004|pH|.magnitude<=8.5",
          "$gt0003|Calciumjon|.magnitude>=0.5&&$gt0003|Calciumjon|.magnitude<=2.5"
        ],
        "then" : [
          "$gt0006|output|.magnitude=$gt0003|Calciumjon|.magnitude*$gt0008|Calculation 1|",
          "$gt0006|output|.precision=2"
        ]
      }
    }
  },
