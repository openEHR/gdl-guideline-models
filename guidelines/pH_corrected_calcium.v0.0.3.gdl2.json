{
  "uuid" : "f711a1b2-b5a1-48d6-a546-a6550fa1d14b",
  "id" : "pH_corrected_calcium.v0.0.3",
  "gdl_version" : "2.1",
  "concept" : "gt0001",
  "language" : {
    "original_language" : "ISO_639-1::en"
  },
  "description" : {
    "original_author" : {
      "name" : "Mahmoud Elachi",
      "email" : "mel.achi@gmail.com",
      "organisation" : "Cambio CDS"
    },
    "lifecycle_state" : "DRAFTED",
    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To estimate the biologically active calcium level when ionized calcium is unavailable, adjusted for pH and albumin.",
        "keywords" : [
          "ionized calcium",
          "calcium ion",
          "pH correction",
          "calcium homeostasis",
          "pH",
          "calcium",
          "pH-corrected calcium"
        ],
        "use" : "Use in patients with abnormal albumin or acid-base disturbances to assess true calcium status.",
        "misuse" : "Not to be used as a replacement for direct ionized calcium measurement, particularly in critically ill patients or those with significant protein abnormalities.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "Fogh-Andersen N. Ionized calcium analyzer with a built-in pH correction. Clin Chem. 1981 Jul;27(7):1264-7. PMID: 7237795.",
      "en" : "Estimates ionised calcium concentration adjusted to physiologic pH (7.40) based on the experimentally observed relationship between pH and ionised calcium."
    }
  },
  "definition" : {
    "rules" : {
      "gt0008" : {
        "id" : "gt0008",
        "priority" : 2,
        "when" : [
          "$gt0004|pH|!=null"
        ],
        "then" : [
          "$gt0008|Calcualtion|=1-0.53*(7.4-$gt0004|pH|.magnitude)"
        ]
      },
      "gt0007" : {
        "id" : "gt0007",
        "priority" : 1,
        "when" : [
          "$gt0003|Calcium ion|!=null",
          "$gt0008|Calculate pH correction factor|!=null",
          "$gt0003|Calcium ion|.magnitude>=0.5&&$gt0003|Calcium ion|.magnitude<=2.5",
          "$gt0004|pH|.magnitude>=6.5&&$gt0004|pH|.magnitude<=8.5"
        ],
        "then" : [
          "$gt0006|output|.magnitude=$gt0003|Calcium ion|.magnitude*$gt0008|Calculate pH correction factor|",
          "$gt0006|output|.precision=2",
          "$gt0006|output|.unit='mmol/L'"
        ]
      }
    }
  },
  "ontology" : {
    "term_definitions" : {
      "en" : {
        "id" : "en",
        "terms" : {
          "gt0001" : {
            "id" : "gt0001",
            "text" : "pH corrected calcium",
            "description" : "Calculates the pH-corrected (physiologically adjusted) calcium level based on total calcium, albumin, and pH."
          },
          "gt0007" : {
            "id" : "gt0007",
            "text" : "Calculate corrected calcium",
            "description" : "output = Calciumjon * Calculation"
          },
          "gt0008" : {
            "id" : "gt0008",
            "text" : "Calculate pH correction factor",
            "description" : "Calculation = 1 - 0.53 * (7.4 - pH)"
          }
        }
      }
    }
  }
}