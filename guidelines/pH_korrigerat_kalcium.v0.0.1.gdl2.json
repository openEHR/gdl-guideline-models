    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To standardise interpretation of ionised calcium measurements in patients with acid–base disturbances by adjusting measured values to physiologic pH.",
        "use" : "Intended for adult patients where ionised calcium and blood pH are measured from the same blood sample, particularly in emergency medicine, intensive care, preoperative care, and metabolic assessment.",
        "misuse" : "Not intended for use with total serum calcium.\nNot validated in extreme pH values outside physiologic range.\nShould not be used as a standalone diagnostic tool without clinical context.\nNot validated in severe protein-binding disorders.",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "references" : "https://pubmed.ncbi.nlm.nih.gov/7237795/",
      "en" : "Estimates ionised calcium concentration adjusted to physiologic pH (7.40) based on the experimentally observed relationship between pH and ionised calcium."
    }
  },
