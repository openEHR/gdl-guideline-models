        "then" : [
          "$gt0020|Male sex|=10|local::at0016|Present|"
        ]
      },
      "gt0036" : {
        "id" : "gt0036",
        "priority" : 2,
        "when" : [
          "$gt0006|Cancer (unspecified)|==1|local::at0052|Yes|"
        ],
        "then" : [
          "$gt0021|Cancer (comorbidity)|=30|local::at0018|Present|"
        ]
      },
      "gt0037" : {
        "id" : "gt0037",
        "priority" : 1
      }
