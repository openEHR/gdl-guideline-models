    "rules" : {
      "gt0044" : {
        "id" : "gt0044",
        "priority" : 6,
        "when" : [
          "$gt0060|Age|!=null",
          "$gt0061|Male sex|!=null",
          "$gt0062|Cancer (comorbidity)|!=null",
          "$gt0063|Heart failure (comorbidity)|!=null",
          "$gt0064|Chronic lung disease (comorbidity)|!=null",
          "$gt0065|Pulse ≥ 110/min|!=null",
          "$gt0066|Systolic blood pressure < 100 mmHg|!=null",
          "$gt0067|Respiratory rate ≥ 30/min|!=null",
          "$gt0068|Temperature < 36°C|!=null",
          "$gt0069|Altered mental status|!=null",
          "$gt0070|Arterial oxygen saturation < 90%|!=null"
        ],
        "then" : [
          "$gt0075|Total score|.magnitude=$gt0060|Age|.magnitude+$gt0061|Male sex|.value+$gt0062|Cancer (comorbidity)|.value+$gt0063|Heart failure (comorbidity)|.value+$gt0064|Chronic lung disease (comorbidity)|.value+$gt0065|Pulse ≥ 110/min|.value+$gt0066|Systolic blood pressure < 100 mmHg|.value+$gt0067|Respiratory rate ≥ 30/min|.value+$gt0068|Temperature < 36°C|.value+$gt0069|Altered mental status|.value+$gt0070|Arterial oxygen saturation < 90%|.value"
        ]
      },
      "gt0045" : {
        "id" : "gt0045",
        "priority" : 5,
        "when" : [
          "$gt0075|Total score|<=65"
        ],
        "then" : [
          "$gt0072|Risk class|=local::at0003|Class I (very low risk)|",
          "$gt0073|30-day mortality|=local::at0009|0.0 - 1.6%|"
        ]
      },
      "gt0055" : {
        "id" : "gt0055",
        "priority" : 4,
        "when" : [
          "$gt0075|Total score|<=85",
          "$gt0075|Total score|>65"
        ],
        "then" : [
          "$gt0072|Risk class|=local::at0004|Class II (low risk)|",
          "$gt0073|30-day mortality|=local::at0010|1.7 - 3.5%|"
        ]
      },
      "gt0056" : {
        "id" : "gt0056",
        "priority" : 3,
        "when" : [
          "$gt0075|Total score|<=105",
          "$gt0075|Total score|>85"
        ],
        "then" : [
          "$gt0072|Risk class|=local::at0005|Class III (intermediate risk)|",
          "$gt0073|30-day mortality|=local::at0011|3.2 - 7.1%|"
        ]
      },
      "gt0057" : {
        "id" : "gt0057",
        "priority" : 2,
        "when" : [
          "$gt0075|Total score|<=125",
          "$gt0075|Total score|>105"
        ],
        "then" : [
          "$gt0072|Risk class|=local::at0006|Class IV (high risk)|",
          "$gt0073|30-day mortality|=local::at0012|4.0 - 11.4%|"
        ]
      },
      "gt0058" : {
