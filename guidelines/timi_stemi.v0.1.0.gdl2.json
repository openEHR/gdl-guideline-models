    "details" : {
      "en" : {
        "id" : "en",
        "purpose" : "To calculate the TIMI risk score for STEMI and estimate 30-day mortality risk in patients with ST-elevation myocardial infarction.",
        "keywords" : [
          "TIMI",
          "STEMI",
          "risk",
          "score",
          "myocardial infarction",
          "st-elevation",
          "mortality",
          "30-day mortality",
          "diabetes",
          "hypertension",
          "angina",
          "left bundle branch block",
          "killip class",
          "heart rate",
          "systolic blood pressure",
          "body weight",
          "time to treatment"
        ],
        "use" : "Use this guideline to calculate the TIMI risk score for STEMI and estimate 30-day mortality risk.\n\nInputs:\n- age\n- systolic blood pressure\n- heart rate\n- body weight\n- diabetes mellitus\n- hypertension\n- angina pectoris\n- anterior ST elevation\n- left bundle branch block (LBBB)\n- time to treatment &gt;4 hours\n- Killip class\n\nScoring:\n- age 65–74 years = 2 points\n- age ≥75 years = 3 points\n- systolic blood pressure &lt;100 mmHg = 3 points\n- heart rate &gt;100/min = 2 points\n- Killip class II–IV = 2 points\n- body weight &lt;67 kg = 1 point\n- diabetes mellitus, hypertension, or angina pectoris present = 1 point\n- anterior ST elevation or LBBB present = 1 point\n- time to treatment &gt;4 hours = 1 point\n\nThe total score ranges from 0 to 14 points and is used to estimate 30-day mortality risk.",
        "misuse" : "Not to be used for patients with cardiogenic shock, severe hypertension, or patients undergoing primary percutaneous coronary intervention (PCI).",
        "copyright" : "© Cambio CDS"
      }
    },
    "other_details" : {
      "en" : "A structured guideline used to calculate the TIMI risk score for ST-elevation myocardial infarction (STEMI) and derive the estimated 30-day mortality risk.",
      "references" : "Morrow DA, Antman EM, Charlesworth A, Cairns R, Murphy SA, de Lemos JA, Giugliano RP, McCabe CH, Braunwald E. TIMI risk score for ST-elevation myocardial infarction: A convenient, bedside, clinical score for risk assessment at presentation: An intravenous nPA for treatment of infarcting myocardium early II trial substudy. Circulation. 2000 Oct 24;102(17):2031-7. doi: 10.1161/01.cir.102.17.2031. PMID: 11044416."
    }
  },
