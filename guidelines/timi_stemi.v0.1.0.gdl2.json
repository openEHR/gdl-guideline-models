    "rules" : {
      "gt0028" : {
        "id" : "gt0028",
        "priority" : 25,
        "when" : [
          "$gt0003|Age|.magnitude<65"
        ],
        "then" : [
          "$gt0019|Age category|=0|local::at0019|Age < 65|"
        ]
      },
      "gt0029" : {
        "id" : "gt0029",
        "priority" : 24,
        "when" : [
          "$gt0003|Age|.magnitude>=65",
          "$gt0003|Age|.magnitude<=74"
        ],
        "then" : [
          "$gt0019|Age category|=2|local::at0020|Age between 65-74|"
        ]
      },
      "gt0030" : {
        "id" : "gt0030",
        "priority" : 23,
        "when" : [
          "$gt0003|Age|.magnitude>=75"
        ],
        "then" : [
          "$gt0019|Age category|=3|local::at0021|Age >= 75|"
        ]
      },
      "gt0031" : {
        "id" : "gt0031",
        "priority" : 22,
        "when" : [
          "$gt0005|Systolic BP|.magnitude>=100"
        ],
        "then" : [
          "$gt0020|Sys BP < 100mmhg|=0|local::at0027|No|"
        ]
      },
      "gt0032" : {
        "id" : "gt0032",
        "priority" : 21,
        "when" : [
          "$gt0005|Systolic BP|.magnitude<100"
        ],
        "then" : [
          "$gt0020|Sys BP < 100mmhg|=3|local::at0028|Yes|"
        ]
      },
      "gt0033" : {
        "id" : "gt0033",
        "priority" : 20,
        "when" : [
          "$gt0007|Heart Rate|.magnitude<=100"
        ],
        "then" : [
          "$gt0021|HR > 100 bpm|=0|local::at0029|No|"
        ]
      },
      "gt0034" : {
        "id" : "gt0034",
        "priority" : 19,
        "when" : [
          "$gt0007|Heart Rate|.magnitude>100"
        ],
        "then" : [
          "$gt0021|HR > 100 bpm|=2|local::at0030|Yes|"
        ]
      },
      "gt0037" : {
        "id" : "gt0037",
        "priority" : 18,
        "when" : [
          "$gt0009|Weight|!=null",
          "$gt0009|Weight|.unit=='[lb_av]'"
        ],
        "then" : [
          "$gt0009|Weight|.magnitude=$gt0009|Weight|.magnitude/2.20462262",
          "$gt0009|Weight|.unit='kg'",
          "$gt0009|Weight|.precision=3"
        ]
      },
      "gt0035" : {
        "id" : "gt0035",
        "priority" : 17,
        "when" : [
          "$gt0009|Weight|.magnitude>=67",
          "$gt0009|Weight|.unit=='kg'"
        ],
        "then" : [
          "$gt0022|Weight < 67kg|=0|local::at0016|No|"
        ]
      },
      "gt0036" : {
        "id" : "gt0036",
        "priority" : 16,
        "when" : [
          "$gt0009|Weight|.magnitude<67",
          "$gt0009|Weight|.unit=='kg'"
        ],
        "then" : [
          "$gt0022|Weight < 67kg|=1|local::at0017|Yes|"
        ]
      },
      "gt0039" : {
        "id" : "gt0039",
        "priority" : 15,
        "when" : [
          "$gt0011|Diabetes mellitus|==local::at0032|No|&&$gt0012|Hypertension|==local::at0035|No|&&$gt0013|Angina pectoris|==local::at0038|No|"
        ],
        "then" : [
          "$gt0023|DM/HyperT/Angina history|=0|local::at0005|No|"
        ]
      },
      "gt0038" : {
        "id" : "gt0038",
        "priority" : 14,
        "when" : [
          "$gt0011|Diabetes mellitus|==local::at0033|Yes|||$gt0012|Hypertension|==local::at0036|Yes|||$gt0013|Angina pectoris|==local::at0039|Yes|"
        ],
        "then" : [
          "$gt0023|DM/HyperT/Angina history|=1|local::at0006|Yes|"
        ]
      },
      "gt0040" : {
        "id" : "gt0040",
        "priority" : 13,
        "when" : [
          "$gt0015|Anterior ST elevation|==local::at0041|No|&&$gt0016|Left bundle branch block|==local::at0044|No|"
        ],
        "then" : [
          "$gt0024|Anterior ST elevation or LBBB|=0|local::at0008|No|"
        ]
      },
      "gt0041" : {
        "id" : "gt0041",
        "priority" : 12,
        "when" : [
          "$gt0015|Anterior ST elevation|==local::at0042|Yes|||$gt0016|Left bundle branch block|==local::at0045|Yes|"
        ],
        "then" : [
          "$gt0024|Anterior ST elevation or LBBB|=1|local::at0009|Yes|"
        ]
      },
      "gt0042" : {
        "id" : "gt0042",
        "priority" : 11,
        "when" : [
          "$gt0003|Age|!=null",
          "$gt0005|Systolic BP|!=null",
          "$gt0007|Heart Rate|!=null",
          "$gt0009|Weight|!=null",
          "$gt0011|Diabetes mellitus|!=null",
          "$gt0012|Hypertension|!=null",
          "$gt0013|Angina pectoris|!=null",
          "$gt0014|Killip Class II-IV|!=null",
          "$gt0015|Anterior ST elevation|!=null",
          "$gt0016|Left bundle branch block|!=null",
          "$gt0017|Time to treatment > 4hrs|!=null"
        ],
        "then" : [
          "$gt0025|TIMI risk score for STEMI|.magnitude=$gt0019|Age category|.value+$gt0020|Sys BP < 100mmhg|.value+$gt0021|HR > 100 bpm|.value+$gt0022|Weight < 67kg|.value+$gt0023|DM/HyperT/Angina history|.value+$gt0024|Anterior ST elevation or LBBB|.value+$gt0014|Killip Class II-IV|.value+$gt0017|Time to treatment > 4hrs|.value"
        ]
      },
      "gt0043" : {
        "id" : "gt0043",
        "priority" : 10,
        "when" : [
          "$gt0025|TIMI risk score for STEMI|.magnitude==0"
        ],
        "then" : [
          "$gt0049|30-day mortality risk|=local::at0016|0,8%|"
        ]
      },
      "gt0044" : {
        "id" : "gt0044",
        "priority" : 9,
        "when" : [
          "$gt0025|TIMI risk score for STEMI|.magnitude==1"
        ],
        "then" : [
          "$gt0049|30-day mortality risk|=local::at0017|1,6%|"
        ]
      },
      "gt0045" : {
        "id" : "gt0045",
        "priority" : 8,
        "when" : [
          "$gt0025|TIMI risk score for STEMI|.magnitude==2"
        ],
        "then" : [
          "$gt0049|30-day mortality risk|=local::at0018|2,2%|"
        ]
      },
      "gt0046" : {
        "id" : "gt0046",
        "priority" : 7,
        "when" : [
          "$gt0025|TIMI risk score for STEMI|.magnitude==3"
        ],
        "then" : [
          "$gt0049|30-day mortality risk|=local::at0019|4,4%|"
        ]
      },
      "gt0047" : {
        "id" : "gt0047",
        "priority" : 6,
        "when" : [
          "$gt0025|TIMI risk score for STEMI|.magnitude==4"
        ],
        "then" : [
          "$gt0049|30-day mortality risk|=local::at0020|7,3%|"
        ]
      },
      "gt0050" : {
        "id" : "gt0050",
        "priority" : 5,
        "when" : [
          "$gt0025|TIMI risk score for STEMI|.magnitude==5"
        ],
        "then" : [
          "$gt0049|30-day mortality risk|=local::at0021|12,4%|"
        ]
      },
      "gt0051" : {
        "id" : "gt0051",
        "priority" : 4,
        "when" : [
          "$gt0025|TIMI risk score for STEMI|.magnitude==6"
        ],
        "then" : [
          "$gt0049|30-day mortality risk|=local::at0022|16,1%|"
        ]
      },
      "gt0052" : {
        "id" : "gt0052",
        "priority" : 3,
        "when" : [
          "$gt0025|TIMI risk score for STEMI|.magnitude==7"
        ],
        "then" : [
          "$gt0049|30-day mortality risk|=local::at0023|23,4%|"
        ]
      },
      "gt0053" : {
        "id" : "gt0053",
        "priority" : 2,
        "when" : [
          "$gt0025|TIMI risk score for STEMI|.magnitude==8"
        ],
        "then" : [
          "$gt0049|30-day mortality risk|=local::at0024|26,8%|"
        ]
      },
      "gt0054" : {
        "id" : "gt0054",
        "priority" : 1,
        "when" : [
          "$gt0025|TIMI risk score for STEMI|.magnitude>=9",
          "$gt0025|TIMI risk score for STEMI|.magnitude<=14"
        ],
        "then" : [
          "$gt0049|30-day mortality risk|=local::at0025|35,9%|"
        ]
      }
    }
